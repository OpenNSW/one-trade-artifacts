{
  "id": "npqs-visual-consignment--officer-form-v2",
  "title": "Consignment Visual Inspection Outcome",
  "schema": {
    "type": "object",
    "properties": {
      "visual_result": {
        "type": "string",
        "title": "Inspection Result",
        "oneOf": [
          {
            "const": "pass",
            "title": "Pass (Consignment approved visually)"
          },
          {
            "const": "fail",
            "title": "Fail (Consignment has pests, rot, or damage)"
          }
        ],
        "default": "pass"
      },
      "inspection_comments": {
        "type": "string",
        "title": "Inspection Notes",
        "example": "Conducted visual inspection of packages at port. Storage conditions are acceptable, all seals intact."
      },
      "items": {
        "type": "array",
        "title": "Commodity Consignment Inspection Results (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "string",
              "title": "Common Name"
            },
            "visual_result": {
              "type": "string",
              "title": "Inspection Result",
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass (Approved visually)"
                },
                {
                  "const": "fail",
                  "title": "Fail (Pests, rot, or damage detected)"
                }
              ],
              "default": "pass"
            },
            "visual_failure_reason": {
              "type": "string",
              "title": "Failure Reason",
              "example": "Rot and physical fungal damage observed on packaging."
            }
          },
          "required": [
            "id",
            "visual_result"
          ]
        }
      }
    },
    "required": [
      "visual_result"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/visual_result"
      },
      {
        "type": "Control",
        "scope": "#/properties/inspection_comments"
      },
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/commodity_common_name",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/visual_result"
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/visual_failure_reason",
                "rule": {
                  "effect": "SHOW",
                  "condition": {
                    "scope": "#/properties/visual_result",
                    "schema": {
                      "const": "fail"
                    }
                  }
                }
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      }
    ]
  }
}
