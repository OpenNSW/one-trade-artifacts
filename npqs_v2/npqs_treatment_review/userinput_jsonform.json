{
  "id": "npqs-upload-treatment-certs--trader-form-v2",
  "title": "Trader Submitted Treatment Certificates",
  "schema": {
    "type": "object",
    "properties": {
      "treatment_items": {
        "type": "array",
        "title": "Items Under Treatment (Context)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "string",
              "title": "Commodity Name"
            },
            "treatment_type": {
              "type": "string",
              "title": "Treatment Type Requested"
            }
          }
        }
      },
      "treatment_certificate_url": {
        "type": "string",
        "format": "file",
        "title": "Treatment Certificate Document (PDF/Image)",
        "readOnly": true
      },
      "supervision_report_url": {
        "type": "string",
        "format": "file",
        "title": "Supervision Report Document (Required if supervision was requested)",
        "readOnly": true
      },
      "upload_remarks": {
        "type": "string",
        "title": "Trader Comments / Remarks",
        "readOnly": true
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/treatment_items",
        "options": {
          "readonly": true,
          "detail": {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/id",
                "options": {
                  "readOnly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_common_name",
                "options": {
                  "readOnly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/treatment_type",
                "options": {
                  "readOnly": true
                }
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/treatment_certificate_url",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/supervision_report_url",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/upload_remarks",
        "options": {
          "readonly": true
        }
      }
    ]
  }
}
