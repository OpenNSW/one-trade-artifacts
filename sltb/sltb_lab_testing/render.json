{
  "id": "sltb-lab-testing--review:render",
  "type": "APPLICATION",
  "title": "Lab Testing & Results",
  "files": [
    "payload.payload.test_report_file",
    "reviewform.test_report_file"
  ],
  "sections": {
    "review_form": {
      "templateId": "sltb-lab-testing--officer-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "handles": [
        {
          "command": "submit",
          "label": "Submit Review",
          "element": "primary_action"
        }
      ]
    },
    "status_message": {
      "templateId": "sltb-lab-testing--submission-view",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
