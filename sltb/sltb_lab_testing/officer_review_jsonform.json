{
  "id": "sltb-lab-testing--officer-form",
  "title": "Record Lab Test Results",
  "schema": {
    "type": "object",
    "required": ["lab_tests", "test_result", "test_date", "test_report_file"],
    "properties": {
      "sample_number": {
        "type": "string",
        "title": "Sample Number",
        "readOnly": true
      },
      "lab_tests": {
        "type": "array",
        "title": "Lab Tests",
        "description": "One entry per test. If any test fails, the sample fails.",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["test_name", "result"],
          "properties": {
            "test_name": {
              "type": "string",
              "title": "Test",
              "example": "Moisture Content"
            },
            "result": {
              "type": "string",
              "title": "Result",
              "oneOf": [
                { "const": "pass", "title": "Pass" },
                { "const": "fail", "title": "Fail" }
              ]
            },
            "remarks": {
              "type": "string",
              "title": "Remarks (Optional)",
              "example": "5.8% — within the 7% limit."
            }
          }
        }
      },
      "test_result": {
        "type": "string",
        "title": "Overall Result",
        "description": "Fail if any test failed. A failed sample is charged the lab test fee and the application is rejected.",
        "oneOf": [
          { "const": "pass", "title": "Pass — Every test passed" },
          { "const": "fail", "title": "Fail — At least one test failed" }
        ]
      },
      "lab_fee_amount": {
        "type": "number",
        "title": "Lab Test Fee for Failed Sample (LKR)",
        "exclusiveMinimum": 0,
        "example": 5000,
        "description": "Enter the lab test fee the trader must pay for the failed sample."
      },
      "test_date": {
        "type": "string",
        "format": "date",
        "title": "Date of Testing",
        "example": "2026-07-05"
      },
      "test_report_file": {
        "type": "string",
        "format": "file",
        "title": "Lab Test Report (PDF)",
        "description": "Upload the signed lab test report. The trader can download it.",
        "x-file": { "accept": ".pdf" }
      },
      "test_report_ref": {
        "type": "string",
        "title": "Lab Report Reference Number (Optional)",
        "example": "SLTB-LAB-2026-00412"
      },
      "test_notes": {
        "type": "string",
        "title": "Testing Notes / Comments (Optional)",
        "example": "Moisture content and grade within acceptable SLTB standards."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": { "test_result": { "const": "fail" } },
          "required": ["test_result"]
        },
        "then": { "required": ["lab_fee_amount"] }
      },
      {
        "if": {
          "properties": {
            "lab_tests": {
              "contains": {
                "properties": { "result": { "const": "fail" } },
                "required": ["result"]
              }
            }
          },
          "required": ["lab_tests"]
        },
        "then": { "properties": { "test_result": { "const": "fail" } } },
        "else": { "properties": { "test_result": { "const": "pass" } } }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/sample_number",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/sample_number",
            "schema": { "type": "string", "minLength": 1 }
          }
        }
      },
      { "type": "Control", "scope": "#/properties/lab_tests" },
      { "type": "Control", "scope": "#/properties/test_result" },
      {
        "type": "Control",
        "scope": "#/properties/lab_fee_amount",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/test_result",
            "schema": { "const": "fail" }
          }
        }
      },
      { "type": "Control", "scope": "#/properties/test_date" },
      { "type": "Control", "scope": "#/properties/test_report_file" },
      { "type": "Control", "scope": "#/properties/test_report_ref" },
      {
        "type": "Control",
        "scope": "#/properties/test_notes",
        "options": { "multiLine": true }
      }
    ]
  }
}
