{
  "id": "sltb-final-decision--review-workflow",
  "name": "SLTB Final Decision — Officer Review",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "userform",
      "type": "TASK",
      "task_template_id": "sltb-final-decision--officer-review",
      "input_mapping": {
        "submission?": "submission",
        "submission.sample_number?": "reviewform.sample_number",
        "reviewform.remarks?": "previous_remarks"
      },
      "output_mapping": {
        "final_decision_outcome": "reviewform.final_decision_outcome",
        "remarks?": "reviewform.remarks"
      }
    },
    {
      "id": "decision_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "request_info",
      "type": "TASK",
      "task_template_id": "sltb-final-decision--request-info",
      "input_mapping": {
        "callbackToken": "replyToken",
        "reviewform.final_decision_outcome": "payload.final_decision_outcome",
        "reviewform.remarks?": "payload.remarks",
        "submission?": "submission",
        "reviewform": "reviewform"
      },
      "output_mapping": {
        "submission": "submission",
        "callbackToken": "callbackToken"
      }
    },
    {
      "id": "api_call",
      "type": "TASK",
      "task_template_id": "sltb-final-decision--notify-decision",
      "input_mapping": {
        "callbackToken": "callbackToken",
        "reviewform?": "reviewform",
        "submission?": "submission",
        "taskId": "taskId",
        "reviewform.final_decision_outcome": "payload.command",
        "reviewform": "payload.payload"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "userform"
    },
    {
      "id": "e2",
      "source_id": "userform",
      "target_id": "decision_gateway"
    },
    {
      "id": "e_needs_info",
      "source_id": "decision_gateway",
      "target_id": "request_info",
      "condition": "reviewform.final_decision_outcome == 'needs_more_info'"
    },
    {
      "id": "e_resubmitted",
      "source_id": "request_info",
      "target_id": "userform"
    },
    {
      "id": "e_decided",
      "source_id": "decision_gateway",
      "target_id": "api_call",
      "condition": "reviewform.final_decision_outcome in ['approve', 'reject']"
    },
    {
      "id": "e3",
      "source_id": "api_call",
      "target_id": "end"
    }
  ]
}
