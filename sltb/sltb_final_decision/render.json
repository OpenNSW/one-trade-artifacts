{
  "id": "sltb-final-decision--review:render",
  "type": "APPLICATION",
  "title": "SLTB Final Decision",
  "files": [
    "submission.cusdec_draft.supportingDocuments.scannedDocuments[*].fileBase64",
    "submission.lab_tests[*].report_file"
  ],
  "sections": {
    "previous_review": {
      "templateId": "sltb-final-decision--previous-review",
      "title": "Previous Review",
      "projector": "MARKDOWN",
      "dataKey": "previous_remarks",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "previous_remarks"
      }
    },
    "lab_results": {
      "templateId": "sltb-final-decision--lab-results",
      "title": "Lab Results",
      "projector": "MARKDOWN",
      "dataKey": "submission"
    },
    "submission_view": {
      "templateId": "sltb-submit-blendsheet--officer-view-form",
      "title": "Submitted Blend Sheets and CusDec",
      "projector": "FORM",
      "dataKey": "submission"
    },
    "review_form": {
      "templateId": "sltb-final-decision--officer-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "handles": [
        {
          "command": "submit",
          "label": "Submit Review",
          "element": "primary_action"
        }
      ]
    },
    "status_message": {
      "templateId": "sltb-final-decision--submission-view",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "callbackToken"
      }
    },
    "awaiting_resubmission": {
      "templateId": "sltb-final-decision--awaiting-resubmission",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "dataKey": "reviewform",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "replyToken"
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ],
      "order": {
        "$ref": "#/layouts/review"
      }
    }
  },
  "layouts": {
    "review": [
      "previous_review",
      "lab_results",
      "submission_view",
      "review_form",
      "status_message",
      "awaiting_resubmission"
    ]
  }
}
