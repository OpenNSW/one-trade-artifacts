{
  "id": "sltb-submit-blendsheet--user-form",
  "title": "SLTB Blend Sheet Submission",
  "schema": {
    "type": "object",
    "required": [
      "exporter_registration_no",
      "cusdec_number",
      "warehouse_id",
      "blendsheet_data"
    ],
    "properties": {
      "exporter_registration_no": {
        "type": "string",
        "title": "Exporter Registration Number",
        "default": "SLTB/EXP/2026/0498",
        "oneOf": [
          {
            "const": "SLTB/EXP/2026/0498",
            "title": "Ceylon Tea Gardens PLC (SLTB/EXP/2026/0498)"
          },
          {
            "const": "SLTB/EXP/2026/0812",
            "title": "Lanka Blend Masters Ltd (SLTB/EXP/2026/0812)"
          }
        ]
      },
      "cusdec_number": {
        "type": "string",
        "title": "CUSDEC Number",
        "example": "CUSDEC-2026-778120"
      },

      "warehouse_id": {
        "type": "string",
        "title": "Warehouse Name / ID",
        "default": "WH-COLOMBO-TEA-01",
        "oneOf": [
          {
            "const": "WH-COLOMBO-TEA-01",
            "title": "SLTB Colombo Central Warehouse (WH-COLOMBO-TEA-01)"
          },
          {
            "const": "WH-GAMPOLA-TEA-02",
            "title": "SLTB Gampola Tea Logistics Hub (WH-GAMPOLA-TEA-02)"
          }
        ]
      },
      "blendsheet_data": {
        "type": "array",
        "title": "Blend Sheet Data Upload",
        "items": {
          "type": "object",
          "properties": {
            "avg_rate_per_kg": {
              "type": "number",
              "title": "Average Value Per KG",
              "description": "This value need to enter manually",
              "example": 1054.56
            },
            "fob_avg": {
              "type": "number",
              "title": "FOB Average Value",
              "description": "This value need to enter manually",
              "example": 2359
            },
            "quality_to_be_exported": {
              "type": "number",
              "title": "Quality to be Exported (Kg)",
              "description": "This value need to enter manually",
              "example": 16128
            },
            "grade_or_standard": {
              "type": "string",
              "title": "Grade/Standard",
              "description": "This value need to enter manually",
              "example": "BOPF"
            },
            "date_of_blend": {
              "type": "string",
              "format": "date",
              "title": "Date of Blend",
              "description": "This value need to enter manually",
              "example": "2026-07-23"
            },
            "sales": {
              "type": "object",
              "title": "PARTICULAR OF SALE",
              "description": "Please upload the official sale sheet containing the detailed blend analysis (.xlsx, .xls, .csv)",
              "x-spreadsheet": {
                "accept": ".xlsx,.xls,.csv",
                "maxSize": 10485760,
                "persistSheet": true,
                "columnHeader": true
              },
              "x-evaluate": [
                { "id": "total_sales", "label": "Total Sales Quantity (KG)", "expression": "=SUM(I2:I)" },
                { "id": "average_value_per_kg", "label": "Average Value Per KG", "expression": "=AVERAGE(H2:H)" }
              ],
              "properties": {
                "sheet": { "type": "array" },
                "derivations": { "type": "object" }
              }
            },
            "imported_tea": {
              "type": "object",
              "title": "PARTICULAR OF IMPORTED TEA",
              "description": "Please upload the official import sheet containing the detailed import analysis (.xlsx, .xls, .csv)",
              "x-spreadsheet": {
                "accept": ".xlsx,.xls,.csv",
                "maxSize": 10485760,
                "persistSheet": true,
                "columnHeader": true
              },
              "x-evaluate": [
                { "id": "total_import", "label": "Total Import Quantity (KG)", "expression": "=SUM(F2:F)" }
              ],
              "properties": {
                "sheet": { "type": "array" },
                "derivations": { "type": "object" }
              }
            },
            "blend_balances": {
              "type": "object",
              "title": "PARTICULARS OF BLEND BALANCES USED (IF APPLICABLE)",
              "description": "Please upload the official blend balances sheet containing the detailed blend analysis (.xlsx, .xls, .csv)",
              "x-spreadsheet": {
                "accept": ".xlsx,.xls,.csv",
                "maxSize": 10485760,
                "persistSheet": true,
                "columnHeader": true
              },
              "x-evaluate": [
                { "id": "total_blend_balances", "label": "Total Blend Balances (KG)", "expression": "=SUM(C2:C)" },
                { "id": "total_blend_gain", "label": "Total Blend Gain (KG)", "expression": "=SUM(D2:D)" }
              ],
              "properties": {
                "sheet": { "type": "array" },
                "derivations": { "type": "object" }
              }
            },
            "total_blend_balances_and_gain": {
              "type": "number",
              "title": "Total Blend Balances and Gain (KG)",
              "description": "Total Blend Balances and Gain = Total Blend Balances + Total Blend Gain",
              "x-computed": {
                "inputs": {
                  "blend_balances": {
                    "path": "blend_balances.derivations.total_blend_balances.value",
                    "default": 0
                  },
                  "blend_gain": {
                    "path": "blend_balances.derivations.total_blend_gain.value",
                    "default": 0
                  }
                },
                "formula": "blend_balances + blend_gain",
                "decimals": 4
              }
            },
            "total": {
              "type": "number",
              "title": "Total Quantity (KG)",
              "description": "Total Quantity = Total Sales + Total Imported + Total Blend Balances and Gain",
              "x-computed": {
                "inputs": {
                  "sales_quantity": {
                    "path": "sales.derivations.total_sales.value",
                    "default": 0
                  },
                  "imported_quantity": {
                    "path": "imported_tea.derivations.total_import.value",
                    "default": 0
                  },
                  "total_blend_balances_and_gain": {
                    "path": "total_blend_balances_and_gain",
                    "default": 0
                  }
                },
                "formula": "sales_quantity + imported_quantity + total_blend_balances_and_gain",
                "decimals": 4
              }
            },
            "blend_balance": {
              "type": "number",
              "title": "Blend Balance (KG)",
              "description": "Blend Balance = Total Quantity - Quality to be Exported",
              "x-computed": {
                "inputs": {
                  "total_quantity": {
                    "path": "total",
                    "default": 0
                  },
                  "quality_to_be_exported": {
                    "path": "quality_to_be_exported",
                    "default": 0
                  }
                },
                "formula": "total_quantity - quality_to_be_exported",
                "decimals": 4
              }
            }
          },
          "required": [
            "avg_rate_per_kg",
            "fob_avg",
            "quality_to_be_exported",
            "grade_or_standard",
            "date_of_blend",
            "sales",
            "imported_tea",
            "blend_balances",
            "total_blend_balances_and_gain",
            "total",
            "blend_balance"
          ]
        },
        "uniqueItems": true,
        "minItems": 1
      },
      "lion_logo_requested": {
        "type": "string",
        "title": "Apply for Lion Logo Certification",
        "description": "Select 'Yes' if this consignment requires SLTB Lion Logo certification.",
        "oneOf": [
          { "const": "no", "title": "No — Lion Logo not required" },
          { "const": "yes", "title": "Yes — Apply for Lion Logo" }
        ],
        "default": "no"
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Group",
        "label": "1. Exporter & Blend Information",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/exporter_registration_no"
          },
          {
            "type": "Control",
            "scope": "#/properties/cusdec_number"
          },
          {
            "type": "Control",
            "scope": "#/properties/warehouse_id"
          }
        ]
      },
      {
        "type": "Group",
        "label": "2. Blend Sheet Data Upload",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/blendsheet_data",
            "options": {
              "detail": {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/avg_rate_per_kg"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/fob_avg"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/quality_to_be_exported"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/grade_or_standard"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/date_of_blend"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/sales"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/imported_tea"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/blend_balances"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/total_blend_balances_and_gain"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/total"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/blend_balance"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "type": "Group",
        "label": "3. Lion Logo Certification",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/lion_logo_requested"
          }
        ]
      }
    ]
  }
}
