{
  "id": "sltb-final-decision--officer-form",
  "title": "SLTB Final Application Decision",
  "schema": {
    "type": "object",
    "required": [
      "final_decision_outcome"
    ],
    "properties": {
      "sample_number": {
        "type": "string",
        "title": "Sample Number",
        "readOnly": true
      },
      "final_decision_outcome": {
        "type": "string",
        "title": "Final Decision Outcome",
        "oneOf": [
          {
            "const": "approve",
            "title": "Approve the Blend Sheet Application"
          }
        ]
      },
      "remarks": {
        "type": "string",
        "title": "Decision Remarks / Comments",
        "description": "Provide detail about the approval.",
        "example": "All quality checks passed. Blend sheet approved."
      },
      "asycuda_approval_confirmed": {
        "type": "boolean",
        "title": "I have logged into the ASYCUDA System and pressed the green check (✓) button to approve this consignment",
        "description": "Login to ASYCUDA and press the green check button for this consignment before approving here.",
        "default": false,
        "example": true
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "final_decision_outcome": {
              "const": "approve"
            }
          },
          "required": [
            "final_decision_outcome"
          ]
        },
        "then": {
          "required": [
            "asycuda_approval_confirmed"
          ],
          "properties": {
            "asycuda_approval_confirmed": {
              "const": true
            }
          }
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/sample_number",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/sample_number",
            "schema": { "type": "string", "minLength": 1 }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/final_decision_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/remarks",
        "options": {
          "multiLine": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/asycuda_approval_confirmed"
      }
    ]
  }
}
