{
  "id": "sltb-payment--confirm-form",
  "title": "Finpak Account Lab Test Fee Deduction Confirmation",
  "schema": {
    "type": "object",
    "required": [
      "deduction_status"
    ],
    "properties": {
      "deduction_status": {
        "type": "string",
        "title": "Finpak Deduction Status",
        "oneOf": [
          {
            "const": "deducted",
            "title": "Confirm Lab Test Fee Deducted from Finpak Account"
          },
          {
            "const": "insufficient_funds",
            "title": "Not Deducted — Insufficient Funds in the Finpak Account"
          }
        ],
        "default": "deducted"
      },
      "remarks": {
        "type": "string",
        "title": "Officer Remarks (Required if Funds are Insufficient)",
        "example": "Lab test fee deducted from the Finpak account."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "deduction_status": {
              "const": "insufficient_funds"
            }
          },
          "required": [
            "deduction_status"
          ]
        },
        "then": {
          "properties": {
            "remarks": {
              "minLength": 1
            }
          },
          "required": [
            "remarks"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/deduction_status"
      },
      {
        "type": "Control",
        "scope": "#/properties/remarks",
        "options": {
          "multiLine": true
        }
      }
    ]
  }
}
