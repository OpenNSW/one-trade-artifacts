{
  "id": "sltb-payment-confirm--review-workflow",
  "name": "SLTB Finpak Lab Test Fee Deduction Confirmation — Officer Review",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "userform",
      "type": "TASK",
      "task_template_id": "sltb-payment-confirm--officer-review",
      "input_mapping": {
        "submission?": "submission",
        "reviewform.remarks?": "previous_remarks"
      },
      "output_mapping": {
        "deduction_status": "reviewform.deduction_status",
        "remarks?": "reviewform.remarks"
      }
    },
    {
      "id": "decision_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "request_info",
      "type": "TASK",
      "task_template_id": "sltb-payment-confirm--request-info",
      "input_mapping": {
        "callbackToken": "replyToken",
        "reviewform.deduction_status": "payload.payment_status",
        "reviewform.remarks?": "payload.remarks",
        "submission?": "submission",
        "reviewform": "reviewform"
      },
      "output_mapping": {
        "submission": "submission",
        "callbackToken": "callbackToken"
      }
    },
    {
      "id": "api_call",
      "type": "TASK",
      "task_template_id": "sltb-payment-confirm--notify-decision",
      "input_mapping": {
        "callbackToken": "callbackToken",
        "reviewform?": "reviewform",
        "submission?": "submission",
        "taskId": "taskId",
        "reviewform.deduction_status": "payload.command",
        "reviewform": "payload.payload"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "userform"
    },
    {
      "id": "e2",
      "source_id": "userform",
      "target_id": "decision_gateway"
    },
    {
      "id": "e_insufficient_funds",
      "source_id": "decision_gateway",
      "target_id": "request_info",
      "condition": "reviewform.deduction_status == 'insufficient_funds'"
    },
    {
      "id": "e_topped_up",
      "source_id": "request_info",
      "target_id": "userform"
    },
    {
      "id": "e_deducted",
      "source_id": "decision_gateway",
      "target_id": "api_call",
      "condition": "reviewform.deduction_status == 'deducted'"
    },
    {
      "id": "e3",
      "source_id": "api_call",
      "target_id": "end"
    }
  ]
}
