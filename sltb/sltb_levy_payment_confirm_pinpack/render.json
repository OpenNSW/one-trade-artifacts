{
  "id": "sltb-levy-payment-confirm-pinpack--review:render",
  "type": "APPLICATION",
  "title": "SLTB Finpak Levy Deduction Confirmation",
  "sections": {
    "previous_review": {
      "templateId": "sltb-levy-payment-confirm-pinpack--previous-review",
      "title": "Previous Review",
      "projector": "MARKDOWN",
      "dataKey": "previous_remarks",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "previous_remarks"
      }
    },
    "submitted_info": {
      "templateId": "sltb-levy-payment-confirm-pinpack--submitted-info",
      "title": "Submitted Information",
      "projector": "MARKDOWN",
      "dataKey": "submission"
    },
    "review_form": {
      "templateId": "sltb-pay-levy--confirm-pinpack-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "handles": [
        {
          "command": "submit",
          "label": "Submit Review",
          "element": "primary_action"
        }
      ]
    },
    "status_message": {
      "templateId": "sltb-levy-payment-confirm-pinpack--submission-view",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "callbackToken"
      }
    },
    "awaiting_resubmission": {
      "templateId": "sltb-levy-payment-confirm-pinpack--awaiting-resubmission",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "dataKey": "reviewform",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "replyToken"
      }
    }
  },
  "layouts": {
    "review": [
      "previous_review",
      "submitted_info",
      "review_form",
      "status_message",
      "awaiting_resubmission"
    ]
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ],
      "order": {
        "$ref": "#/layouts/review"
      }
    }
  }
}
