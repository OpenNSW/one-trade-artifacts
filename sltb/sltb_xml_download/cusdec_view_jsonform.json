                }
              }
            }
          }
        }
      },
      "supportingDocuments": {
        "type": "object",
        "title": "Supporting Documents",
        "properties": {
          "scannedDocuments": {
            "type": "array",
            "title": "Scanned Documents",
            "description": "Scanned PDFs for the SCAN DOC tab in the CusDec. Up to 300 KB each.",
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "fileBase64": {
                  "type": "string",
                  "format": "file",
                  "title": "File",
                  "x-file": {
                    "accept": ".pdf",
                    "maxSize": 307200
                  },
                  "example": "storage/customs/invoice-1092.pdf"
                },
                "documentCode": {
                  "type": "string",
                  "title": "Document Code",
                  "example": "INV"
                }
              }
            }
          },
          "metaDocuments": {
            "type": "array",
            "title": "Meta Documents",
            "description": "Documents referenced by code and reference number (no scan).",
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "itemSequence": {
                  "type": "string",
                  "title": "Item Number",
                  "description": "Item number in the declaration that this document applies to, e.g. 8 for the 8th item.",
                  "pattern": "^[1-9][0-9]*$",
                  "example": "8"
                },
                "documentCode": {
                  "type": "string",
                  "title": "Document Code",
                  "example": "INV"
                },
                "documentId": {
                  "type": "string",
                  "title": "Document Reference Number",
                  "description": "Reference of a document already held elsewhere.",
                  "example": "INV-1092"
                },
                "dateAsString": {
                  "type": "string",
                  "format": "date",
                  "title": "Document Date",
                  "description": "Date of the referenced document.",
                  "example": "2026-09-15"
                }
              }
            }
          }
        }
      }
    }
  },
