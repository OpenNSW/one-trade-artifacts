        {
          "command": "submit",
          "label": "Acknowledge",
          "element": "primary_action"
        }
      ]
    },
    "blend_sheet_view": {
      "templateId": "sltb-submit-blendsheet--officer-view-form",
      "title": "Submitted Blend Sheet",
      "projector": "FORM",
      "dataKey": "submission"
    },
    "cusdec_view": {
      "templateId": "sltb-xml-download--cusdec-view-form",
      "title": "CusDec",
      "projector": "FORM",
      "dataKey": "cusdec",
      "requireDataKey": "cusdec"
    },
    "status_message": {
      "templateId": "sltb-xml-download--submission-view",
      "title": "Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    }
  },
  "states": {
