{
  "id": "sltb-record-sample-draw--officer-form",
  "title": "Record Warehouse Sample Draw",
  "schema": {
    "type": "object",
    "required": [
      "sample_number",
      "draw_date"
    ],
    "properties": {
      "sample_number": {
        "type": "string",
        "title": "Assigned Sample Number",
        "description": "Assigned when the task opens.",
        "readOnly": true,
        "example": "2026/09/0001"
      },
      "draw_date": {
        "type": "string",
        "format": "date",
        "title": "Date of Sample Draw",
        "example": "2026-07-02"
      },
      "inspector_name": {
        "type": "string",
        "title": "Tea Inspector (Optional)",
        "example": "K. Perera"
      },
      "draw_notes": {
        "type": "string",
        "title": "Draw Notes / Comments (Optional)",
        "example": "Sample drawn from warehouse lot B-12, batch #4."
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/sample_number"
      },
      {
        "type": "Control",
        "scope": "#/properties/draw_date"
      },
      {
        "type": "Control",
        "scope": "#/properties/inspector_name"
      },
      {
        "type": "Control",
        "scope": "#/properties/draw_notes",
        "options": {
          "multiLine": true
        }
      }
    ]
  }
}
