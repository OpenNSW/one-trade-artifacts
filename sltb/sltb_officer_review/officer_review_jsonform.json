{
  "id": "sltb-submit-blendsheet--officer-review-form",
  "title": "SLTB Officer Blend Sheet Review",
  "schema": {
    "type": "object",
    "required": [
      "review_outcome"
    ],
    "properties": {
      "review_outcome": {
        "type": "string",
        "title": "Review Outcome",
        "oneOf": [
          {
            "const": "approve",
            "title": "Approve Blend Sheet & Assess Levy"
          },
          {
            "const": "needs_more_info",
            "title": "Request Resubmission (Needs More Info)"
          },
          {
            "const": "reject",
            "title": "Reject Application (Blend Sheet Not Reconcilable)"
          }
        ]
      },
      "feedback": {
        "type": "string",
        "title": "Officer Feedback & Deficiencies",
        "description": "Provide detail if resubmission is required.",
        "example": "Blendsheet figures don't reconcile with CUSDEC quantities. Please re-upload with corrected totals."
      },
      "blendsheet_data": {
        "type": "array",
        "title": "Blend Sheet Levy",
        "items": {
          "type": "object",
          "properties": {
            "blend_no": {
              "type": "string",
              "title": "Blend No.",
              "readOnly": true
            },
            "quantity_to_be_exported": {
              "type": "number",
              "title": "Quantity to be Exported (KGs)",
              "readOnly": true
            },
            "levy_multiplier": {
              "type": "number",
              "title": "Levy Multiplier",
              "exclusiveMinimum": 0,
              "default": 3
            },
            "assessed_levy": {
              "type": "number",
              "title": "Assessed Levy (LKR)",
              "description": "Assessed Levy = Quantity to be Exported × Levy Multiplier",
              "readOnly": true,
              "x-computed": {
                "inputs": {
                  "quantity_to_be_exported": "quantity_to_be_exported",
                  "levy_multiplier": "levy_multiplier"
                },
                "formula": "quantity_to_be_exported * levy_multiplier",
                "decimals": 2
              }
            }
          }
        }
      },
      "levy_amount": {
        "type": "number",
        "title": "Assessed SLTB Levy (LKR)",
        "exclusiveMinimum": 0,
        "description": "Sum of each blend sheet's Assessed Levy.",
        "readOnly": true,
        "x-computed": {
          "inputs": {
            "total_levy": {
              "path": "blendsheet_data.*.assessed_levy",
              "aggregate": "sum"
            }
          },
          "formula": "total_levy",
          "decimals": 2
        }
      },
      "collection_method": {
        "type": "string",
        "title": "Sample Collection Method",
        "oneOf": [
          {
            "const": "none",
            "title": "No Sample Required"
          },
          {
            "const": "pickup",
            "title": "Warehouse Pickup (Tea Inspector visits warehouse)"
          },
          {
            "const": "dropoff",
            "title": "Trader Drop-off (Trader delivers sample to SLTB Export Division)"
          }
        ],
        "default": "pickup"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "review_outcome": {
              "const": "approve"
            }
          },
          "required": [
            "review_outcome"
          ]
        },
        "then": {
          "required": [
            "levy_amount"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "review_outcome": {
              "const": "reject"
            }
          },
          "required": [
            "review_outcome"
          ]
        },
        "then": {
          "required": [
            "feedback"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/review_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/feedback",
        "options": {
          "multiLine": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/collection_method",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/blendsheet_data",
        "options": {
          "addable": false,
          "removable": false,
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  { "type": "Control", "scope": "#/properties/blend_no" },
                  { "type": "Control", "scope": "#/properties/quantity_to_be_exported" }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  { "type": "Control", "scope": "#/properties/levy_multiplier" },
                  { "type": "Control", "scope": "#/properties/assessed_levy" }
                ]
              }
            ]
          }
        },
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/levy_amount",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      }
    ]
  }
}
