{
  "id": "sltb-submit-blendsheet--officer-review-form",
  "title": "SLTB Officer Blend Sheet Review",
  "schema": {
    "type": "object",
    "required": [
      "review_outcome"
    ],
    "properties": {
      "review_outcome": {
        "type": "string",
        "title": "Review Outcome",
        "oneOf": [
          {
            "const": "approve",
            "title": "Approve Blend Sheet & Assess Levy"
          },
          {
            "const": "needs_more_info",
            "title": "Request Modifications (Blend Sheet or CusDec)"
          },
          {
            "const": "reject",
            "title": "Reject Application"
          }
        ]
      },
      "feedback": {
        "type": "string",
        "title": "Officer Feedback & Deficiencies",
        "description": "Required when requesting modifications or rejecting the application.",
        "example": "Blendsheet figures don't reconcile with CUSDEC quantities. Please re-upload with corrected totals."
      },
      "blendsheet_data": {
        "type": "array",
        "title": "Blend Sheet Levy",
        "items": {
          "type": "object",
          "properties": {
            "blend_no": {
              "type": "string",
              "title": "Blend No.",
              "readOnly": true
            },
            "quantity_to_be_exported": {
              "type": "number",
              "title": "Quantity to be Exported (KGs)",
              "exclusiveMinimum": 0,
              "readOnly": true
            },
            "overwrite_levy_multiplier": {
              "type": "boolean",
              "title": "Overwrite Levy Multiplier"
            },
            "levy_multiplier": {
              "type": "number",
              "title": "Levy Multiplier",
              "exclusiveMinimum": 0
            },
            "assessed_levy": {
              "type": "number",
              "title": "Assessed Levy (LKR)",
              "description": "Assessed Levy = Quantity to be Exported × 3, or × the Levy Multiplier when it is overwritten",
              "x-computed": {
                "inputs": {
                  "quantity_to_be_exported": "quantity_to_be_exported",
                  "overwrite_levy_multiplier": {
                    "path": "overwrite_levy_multiplier",
                    "default": false
                  },
                  "levy_multiplier": {
                    "path": "levy_multiplier",
                    "default": 3
                  }
                },
                "formula": "ROUND(IF(overwrite_levy_multiplier, quantity_to_be_exported * levy_multiplier, quantity_to_be_exported * 3), 2)",
                "decimals": 2
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "overwrite_levy_multiplier": {
                    "const": true
                  }
                },
                "required": [
                  "overwrite_levy_multiplier"
                ]
              },
              "then": {
                "required": [
                  "levy_multiplier"
                ]
              }
            }
          ]
        }
      },
      "levy_amount": {
        "type": "number",
        "title": "Assessed SLTB Levy (LKR)",
        "exclusiveMinimum": 0,
        "description": "Sum of each blend sheet's Assessed Levy.",
        "x-computed": {
          "inputs": {
            "total_levy": {
              "path": "blendsheet_data.*.assessed_levy",
              "aggregate": "sum"
            }
          },
          "formula": "ROUND(total_levy, 2)",
          "decimals": 2
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "review_outcome": {
              "const": "approve"
            }
          },
          "required": [
            "review_outcome"
          ]
        },
        "then": {
          "required": [
            "levy_amount"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "review_outcome": {
              "enum": ["needs_more_info", "reject"]
            }
          },
          "required": [
            "review_outcome"
          ]
        },
        "then": {
          "required": [
            "feedback"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/review_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/feedback",
        "options": {
          "multiLine": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/blendsheet_data",
        "options": {
          "addable": false,
          "removable": false,
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  { "type": "Control", "scope": "#/properties/blend_no" },
                  { "type": "Control", "scope": "#/properties/quantity_to_be_exported" }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "VerticalLayout",
                    "elements": [
                      { "type": "Control", "scope": "#/properties/overwrite_levy_multiplier" },
                      {
                        "type": "Control",
                        "scope": "#/properties/levy_multiplier",
                        "rule": {
                          "effect": "SHOW",
                          "condition": {
                            "scope": "#/properties/overwrite_levy_multiplier",
                            "schema": {
                              "const": true
                            }
                          }
                        }
                      }
                    ]
                  },
                  { "type": "Control", "scope": "#/properties/assessed_levy" }
                ]
              }
            ]
          }
        },
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/levy_amount",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      }
    ]
  }
}
