{
  "id": "npqs-visual-sample-collection--officer-receive-form",
  "title": "Verify & Register Received Sample (Visual Inspection)",
  "schema": {
    "type": "object",
    "properties": {
      "sample_number": {
        "type": "string",
        "title": "Assigned Sample Number",
        "readOnly": true,
        "example": "TNSW/NPQS/SEA-CMB/PC/2026/000001"
      },
      "receive_comments": {
        "type": "string",
        "title": "Observations on Receipt",
        "example": "Sample bag intact, sealed correctly."
      }
    },
    "required": [
      "sample_number"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/sample_number",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/receive_comments"
      }
    ]
  }
}
