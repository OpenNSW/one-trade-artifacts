{
  "id": "npqs-application-review--review-workflow",
  "name": "NPQS Application Review — Officer Review",
  "version": 3,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "generate_reference_number",
      "type": "TASK",
      "task_template_id": "npqs-application-review--generate-reference-number",
      "input_mapping": {
        "submission.reference_number?": "reference_number",
        "submission.nppo_office_location": "officeLocation"
      },
      "output_mapping": {
        "refid.reference_number": "reviewform.reference_number"
      }
    },
    {
      "id": "userform",
      "type": "TASK",
      "task_template_id": "npqs-application-review--officer-review",
      "input_mapping": {
        "submission?": "submission",
        "submission.commodities?": "reviewform.commodities",
        "reviewform.reference_number": "reviewform.reference_number",
        "reviewform.clarification_reason?": "previous_clarification_reason"
      },
      "output_mapping": {
        "review_outcome": "reviewform.review_outcome",
        "commodities": "reviewform.commodities",
        "ephyto_required?": "reviewform.ephyto_required",
        "clarification_reason?": "reviewform.clarification_reason"
      }
    },
    {
      "id": "decision_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "request_info",
      "type": "TASK",
      "task_template_id": "npqs-application-review--request-info",
      "input_mapping": {
        "callbackToken": "replyToken",
        "reviewform.review_outcome": "review_outcome",
        "reviewform.reference_number": "reference_number",
        "reviewform.commodities": "commodities",
        "reviewform.ephyto_required?": "ephyto_required",
        "reviewform.clarification_reason?": "clarification_reason"
      },
      "output_mapping": {
        "submission": "submission",
        "callbackToken": "callbackToken"
      }
    },
    {
      "id": "api_call",
      "type": "TASK",
      "task_template_id": "npqs-application-review--notify-decision",
      "input_mapping": {
        "callbackToken": "callbackToken",
        "reviewform?": "reviewform",
        "submission?": "submission",
        "taskId": "taskId",
        "reviewform.review_outcome": "payload.command",
        "reviewform": "payload.payload"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "generate_reference_number"
    },
    {
      "id": "e_generated",
      "source_id": "generate_reference_number",
      "target_id": "userform"
    },
    {
      "id": "e2",
      "source_id": "userform",
      "target_id": "decision_gateway"
    },
    {
      "id": "e_needs_info",
      "source_id": "decision_gateway",
      "target_id": "request_info",
      "condition": "reviewform.review_outcome == 'needs_more_info'"
    },
    {
      "id": "e_resubmitted",
      "source_id": "request_info",
      "target_id": "userform"
    },
    {
      "id": "e_approve",
      "source_id": "decision_gateway",
      "target_id": "api_call",
      "condition": "reviewform.review_outcome == 'approve'"
    },
    {
      "id": "e3",
      "source_id": "api_call",
      "target_id": "end"
    }
  ]
}
