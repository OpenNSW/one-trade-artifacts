{
  "id": "npqs-issue-certificate--officer-form",
  "title": "Issue Phytosanitary Certificate",
  "schema": {
    "type": "object",
    "properties": {
      "certificate_items": {
        "type": "array",
        "title": "Items To Include On This Certificate",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "displayTemplate": "{name}",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "include_in_certificate": {
              "type": "boolean",
              "title": "Include on Certificate"
            },
            "sample_test_result": {
              "type": "string",
              "title": "Lab Test Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail_resubmit",
                  "title": "Fail (resubmission allowed)"
                },
                {
                  "const": "fail_final",
                  "title": "Fail"
                },
                {
                  "const": "skipped",
                  "title": "Skipped"
                }
              ],
              "default": "skipped"
            },
            "visual_result": {
              "type": "string",
              "title": "Visual Inspection 1 Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                },
                {
                  "const": "skipped",
                  "title": "Skipped"
                }
              ],
              "default": "skipped"
            },
            "treatment_result": {
              "type": "string",
              "title": "Treatment Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                },
                {
                  "const": "skipped",
                  "title": "Skipped"
                }
              ],
              "default": "skipped"
            },
            "visual2_result": {
              "type": "string",
              "title": "Visual Inspection 2 Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                },
                {
                  "const": "skipped",
                  "title": "Skipped"
                }
              ],
              "default": "skipped"
            },
            "commodity_botanical_name": {
              "type": "string",
              "title": "Botanical Name",
              "readOnly": true
            }
          },
          "required": [
            "id"
          ],
          "if": {
            "anyOf": [
              {
                "properties": {
                  "sample_test_result": {
                    "enum": [
                      "fail_final",
                      "fail_resubmit"
                    ]
                  }
                },
                "required": [
                  "sample_test_result"
                ]
              },
              {
                "properties": {
                  "visual_result": {
                    "enum": [
                      "fail"
                    ]
                  }
                },
                "required": [
                  "visual_result"
                ]
              },
              {
                "properties": {
                  "treatment_result": {
                    "enum": [
                      "fail"
                    ]
                  }
                },
                "required": [
                  "treatment_result"
                ]
              },
              {
                "properties": {
                  "visual2_result": {
                    "enum": [
                      "fail"
                    ]
                  }
                },
                "required": [
                  "visual2_result"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "include_in_certificate": {
                "default": false
              }
            }
          },
          "else": {
            "properties": {
              "include_in_certificate": {
                "default": true
              }
            }
          }
        }
      },
      "certificate_id": {
        "type": "string",
        "title": "Phytosanitary Certificate Number",
        "example": "PC-NPQS-2026-8092"
      },
      "certificate_url": {
        "type": "string",
        "format": "file",
        "title": "Scanned Phytosanitary Certificate (PDF)",
        "example": "https://nsw.gov.lk/storage/certs/phytosanitary-certificate-1029.pdf"
      },
      "comments": {
        "type": "string",
        "title": "Officer Remarks",
        "example": "Issued phytosanitary certificate after validating treatment and visual inspection records."
      },
      "send_application_documents": {
        "type": "boolean",
        "title": "Documents attached to the application",
        "description": "The files the trader attached when applying: permits, invoices, certificates. Sent with the certificate and listed on it as accompanying the consignment.",
        "default": true
      },
      "send_treatment_certificate": {
        "type": "boolean",
        "title": "Treatment certificate",
        "description": "Uploaded at the treatment step. Sent with the certificate and listed on it as accompanying the consignment.",
        "default": true
      },
      "send_supervision_report": {
        "type": "boolean",
        "title": "Treatment supervision report",
        "description": "Uploaded at the treatment step, where supervision was requested. Sent with the certificate and listed on it as accompanying the consignment.",
        "default": true
      },
      "send_invoice": {
        "type": "boolean",
        "title": "Commercial invoice",
        "description": "Uploaded at the supporting documents step. Sent with the certificate and listed on it as accompanying the consignment.",
        "default": true
      },
      "send_packing_list": {
        "type": "boolean",
        "title": "Packing list",
        "description": "Uploaded at the supporting documents step. Sent with the certificate and listed on it as accompanying the consignment.",
        "default": true
      },
      "send_additional_document": {
        "type": "boolean",
        "title": "Additional supporting document",
        "description": "Uploaded at the supporting documents step. Sent with the certificate and listed on it as accompanying the consignment.",
        "default": true
      }
    },
    "required": [
      "certificate_items",
      "certificate_id",
      "certificate_url"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/certificate_items",
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/commodity_common_name/properties/label",
                    "options": {
                      "readOnly": true
                    },
                    "label": "Commodity Name"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/commodity_botanical_name",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/sample_test_result",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/visual_result",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/treatment_result",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/visual2_result",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/include_in_certificate"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/certificate_id"
      },
      {
        "type": "Control",
        "scope": "#/properties/certificate_url"
      },
      {
        "type": "Group",
        "label": "Documents to Send to the IPPC ePhyto Hub",
        "elements": [
          {
            "type": "Label",
            "text": "Used only when the consignment needs an ePhyto upload. A document the trader did not upload is skipped."
          },
          {
            "type": "Control",
            "scope": "#/properties/send_application_documents"
          },
          {
            "type": "Control",
            "scope": "#/properties/send_treatment_certificate"
          },
          {
            "type": "Control",
            "scope": "#/properties/send_supervision_report"
          },
          {
            "type": "Control",
            "scope": "#/properties/send_invoice"
          },
          {
            "type": "Control",
            "scope": "#/properties/send_packing_list"
          },
          {
            "type": "Control",
            "scope": "#/properties/send_additional_document"
          }
        ]
      },
      {
        "type": "Control",
        "scope": "#/properties/comments"
      }
    ]
  }
}
