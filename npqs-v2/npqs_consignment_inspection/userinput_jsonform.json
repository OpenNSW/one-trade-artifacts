{
  "id": "npqs-visual-consignment--trader-schedule-form",
  "title": "Trader Submitted Inspection Schedule",
  "schema": {
    "type": "object",
    "properties": {
      "inspection_date": {
        "type": "string",
        "format": "date",
        "title": "Preferred Date of Inspection",
        "readOnly": true
      },
      "inspection_time": {
        "type": "string",
        "title": "Preferred Time Slot",
        "readOnly": true
      },
      "contact_name": {
        "type": "string",
        "title": "On-Site Contact Person Name",
        "readOnly": true
      },
      "contact_phone": {
        "type": "string",
        "title": "On-Site Contact Mobile Number",
        "readOnly": true
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/inspection_date",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/inspection_time",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/contact_name",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/contact_phone",
        "options": {
          "readonly": true
        }
      }
    ]
  }
}
