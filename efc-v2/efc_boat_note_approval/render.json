{
  "id": "efc-boat-note-approval--review:render",
  "type": "APPLICATION",
  "title": "EFC Boat Note Approval",
  "read": {
    "roles": [
      "officer"
    ]
  },
  "sections": {
    "previous_review": {
      "templateId": "efc-boat-note-approval--previous-review",
      "title": "Previous Review",
      "projector": "MARKDOWN",
      "dataKey": "previous_remarks",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "previous_remarks"
      }
    },
    "boat_note_document": {
      "templateId": "efc-boat-note-approval--boat-note-document",
      "title": "Boat Note Document",
      "projector": "MARKDOWN",
      "dataKey": "submission"
    },
    "submission_view": {
      "templateId": "efc-boat-note--user-form",
      "title": "Submitted Boat Note",
      "projector": "FORM",
      "dataKey": "submission"
    },
    "review_form": {
      "templateId": "efc-boat-note-approval--officer-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "handles": [
        {
          "command": "submit",
          "label": "Submit Review",
          "element": "primary_action"
        }
      ]
    },
    "status_message": {
      "templateId": "efc-boat-note-approval--submission-view",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "callbackToken"
      }
    },
    "awaiting_resubmission": {
      "templateId": "efc-boat-note-approval--awaiting-resubmission",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "dataKey": "reviewform",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "replyToken"
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
