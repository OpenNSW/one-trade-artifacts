{
  "id": "cda-lot-adjustment-trader--user-form",
  "title": "CDA Export Certificate Lot Adjustment",
  "schema": {
    "type": "object",
    "properties": {
      "adjustment_choice": {
        "type": "string",
        "title": "Select Action",
        "oneOf": [
          {
            "const": "complete_application",
            "title": "Complete Application & Finish"
          },
          {
            "const": "request_lot_adjustment",
            "title": "Request Lot Adjustment (Remove specific lots)"
          }
        ],
        "default": "complete_application"
      },
      "revised_dc_bags_details": {
        "type": "string",
        "format": "file",
        "title": "Upload Revised DC Bags Details File (Excel)",
        "description": "Upload the completed Excel sheet (.xlsx or .xls) with the amended DC bag details for this consignment.",
        "x-file": {
          "accept": ".xlsx,.xls"
        }
      }
    },
    "required": [
      "adjustment_choice"
    ],
    "if": {
      "properties": {
        "adjustment_choice": { "const": "request_lot_adjustment" }
      },
      "required": [
        "adjustment_choice"
      ]
    },
    "then": {
      "required": [
        "revised_dc_bags_details"
      ]
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/adjustment_choice"
      },
      {
        "type": "Control",
        "scope": "#/properties/revised_dc_bags_details",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/adjustment_choice",
            "schema": {
              "const": "request_lot_adjustment"
            }
          }
        }
      }
    ]
  }
}
