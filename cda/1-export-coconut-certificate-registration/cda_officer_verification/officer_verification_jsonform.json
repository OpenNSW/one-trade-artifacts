{
  "id": "cda-apply-coconut-cert--officer-verification-form",
  "title": "CDA Officer Application Verification",
  "schema": {
    "type": "object",
    "properties": {
      "verification_outcome": {
        "type": "string",
        "title": "Verification Outcome",
        "oneOf": [
          {
            "const": "approve",
            "title": "Approve Verification"
          },
          {
            "const": "needs_more_info",
            "title": "Needs More Information (Send back to applicant)"
          }
        ],
        "default": "approve",
        "example": "approve"
      },
      "rejection_reason": {
        "type": "string",
        "title": "Comments / Feedback / Deficiencies (Required if Needs More Info)",
        "example": "Please upload the correct certificate template."
      },
      "product_type": {
        "type": "string",
        "title": "Product Type",
        "oneOf": [
          {
            "const": "dc",
            "title": "DC"
          },
          {
            "const": "value_added_dc",
            "title": "Value Added DC / Low Fat DC"
          },
          {
            "const": "both",
            "title": "DC and Value Added DC / Low Fat DC"
          }
        ]
      }
    },
    "required": [
      "verification_outcome"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "verification_outcome": {
              "const": "needs_more_info"
            }
          },
          "required": [
            "verification_outcome"
          ]
        },
        "then": {
          "required": [
            "rejection_reason"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "verification_outcome": {
              "const": "approve"
            }
          },
          "required": [
            "verification_outcome"
          ]
        },
        "then": {
          "required": [
            "product_type"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/verification_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/rejection_reason",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/verification_outcome",
            "schema": {
              "const": "needs_more_info"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/product_type",
        "options": {
          "format": "radio",
          "required": true
        },
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/verification_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      }
    ]
  }
}
