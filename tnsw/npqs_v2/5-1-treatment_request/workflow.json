{
  "id": "npqs-v2-treatment-request",
  "name": "Submit & Approve Treatment Request",
  "version": 1,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "trader_request",
      "type": "TASK",
      "task_template_id": "npqs-v2-treatment-request--trader-request",
      "input_mapping": {
        "traderinput.treatment_items": "traderinput.treatment_items"
      },
      "output_mapping": {
        "treatment_items": "traderinput.treatment_items",
        "general_remarks?": "traderinput.general_remarks"
      }
    },
    {
      "id": "officer_review",
      "type": "TASK",
      "task_template_id": "npqs-v2-treatment-request--officer-review",
      "input_mapping": {
        "reference_number": "submission.reference_number",
        "traderinput": "submission",
        "userform?": "submission.userform"
      },
      "output_mapping": {
        "treatment_request_outcome": "reviewerform.treatment_request_outcome",
        "clarification_comments?": "reviewerform.clarification_comments"
      }
    },
    {
      "id": "review_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "trader_request"
    },
    {
      "id": "e2",
      "source_id": "trader_request",
      "target_id": "officer_review"
    },
    {
      "id": "e3",
      "source_id": "officer_review",
      "target_id": "review_gateway"
    },
    {
      "id": "e_approve",
      "source_id": "review_gateway",
      "target_id": "end",
      "condition": "reviewerform.treatment_request_outcome == \"approve\""
    },
    {
      "id": "e_needs_info",
      "source_id": "review_gateway",
      "target_id": "trader_request",
      "condition": "reviewerform.treatment_request_outcome == \"needs_more_info\""
    }
  ]
}
