  "edges": [
    {
      "id": "e_start",
      "source_id": "start",
      "target_id": "n1_apply"
    },
    {
      "id": "e_apply_to_par_split",
      "source_id": "n1_apply",
      "target_id": "gw_par_split"
    },
    {
      "id": "e_par_to_lab_track",
      "source_id": "gw_par_split",
      "target_id": "gw_lab_split"
    },
    {
      "id": "e_par_to_visual_track",
      "source_id": "gw_par_split",
      "target_id": "gw_visual_split"
    },
    {
      "id": "e_par_to_treatment_track",
      "source_id": "gw_par_split",
      "target_id": "gw_treatment_split"
    },
    {
      "id": "e_lab_split_to_draw",
      "source_id": "gw_lab_split",
      "target_id": "n4_0_draw_sample",
      "condition": "item.lab_required == true"
    },
    {
      "id": "e_lab_split_to_join_bypass",
      "source_id": "gw_lab_split",
      "target_id": "gw_lab_join",
      "condition": "item.lab_required != true"
    },
    {
      "id": "e_draw_to_lab_check",
      "source_id": "n4_0_draw_sample",
      "target_id": "n2_1_lab_testing"
    },
    {
      "id": "e_lab_testing_to_split",
      "source_id": "n2_1_lab_testing",
      "target_id": "lab_result_split"
    },
    {
      "id": "e_lab_fail_resubmit",
      "source_id": "lab_result_split",
      "target_id": "n4_0b_lab_resubmit_draw",
      "condition": "item.sample_test_result == 'fail_resubmit'"
    },
    {
      "id": "e_lab_resubmit_draw_to_retest",
      "source_id": "n4_0b_lab_resubmit_draw",
      "target_id": "n2_1b_lab_resubmit_test"
    },
    {
      "id": "e_lab_resubmit_retest_to_split",
      "source_id": "n2_1b_lab_resubmit_test",
      "target_id": "lab_result_split"
    },
    {
      "id": "e_lab_fail_final",
      "source_id": "lab_result_split",
      "target_id": "lab_result_join",
      "condition": "item.sample_test_result == 'fail_final'"
    },
    {
      "id": "e_lab_pass",
      "source_id": "lab_result_split",
      "target_id": "lab_result_join",
      "condition": "item.sample_test_result == 'pass'"
    },
    {
      "id": "e_lab_result_join_to_lab_join",
      "source_id": "lab_result_join",
      "target_id": "gw_lab_join"
    },
    {
      "id": "e_lab_join_to_par_join",
      "source_id": "gw_lab_join",
      "target_id": "gw_par_join"
    },
    {
      "id": "e_vis_split_to_consign",
      "source_id": "gw_visual_split",
      "target_id": "n_visual_consignment_flow",
      "condition": "item.visual_required == true && item.visual_approach == 'consignment'"
    },
    {
      "id": "e_vis_split_to_sample",
      "source_id": "gw_visual_split",
      "target_id": "n_visual_sample_collect",
      "condition": "item.visual_required == true && item.visual_approach == 'sample'"
    },
    {
      "id": "e_vis_collect_to_sample",
      "source_id": "n_visual_sample_collect",
      "target_id": "n_visual_sample_inspection"
    },
    {
      "id": "e_vis_split_to_system",
      "source_id": "gw_visual_split",
      "target_id": "n5_0_visual_inspection",
      "condition": "item.visual_required == true && item.visual_approach == 'system'"
