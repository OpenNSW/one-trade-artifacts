{
  "id": "npqs-v2-lab-testing--officer-form",
  "title": "Laboratory Test Results",
  "schema": {
    "type": "object",
    "properties": {
      "sample_test_result": {
        "type": "string",
        "title": "Overall Batch Result (worst outcome across the items below)",
        "oneOf": [
          {
            "const": "pass",
            "title": "Pass — All Items Clear"
          },
          {
            "const": "fail_resubmit",
            "title": "Fail — One or More Items Allowed Resubmission"
          },
          {
            "const": "fail_final",
            "title": "Fail Final — One or More Items Rejected"
          }
        ],
        "default": "pass"
      },
      "lab_report_attachment_url": {
        "type": "string",
        "format": "file",
        "title": "Uploaded Lab Test Report (PDF)",
        "example": "https://nsw.gov.lk/storage/reports/lab-report-2026.pdf"
      },
      "lab_comments": {
        "type": "string",
        "title": "Overall Laboratory Analysis Details",
        "example": "Entomology and pathology tests completed for sample batch."
      },
      "items": {
        "type": "array",
        "title": "Commodity Test Results (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "string",
              "title": "Common Name"
            },
            "commodity_botanical_name": {
              "type": "string",
              "title": "Botanical Name"
            },
            "sample_test_result": {
              "type": "string",
              "title": "Test Outcome",
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass (No Quarantine Pests Found)"
                },
                {
                  "const": "fail_resubmit",
                  "title": "Fail — Allow Resubmission"
                },
                {
                  "const": "fail_final",
                  "title": "Fail Final — Reject Item"
                }
              ],
              "default": "pass"
            },
            "post_lab_visual_required": {
              "type": "boolean",
              "title": "Post-Lab Visual Required",
              "default": false
            },
            "lab_failure_reason": {
              "type": "string",
              "title": "Failure Reason (If failed)",
              "example": "Presence of quarantine pest: Bactrocera dorsalis"
            }
          },
          "required": [
            "id",
            "sample_test_result"
          ]
        }
      }
    },
    "required": [
      "sample_test_result",
      "lab_comments"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/sample_test_result"
      },
      {
        "type": "Control",
        "scope": "#/properties/lab_report_attachment_url"
      },
      {
        "type": "Control",
        "scope": "#/properties/lab_comments"
      },
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/commodity_common_name",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/sample_test_result"
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/lab_failure_reason",
                "rule": {
                  "effect": "SHOW",
                  "condition": {
                    "scope": "#/properties/sample_test_result",
                    "schema": {
                      "not": {
                        "const": "pass"
                      }
                    }
                  }
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/post_lab_visual_required",
                "rule": {
                  "effect": "SHOW",
                  "condition": {
                    "scope": "#/properties/sample_test_result",
                    "schema": {
                      "const": "pass"
                    }
                  }
                }
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      }
    ]
  }
}
