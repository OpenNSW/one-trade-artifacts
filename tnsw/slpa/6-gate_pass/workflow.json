{
  "id": "slpa-gate-pass-flow",
  "name": "Issue SLPA Container Gate Pass",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "haulage_details",
      "type": "TASK",
      "task_template_id": "slpa-gp--user-input",
      "input_mapping": {
        "container_no?": "gpform.container_no",
        "gpform?": "gpform",
        "gp?": "gp",
        "cap_id?": "cap_id",
        "so_container_no?": "gpform.so_container_no",
        "gp.gate_pass_no?": "gpform.previous_gate_pass_no"
      },
      "output_mapping": {
        "truck_no?": "gpform.truck_no",
        "driver_name?": "gpform.driver_name",
        "seal_no?": "gpform.seal_no",
        "action?": "gpform.action"
      }
    },
    {
      "id": "action_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "delete_consolidation",
      "type": "TASK",
      "task_template_id": "slpa-consolidation--delete",
      "input_mapping": {
        "gp?": "gp",
        "cap_id": "cap_id",
        "client_key?": "client_key",
        "so_container_no": "so_container_no",
        "container_no": "container_no"
      },
      "output_mapping": {
        "consolidation.deleted": "consolidation.deleted",
        "consolidation.error?": "consolidation.error"
      }
    },
    {
      "id": "issue",
      "type": "TASK",
      "task_template_id": "slpa-gp--issue",
      "input_mapping": {
        "gpform": "payload",
        "container_no?": "container_no",
        "slug?": "slug",
        "client_key?": "client_key",
        "so_container_no?": "so_container_no"
      },
      "output_mapping": {
        "gp.issued": "gp.issued",
        "gp.error?": "gp.error",
        "gp.gate_pass_no?": "gp.gate_pass_no",
        "gp.gate_pass_id?": "gp.gate_pass_id",
        "gp.container_no?": "gp.container_no",
        "gp.truck_no?": "gp.truck_no",
        "gp.driver_name?": "gp.driver_name",
        "gp.seal_no?": "gp.seal_no",
        "gp.barcode?": "gp.barcode",
        "gp.status?": "gp.status",
        "gp.issued_at?": "gp.issued_at",
        "gp.gate_pass_url?": "gp.gate_pass_url"
      }
    },
    {
      "id": "issued_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "archive_gate_pass",
      "type": "TASK",
      "task_template_id": "slpa-gp--archive-gate-pass",
      "input_mapping": {
        "gp.gate_pass_url?": "gate_pass_url"
      },
      "output_mapping": {
        "gate_pass_file?": "gp.gate_pass_file"
      }
    },
    {
      "id": "archive_barcode",
      "type": "TASK",
      "task_template_id": "slpa-gp--archive-barcode",
      "input_mapping": {
        "gp.barcode?": "barcode"
      },
      "output_mapping": {
        "barcode_file?": "gp.barcode_file"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "source_id": "start",
      "target_id": "haulage_details"
    },
    {
      "id": "e_choice",
      "source_id": "haulage_details",
      "target_id": "action_check"
    },
    {
      "id": "e_finish",
      "source_id": "action_check",
      "target_id": "end",
      "condition": "gpform.action == 'finish' && $env?.gp?.gate_pass_no != nil"
    },
    {
      "id": "e_delete",
      "source_id": "action_check",
      "target_id": "delete_consolidation",
      "condition": "gpform.action == 'delete_consolidation' && $env?.gp?.gate_pass_no == nil"
    },
    {
      "id": "e_generate",
      "source_id": "action_check",
      "target_id": "issue",
      "condition": "gpform.action == 'generate_gate_pass'"
    },
    {
      "id": "e_not_allowed",
      "source_id": "action_check",
      "target_id": "haulage_details"
    },
    {
      "id": "e_deleted",
      "source_id": "delete_consolidation",
      "target_id": "end"
    },
    {
      "id": "e_after_issue",
      "source_id": "issue",
      "target_id": "issued_check"
    },
    {
      "id": "e_pass_issued",
      "source_id": "issued_check",
      "target_id": "archive_gate_pass",
      "condition": "gp.issued == true"
    },
    {
      "id": "e_pass_refused",
      "source_id": "issued_check",
      "target_id": "haulage_details",
      "condition": "gp.issued != true"
    },
    {
      "id": "e_pass_stored",
      "source_id": "archive_gate_pass",
      "target_id": "archive_barcode"
    },
    {
      "id": "e_barcode_stored",
      "source_id": "archive_barcode",
      "target_id": "haulage_details"
    }
  ]
}
