{
  "id": "slpa-gp--user-form",
  "title": "Gate Pass Details",
  "schema": {
    "type": "object",
    "properties": {
      "container_no": {
        "type": "string",
        "title": "Container No",
        "readOnly": true,
        "description": "The container SLPA consolidated. A pass can only be issued for a consolidated container."
      },
      "action": {
        "type": "string",
        "title": "What would you like to do?",
        "oneOf": [
          {
            "const": "generate_gate_pass",
            "title": "Generate the gate pass"
          },
          {
            "const": "delete_consolidation",
            "title": "Delete the consolidation and choose a different container"
          }
        ],
        "description": "Deleting removes the pairing at SLPA and returns you to this container\u2019s consolidation step. It is only offered before a pass exists."
      },
      "truck_no": {
        "type": "string",
        "title": "Truck No",
        "minLength": 1,
        "description": "The vehicle the container leaves on, as it appears on the plate."
      },
      "driver_name": {
        "type": "string",
        "title": "Driver Name",
        "minLength": 1,
        "description": "The driver presenting this pass at the gate."
      },
      "seal_no": {
        "type": "string",
        "title": "Seal No",
        "minLength": 1,
        "description": "The seal the container leaves under."
      }
    },
    "required": [
      "action"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "generate_gate_pass"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "required": [
            "truck_no",
            "driver_name",
            "seal_no"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/container_no"
      },
      {
        "type": "Control",
        "scope": "#/properties/action"
      },
      {
        "type": "Control",
        "scope": "#/properties/truck_no",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/action",
            "schema": {
              "const": "generate_gate_pass"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/driver_name",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/action",
            "schema": {
              "const": "generate_gate_pass"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/seal_no",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/action",
            "schema": {
              "const": "generate_gate_pass"
            }
          }
        }
      }
    ]
  }
}
