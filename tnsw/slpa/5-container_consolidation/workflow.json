{
  "id": "slpa-consolidation-flow",
  "name": "Consolidate SLPA FCL Containers",
  "version": 1,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "fetch",
      "type": "TASK",
      "task_template_id": "slpa-consolidation--fetch",
      "input_mapping": {
        "cusdec_serial?": "cusdec_serial",
        "client_key?": "client_key"
      },
      "output_mapping": {
        "consolidation.outcome": "consolidation.outcome",
        "consolidation.rows": "consolidationform.rows",
        "consolidation.available_so_containers?": "consolidationform.available_so_containers",
        "consolidation.so_containers?": "consolidation.so_containers",
        "consolidation.already_consolidated?": "consolidation.already_consolidated",
        "consolidation.consolidated?": "consolidation.consolidated",
        "consolidation.summary?": "consolidation.summary",
        "consolidation.cap_container_count?": "consolidation.cap_container_count",
        "consolidation.so_container_count?": "consolidation.so_container_count",
        "consolidation.error?": "consolidation.error"
      }
    },
    {
      "id": "offer_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "select",
      "type": "TASK",
      "task_template_id": "slpa-consolidation--select",
      "input_mapping": {
        "consolidationform?": "consolidationform",
        "consolidation?": "consolidation"
      },
      "output_mapping": {
        "rows?": "consolidationform.rows"
      }
    },
    {
      "id": "selection_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "save",
      "type": "TASK",
      "task_template_id": "slpa-consolidation--save",
      "input_mapping": {
        "consolidationform": "payload",
        "consolidation.so_containers": "so_containers",
        "client_key?": "client_key"
      },
      "output_mapping": {
        "consolidation.saved": "consolidation.saved",
        "consolidation.message?": "consolidation.message",
        "consolidation.error?": "consolidation.error"
      }
    },
    {
      "id": "save_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "fetch"
    },
    {
      "id": "e_fetched",
      "source_id": "fetch",
      "target_id": "offer_check"
    },
    {
      "id": "e_all_done",
      "source_id": "offer_check",
      "target_id": "end",
      "condition": "consolidation.outcome == 'done'"
    },
    {
      "id": "e_offer",
      "source_id": "offer_check",
      "target_id": "select",
      "condition": "consolidation.outcome != 'done'"
    },
    {
      "id": "e_submitted",
      "source_id": "select",
      "target_id": "selection_check"
    },
    {
      "id": "e_selected",
      "source_id": "selection_check",
      "target_id": "save",
      "condition": "len(filter(consolidationform.rows, {.consolidate == true})) > 0"
    },
    {
      "id": "e_nothing_selected",
      "source_id": "selection_check",
      "target_id": "fetch",
      "condition": "len(filter(consolidationform.rows, {.consolidate == true})) == 0"
    },
    {
      "id": "e_saved_check",
      "source_id": "save",
      "target_id": "save_check"
    },
    {
      "id": "e_saved",
      "source_id": "save_check",
      "target_id": "end",
      "condition": "consolidation.saved == true"
    },
    {
      "id": "e_not_saved",
      "source_id": "save_check",
      "target_id": "fetch",
      "condition": "consolidation.saved != true"
    }
  ]
}
