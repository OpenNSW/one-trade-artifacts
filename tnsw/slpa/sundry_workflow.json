      "task_template_id": "slpa-sundry-order-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "traderCompany.data.slpacmsuser_key?": "client_key"
      },
      "output_mapping": {
        "sundryform?": "sundry.form",
