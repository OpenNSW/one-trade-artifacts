{
  "id": "slpa-ecdn-submission",
  "name": "SLPA Electronic Cargo Declaration Note (ECDN)",
  "version": 1,
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "name": "Start"
    },
    {
      "id": "slpa_1_0_ecdn",
      "type": "TASK",
      "name": "[SLPA 1.0] Submit ECDN",
      "task_template_id": "slpa-ecdn-submission-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "_iter.input.company.data.slpacmsuser_key?": "client_key"
      },
      "output_mapping": {
        "userform": "slpa.userform",
        "userform.cdnNumber": "slpa.cdn_number",
        "cms.cusdec_serial?": "slpa.cusdec_serial"
      }
    },
    {
      "id": "slpa_2_0_service_order",
      "type": "TASK",
      "name": "[SLPA 2.0] Raise Export Service Order",
      "task_template_id": "slpa-service-order-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "_iter.input.company.data.slpacmsuser_key?": "client_key",
        "slpa.cusdec_serial?": "serviceform.cusdecNo",
        "slpa.userform.status?": "serviceform.cargoType",
        "slpa.userform.containers?": "serviceform.containers",
        "slpa.userform.volumeCBM?": "serviceform.declaredVolumeCBM"
      },
      "output_mapping": {
        "so.service_order_no?": "slpa.service_order_no",
        "so.slug?": "slpa.service_order_slug",
        "so.invoice_no?": "slpa.invoice_no"
      }
    },
    {
      "id": "slpa_3_0_approval",
      "type": "TASK",
      "name": "[SLPA 3.0] Service Order Approval",
      "task_template_id": "slpa-approval-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "slpa.service_order_slug?": "so.slug",
        "slpa.service_order_no?": "so.service_order_no"
      },
      "output_mapping": {
        "decision.decision?": "slpa.approval",
        "decision.invoice_no?": "slpa.invoice_no"
      }
    },
    {
      "id": "slpa_4_0_invoice",
      "type": "TASK",
      "name": "[SLPA 4.0] Invoice & Payment",
      "task_template_id": "slpa-invoice-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "slpa.service_order_slug?": "so.slug",
        "slpa.service_order_no?": "so.service_order_no"
      },
      "output_mapping": {
        "payment.invoice_no?": "slpa.invoice_no",
        "payment.paid_at?": "slpa.invoice_paid_at",
        "payment.receipt_url?": "slpa.invoice_receipt_url"
      }
    },
    {
      "id": "slpa_5_0_consolidation",
      "type": "TASK",
      "name": "[SLPA 5.0] Container Consolidation",
      "task_template_id": "slpa-consolidation-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "_iter.input.company.data.slpacmsuser_key?": "client_key",
        "slpa.cusdec_serial?": "cusdec_serial"
      },
      "output_mapping": {
        "consolidationform.rows?": "slpa.consolidation_rows",
        "consolidation.already_consolidated?": "slpa.already_consolidated",
        "consolidation.summary?": "slpa.consolidation_summary"
      }
    },
    {
      "id": "slpa_6_0_prepare_gate_passes",
      "type": "TASK",
      "name": "[SLPA 6.0] Prepare Gate Pass Items",
      "task_template_id": "slpa-gate-pass-prepare-flow",
      "lane": "System",
      "input_mapping": {
        "slpa.consolidation_rows?": "rows",
        "slpa.already_consolidated?": "containers",
        "slpa.service_order_slug?": "slug",
        "_iter.input.company.data.slpacmsuser_key?": "client_key"
      },
      "output_mapping": {
        "split_items": "slpa.gate_pass_items"
      }
    },
    {
      "id": "slpa_6_1_gate_passes",
      "type": "SPLIT_TASK",
      "name": "[SLPA 6.1] Issue Container Gate Passes",
      "task_template_id": "slpa-gate-pass-branch",
      "split_task": {
        "mode": "SAME_TEMPLATE",
        "items_variable": "slpa.gate_pass_items",
        "results_variable": "slpa.gate_passes",
        "failure_mode": "COLLECT_ALL"
      }
    },
    {
      "id": "end",
      "type": "END",
      "name": "SLPA Gate Passes Issued"
    }
  ],
  "edges": [
    {
      "id": "e_start_to_ecdn",
      "source_id": "start",
      "target_id": "slpa_1_0_ecdn"
    },
    {
      "id": "e_ecdn_to_order",
      "source_id": "slpa_1_0_ecdn",
      "target_id": "slpa_2_0_service_order"
    },
    {
      "id": "e_order_to_approval",
      "source_id": "slpa_2_0_service_order",
      "target_id": "slpa_3_0_approval"
    },
    {
      "id": "e_approval_to_invoice",
      "source_id": "slpa_3_0_approval",
      "target_id": "slpa_4_0_invoice"
    },
    {
      "id": "e_invoice_to_consolidation",
      "source_id": "slpa_4_0_invoice",
      "target_id": "slpa_5_0_consolidation"
    },
    {
      "id": "e_consolidation_to_prepare",
      "source_id": "slpa_5_0_consolidation",
      "target_id": "slpa_6_0_prepare_gate_passes"
    },
    {
      "id": "e_prepare_to_gate_passes",
      "source_id": "slpa_6_0_prepare_gate_passes",
      "target_id": "slpa_6_1_gate_passes"
    },
    {
      "id": "e_gate_passes_to_end",
      "source_id": "slpa_6_1_gate_passes",
      "target_id": "end"
    }
  ]
}
