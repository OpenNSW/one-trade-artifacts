{
  "id": "slpa-invoice-flow:render",
  "type": "APPLICATION",
  "title": "[SLPA] Invoice & Payment",
  "sections": {
    "request_prompt": {
      "templateId": "slpa-invoice--request-message",
      "title": "Invoice",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ]
      }
    },
    "request_button": {
      "templateId": "slpa-invoice--request-form",
      "title": "Generate the Invoice",
      "projector": "FORM",
      "dataKey": "request",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ]
      },
      "handles": [
        {
          "command": "submit",
          "label": "Generate Invoice",
          "element": "primary_action"
        }
      ]
    },
    "awaiting_payment": {
      "templateId": "slpa-invoice--awaiting-message",
      "title": "Invoice Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "STARTING",
          "QUEUED_EXTERNALLY"
        ]
      }
    },
    "paid_message": {
      "templateId": "slpa-invoice--paid-message",
      "title": "Payment Confirmed",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "COMPLETED"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
