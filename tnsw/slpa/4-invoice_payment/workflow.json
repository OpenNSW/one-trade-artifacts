{
  "id": "slpa-invoice-flow",
  "name": "Settle the SLPA Invoice",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "request_invoice",
      "type": "TASK",
      "task_template_id": "slpa-invoice--request",
      "input_mapping": {
        "payment?": "payment",
        "payment.error?": "error"
      },
      "output_mapping": {}
    },
    {
      "id": "generate_invoice",
      "type": "TASK",
      "task_template_id": "slpa-invoice--generate",
      "input_mapping": {
        "so.service_order_no?": "service_order_no",
        "client_key?": "client_key"
      },
      "output_mapping": {
        "payment.invoice_no?": "payment.invoice_no",
        "payment.invoice_serial?": "payment.invoice_serial",
        "payment.payable_lkr?": "payment.payable_lkr",
        "payment.exchange_rate?": "payment.exchange_rate",
        "payment.generated_at?": "payment.generated_at",
        "payment.payment_slip_url?": "payment.payment_slip_url",
        "payment.cms_status?": "payment.cms_status",
        "payment.paid?": "payment.paid",
        "payment.issued?": "payment.issued",
        "payment.error?": "payment.error",
        "payment.items?": "payment.items",
        "payment.payment_slip?": "payment.payment_slip"
      }
    },
    {
      "id": "issued_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "archive_payment_slip",
      "type": "TASK",
      "task_template_id": "slpa-invoice--archive-payment-slip",
      "input_mapping": {
        "payment?": "payment",
        "payment.payment_slip_url?": "payment_slip_url"
      },
      "output_mapping": {
        "payment_slip_file?": "payment.payment_slip_file"
      }
    },
    {
      "id": "slip_paid_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "await_payment",
      "type": "TASK",
      "task_template_id": "slpa-invoice--wait",
      "input_mapping": {
        "payment?": "payment",
        "so.slug?": "so.slug",
        "so.service_order_no?": "so.service_order_no"
      },
      "output_mapping": {
        "invoice_no?": "payment.invoice_no",
        "invoice_serial?": "payment.invoice_serial",
        "paid_at?": "payment.paid_at",
        "payable_lkr?": "payment.payable_lkr",
        "receipt_url?": "payment.receipt_url",
        "payment_slip_url?": "payment.payment_slip_url",
        "cms_status?": "payment.cms_status",
        "paid?": "payment.paid",
        "receipt_no?": "payment.receipt_no",
        "exchange_rate?": "payment.exchange_rate",
        "generated_at?": "payment.generated_at",
        "cusdec_no?": "payment.cusdec_no",
        "invoice_type?": "payment.invoice_type",
        "shipper?": "payment.shipper",
        "consignee?": "payment.consignee"
      }
    },
    {
      "id": "payment_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "archive_receipt",
      "type": "TASK",
      "task_template_id": "slpa-invoice--archive-receipt",
      "input_mapping": {
        "payment.receipt_url?": "receipt_url"
      },
      "output_mapping": {
        "receipt_file?": "payment.receipt_file"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "source_id": "start",
      "target_id": "request_invoice"
    },
    {
      "id": "e_requested",
      "source_id": "request_invoice",
      "target_id": "generate_invoice"
    },
    {
      "id": "e_issued_check",
      "source_id": "generate_invoice",
      "target_id": "issued_check"
    },
    {
      "id": "e_not_issued",
      "source_id": "issued_check",
      "target_id": "request_invoice",
      "condition": "payment.issued != true"
    },
    {
      "id": "e_issued",
      "source_id": "issued_check",
      "target_id": "archive_payment_slip",
      "condition": "payment.issued == true"
    },
    {
      "id": "e_slip_stored",
      "source_id": "archive_payment_slip",
      "target_id": "slip_paid_check"
    },
    {
      "id": "e_already_paid",
      "source_id": "slip_paid_check",
      "target_id": "archive_receipt",
      "condition": "payment.paid == true"
    },
    {
      "id": "e_await_payment",
      "source_id": "slip_paid_check",
      "target_id": "await_payment",
      "condition": "payment.paid != true"
    },
    {
      "id": "e_check",
      "source_id": "await_payment",
      "target_id": "payment_check"
    },
    {
      "id": "e_paid",
      "source_id": "payment_check",
      "target_id": "archive_receipt",
      "condition": "payment.paid == true"
    },
    {
      "id": "e_unpaid",
      "source_id": "payment_check",
      "target_id": "await_payment",
      "condition": "payment.paid != true"
    },
    {
      "id": "e_receipt_stored",
      "source_id": "archive_receipt",
      "target_id": "end"
    }
  ]
}
