{
  "id": "slpa-ecdn--user-form",
  "title": "Electronic Cargo Declaration Note (ECDN)",
  "schema": {
    "type": "object",
    "properties": {
      "cusdecNo": {
        "type": "string",
        "title": "Cusdec No",
        "pattern": "^[A-Za-z0-9/-]+$",
        "description": "The number Sri Lanka Customs gave the declaration when it assessed it.",
        "readOnly": true,
        "example": "CBEX1/2026/E/1050"
      },
      "cusdecDate": {
        "type": "string",
        "title": "Cusdec Date",
        "example": "2026-08-20",
        "format": "date"
      },
      "cusdecOffice": {
        "type": "string",
        "title": "Cusdec Office",
        "oneOf": [
          {
            "const": "BIBE1",
            "title": "BIBE1"
          },
          {
            "const": "BIBE3",
            "title": "BIBE3"
          },
          {
            "const": "BIBI1",
            "title": "BIBI1"
          },
          {
            "const": "CBBD1",
            "title": "CBBD1"
          },
          {
            "const": "CBBE3",
            "title": "CBBE3"
          },
          {
            "const": "CBBI1",
            "title": "CBBI1"
          },
          {
            "const": "CBBO1",
            "title": "CBBO1"
          },
          {
            "const": "CBBI3",
            "title": "CBBI3"
          },
          {
            "const": "CBMV1",
            "title": "CBMV1"
          },
          {
            "const": "CBEX1",
            "title": "CBEX1"
          },
          {
            "const": "CBLR1",
            "title": "CBLR1"
          },
          {
            "const": "CBIF1",
            "title": "CBIF1"
          },
          {
            "const": "CBBD3",
            "title": "CBBD3"
          },
          {
            "const": "CBHQ1",
            "title": "CBHQ1"
          },
          {
            "const": "CBOND",
            "title": "CBOND"
          },
          {
            "const": "CBCDU",
            "title": "CBCDU"
          },
          {
            "const": "CBBE1",
            "title": "CBBE1"
          },
          {
            "const": "CBTRS",
            "title": "CBTRS"
          },
          {
            "const": "HBIM1",
            "title": "HBIM1"
          },
          {
            "const": "KGBE1",
            "title": "KGBE1"
          },
          {
            "const": "KTBE1",
            "title": "KTBE1"
          },
          {
            "const": "KTBE3",
            "title": "KTBE3"
          },
          {
            "const": "KTBG1",
            "title": "KTBG1"
          },
          {
            "const": "KTBI1",
            "title": "KTBI1"
          },
          {
            "const": "KTCC2",
            "title": "KTCC2"
          },
          {
            "const": "KTEX1",
            "title": "KTEX1"
          },
          {
            "const": "KTIM1",
            "title": "KTIM1"
          },
          {
            "const": "MRBG1",
            "title": "MRBG1"
          },
          {
            "const": "MREX1",
            "title": "MREX1"
          },
          {
            "const": "MRIM1",
            "title": "MRIM1"
          },
          {
            "const": "PGBI1",
            "title": "PGBI1"
          },
          {
            "const": "PKBE1",
            "title": "PKBE1"
          },
          {
            "const": "PKBI1",
            "title": "PKBI1"
          },
          {
            "const": "GEME1",
            "title": "GEME1"
          },
          {
            "const": "GEME2",
            "title": "GEME2"
          }
        ],
        "description": "SLPA office code list."
      },
      "cusdecSerLet": {
        "type": "string",
        "title": "CusDec SerLet",
        "description": "Leave empty to use the serial letter in the CusDec number.",
        "example": "E"
      },
      "cdnNumber": {
        "type": "string",
        "title": "CDN Number",
        "example": "CDN-2026-00481"
      },
      "terminal": {
        "type": "string",
        "title": "Terminal",
        "oneOf": [
          {
            "const": "JCT",
            "title": "JCT"
          },
          {
            "const": "CICT",
            "title": "CICT"
          },
          {
            "const": "SAGT",
            "title": "SAGT"
          },
          {
            "const": "UCT",
            "title": "UCT"
          },
          {
            "const": "ECT",
            "title": "ECT"
          },
          {
            "const": "CWIT",
            "title": "CWIT"
          }
        ]
      },
      "status": {
        "type": "string",
        "title": "Status",
        "oneOf": [
          {
            "const": "FCL",
            "title": "FCL"
          },
          {
            "const": "LCL",
            "title": "LCL"
          }
        ],
        "description": "FCL and LCL are validated differently by the CMS."
      },
      "shipperName": {
        "type": "string",
        "title": "Shipper Name",
        "example": "JOTHI COCONUT EXPORTERS"
      },
      "shipperAddress": {
        "type": "string",
        "title": "Shipper Address",
        "example": "45A, KANDY ROAD, PILIMATHALAWA"
      },
      "consigneeName": {
        "type": "string",
        "title": "Consignee Name",
        "example": "COCO WORLD SDN BHD"
      },
      "consigneeAddress": {
        "type": "string",
        "title": "Consignee Address",
        "example": "125, PUTRAJAYA, KUALA LUMPUR"
      },
      "packageNumber": {
        "type": "number",
        "title": "Package Number",
        "example": 80
      },
      "packageType": {
        "type": "string",
        "title": "Package Type",
        "oneOf": [
          {
            "const": "Bags",
            "title": "Bags"
          },
          {
            "const": "Bales",
            "title": "Bales"
          },
          {
            "const": "Barrels",
            "title": "Barrels"
          },
          {
            "const": "Boxes",
            "title": "Boxes"
          },
          {
            "const": "Bulk",
            "title": "Bulk"
          },
          {
            "const": "Bundles",
            "title": "Bundles"
          },
          {
            "const": "Cartoons",
            "title": "Cartoons"
          },
          {
            "const": "Cases",
            "title": "Cases"
          },
          {
            "const": "Crate",
            "title": "Crate"
          },
          {
            "const": "Drums",
            "title": "Drums"
          },
          {
            "const": "Meteres",
            "title": "Meteres"
          },
          {
            "const": "Numbers",
            "title": "Numbers"
          },
          {
            "const": "Packages",
            "title": "Packages"
          },
          {
            "const": "Packets",
            "title": "Packets"
          },
          {
            "const": "Packs",
            "title": "Packs"
          },
          {
            "const": "Pallets",
            "title": "Pallets"
          },
          {
            "const": "Pieces",
            "title": "Pieces"
          },
          {
            "const": "Plates",
            "title": "Plates"
          },
          {
            "const": "Reels",
            "title": "Reels"
          },
          {
            "const": "Roles",
            "title": "Roles"
          },
          {
            "const": "Sets",
            "title": "Sets"
          },
          {
            "const": "Units",
            "title": "Units"
          },
          {
            "const": "W.Boxes",
            "title": "W.Boxes"
          },
          {
            "const": "Other",
            "title": "Other"
          }
        ]
      },
      "volumeCBM": {
        "type": "number",
        "title": "Volume (CBM)",
        "example": 32.5
      },
      "weightKg": {
        "type": "number",
        "title": "Weight (Kg.)",
        "example": 16500.5
      },
      "goodsDescription": {
        "type": "string",
        "title": "Goods Description",
        "example": "Refined Organic Coconut Oil"
      },
      "voyageNumber": {
        "type": "string",
        "title": "Voyage Number",
        "example": "V092",
        "description": "Optional on the SLPA form."
      },
      "voyageDate": {
        "type": "string",
        "title": "Voyage Date",
        "example": "2026-08-25",
        "format": "date"
      },
      "portOfLoading": {
        "type": "string",
        "title": "Port Of Loading",
        "example": "LKCMB",
        "description": "Optional on the SLPA form."
      },
      "portOfUnloading": {
        "type": "string",
        "title": "Port Of Unloading",
        "example": "DEHAM",
        "description": "Optional on the SLPA form."
      },
      "vesselOPCode": {
        "type": "string",
        "title": "Vessel OPCode",
        "example": "OP-MSC",
        "description": "Optional on the SLPA form."
      },
      "contOPCode": {
        "type": "string",
        "title": "Cont. OPCode",
        "example": "CO-882",
        "description": "Optional on the SLPA form."
      },
      "exVessel": {
        "type": "string",
        "title": "EX Vessel",
        "example": "MAERSK KOWLOON",
        "description": "Optional on the SLPA form."
      },
      "email": {
        "type": "string",
        "title": "Email",
        "example": "exports@jothicoconut.lk",
        "format": "email",
        "description": "Optional on the SLPA form."
      },
      "contactNo": {
        "type": "string",
        "title": "Contact No",
        "pattern": "^([0-9]{10})?$",
        "example": "0112345678",
        "description": "Optional on the SLPA form. Exactly 10 digits, with no letters, spaces or symbols."
      },
      "remarks": {
        "type": "string",
        "title": "Remarks",
        "description": "Optional on the SLPA form."
      },
      "containers": {
        "type": "array",
        "title": "Container Details",
        "description": "One row per container. The CMS applies FCL/LCL rules against these.",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "containerNo": {
              "type": "string",
              "title": "Container No",
              "description": "Generated for you as each container is added. SLPA reads this as the per-declaration key; the physical container number goes in Container Mark.",
              "x-template": {
                "template": "{cusdecNo}-{cusdecDate}-{seq(2)}"
              }
            },
            "containerType": {
              "type": "string",
              "title": "Container Type",
              "oneOf": [
                {
                  "const": "General",
                  "title": "General"
                },
                {
                  "const": "Open Top",
                  "title": "Open Top"
                },
                {
                  "const": "Flat Rack",
                  "title": "Flat Rack"
                },
                {
                  "const": "Reefer",
                  "title": "Reefer"
                }
              ]
            },
            "containerSize": {
              "type": "string",
              "title": "Container Size",
              "oneOf": [
                {
                  "const": "20",
                  "title": "20"
                },
                {
                  "const": "40",
                  "title": "40"
                },
                {
                  "const": "45",
                  "title": "45"
                }
              ]
            },
            "sealNumber": {
              "type": "string",
              "title": "Seal Number",
              "example": "894021"
            },
            "containerMark": {
              "type": "string",
              "title": "Container Mark",
              "example": "MSCU-849201-9"
            },
            "commodity": {
              "type": "string",
              "title": "Commodity",
              "oneOf": [
                {
                  "const": "DC/Reefer/Liquor",
                  "title": "DC/Reefer/Liquor"
                },
                {
                  "const": "Non DC",
                  "title": "Non DC"
                }
              ]
            }
          },
          "required": [
            "containerNo",
            "containerType",
            "containerSize",
            "sealNumber",
            "containerMark",
            "commodity"
          ]
        }
      }
    },
    "required": [
      "cusdecNo",
      "cusdecDate",
      "cusdecOffice",
      "cdnNumber",
      "terminal",
      "status",
      "shipperName",
      "shipperAddress",
      "consigneeName",
      "consigneeAddress",
      "packageNumber",
      "packageType",
      "volumeCBM",
      "weightKg",
      "goodsDescription",
      "voyageDate",
      "containers"
    ]
  },
  "uiSchema": {
    "type": "Categorization",
    "options": {
      "variant": "stepper"
    },
    "elements": [
      {
        "type": "Category",
        "label": "CusDec Details",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/cusdecNo"
          },
          {
            "type": "Control",
            "scope": "#/properties/cusdecDate"
          },
          {
            "type": "Control",
            "scope": "#/properties/cusdecOffice"
          },
          {
            "type": "Control",
            "scope": "#/properties/cusdecSerLet"
          },
          {
            "type": "Control",
            "scope": "#/properties/cdnNumber"
          },
          {
            "type": "Control",
            "scope": "#/properties/terminal"
          },
          {
            "type": "Control",
            "scope": "#/properties/status"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Shipper and Consignee",
        "elements": [
          {
            "type": "Group",
            "label": "Shipper",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/shipperName"
              },
              {
                "type": "Control",
                "scope": "#/properties/shipperAddress"
              }
            ]
          },
          {
            "type": "Group",
            "label": "Consignee",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/consigneeName"
              },
              {
                "type": "Control",
                "scope": "#/properties/consigneeAddress"
              }
            ]
          }
        ]
      },
      {
        "type": "Category",
        "label": "Cargo",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/goodsDescription"
          },
          {
            "type": "Control",
            "scope": "#/properties/packageNumber"
          },
          {
            "type": "Control",
            "scope": "#/properties/packageType"
          },
          {
            "type": "Control",
            "scope": "#/properties/volumeCBM"
          },
          {
            "type": "Control",
            "scope": "#/properties/weightKg"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Voyage and Route",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/voyageNumber"
          },
          {
            "type": "Control",
            "scope": "#/properties/voyageDate"
          },
          {
            "type": "Control",
            "scope": "#/properties/portOfLoading"
          },
          {
            "type": "Control",
            "scope": "#/properties/portOfUnloading"
          },
          {
            "type": "Control",
            "scope": "#/properties/vesselOPCode"
          },
          {
            "type": "Control",
            "scope": "#/properties/contOPCode"
          },
          {
            "type": "Control",
            "scope": "#/properties/exVessel"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Contact",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/email"
          },
          {
            "type": "Control",
            "scope": "#/properties/contactNo"
          },
          {
            "type": "Control",
            "scope": "#/properties/remarks"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Container Details",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/containers",
            "options": {
              "display": "cards",
              "itemLabel": "Container",
              "summary": "{containerMark} · {containerSize} {containerType}",
              "summaryDetail": "{containerNo} · Seal {sealNumber} · {commodity}"
            }
          }
        ]
      }
    ]
  }
}
