{
  "id": "npqs-visual2-inspection-flow",
  "name": "Visual Inspection 2 Flow",
  "version": 1,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "trader_schedule",
      "type": "TASK",
      "task_template_id": "npqs-visual2-inspection--trader-schedule",
      "input_mapping": {"commodities?": "commodities", "reference_number?": "reference_number"},
      "output_mapping": {
        "inspection_date": "traderinput.inspection_date",
        "inspection_time": "traderinput.inspection_time",
        "contact_name": "traderinput.contact_name",
        "contact_phone": "traderinput.contact_phone"
      }
    },
    {
      "id": "officer_inspection",
      "type": "TASK",
      "task_template_id": "npqs-visual2-inspection--officer-review",
      "input_mapping": {
        "reference_number?": "reference_number",
        "traderinput?": "traderinput",
        "reference_number": "submission.reference_number",
        "traderinput": "submission",
        "commodities?": "submission.items"
      },
      "output_mapping": {
        "visual2_result": "visual2_result",
        "items": "commodities"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "trader_schedule"
    },
    {
      "id": "e2",
      "source_id": "trader_schedule",
      "target_id": "officer_inspection"
    },
    {
      "id": "e3",
      "source_id": "officer_inspection",
      "target_id": "end"
    }
  ]
}
