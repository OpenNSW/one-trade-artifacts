{
  "id": "npqs-v3-test-visual1-reg",
  "name": "NPQS v3 Test: Visual Inspection 1 Only",
  "version": 1,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "n1_apply",
      "name": "Apply, Review & Generate Reference Number",
      "type": "TASK",
      "task_template_id": "npqs-apply-phyto-cert",
      "input_mapping": {
        "_iter.input.company.name?": "applicant_name",
        "_iter.input.company.name": "exporter_name",
        "_iter.input.company.address?": "exporter_address"
      },
      "output_mapping": {
        "reviewerform.reference_number": "npqs.reference_number",
        "userform": "npqs.userform",
        "reviewerform.review_outcome": "npqs.review_outcome",
        "reviewerform.commodities": "commodities",
        "reviewerform.ephyto_required?": "npqs.ephyto_required"
      }
    },
    {
      "id": "gw_visual_split",
      "name": "Stage 2: Visual Inspection 1 (Partition Items)",
      "type": "GATEWAY",
      "gateway_type": "BATCH_SPLIT",
      "batch_gateway": {
        "items_variable": "commodities",
        "id_field": "id"
      },
      "input_mapping": {
        "npqs.reference_number?": "npqs.reference_number",
        "npqs.userform?": "npqs.userform"
      }
    },
    {
      "id": "n_visual_sample_collect",
      "name": "Collect Sample for Visual Inspection",
      "type": "TASK",
      "task_template_id": "npqs-visual-sample-collection",
      "input_mapping": {
        "npqs.reference_number": "reference_number",
        "npqs.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "sample_number": "npqs.visual_sample_number"
      }
    },
    {
      "id": "n_visual_sample_inspection",
      "name": "Conduct Visual Sample Inspection",
      "type": "TASK",
      "task_template_id": "npqs-visual-sample-inspection",
      "input_mapping": {
        "npqs.reference_number": "reference_number",
        "npqs.userform": "userform",
        "commodities": "commodities",
        "npqs.visual_sample_number?": "sample_number"
      },
      "output_mapping": {
        "commodities": "commodities"
      }
    },
    {
      "id": "visual_sample_result_split",
      "name": "Sample Visual Result",
      "type": "GATEWAY",
      "gateway_type": "BATCH_SPLIT",
      "batch_gateway": {
        "items_variable": "commodities",
        "id_field": "id"
      },
      "input_mapping": {
        "npqs.reference_number?": "npqs.reference_number",
        "npqs.userform?": "npqs.userform"
      }
    },
    {
      "id": "visual_sample_result_join",
      "name": "Merge Sample Visual Results",
      "type": "GATEWAY",
      "gateway_type": "BATCH_JOIN",
      "batch_join": {
        "gateway_node_id": "visual_sample_result_split",
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "n_visual_sample_escalated_consignment",
      "name": "Escalated Consignment Inspection (from Sample)",
      "type": "TASK",
      "task_template_id": "npqs-visual-consignment-flow",
      "input_mapping": {
        "npqs.reference_number": "reference_number",
        "npqs.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "commodities": "commodities"
      }
    },
    {
      "id": "visual_sample_escalated_result_split",
      "name": "Escalated Consignment Result",
      "type": "GATEWAY",
      "gateway_type": "BATCH_SPLIT",
      "batch_gateway": {
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "visual_sample_escalated_result_join",
      "name": "Merge Escalated Consignment Results",
      "type": "GATEWAY",
      "gateway_type": "BATCH_JOIN",
      "batch_join": {
        "gateway_node_id": "visual_sample_escalated_result_split",
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "n_visual_consignment_flow",
      "name": "Schedule & Conduct Consignment Inspection",
      "type": "TASK",
      "task_template_id": "npqs-visual-consignment-flow",
      "input_mapping": {
        "npqs.reference_number": "reference_number",
        "npqs.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "commodities": "commodities"
      }
    },
    {
      "id": "visual_consignment_result_split",
      "name": "Consignment Inspection Result",
      "type": "GATEWAY",
      "gateway_type": "BATCH_SPLIT",
      "batch_gateway": {
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "visual_consignment_result_join",
      "name": "Merge Consignment Inspection Results",
      "type": "GATEWAY",
      "gateway_type": "BATCH_JOIN",
      "batch_join": {
        "gateway_node_id": "visual_consignment_result_split",
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "n5_0_visual_inspection",
      "name": "Visual Inspection (Through System)",
      "type": "TASK",
      "task_template_id": "npqs-visual-system-inspection",
      "input_mapping": {
        "npqs.reference_number": "reference_number",
        "npqs.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "commodities": "commodities"
      }
    },
    {
      "id": "visual_system_result_split",
      "name": "System Inspection Result",
      "type": "GATEWAY",
      "gateway_type": "BATCH_SPLIT",
      "batch_gateway": {
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "visual_system_result_join",
      "name": "Merge System Inspection Results",
      "type": "GATEWAY",
      "gateway_type": "BATCH_JOIN",
      "batch_join": {
        "gateway_node_id": "visual_system_result_split",
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "gw_visual_join",
      "name": "Stage 2: Visual Inspection 1 (Merge Results)",
      "type": "GATEWAY",
      "gateway_type": "BATCH_JOIN",
      "batch_join": {
        "gateway_node_id": "gw_visual_split",
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "n8_0_issue_certificate",
      "name": "Issue Phytosanitary Certificate",
      "type": "TASK",
      "task_template_id": "npqs-issue-certificate",
      "input_mapping": {
        "npqs.reference_number": "reference_number",
        "npqs.userform": "userform",
        "npqs.ephyto_required?": "ephyto_required",
        "commodities?": "certificate_items"
      },
      "output_mapping": {
        "certificate_id": "npqs.certificate_id",
        "certificate_items?": "npqs.certificate_items"
      }
    },
    {
      "id": "end_success",
      "name": "Phytosanitary Certificate Issued",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "source_id": "start",
      "target_id": "n1_apply"
    },
    {
      "id": "e_apply_to_stage",
      "source_id": "n1_apply",
      "target_id": "gw_visual_split"
    },
    {
      "id": "e_vis_split_to_consign",
      "source_id": "gw_visual_split",
      "target_id": "n_visual_consignment_flow",
      "condition": "item.visual_required == true && item.visual_approach == 'consignment' && item.sample_test_result not in ['fail_final', 'fail_resubmit']"
    },
    {
      "id": "e_vis_split_to_sample",
      "source_id": "gw_visual_split",
      "target_id": "n_visual_sample_collect",
      "condition": "item.visual_required == true && item.visual_approach == 'sample' && item.sample_test_result not in ['fail_final', 'fail_resubmit']"
    },
    {
      "id": "e_vis_collect_to_sample",
      "source_id": "n_visual_sample_collect",
      "target_id": "n_visual_sample_inspection"
    },
    {
      "id": "e_vis_split_to_system",
      "source_id": "gw_visual_split",
      "target_id": "n5_0_visual_inspection",
      "condition": "item.visual_required == true && item.visual_approach == 'system' && item.sample_test_result not in ['fail_final', 'fail_resubmit']"
    },
    {
      "id": "e_vis_split_to_join_bypass",
      "source_id": "gw_visual_split",
      "target_id": "gw_visual_join",
      "condition": "item.visual_required != true || item.visual_approach == 'none' || item.sample_test_result in ['fail_final', 'fail_resubmit']"
    },
    {
      "id": "e_vis_consign_to_split",
      "source_id": "n_visual_consignment_flow",
      "target_id": "visual_consignment_result_split"
    },
    {
      "id": "e_vis_consign_fail",
      "source_id": "visual_consignment_result_split",
      "target_id": "visual_consignment_result_join",
      "condition": "item.visual_result == 'fail'"
    },
    {
      "id": "e_vis_consign_pass",
      "source_id": "visual_consignment_result_split",
      "target_id": "visual_consignment_result_join",
      "condition": "item.visual_result == 'pass'"
    },
    {
      "id": "e_vis_sample_to_split",
      "source_id": "n_visual_sample_inspection",
      "target_id": "visual_sample_result_split"
    },
    {
      "id": "e_vis_sample_fail",
      "source_id": "visual_sample_result_split",
      "target_id": "visual_sample_result_join",
      "condition": "item.visual_result == 'fail'"
    },
    {
      "id": "e_vis_sample_escalate",
      "source_id": "visual_sample_result_split",
      "target_id": "n_visual_sample_escalated_consignment",
      "condition": "item.visual_result == 'escalate_consignment'"
    },
    {
      "id": "e_vis_sample_pass",
      "source_id": "visual_sample_result_split",
      "target_id": "visual_sample_result_join",
      "condition": "item.visual_result == 'pass'"
    },
    {
      "id": "e_escalated_to_split",
      "source_id": "n_visual_sample_escalated_consignment",
      "target_id": "visual_sample_escalated_result_split"
    },
    {
      "id": "e_escalated_fail",
      "source_id": "visual_sample_escalated_result_split",
      "target_id": "visual_sample_escalated_result_join",
      "condition": "item.visual_result == 'fail'"
    },
    {
      "id": "e_escalated_pass",
      "source_id": "visual_sample_escalated_result_split",
      "target_id": "visual_sample_escalated_result_join",
      "condition": "item.visual_result == 'pass'"
    },
    {
      "id": "e_vis_system_to_split",
      "source_id": "n5_0_visual_inspection",
      "target_id": "visual_system_result_split"
    },
    {
      "id": "e_vis_system_fail",
      "source_id": "visual_system_result_split",
      "target_id": "visual_system_result_join",
      "condition": "item.visual_result == 'fail'"
    },
    {
      "id": "e_vis_system_pass",
      "source_id": "visual_system_result_split",
      "target_id": "visual_system_result_join",
      "condition": "item.visual_result == 'pass'"
    },
    {
      "id": "e_vis_consign_join_to_visual_join",
      "source_id": "visual_consignment_result_join",
      "target_id": "gw_visual_join"
    },
    {
      "id": "e_vis_sample_join_to_visual_join",
      "source_id": "visual_sample_result_join",
      "target_id": "gw_visual_join"
    },
    {
      "id": "e_escalated_join_to_sample_join",
      "source_id": "visual_sample_escalated_result_join",
      "target_id": "visual_sample_result_join"
    },
    {
      "id": "e_vis_system_join_to_visual_join",
      "source_id": "visual_system_result_join",
      "target_id": "gw_visual_join"
    },
    {
      "id": "e_stage_to_certificate",
      "source_id": "gw_visual_join",
      "target_id": "n8_0_issue_certificate"
    },
    {
      "id": "e_certificate_to_end",
      "source_id": "n8_0_issue_certificate",
      "target_id": "end_success"
    }
  ]
}
