{
  "id": "trade-cha-selection--form",
  "title": "Initialize Consignment",
  "schema": {
    "type": "object",
    "properties": {
      "consignment_name": {
        "title": "Consignment Name",
        "type": "string",
        "maxLength": 255
      },
      "cha_company_id": {
        "title": "Select Customs House Agent",
        "type": "string",
        "description": "Type to search for a Customs House Agent",
        "x-search": {
          "service": "cha",
          "loadOnOpen": true
        },
        "example": "Adam Pvt Ltd"
      },
      "notifyRecipient": {
        "type": "string",
        "format": "email",
        "title": "Contact email for notifications",
        "example": "trader@example.lk"
      }
    },
    "required": [
      "consignment_name",
      "cha_company_id"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/consignment_name"
      },
      {
        "type": "Control",
        "scope": "#/properties/cha_company_id",
        "options": {
          "placeholder": "Search for a CHA…"
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/notifyRecipient"
      }
    ]
  }
}