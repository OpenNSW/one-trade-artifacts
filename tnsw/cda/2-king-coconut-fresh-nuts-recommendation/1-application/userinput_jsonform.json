{
  "id": "cda-kcfn-apply--user-form",
  "title": "King Coconut / Fresh Nuts Export Recommendation Application",
  "schema": {
    "type": "object",
    "properties": {
      "import_application_xml": {
        "type": "object",
        "title": "Import Application XML",
        "description": "Upload an application XML to fill this form automatically. Also accepts a file from Download Application XML. Files to upload still need to be attached by hand. Values can be corrected afterwards.",
        "x-xml": {
          "accept": ".xml,text/xml,application/xml",
          "maxSize": 5242880,
          "persistDocument": false,
          "writeTo": [
            { "from": "CDA_KCFN.email", "to": "email", "as": "string" },
            { "from": "CDA_KCFN.company_name", "to": "company_name", "as": "string" },
            { "from": "CDA_KCFN.cda_registration_no", "to": "cda_registration_no", "as": "string" },
            { "from": "CDA_KCFN.destination_country", "to": "destination_country", "as": "string" },
            { "from": "CDA_KCFN.destination_city", "to": "destination_city", "as": "string" },
            { "from": "CDA_KCFN.vessel", "to": "vessel", "as": "string" },
            { "from": "CDA_KCFN.date_of_sailing", "to": "date_of_sailing", "as": "date" },
            { "from": "CDA_KCFN.cargo_type", "to": "cargo_type", "as": "string" },
            { "from": "CDA_KCFN.port_of_loading", "to": "port_of_loading", "as": "string" },
            { "from": "CDA_KCFN.port_of_discharge", "to": "port_of_discharge", "as": "string" },
            { "from": "CDA_KCFN.commercial_invoice_no", "to": "commercial_invoice_no", "as": "string" },
            { "from": "CDA_KCFN.commercial_invoice_date", "to": "commercial_invoice_date", "as": "date" },
            { "from": "CDA_KCFN.filling_date", "to": "filling_date", "as": "date" },
            { "from": "CDA_KCFN.buyer_name", "to": "buyer_name", "as": "string" },
            { "from": "CDA_KCFN.buyer_country", "to": "buyer_country", "as": "string" },
            { "from": "CDA_KCFN.buyer_city", "to": "buyer_city", "as": "string" },
            { "from": "CDA_KCFN.container_type", "to": "container_type", "as": "string" },
            { "from": "CDA_KCFN.nut_type", "to": "nut_type", "as": "string" },
            { "from": "CDA_KCFN.with_husk", "to": "with_husk", "as": "boolean" },
            { "from": "CDA_KCFN.container_number", "to": "container_number", "as": "string" },
            { "from": "CDA_KCFN.inner_packing_type", "to": "inner_packing_type", "as": "string" },
            { "from": "CDA_KCFN.serial_no_from", "to": "serial_no_from", "as": "string" },
            { "from": "CDA_KCFN.serial_no_to", "to": "serial_no_to", "as": "string" },
            { "from": "CDA_KCFN.quantity_nuts", "to": "quantity_nuts", "as": "number" },
            { "from": "CDA_KCFN.total_net_weight", "to": "total_net_weight", "as": "number" },
            { "from": "CDA_KCFN.total_fob", "to": "total_fob", "as": "string" },
            { "from": "CDA_KCFN.total_cif", "to": "total_cif", "as": "string" },
            { "from": "CDA_KCFN.location", "to": "location", "as": "string" },
            { "from": "CDA_KCFN.stuffing_date", "to": "stuffing_date", "as": "date" },
            { "from": "CDA_KCFN.contact_person_at_venue", "to": "contact_person_at_venue", "as": "string" },
            { "from": "CDA_KCFN.tel_no", "to": "tel_no", "as": "string" },
            { "from": "CDA_KCFN.applicant_name", "to": "applicant_name", "as": "string" },
            { "from": "CDA_KCFN.applicant_designation", "to": "applicant_designation", "as": "string" },
            { "from": "CDA_KCFN.application_date", "to": "application_date", "as": "date" },
            { "from": "CDA_KCFN.applicant_email", "to": "applicant_email", "as": "string" }
          ]
        }
      },
      "export_application_xml": {
        "type": "object",
        "title": "Download Application XML",
        "description": "Download this application as XML, to fill it in again later through Import Application XML.",
        "x-xml-export": {
          "rootElement": "CDA_KCFN",
          "declaration": { "standalone": "no" },
          "fileName": "cda-kcfn-{today(YYYYMMDD)}.xml",
          "writeTo": [
            { "from": "email", "to": "email", "as": "string" },
            { "from": "company_name", "to": "company_name", "as": "string" },
            { "from": "cda_registration_no", "to": "cda_registration_no", "as": "string" },
            { "from": "destination_country", "to": "destination_country", "as": "string" },
            { "from": "destination_city", "to": "destination_city", "as": "string" },
            { "from": "vessel", "to": "vessel", "as": "string" },
            { "from": "date_of_sailing", "to": "date_of_sailing", "as": "date" },
            { "from": "cargo_type", "to": "cargo_type", "as": "string" },
            { "from": "port_of_loading", "to": "port_of_loading", "as": "string" },
            { "from": "port_of_discharge", "to": "port_of_discharge", "as": "string" },
            { "from": "commercial_invoice_no", "to": "commercial_invoice_no", "as": "string" },
            { "from": "commercial_invoice_date", "to": "commercial_invoice_date", "as": "date" },
            { "from": "filling_date", "to": "filling_date", "as": "date" },
            { "from": "buyer_name", "to": "buyer_name", "as": "string" },
            { "from": "buyer_country", "to": "buyer_country", "as": "string" },
            { "from": "buyer_city", "to": "buyer_city", "as": "string" },
            { "from": "container_type", "to": "container_type", "as": "string" },
            { "from": "nut_type", "to": "nut_type", "as": "string" },
            { "from": "with_husk", "to": "with_husk", "as": "boolean" },
            { "from": "container_number", "to": "container_number", "as": "string" },
            { "from": "inner_packing_type", "to": "inner_packing_type", "as": "string" },
            { "from": "serial_no_from", "to": "serial_no_from", "as": "string" },
            { "from": "serial_no_to", "to": "serial_no_to", "as": "string" },
            { "from": "quantity_nuts", "to": "quantity_nuts", "as": "number" },
            { "from": "total_net_weight", "to": "total_net_weight", "as": "number" },
            { "from": "total_fob", "to": "total_fob", "as": "string" },
            { "from": "total_cif", "to": "total_cif", "as": "string" },
            { "from": "location", "to": "location", "as": "string" },
            { "from": "stuffing_date", "to": "stuffing_date", "as": "date" },
            { "from": "contact_person_at_venue", "to": "contact_person_at_venue", "as": "string" },
            { "from": "tel_no", "to": "tel_no", "as": "string" },
            { "from": "applicant_name", "to": "applicant_name", "as": "string" },
            { "from": "applicant_designation", "to": "applicant_designation", "as": "string" },
            { "from": "application_date", "to": "application_date", "as": "date" },
            { "from": "applicant_email", "to": "applicant_email", "as": "string" }
          ]
        }
      },
      "email": {
        "type": "string",
        "title": "Email",
        "example": "trader@example.com"
      },
      "company_name": {
        "type": "string",
        "title": "Company Name",
        "example": "Lanka Fresh Nuts (Pvt) Ltd"
      },
      "cda_registration_no": {
        "type": "string",
        "title": "CDA Registration No (Marketing Division)",
        "example": "0001"
      },
      "destination_country": {
        "type": "string",
        "title": "Country",
        "description": "Free text until the full ISO country list / API integration is wired in.",
        "example": "United Arab Emirates"
      },
      "destination_city": {
        "type": "string",
        "title": "City",
        "example": "Dubai"
      },
      "vessel": {
        "type": "string",
        "title": "Vessel",
        "example": "MSC LORETO"
      },
      "date_of_sailing": {
        "type": "string",
        "format": "date",
        "title": "Date of Sailing"
      },
      "cargo_type": {
        "type": "string",
        "title": "Cargo Type",
        "oneOf": [
          { "const": "sea", "title": "Sea" },
          { "const": "air", "title": "Air" }
        ],
        "example": "sea"
      },
      "port_of_loading": {
        "type": "string",
        "title": "Port of Loading",
        "example": "Colombo"
      },
      "port_of_discharge": {
        "type": "string",
        "title": "Port of Discharge",
        "example": "Jebel Ali"
      },
      "commercial_invoice_no": {
        "type": "string",
        "title": "Commercial Invoice No.",
        "example": "INV-2026-04521"
      },
      "commercial_invoice_date": {
        "type": "string",
        "format": "date",
        "title": "Commercial Invoice Date"
      },
      "filling_date": {
        "type": "string",
        "format": "date",
        "title": "Filling Date"
      },
      "buyer_name": {
        "type": "string",
        "title": "Name",
        "example": "Al Barakah Trading LLC"
      },
      "buyer_country": {
        "type": "string",
        "title": "Country",
        "description": "Free text until the full ISO country list / API integration is wired in.",
        "example": "United Arab Emirates"
      },
      "buyer_city": {
        "type": "string",
        "title": "City",
        "example": "Dubai"
      },
      "container_type": {
        "type": "string",
        "title": "Type of Container",
        "oneOf": [
          { "const": "40_gp", "title": "40' Gen Purpose" },
          { "const": "20_gp", "title": "20' Gen Purpose" },
          { "const": "40_hc", "title": "40' High Cube" },
          { "const": "20_reefer", "title": "20' Reefer" },
          { "const": "40_reefer", "title": "40' Reefer" },
          { "const": "40_ot", "title": "40' Open Top" },
          { "const": "20_ot", "title": "20' Open Top" },
          { "const": "20_fr", "title": "20' Flat Rack" },
          { "const": "40_fr", "title": "40' Flat Rack" },
          { "const": "air", "title": "AIR" }
        ],
        "example": "40_gp"
      },
      "nut_type": {
        "type": "string",
        "title": "Nut Type",
        "description": "Selects the fee's CDA sub service category: 00002 King Coconut, 00001 Fresh Nut.",
        "oneOf": [
          { "const": "00002", "title": "King Coconut" },
          { "const": "00001", "title": "Fresh Nut" }
        ]
      },
      "with_husk": {
        "type": "boolean",
        "title": "Nature of Coconuts — With Husk",
        "description": "Check if the coconuts are supplied with husk.",
        "default": false
      },
      "container_number": {
        "type": "string",
        "title": "Container Number",
        "description": "Use example format, e.g. TCMU 1234567.",
        "example": "TCMU1234567"
      },
      "inner_packing_type": {
        "type": "string",
        "title": "Type of Inner Packing",
        "oneOf": [
          { "const": "carton_box", "title": "Carton Box" },
          { "const": "bunch", "title": "Bunch" },
          { "const": "carton_box_and_bunch", "title": "Carton Box & Bunch" }
        ],
        "example": "carton_box"
      },
      "serial_no_from": {
        "type": "string",
        "title": "Serial No. (From)",
        "description": "Enter 1 to 3 codes in the format: AB 012345, separated by commas and a space. Example: AB 0123457 or AB 0123456, AB 0234567",
        "example": "AB 0123456"
      },
      "serial_no_to": {
        "type": "string",
        "title": "Serial No. (To)",
        "description": "Enter 1 to 3 codes in the format: AB 012345, separated by commas and a space. Example: AB 0123456 or AB 0123457, AB 0234567",
        "example": "AB 0123457"
      },
      "quantity_nuts": {
        "type": "number",
        "title": "Quantity (Number of Nuts)",
        "example": 45000
      },
      "total_net_weight": {
        "type": "number",
        "title": "Total Net Weight",
        "example": 18000
      },
      "total_fob": {
        "type": "string",
        "title": "Tot: FOB",
        "example": "USD 12,500.00"
      },
      "total_cif": {
        "type": "string",
        "title": "Tot: CIF",
        "example": "USD 13,200.00"
      },
      "location": {
        "type": "string",
        "title": "Location",
        "description": "Location address with District and DS Division.",
        "example": "8A, Mallampitiya, Madurankuliya - Puttalam - Chenaikudirippuwa"
      },
      "stuffing_date": {
        "type": "string",
        "format": "date",
        "title": "Stuffing Date"
      },
      "contact_person_at_venue": {
        "type": "string",
        "title": "Contact Person at Venue",
        "example": "K. Perera"
      },
      "tel_no": {
        "type": "string",
        "title": "Tel No",
        "pattern": "^(\\+[0-9]{11}|[0-9]{10})$",
        "description": "10 digits, or + followed by 11 digits.",
        "example": "0771234567"
      },
      "applicant_name": {
        "type": "string",
        "title": "Name of the Applicant",
        "example": "K. Perera"
      },
      "applicant_designation": {
        "type": "string",
        "title": "Designation",
        "example": "Export Manager"
      },
      "application_date": {
        "type": "string",
        "format": "date",
        "title": "Date"
      },
      "applicant_email": {
        "type": "string",
        "title": "Email Address",
        "example": "applicant@example.com"
      }
    },
    "required": [
      "email",
      "company_name",
      "cda_registration_no",
      "destination_country",
      "destination_city",
      "vessel",
      "date_of_sailing",
      "cargo_type",
      "port_of_loading",
      "port_of_discharge",
      "commercial_invoice_no",
      "commercial_invoice_date",
      "filling_date",
      "buyer_name",
      "buyer_country",
      "buyer_city",
      "container_type",
      "nut_type",
      "with_husk",
      "container_number",
      "inner_packing_type",
      "serial_no_from",
      "serial_no_to",
      "quantity_nuts",
      "total_net_weight",
      "total_fob",
      "total_cif",
      "location",
      "stuffing_date",
      "contact_person_at_venue",
      "tel_no",
      "applicant_name",
      "applicant_designation",
      "application_date",
      "applicant_email"
    ]
  },
  "uiSchema": {
    "type": "Categorization",
    "options": {
      "variant": "stepper"
    },
    "elements": [
      {
        "type": "Category",
        "label": "Exporter",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/import_application_xml"
          },
          {
            "type": "Control",
            "scope": "#/properties/export_application_xml"
          },
          {
            "type": "Control",
            "scope": "#/properties/email"
          },
          {
            "type": "Control",
            "scope": "#/properties/company_name"
          },
          {
            "type": "Control",
            "scope": "#/properties/cda_registration_no"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Shipment",
        "elements": [
          {
            "type": "Group",
            "label": "Destination",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/destination_country"
              },
              {
                "type": "Control",
                "scope": "#/properties/destination_city"
              }
            ]
          },
          {
            "type": "Control",
            "scope": "#/properties/vessel"
          },
          {
            "type": "Control",
            "scope": "#/properties/date_of_sailing"
          },
          {
            "type": "Control",
            "scope": "#/properties/cargo_type"
          },
          {
            "type": "Control",
            "scope": "#/properties/port_of_loading"
          },
          {
            "type": "Control",
            "scope": "#/properties/port_of_discharge"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Invoice and Buyer",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/commercial_invoice_no"
          },
          {
            "type": "Control",
            "scope": "#/properties/commercial_invoice_date"
          },
          {
            "type": "Control",
            "scope": "#/properties/filling_date"
          },
          {
            "type": "Group",
            "label": "Buyer",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/buyer_name"
              },
              {
                "type": "Control",
                "scope": "#/properties/buyer_country"
              },
              {
                "type": "Control",
                "scope": "#/properties/buyer_city"
              }
            ]
          }
        ]
      },
      {
        "type": "Category",
        "label": "Container",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/container_type"
          },
          {
            "type": "Control",
            "scope": "#/properties/container_number"
          },
          {
            "type": "Control",
            "scope": "#/properties/inner_packing_type"
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/serial_no_from"
              },
              {
                "type": "Control",
                "scope": "#/properties/serial_no_to"
              }
            ]
          }
        ]
      },
      {
        "type": "Category",
        "label": "Nuts and Value",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/nut_type"
          },
          {
            "type": "Control",
            "scope": "#/properties/with_husk"
          },
          {
            "type": "Control",
            "scope": "#/properties/quantity_nuts"
          },
          {
            "type": "Control",
            "scope": "#/properties/total_net_weight"
          },
          {
            "type": "Control",
            "scope": "#/properties/total_fob"
          },
          {
            "type": "Control",
            "scope": "#/properties/total_cif"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Inspection Venue",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/location"
          },
          {
            "type": "Control",
            "scope": "#/properties/stuffing_date"
          },
          {
            "type": "Control",
            "scope": "#/properties/contact_person_at_venue"
          },
          {
            "type": "Control",
            "scope": "#/properties/tel_no"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Applicant",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/applicant_name"
          },
          {
            "type": "Control",
            "scope": "#/properties/applicant_designation"
          },
          {
            "type": "Control",
            "scope": "#/properties/application_date"
          },
          {
            "type": "Control",
            "scope": "#/properties/applicant_email"
          }
        ]
      }
    ]
  }
}