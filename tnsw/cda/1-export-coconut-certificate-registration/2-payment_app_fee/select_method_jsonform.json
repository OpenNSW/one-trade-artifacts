{
  "id": "cda-pay-app-fee--select-method-form",
  "title": "Select Payment Gateway",
  "schema": {
    "type": "object",
    "required": [
      "selected_method"
    ],
    "properties": {
      "selected_method": {
        "type": "string",
        "title": "Payment Method",
        "default": "govpay",
        "oneOf": [
          {
            "const": "govpay",
            "title": "GovPay (Bank/ATM/Online) [Offline Instructions]"
          }
        ]
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Label",
        "text": "The certificate charge is LKR 1814.25 for the Salmonella fee and the Physical Quality Certification. Select the payment method. The next screen shows the payment reference and how to pay."
      },
      {
        "type": "Control",
        "scope": "#/properties/selected_method"
      }
    ]
  }
}