{
  "id": "cda-lot-adjustment-flow",
  "name": "Application for Alteration of Bag Details",
  "version": 3,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "trader_request",
      "type": "TASK",
      "task_template_id": "cda-lot-adjustment-trader--user-input",
      "input_mapping": {
        "reference_number": "reference_number",
        "physical_certificate_id?": "physical_certificate_id",
        "physical_certificate_file?": "physical_certificate_file",
        "salmonella_certificate_id?": "salmonella_certificate_id",
        "salmonella_certificate_file?": "salmonella_certificate_file",
        "adjustment_feedback?": "adjustment_feedback",
        "exporter_details?": "adjustmentform.exporter_details",
        "reference_number?": "adjustmentform.cusdec_number"
      },
      "output_mapping": {
        "adjustment_choice": "adjustment_choice",
        "lots_to_remove?": "lots_to_remove",
        "exporter_details?": "exporter_details",
        "cusdec_number?": "cusdec_number",
        "number_of_bags_not_shipped?": "number_of_bags_not_shipped",
        "cusdec_document?": "cusdec_document"
      }
    },
    {
      "id": "choice_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "officer_review",
      "type": "TASK",
      "task_template_id": "cda-lot-adjustment-officer--review",
      "input_mapping": {
        "reference_number": "submission.reference_number",
        "adjustment_choice": "submission.adjustment_choice",
        "exporter_details": "submission.exporter_details",
        "cusdec_number": "submission.cusdec_number",
        "number_of_bags_not_shipped": "submission.number_of_bags_not_shipped",
        "cusdec_document": "submission.cusdec_document",
        "lots_to_remove": "submission.lots_to_remove",
        "cert_type?": "submission.cert_type",
        "agency_token?": "replyToken"
      },
      "output_mapping": {
        "adjustment_outcome": "adjustment_outcome",
        "new_physical_certificate_file?": "physical_certificate_file",
        "new_salmonella_certificate_file?": "salmonella_certificate_file",
        "adjustment_feedback?": "adjustment_feedback",
        "callbackToken?": "agency_token"
      }
    },
    {
      "id": "review_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "trader_request"
    },
    {
      "id": "e2",
      "source_id": "trader_request",
      "target_id": "choice_gateway"
    },
    {
      "id": "e_complete",
      "source_id": "choice_gateway",
      "target_id": "end",
      "condition": "adjustment_choice == 'complete_application'"
    },
    {
      "id": "e_adjust",
      "source_id": "choice_gateway",
      "target_id": "officer_review",
      "condition": "adjustment_choice == 'request_lot_adjustment'"
    },
    {
      "id": "e3",
      "source_id": "officer_review",
      "target_id": "review_gateway"
    },
    {
      "id": "e_needs_info",
      "source_id": "review_gateway",
      "target_id": "trader_request",
      "condition": "adjustment_outcome == 'needs_more_info'"
    },
    {
      "id": "e_approve",
      "source_id": "review_gateway",
      "target_id": "end",
      "condition": "adjustment_outcome == 'approve'"
    }
  ]
}