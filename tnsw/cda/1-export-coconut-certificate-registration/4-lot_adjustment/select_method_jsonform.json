{
  "id": "cda-lot-adjustment--select-method-form",
  "title": "Amendment Fee",
  "schema": {
    "type": "object",
    "required": [
      "selected_method"
    ],
    "properties": {
      "selected_method": {
        "type": "string",
        "title": "Payment Method",
        "default": "govpay",
        "oneOf": [
          {
            "const": "govpay",
            "title": "GovPay (Bank/ATM/Online) [Offline Instructions]"
          }
        ]
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Label",
        "text": "A certificate amendment is charged only the amendment fee of LKR 604.75. The certificate charge of LKR 1814.25 is not charged again. Select the payment method. The next screen shows the payment reference and how to pay."
      },
      {
        "type": "Control",
        "scope": "#/properties/selected_method"
      }
    ]
  }
}
