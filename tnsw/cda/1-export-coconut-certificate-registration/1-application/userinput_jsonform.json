{
  "id": "cda-apply-coconut-cert--user-form",
  "title": "CDA Export Coconut Certificate Application",
  "schema": {
    "type": "object",
    "properties": {
      "import_application_xml": {
        "type": "object",
        "title": "Import Application XML",
        "description": "Upload an application XML to fill this form automatically. Also accepts a file from Download Application XML. Files to upload still need to be attached by hand. Values can be corrected afterwards.",
        "x-xml": {
          "accept": ".xml,text/xml,application/xml",
          "maxSize": 5242880,
          "arrayPaths": [
            "CDA_COCONUT_CERT.dc_grades"
          ],
          "persistDocument": false,
          "writeTo": [
            { "from": "CDA_COCONUT_CERT.exporter_name", "to": "exporter_name", "as": "string" },
            { "from": "CDA_COCONUT_CERT.exporter_registration_number", "to": "exporter_registration_number", "as": "string" },
            { "from": "CDA_COCONUT_CERT.exporter_address", "to": "exporter_address", "as": "string" },
            { "from": "CDA_COCONUT_CERT.relates_to_previous_approval", "to": "relates_to_previous_approval", "as": "boolean" },
            { "from": "CDA_COCONUT_CERT.previous_cusdec_number", "to": "previous_cusdec_number", "as": "string" },
            { "from": "CDA_COCONUT_CERT.previous_certificate_number", "to": "previous_certificate_number", "as": "string" },
            { "from": "CDA_COCONUT_CERT.cancellation_reason", "to": "cancellation_reason", "as": "string" },
            { "from": "CDA_COCONUT_CERT.hs_code", "to": "hs_code", "as": "string" },
            { "from": "CDA_COCONUT_CERT.contact_number", "to": "contact_number", "as": "string" },
            { "from": "CDA_COCONUT_CERT.contract_number", "to": "contract_number", "as": "string" },
            { "from": "CDA_COCONUT_CERT.lot_number", "to": "lot_number", "as": "string" },
            { "from": "CDA_COCONUT_CERT.product_type", "to": "product_type", "as": "string" },
            {
              "from": "CDA_COCONUT_CERT.dc_grades", "to": "dc_grades",
              "writeTo": [
                { "from": "dc_grade", "to": "dc_grade", "as": "string" },
                { "from": "number_of_bags", "to": "number_of_bags", "as": "number" },
                { "from": "weight_of_bag", "to": "weight_of_bag", "as": "number" },
                { "from": "total_weight", "to": "total_weight", "as": "number" }
              ]
            },
            { "from": "CDA_COCONUT_CERT.date_of_containerization", "to": "date_of_containerization", "as": "date" },
            { "from": "CDA_COCONUT_CERT.vessel_name", "to": "vessel_name", "as": "string" },
            { "from": "CDA_COCONUT_CERT.container_number", "to": "container_number", "as": "string" },
            { "from": "CDA_COCONUT_CERT.date_of_sailing", "to": "date_of_sailing", "as": "date" },
            { "from": "CDA_COCONUT_CERT.port_of_discharge", "to": "port_of_discharge", "as": "string" },
            { "from": "CDA_COCONUT_CERT.final_destination", "to": "final_destination", "as": "string" },
            { "from": "CDA_COCONUT_CERT.buyer_name", "to": "buyer_name", "as": "string" },
            { "from": "CDA_COCONUT_CERT.container_filling_status", "to": "container_filling_status", "as": "string" },
            { "from": "CDA_COCONUT_CERT.balance_material_nature", "to": "balance_material_nature", "as": "string" },
            { "from": "CDA_COCONUT_CERT.cert_type", "to": "cert_type", "as": "string" }
          ]
        }
      },
      "export_application_xml": {
        "type": "object",
        "title": "Download Application XML",
        "description": "Download this application as XML, to fill it in again later through Import Application XML.",
        "x-xml-export": {
          "rootElement": "CDA_COCONUT_CERT",
          "declaration": { "standalone": "no" },
          "fileName": "cda-coconut-cert-{today(yyyyMMdd)}.xml",
          "writeTo": [
            { "from": "exporter_name", "to": "exporter_name", "as": "string" },
            { "from": "exporter_registration_number", "to": "exporter_registration_number", "as": "string" },
            { "from": "exporter_address", "to": "exporter_address", "as": "string" },
            { "from": "relates_to_previous_approval", "to": "relates_to_previous_approval", "as": "boolean" },
            { "from": "previous_cusdec_number", "to": "previous_cusdec_number", "as": "string" },
            { "from": "previous_certificate_number", "to": "previous_certificate_number", "as": "string" },
            { "from": "cancellation_reason", "to": "cancellation_reason", "as": "string" },
            { "from": "hs_code", "to": "hs_code", "as": "string" },
            { "from": "contact_number", "to": "contact_number", "as": "string" },
            { "from": "contract_number", "to": "contract_number", "as": "string" },
            { "from": "lot_number", "to": "lot_number", "as": "string" },
            { "from": "product_type", "to": "product_type", "as": "string" },
            {
              "from": "dc_grades", "to": "dc_grades",
              "writeTo": [
                { "from": "dc_grade", "to": "dc_grade", "as": "string" },
                { "from": "number_of_bags", "to": "number_of_bags", "as": "number" },
                { "from": "weight_of_bag", "to": "weight_of_bag", "as": "number" },
                { "from": "total_weight", "to": "total_weight", "as": "number" }
              ]
            },
            { "from": "date_of_containerization", "to": "date_of_containerization", "as": "date" },
            { "from": "vessel_name", "to": "vessel_name", "as": "string" },
            { "from": "container_number", "to": "container_number", "as": "string" },
            { "from": "date_of_sailing", "to": "date_of_sailing", "as": "date" },
            { "from": "port_of_discharge", "to": "port_of_discharge", "as": "string" },
            { "from": "final_destination", "to": "final_destination", "as": "string" },
            { "from": "buyer_name", "to": "buyer_name", "as": "string" },
            { "from": "container_filling_status", "to": "container_filling_status", "as": "string" },
            { "from": "balance_material_nature", "to": "balance_material_nature", "as": "string" },
            { "from": "cert_type", "to": "cert_type", "as": "string" }
          ]
        }
      },
      "exporter_name": {
        "type": "string",
        "title": "Exporter Name",
        "example": "Lanka Coconuts Ltd"
      },
      "exporter_registration_number": {
        "type": "string",
        "title": "Exporter Registration Number",
        "example": "0001"
      },
      "exporter_address": {
        "type": "string",
        "title": "Exporter Address",
        "example": "123 Galle Road, Colombo 03"
      },
      "cusdec_number": {
        "type": "string",
        "title": "CUSDEC Number",
        "description": "The number Sri Lanka Customs gave the declaration when it assessed it.",
        "readOnly": true,
        "example": "CBEX1/2026/E/48428"
      },
      "relates_to_previous_approval": {
        "type": "boolean",
        "title": "This application relates to a previously approved consignment",
        "description": "Tick if some or all lots were covered by a previous CDA certificate (for example the original CusDec was cancelled). CDA will use the previous CusDec and certificate numbers to reset master lot records. The new quantity may be less than, the same as, or more than the previous certificate; the officer decides whether testing is required or certificates can be reissued.",
        "default": false
      },
      "previous_cusdec_number": {
        "type": "string",
        "title": "Previous CusDec Number",
        "example": "CUSDEC-2026-804100"
      },
      "previous_certificate_number": {
        "type": "string",
        "title": "Previous Salmonella/Physical Quality Certificate Number",
        "example": "CERT-CDA-2026-08492"
      },
      "cancellation_reason": {
        "type": "string",
        "title": "Reason for Cancellation",
        "example": "Buyer cancelled the order; original CusDec was cancelled."
      },
      "hs_code": {
        "type": "string",
        "title": "HS CODE",
        "example": "08011200"
      },
      "contact_number": {
        "type": "string",
        "title": "Contact Number",
        "pattern": "^(\\+[0-9]{11}|[0-9]{10})$",
        "description": "10 digits, or + followed by 11 digits.",
        "example": "0771234567"
      },
      "contract_number": {
        "type": "string",
        "title": "Contract Number",
        "example": "CN-2026-0412"
      },
      "lot_number": {
        "type": "string",
        "title": "Lot Number",
        "example": "LOT-A321"
      },
      "product_type": {
        "type": "string",
        "title": "Product Type",
        "oneOf": [
          {
            "const": "dc",
            "title": "DC"
          },
          {
            "const": "value_added_dc",
            "title": "Value Added DC / Low Fat DC"
          },
          {
            "const": "both",
            "title": "DC and Value Added DC / Low Fat DC"
          }
        ]
      },
      "dc_grades": {
        "type": "array",
        "title": "DC Grade & Packaging Details",
        "items": {
          "type": "object",
          "properties": {
            "dc_grade": {
              "type": "string",
              "title": "DC Grade",
              "oneOf": [
                {
                  "const": "FINE",
                  "title": "FINE"
                },
                {
                  "const": "MEDIUM",
                  "title": "MEDIUM"
                },
                {
                  "const": "CHIPS",
                  "title": "CHIPS"
                },
                {
                  "const": "VADC",
                  "title": "VADC"
                },
                {
                  "const": "M_MEDIUM",
                  "title": "M/MEDIUM"
                },
                {
                  "const": "SHRED",
                  "title": "SHRED"
                },
                {
                  "const": "SPECIAL_MACAROON",
                  "title": "SPECIAL MACAROON"
                },
                {
                  "const": "THREAD",
                  "title": "THREAD"
                },
                {
                  "const": "LOW_FAT",
                  "title": "LOW FAT"
                },
                {
                  "const": "COARSE",
                  "title": "COARSE"
                },
                {
                  "const": "FLAKES",
                  "title": "FLAKES"
                }
              ]
            },
            "number_of_bags": {
              "type": "integer",
              "title": "Number of Bags",
              "minimum": 1,
              "example": 500
            },
            "weight_of_bag": {
              "type": "number",
              "title": "Weight of a Bag (kg)",
              "exclusiveMinimum": 0,
              "example": 25
            },
            "total_weight": {
              "type": "number",
              "title": "Total Weight (kg)",
              "exclusiveMinimum": 0,
              "example": 12500
            }
          },
          "required": [
            "dc_grade",
            "number_of_bags",
            "weight_of_bag",
            "total_weight"
          ]
        }
      },
      "date_of_containerization": {
        "type": "string",
        "format": "date",
        "title": "Date of Containerization",
        "formatMaximum": {
          "$data": "1/date_of_sailing"
        },
        "example": "2026-06-10"
      },
      "vessel_name": {
        "type": "string",
        "title": "Name of the Vessel",
        "example": "OCEAN GLORY V109"
      },
      "container_number": {
        "type": "string",
        "title": "Container Number",
        "example": "MSCU-908241-5"
      },
      "date_of_sailing": {
        "type": "string",
        "format": "date",
        "title": "Date of Sailing",
        "example": "2026-06-12"
      },
      "port_of_discharge": {
        "type": "string",
        "title": "Port of Discharge",
        "pattern": "^[A-Za-z][A-Za-z .,'-]*$",
        "description": "Letters, spaces and . , ' - only.",
        "example": "Port of Rotterdam"
      },
      "final_destination": {
        "type": "string",
        "title": "Final Destination",
        "pattern": "^[A-Za-z][A-Za-z .,'-]*$",
        "description": "Letters, spaces and . , ' - only.",
        "example": "Rotterdam, Netherlands"
      },
      "buyer_name": {
        "type": "string",
        "title": "Name of the Buyer",
        "example": "European Food Distributors BV"
      },
      "container_filling_status": {
        "type": "string",
        "title": "Container Filling Status",
        "oneOf": [
          {
            "const": "full",
            "title": "Full"
          },
          {
            "const": "part",
            "title": "Part"
          }
        ]
      },
      "balance_material_nature": {
        "type": "string",
        "title": "If Part, Declare Nature of Balance Material",
        "example": "Remaining capacity filled with standard pallet packaging materials."
      },
      "cert_type": {
        "type": "string",
        "title": "Certificates Required",
        "oneOf": [
          {
            "const": "P",
            "title": "Physical Quality Certificate"
          },
          {
            "const": "S",
            "title": "Salmonella Free Certificate"
          },
          {
            "const": "PS",
            "title": "Both Physical Quality and Salmonella Free Certificates"
          }
        ]
      },
      "uploaded_dc_bags_details": {
        "type": "string",
        "format": "file",
        "title": "Upload Completed DC Bags Details File (Excel)",
        "description": "Check below to download the template, then upload the completed Excel sheet (.xlsx) here.",
        "x-file": {
          "accept": ".xlsx",
          "fileName": "DC BAGS DETAILS _{index}"
        }
      }
    },
    "required": [
      "exporter_name",
      "exporter_registration_number",
      "exporter_address",
      "cusdec_number",
      "relates_to_previous_approval",
      "product_type",
      "dc_grades",
      "port_of_discharge",
      "final_destination",
      "container_filling_status",
      "cert_type",
      "uploaded_dc_bags_details"
    ],
    "if": {
      "properties": {
        "relates_to_previous_approval": {
          "const": true
        }
      },
      "required": [
        "relates_to_previous_approval"
      ]
    },
    "then": {
      "required": [
        "previous_cusdec_number",
        "previous_certificate_number",
        "cancellation_reason"
      ]
    }
  },
  "uiSchema": {
    "type": "Categorization",
    "options": {
      "variant": "stepper"
    },
    "elements": [
      {
        "type": "Category",
        "label": "Exporter and Consignment",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/import_application_xml"
          },
          {
            "type": "Control",
            "scope": "#/properties/export_application_xml"
          },
          {
            "type": "Control",
            "scope": "#/properties/exporter_name"
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/exporter_registration_number"
              },
              {
                "type": "Control",
                "scope": "#/properties/exporter_address"
              }
            ]
          },
          {
            "type": "Control",
            "scope": "#/properties/cusdec_number"
          },
          {
            "type": "Control",
            "scope": "#/properties/hs_code"
          },
          {
            "type": "Control",
            "scope": "#/properties/contact_number"
          },
          {
            "type": "Control",
            "scope": "#/properties/contract_number"
          },
          {
            "type": "Control",
            "scope": "#/properties/lot_number"
          },
          {
            "type": "Control",
            "scope": "#/properties/relates_to_previous_approval"
          },
          {
            "type": "Control",
            "scope": "#/properties/previous_cusdec_number",
            "rule": {
              "effect": "SHOW",
              "condition": {
                "scope": "#/properties/relates_to_previous_approval",
                "schema": {
                  "const": true
                }
              }
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/previous_certificate_number",
            "rule": {
              "effect": "SHOW",
              "condition": {
                "scope": "#/properties/relates_to_previous_approval",
                "schema": {
                  "const": true
                }
              }
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/cancellation_reason",
            "rule": {
              "effect": "SHOW",
              "condition": {
                "scope": "#/properties/relates_to_previous_approval",
                "schema": {
                  "const": true
                }
              }
            }
          }
        ]
      },
      {
        "type": "Category",
        "label": "Product and DC Grades",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/product_type",
            "options": {
              "format": "radio"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/dc_grades",
            "options": {
              "detail": {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/dc_grade"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/number_of_bags"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/weight_of_bag"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/total_weight"
                  }
                ]
              },
              "display": "cards",
              "itemLabel": "DC Grade",
              "summary": "{dc_grade} · {number_of_bags} bags",
              "summaryDetail": "{total_weight} kg total · {weight_of_bag} kg per bag",
              "totals": [
                {
                  "field": "number_of_bags",
                  "label": "{sum} bags"
                },
                {
                  "field": "total_weight",
                  "label": "{sum} kg total"
                }
              ]
            }
          }
        ],
        "options": {
          "description": "Choose the product type, then add one item for each DC grade in this consignment."
        }
      },
      {
        "type": "Category",
        "label": "Shipping and Transport",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/date_of_containerization"
              },
              {
                "type": "Control",
                "scope": "#/properties/date_of_sailing"
              }
            ]
          },
          {
            "type": "Control",
            "scope": "#/properties/vessel_name"
          },
          {
            "type": "Control",
            "scope": "#/properties/container_number"
          },
          {
            "type": "Control",
            "scope": "#/properties/port_of_discharge"
          },
          {
            "type": "Control",
            "scope": "#/properties/final_destination"
          },
          {
            "type": "Control",
            "scope": "#/properties/buyer_name"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Container Filling",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/container_filling_status",
            "options": {
              "format": "radio"
            }
          },
          {
            "type": "Control",
            "scope": "#/properties/balance_material_nature",
            "rule": {
              "effect": "SHOW",
              "condition": {
                "scope": "#/properties/container_filling_status",
                "schema": {
                  "const": "part"
                }
              }
            }
          }
        ]
      },
      {
        "type": "Category",
        "label": "Certificates",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/cert_type",
            "options": {
              "format": "radio"
            }
          }
        ]
      },
      {
        "type": "Category",
        "label": "DC Bag Details",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/uploaded_dc_bags_details"
          }
        ]
      }
    ]
  }
}
