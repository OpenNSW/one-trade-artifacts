    { "id": "e_9_assessed_gw", "source_id": "sltb_9_cusdec_submission", "target_id": "sltb_9_assessed_gateway" },
    {
      "id": "e_assessed",
      "source_id": "sltb_9_assessed_gateway",
      "target_id": "customs_1_emit_cusdec",
      "condition": "customs.cusdec_review_outcome == 'approve'"
