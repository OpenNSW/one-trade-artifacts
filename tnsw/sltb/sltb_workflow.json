    {
      "id": "end_success",
      "type": "END",
      "name": "Consignment Cleared by Customs",
      "end": { "outcome": "success" }
    },
    {
      "id": "end_rejected",
      "type": "END",
      "name": "Application Rejected on Review",
      "end": {
        "outcome": "rejected",
        "title": "Application Rejected",
        "description": "An officer rejected this application on review of the blend sheets and CusDec. This application is closed — please submit a new application."
      }
    },
    {
      "id": "end_tasting_rejected",
      "type": "END",
      "name": "Application Rejected on Tasting",
      "end": {
        "outcome": "rejected",
        "title": "Application Rejected",
        "description": "The tea sample did not pass tasting, and the application was rejected. This application is closed."
      }
    },
    {
      "id": "end_lab_rejected",
      "type": "END",
      "name": "Application Rejected on Lab Testing",
      "end": {
        "outcome": "rejected",
        "title": "Application Rejected",
        "description": "Every tea sample failed lab testing, and the application was rejected. This application is closed."
      }
    },
    {
      "id": "end_final_rejected",
      "type": "END",
      "name": "Application Rejected on Final Approval",
      "end": {
        "outcome": "rejected",
        "title": "Application Rejected",
        "description": "The application was rejected at final approval. This application is closed."
      }
    }
