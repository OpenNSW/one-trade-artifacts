{
  "id": "sltb-blendsheet-approval",
  "name": "SLTB Tea Blendsheet Approval & Sample Collection Flow",
  "nodes": [
    { "id": "start", "type": "START", "name": "Start" },
    {
      "id": "sltb_1_submit_blendsheet",
      "type": "TASK",
      "name": "[SLTB 1] Submit & Review Blend Sheet and CusDec",
      "task_template_id": "sltb-submit-blendsheet-flow",
      "lane": "Trader/CHA & SLTB Officer",
      "input_mapping": {},
      "output_mapping": {
        "reviewerform.review_outcome": "sltb.review_outcome",
        "reviewerform.levy_amount?": "sltb.levy_amount",
        "rejection_reason?": "sltb.rejection_reason",
        "userform": "sltb.userform",
        "userform.cusdec_draft": "sltb.cusdec"
      }
    },
    {
      "id": "sltb_1_review_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Application Approved?"
    },
    {
      "id": "sltb_2_pay_levy",
      "type": "TASK",
      "name": "[SLTB 2] Pay SLTB Levy",
      "task_template_id": "sltb-pay-levy-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "sltb.levy_amount": "levy_amount"
      },
      "output_mapping": {
        "payment.payment_status?": "sltb.levy_payment_outcome",
        "payment_review.payment_review_outcome?": "sltb.levy_payment_outcome",
        "payment.deduction_status?": "sltb.levy_payment_outcome"
      }
    },
    {
      "id": "sltb_3_tasting_decision",
      "type": "TASK",
      "name": "[SLTB 3] Officer: Tasting Decision",
      "task_template_id": "sltb-lab-decision-flow",
      "lane": "SLTB Officer",
      "input_mapping": {
        "sltb.userform": "userform"
      },
      "output_mapping": {
        "decision.tasting_required": "sltb.tasting_required",
        "decision.collection_method?": "sltb.collection_method"
      }
    },
    {
      "id": "sltb_3_tasting_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Tasting Required?"
    },
    {
      "id": "sltb_4_collection_split",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Split on Collection Method"
    },
    {
      "id": "sltb_4a_dropoff",
      "type": "TASK",
      "name": "[SLTB 4A] Sample Drop-off at SLTB",
      "task_template_id": "sltb-dropoff-flow",
      "lane": "Trader/CHA & SLTB Officer",
      "input_mapping": {},
      "output_mapping": {
        "sample_number": "sltb.sample_number"
      }
    },
    {
      "id": "sltb_4b_schedule_pickup",
      "type": "TASK",
      "name": "[SLTB 4B] Schedule Sample Draw at Warehouse",
      "task_template_id": "sltb-schedule-pickup-flow",
      "lane": "Trader/CHA & SLTB Officer",
      "input_mapping": {},
      "output_mapping": {
        "schedule.visit_date": "sltb.schedule.visit_date",
        "schedule.visit_time": "sltb.schedule.visit_time",
        "schedule.inspector_name?": "sltb.schedule.inspector_name",
        "schedule.contact_number?": "sltb.schedule.contact_number"
      }
    },
    {
      "id": "sltb_4c_record_sample_draw",
      "type": "TASK",
      "name": "[SLTB 4C] Officer Records Sample Draw",
      "task_template_id": "sltb-record-sample-draw-flow",
      "lane": "SLTB Officer",
      "input_mapping": {
        "sltb.schedule.visit_date": "schedule.visit_date",
        "sltb.schedule.visit_time": "schedule.visit_time",
        "sltb.schedule.inspector_name?": "schedule.inspector_name"
      },
      "output_mapping": {
        "sample_number": "sltb.sample_number"
      }
    },
    {
      "id": "sltb_4_collection_join",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_JOIN",
      "name": "Join Collection Method"
    },
    {
      "id": "sltb_5_tasting_result",
      "type": "TASK",
      "name": "[SLTB 5] Officer: Tasting Result",
      "task_template_id": "sltb-tasting-result-flow",
      "lane": "SLTB Officer",
      "input_mapping": {
        "sltb.userform": "userform",
        "sltb.sample_number": "sample_number"
      },
      "output_mapping": {
        "tasting.tasting_outcome": "sltb.tasting_outcome",
        "tasting.tasting_notes?": "sltb.tasting_notes"
      }
    },
    {
      "id": "sltb_5_tasting_result_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Tasting Outcome?"
    },
    {
      "id": "sltb_6_lab_testing",
      "type": "TASK",
      "name": "[SLTB 6] Lab Testing & Results",
      "task_template_id": "sltb-lab-testing-flow",
      "lane": "SLTB Officer",
      "input_mapping": {
        "sltb.sample_number": "sample_number"
      },
      "output_mapping": {
        "result.lab_tests": "sltb.lab_tests",
        "result.test_result": "sltb.lab_test_result",
        "result.lab_fee_amount?": "sltb.lab_fee_amount",
        "result.test_report_file": "sltb.lab_test_report_file"
      }
    },
    {
      "id": "sltb_6_lab_result_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Lab Test Passed?"
    },
    {
      "id": "sltb_7_pay_lab_fee",
      "type": "TASK",
      "name": "[SLTB 7] Pay Lab Test Fee",
      "task_template_id": "sltb-pay-lab-fee-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "sltb.lab_fee_amount": "lab_fee_amount"
      },
      "output_mapping": {
        "payment_status": "sltb.lab_payment_outcome"
      }
    },
    {
      "id": "sltb_approval_join",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_JOIN",
      "name": "Join for Final Approval"
    },
    {
      "id": "sltb_8_final_decision",
      "type": "TASK",
      "name": "[SLTB 8] Final Application Approval",
      "task_template_id": "sltb-final-decision-flow",
      "lane": "SLTB Officer",
      "input_mapping": {
        "sltb.sample_number?": "sample_number",
        "sltb.userform": "userform"
      },
      "output_mapping": {
        "decision.final_decision_outcome": "sltb.final_decision_outcome",
        "decision.remarks?": "sltb.final_decision_remarks"
      }
    },
    {
      "id": "sltb_8_final_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Final Approval Given?"
    },
    {
      "id": "end_success",
      "type": "END",
      "name": "Blend Sheet Application Approved",
      "end": { "outcome": "success" }
    },
    {
      "id": "end_rejected",
      "type": "END",
      "name": "Application Rejected on Review",
      "end": {
        "outcome": "rejected",
        "title": "Application Rejected",
        "description": "An officer rejected this application on review of the blend sheets and CusDec. This application is closed — please submit a new application."
      }
    },
    {
      "id": "end_tasting_rejected",
      "type": "END",
      "name": "Application Rejected on Tasting",
      "end": {
        "outcome": "rejected",
        "title": "Application Rejected",
        "description": "The tea sample did not pass tasting, and the application was rejected. This application is closed."
      }
    },
    {
      "id": "end_lab_rejected",
      "type": "END",
      "name": "Application Rejected on Lab Testing",
      "end": {
        "outcome": "rejected",
        "title": "Application Rejected",
        "description": "The tea sample failed lab testing, and the application was rejected. This application is closed."
      }
    },
    {
      "id": "end_final_rejected",
      "type": "END",
      "name": "Application Rejected on Final Approval",
      "end": {
        "outcome": "rejected",
        "title": "Application Rejected",
        "description": "The application was rejected at final approval. This application is closed."
      }
    }
  ],
  "edges": [
    { "id": "e_start", "source_id": "start", "target_id": "sltb_1_submit_blendsheet" },
    { "id": "e_1_review_gw", "source_id": "sltb_1_submit_blendsheet", "target_id": "sltb_1_review_gateway" },
    {
      "id": "e_review_reject",
      "source_id": "sltb_1_review_gateway",
      "target_id": "end_rejected",
      "condition": "sltb.review_outcome == 'reject'"
    },
    {
      "id": "e_review_approve",
      "source_id": "sltb_1_review_gateway",
      "target_id": "sltb_2_pay_levy",
      "condition": "sltb.review_outcome == 'approve'"
    },
    { "id": "e_levy_tasting", "source_id": "sltb_2_pay_levy", "target_id": "sltb_3_tasting_decision" },
    { "id": "e_tasting_gw", "source_id": "sltb_3_tasting_decision", "target_id": "sltb_3_tasting_gateway" },
    {
      "id": "e_no_tasting",
      "source_id": "sltb_3_tasting_gateway",
      "target_id": "sltb_approval_join",
      "condition": "sltb.tasting_required == 'no'"
    },
    {
      "id": "e_tasting",
      "source_id": "sltb_3_tasting_gateway",
      "target_id": "sltb_4_collection_split",
      "condition": "sltb.tasting_required == 'yes'"
    },
    {
      "id": "e_split_dropoff",
      "source_id": "sltb_4_collection_split",
      "target_id": "sltb_4a_dropoff",
      "condition": "sltb.collection_method == 'dropoff'"
    },
    {
      "id": "e_split_pickup",
      "source_id": "sltb_4_collection_split",
      "target_id": "sltb_4b_schedule_pickup",
      "condition": "sltb.collection_method == 'pickup'"
    },
    { "id": "e_dropoff_join", "source_id": "sltb_4a_dropoff", "target_id": "sltb_4_collection_join" },
    { "id": "e_4b_4c", "source_id": "sltb_4b_schedule_pickup", "target_id": "sltb_4c_record_sample_draw" },
    { "id": "e_4c_join", "source_id": "sltb_4c_record_sample_draw", "target_id": "sltb_4_collection_join" },
    { "id": "e_join_tasting_result", "source_id": "sltb_4_collection_join", "target_id": "sltb_5_tasting_result" },
    { "id": "e_tasting_result_gw", "source_id": "sltb_5_tasting_result", "target_id": "sltb_5_tasting_result_gateway" },
    {
      "id": "e_tasting_approve",
      "source_id": "sltb_5_tasting_result_gateway",
      "target_id": "sltb_approval_join",
      "condition": "sltb.tasting_outcome == 'approve'"
    },
    {
      "id": "e_tasting_lab",
      "source_id": "sltb_5_tasting_result_gateway",
      "target_id": "sltb_6_lab_testing",
      "condition": "sltb.tasting_outcome == 'send_to_lab'"
    },
    {
      "id": "e_tasting_reject",
      "source_id": "sltb_5_tasting_result_gateway",
      "target_id": "end_tasting_rejected",
      "condition": "sltb.tasting_outcome == 'reject'"
    },
    { "id": "e_lab_result_gw", "source_id": "sltb_6_lab_testing", "target_id": "sltb_6_lab_result_gateway" },
    {
      "id": "e_lab_pass",
      "source_id": "sltb_6_lab_result_gateway",
      "target_id": "sltb_approval_join",
      "condition": "sltb.lab_test_result == 'pass'"
    },
    {
      "id": "e_lab_fail",
      "source_id": "sltb_6_lab_result_gateway",
      "target_id": "sltb_7_pay_lab_fee",
      "condition": "sltb.lab_test_result == 'fail'"
    },
    { "id": "e_lab_fee_rejected", "source_id": "sltb_7_pay_lab_fee", "target_id": "end_lab_rejected" },
    { "id": "e_join_final", "source_id": "sltb_approval_join", "target_id": "sltb_8_final_decision" },
    { "id": "e_final_gw", "source_id": "sltb_8_final_decision", "target_id": "sltb_8_final_gateway" },
    {
      "id": "e_final_approve",
      "source_id": "sltb_8_final_gateway",
      "target_id": "end_success",
      "condition": "sltb.final_decision_outcome == 'approve'"
    },
    {
      "id": "e_final_reject",
      "source_id": "sltb_8_final_gateway",
      "target_id": "end_final_rejected",
      "condition": "sltb.final_decision_outcome == 'reject'"
    }
  ]
}
