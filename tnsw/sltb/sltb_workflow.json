      "output_mapping": {
        "payment_status": "sltb.lab_payment_outcome"
      }
    },
    {
      "id": "sltb_7_lab_fee_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Any Lab Sample Passed?"
