    { "id": "e_2_to_join", "source_id": "customs_2_wait_payment", "target_id": "customs_payment_join" },
    { "id": "e_join_to_3", "source_id": "customs_payment_join", "target_id": "customs_3_wait_warranting" },
    { "id": "e_3_to_4a", "source_id": "customs_3_wait_warranting", "target_id": "customs_4a_prepare_cdn_items" },
    { "id": "e_4a_to_4", "source_id": "customs_4a_prepare_cdn_items", "target_id": "customs_4_create_cdn" },
    { "id": "e_4_to_4b", "source_id": "customs_4_create_cdn", "target_id": "customs_4b_collect_cdn_results" },
    { "id": "e_4b_to_fork", "source_id": "customs_4b_collect_cdn_results", "target_id": "customs_post_cdn_fork" },
