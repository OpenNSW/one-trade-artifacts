    },
    {
      "id": "customs_payment_join",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_JOIN",
      "name": "Paid or Nothing Due"
    },
    {
      "id": "customs_3_wait_warranting",
      "type": "TASK",
      "name": "[Customs 3.0] Wait on CusDec Warranting",
