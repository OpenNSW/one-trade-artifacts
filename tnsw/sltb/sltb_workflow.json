        "reviewerform.rejection_reason?": "sltb.customs_feedback",
        "cig.error?": "sltb.customs_error"
      }
    },
    {
      "id": "sltb_9_assessed_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Assessed by Customs?"
