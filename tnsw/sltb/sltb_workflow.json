    { "id": "e_tasting_result_gw", "source_id": "sltb_5_tasting_result", "target_id": "sltb_5_tasting_result_gateway" },
    {
      "id": "e_tasting_approve",
      "source_id": "sltb_5_tasting_result_gateway",
      "target_id": "sltb_approval_join",
      "condition": "sltb.tasting_outcome == 'approve'"
    },
    {
      "id": "e_tasting_lab",
      "source_id": "sltb_5_tasting_result_gateway",
      "target_id": "sltb_6_lab_testing",
      "condition": "sltb.tasting_outcome == 'send_to_lab'"
    },
    {
      "id": "e_tasting_reject",
      "source_id": "sltb_5_tasting_result_gateway",
      "target_id": "end_tasting_rejected",
      "condition": "sltb.tasting_outcome == 'reject'"
    },
    { "id": "e_lab_result_gw", "source_id": "sltb_6_lab_testing", "target_id": "sltb_6_lab_result_gateway" },
    {
      "id": "e_lab_pass",
      "source_id": "sltb_6_lab_result_gateway",
      "target_id": "sltb_approval_join",
      "condition": "sltb.lab_test_result == 'pass'"
