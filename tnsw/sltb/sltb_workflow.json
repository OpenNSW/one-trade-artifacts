      "input_mapping": {
        "sltb.userform": "userform"
      },
      "output_mapping": {
        "decision.tasting_required": "sltb.tasting_required",
        "decision.collection_method?": "sltb.collection_method"
      }
    },
    {
      "id": "sltb_3_tasting_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
