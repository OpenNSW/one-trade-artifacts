    { "id": "e_lab_fee_gw", "source_id": "sltb_7_pay_lab_fee", "target_id": "sltb_7_lab_fee_gateway" },
    {
      "id": "e_lab_fee_partial",
      "source_id": "sltb_7_lab_fee_gateway",
      "target_id": "sltb_approval_join",
      "condition": "sltb.lab_test_result == 'partial'"
    },
    {
      "id": "e_lab_fee_rejected",
      "source_id": "sltb_7_lab_fee_gateway",
      "target_id": "end_lab_rejected",
      "condition": "sltb.lab_test_result == 'fail'"
    },
    { "id": "e_join_final", "source_id": "sltb_approval_join", "target_id": "sltb_8_final_decision" },
    { "id": "e_final_gw", "source_id": "sltb_8_final_decision", "target_id": "sltb_8_final_gateway" },
    {
      "id": "e_final_approve",
      "source_id": "sltb_8_final_gateway",
      "target_id": "sltb_9_cusdec_submission",
      "condition": "sltb.final_decision_outcome == 'approve'"
