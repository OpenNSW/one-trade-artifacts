      "output_mapping": {
        "cdn_userform": "customs.cdn_userform",
        "cdn_number?": "customs.cdn_number",
        "cdn_numbers": "customs.cdn_numbers",
        "containers": "customs.containers"
      }
    },
    {
      "id": "customs_post_cdn_fork",
      "type": "GATEWAY",
      "gateway_type": "PARALLEL_SPLIT",
      "name": "Boat Note and Export Release in Parallel"
