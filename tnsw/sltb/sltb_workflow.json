    {
      "id": "e_amend",
      "source_id": "sltb_9_assessed_gateway",
      "target_id": "sltb_1_submit_blendsheet",
      "condition": "customs.cusdec_review_outcome in [nil, 'needs_more_info']"
    },
    {
      "id": "e_final_reject",
      "source_id": "sltb_8_final_gateway",
      "target_id": "end_final_rejected",
      "condition": "sltb.final_decision_outcome == 'reject'"
