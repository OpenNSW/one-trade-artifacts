      "input_mapping": {
        "customs.cusdec_number?": "cusdec_ref",
        "customs.userform.traders?": "userform.traders",
        "customs.containers": "containers"
      },
      "output_mapping": {
        "boat_note_prefill.userform": "customs.boat_note_prefill"
      }
    },
    {
      "id": "customs_6_create_boat_note",
      "type": "TASK",
      "name": "[Customs 6.0] Create Boat Note",
