{
  "id": "sltb-pay-levy-flow",
  "name": "Pay SLTB Levy",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "select-method-task",
      "type": "TASK",
      "task_template_id": "sltb-pay-levy--select-method",
      "input_mapping": {},
      "output_mapping": {
        "selected_method": "payment_method.selected_method",
        "reference_number?": "payment_method.reference_number"
      }
    },
    {
      "id": "method-split",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Split on Payment Method"
    },
    {
      "id": "pay-govpay-task",
      "type": "TASK",
      "task_template_id": "sltb-pay-levy--payment",
      "input_mapping": {
        "levy_amount?": "levy_amount",
        "payment_method?": "payment_method",
        "payment_method.selected_method": "selected_method",
        "levy_amount": "amount"
      },
      "output_mapping": {
        "payment_status": "payment.payment_status",
        "payment_receipt_url?": "payment.payment_receipt_url",
        "selected_method?": "payment.selected_method"
      }
    },
    {
      "id": "govpay-result-gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "GovPay Payment Succeeded?"
    },
    {
      "id": "generate-slip-reference-task",
      "type": "TASK",
      "task_template_id": "sltb-pay-levy--generate-reference",
      "input_mapping": {},
      "output_mapping": {
        "refid.reference_number": "reference_number"
      }
    },
    {
      "id": "upload-receipt-task",
      "type": "TASK",
      "task_template_id": "sltb-pay-levy--upload-receipt",
      "input_mapping": {
        "payment_review?": "payment_review",
        "reference_number": "reference_number",
        "levy_amount": "amount",
        "payment_review.payment_feedback?": "payment_feedback"
      },
      "output_mapping": {
        "payment_slip": "payment.payment_slip",
        "reference_number?": "payment.reference_number",
        "amount?": "payment.amount"
      }
    },
    {
      "id": "review-receipt-task",
      "type": "TASK",
      "task_template_id": "sltb-pay-levy--review-receipt",
      "input_mapping": {
        "reference_number": "reference_number",
        "payment.payment_slip": "payment_slip",
        "reference_number?": "submission.reference_number",
        "payment.payment_slip?": "submission.payment_slip",
        "agency_token?": "replyToken"
      },
      "output_mapping": {
        "payment_review_outcome": "payment_review.payment_review_outcome",
        "payment_feedback?": "payment_review.payment_feedback",
        "callbackToken?": "agency_token"
      }
    },
    {
      "id": "slip-review-gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Slip Verified?"
    },
    {
      "id": "generate-office-reference-task",
      "type": "TASK",
      "task_template_id": "sltb-pay-levy--generate-reference",
      "input_mapping": {},
      "output_mapping": {
        "refid.reference_number": "reference_number"
      }
    },
    {
      "id": "confirm-office-task",
      "type": "TASK",
      "task_template_id": "sltb-pay-levy--confirm-office",
      "input_mapping": {
        "reference_number": "submission.reference_number",
        "levy_amount": "submission.amount",
        "office_agency_token?": "replyToken"
      },
      "output_mapping": {
        "receipt_status": "payment.receipt_status",
        "remarks?": "payment.office_remarks",
        "callbackToken?": "office_agency_token"
      }
    },
    {
      "id": "office-result-gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Payment Received at the Office?"
    },
    {
      "id": "notify-paid-task",
      "type": "TASK",
      "task_template_id": "sltb-pay-levy--notify-paid",
      "input_mapping": {
        "payment.office_remarks?": "payment.office_remarks"
      }
    },
    {
      "id": "join-gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_JOIN",
      "name": "Join Payment Method"
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e-start",
      "source_id": "start",
      "target_id": "select-method-task"
    },
    {
      "id": "e-to-split",
      "source_id": "select-method-task",
      "target_id": "method-split"
    },
    {
      "id": "e-govpay",
      "source_id": "method-split",
      "target_id": "pay-govpay-task",
      "condition": "payment_method.selected_method == 'govpay'"
    },
    {
      "id": "e_govpay_result",
      "source_id": "pay-govpay-task",
      "target_id": "govpay-result-gateway"
    },
    {
      "id": "e_govpay_success",
      "source_id": "govpay-result-gateway",
      "target_id": "join-gateway",
      "condition": "payment.payment_status == 'success'"
    },
    {
      "id": "e_govpay_failed",
      "source_id": "govpay-result-gateway",
      "target_id": "select-method-task",
      "condition": "payment.payment_status == 'fail'"
    },
    {
      "id": "e-slip-reference",
      "source_id": "method-split",
      "target_id": "generate-slip-reference-task",
      "condition": "payment_method.selected_method == 'payment_slip'"
    },
    {
      "id": "e-slip-upload",
      "source_id": "generate-slip-reference-task",
      "target_id": "upload-receipt-task"
    },
    {
      "id": "e-to-review",
      "source_id": "upload-receipt-task",
      "target_id": "review-receipt-task"
    },
    {
      "id": "e-to-slip-gw",
      "source_id": "review-receipt-task",
      "target_id": "slip-review-gateway"
    },
    {
      "id": "e-slip-needs-info",
      "source_id": "slip-review-gateway",
      "target_id": "upload-receipt-task",
      "condition": "payment_review.payment_review_outcome == 'needs_more_info'"
    },
    {
      "id": "e-slip-approve",
      "source_id": "slip-review-gateway",
      "target_id": "join-gateway",
      "condition": "payment_review.payment_review_outcome == 'approve'"
    },
    {
      "id": "e-office-reference",
      "source_id": "method-split",
      "target_id": "generate-office-reference-task",
      "condition": "payment_method.selected_method == 'pay_at_office'"
    },
    {
      "id": "e-office",
      "source_id": "generate-office-reference-task",
      "target_id": "confirm-office-task"
    },
    {
      "id": "e-office-result",
      "source_id": "confirm-office-task",
      "target_id": "office-result-gateway"
    },
    {
      "id": "e_office_received",
      "source_id": "office-result-gateway",
      "target_id": "join-gateway",
      "condition": "payment.receipt_status == 'received'"
    },
    {
      "id": "e_office_not_received",
      "source_id": "office-result-gateway",
      "target_id": "notify-paid-task",
      "condition": "payment.receipt_status == 'not_received'"
    },
    {
      "id": "e-join-end",
      "source_id": "join-gateway",
      "target_id": "end"
    },
    {
      "id": "e_office_paid",
      "source_id": "notify-paid-task",
      "target_id": "confirm-office-task"
    }
  ]
}
