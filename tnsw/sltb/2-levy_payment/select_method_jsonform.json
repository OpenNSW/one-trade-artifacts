{
  "id": "sltb-pay-levy--select-method-form",
  "title": "Select Levy Payment Method",
  "schema": {
    "type": "object",
    "required": [
      "selected_method"
    ],
    "properties": {
      "selected_method": {
        "type": "string",
        "title": "Payment Method",
        "default": "govpay",
        "oneOf": [
          {
            "const": "govpay",
            "title": "GovPay"
          },
          {
            "const": "payment_slip",
            "title": "Payment Slip Upload"
          },
          {
            "const": "pay_at_office",
            "title": "Pay at the SLTB Office"
          }
        ]
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Label",
        "text": "Please select your SLTB Levy payment option."
      },
      {
        "type": "Control",
        "scope": "#/properties/selected_method"
      }
    ]
  }
}
