{
  "id": "sltb-pay-levy--select-method-form",
  "title": "Select Levy Payment Method",
  "schema": {
    "type": "object",
    "required": [
      "selected_method"
    ],
    "properties": {
      "selected_method": {
        "type": "string",
        "title": "Payment Method",
        "default": "govpay",
        "oneOf": [
          {
            "const": "govpay",
            "title": "GovPay (Bank/ATM/Online Gateway)"
          },
          {
            "const": "payment_slip",
            "title": "Payment Slip Upload (Manual Payment at Counter / Bank)"
          },
          {
            "const": "pinpack",
            "title": "PinPack Pre-Funded Account Deduction"
          }
        ]
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Label",
        "text": "Please select your preferred SLTB Levy payment method. The next screen will guide you through completing or confirming the payment."
      },
      {
        "type": "Control",
        "scope": "#/properties/selected_method"
      }
    ]
  }
}
