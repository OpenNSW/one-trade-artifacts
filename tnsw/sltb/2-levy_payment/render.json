{
  "id": "sltb-pay-levy-flow:render",
  "type": "PAYMENT",
  "title": "[SLTB] Pay SLTB Levy",
  "sections": {
    "select_method": {
      "templateId": "sltb-pay-levy--select-method-form",
      "title": "Select Payment Method",
      "projector": "FORM",
      "dataKey": "payment_method",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ]
      },
      "handles": [
        {
          "command": "submit",
          "label": "Proceed to Payment",
          "element": "primary_action"
        }
      ]
    },
    "upload_slip": {
      "templateId": "sltb-pay-levy--upload-form",
      "title": "Upload Payment Receipt",
      "projector": "FORM",
      "dataKey": "payment",
      "visibleWhen": {
        "states": [
          "PENDING_SLIP_UPLOAD"
        ]
      },
      "handles": [
        {
          "command": "submit",
          "label": "Submit Payment Slip",
          "element": "primary_action"
        }
      ]
    },
    "pending_verification": {
      "templateId": "sltb-pay-levy--pending-verification-markdown",
      "title": "Payment Verification Pending",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    },
    "payment_details": {
      "templateId": "sltb-pay-levy--payment-details-markdown",
      "title": "Levy Payment Details",
      "projector": "MARKDOWN",
      "dataKey": "payment",
      "visibleWhen": {
        "states": [
          "PENDING_PAYMENT"
        ]
      }
    },
    "payment_success": {
      "templateId": "sltb-pay-levy--success-message",
      "title": "Payment Successful",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "COMPLETED"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    },
    "PENDING_SLIP_UPLOAD": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    },
    "QUEUED_EXTERNALLY": {
      "actions": []
    },
    "PENDING_PAYMENT": {
      "actions": []
    },
    "COMPLETED": {}
  }
}
