{
  "id": "sltb-lab-testing--officer-form",
  "title": "Record Lab Test Results",
  "schema": {
    "type": "object",
    "required": ["test_result", "test_date", "test_report_file"],
    "properties": {
      "sample_number": {
        "type": "string",
        "title": "Sample Number",
        "readOnly": true
      },
      "test_result": {
        "type": "string",
        "title": "Test Result",
        "oneOf": [
          { "const": "pass", "title": "Pass — Sample meets SLTB quality standards" },
          { "const": "fail", "title": "Fail — Sample does not meet SLTB quality standards" }
        ]
      },
      "lab_fee_amount": {
        "type": "number",
        "title": "Lab Test Fee for Failed Sample (LKR)",
        "exclusiveMinimum": 0,
        "example": 5000,
        "description": "Enter the lab test fee the trader must pay for the failed sample."
      },
      "test_date": {
        "type": "string",
        "format": "date",
        "title": "Date of Testing",
        "example": "2026-07-05"
      },
      "test_report_file": {
        "type": "string",
        "format": "file",
        "title": "Lab Test Report (PDF)",
        "description": "Upload the signed lab test report. The trader downloads it and submits it to the SLTB Export Division for verification."
      },
      "test_report_ref": {
        "type": "string",
        "title": "Lab Report Reference Number (Optional)",
        "example": "SLTB-LAB-2026-00412"
      },
      "test_notes": {
        "type": "string",
        "title": "Testing Notes / Comments (Optional)",
        "example": "Moisture content and grade within acceptable SLTB standards."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": { "test_result": { "const": "fail" } },
          "required": ["test_result"]
        },
        "then": { "required": ["lab_fee_amount"] }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/sample_number",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/sample_number",
            "schema": { "type": "string", "minLength": 1 }
          }
        }
      },
      { "type": "Control", "scope": "#/properties/test_result" },
      {
        "type": "Control",
        "scope": "#/properties/lab_fee_amount",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/test_result",
            "schema": { "const": "fail" }
          }
        }
      },
      { "type": "Control", "scope": "#/properties/test_date" },
      { "type": "Control", "scope": "#/properties/test_report_file" },
      { "type": "Control", "scope": "#/properties/test_report_ref" },
      {
        "type": "Control",
        "scope": "#/properties/test_notes",
        "options": { "multiLine": true }
      }
    ]
  }
}
