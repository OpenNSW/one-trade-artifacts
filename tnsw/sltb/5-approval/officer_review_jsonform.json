{
  "id": "sltb-final-decision--officer-form",
  "title": "SLTB Final Application Decision",
  "schema": {
    "type": "object",
    "required": [
      "final_decision_outcome"
    ],
    "properties": {
      "sample_number": {
        "type": "string",
        "title": "Sample Number",
        "readOnly": true
      },
      "final_decision_outcome": {
        "type": "string",
        "title": "Final Decision Outcome",
        "oneOf": [
          {
            "const": "approve",
            "title": "Approve the Blend Sheet Application"
          },
          {
            "const": "needs_more_info",
            "title": "Request Changes to the CusDec or Blend Sheets"
          },
          {
            "const": "reject",
            "title": "Reject the Blend Sheet Application"
          }
        ]
      },
      "remarks": {
        "type": "string",
        "title": "Decision Remarks / Comments",
        "description": "Required when requesting changes or rejecting. Say which fields to fix; to have failed blend sheets removed, list them here.",
        "example": "Remove blend sheet BS/2026/000124, which failed lab testing, and its CusDec item."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "final_decision_outcome": {
              "enum": [
                "needs_more_info",
                "reject"
              ]
            }
          },
          "required": [
            "final_decision_outcome"
          ]
        },
        "then": {
          "required": [
            "remarks"
          ],
          "properties": {
            "remarks": {
              "minLength": 1
            }
          }
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/sample_number",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/sample_number",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/final_decision_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/remarks",
        "options": {
          "multiLine": true
        }
      }
    ]
  }
}
