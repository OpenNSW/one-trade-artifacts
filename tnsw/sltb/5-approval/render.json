{
  "id": "sltb-final-decision-flow:render",
  "type": "APPLICATION",
  "title": "[SLTB 8] Final Application Decision",
  "files": [
    "payload.supportingDocuments.scannedDocuments[*].fileBase64",
    "userform.cusdec_draft.supportingDocuments.scannedDocuments[*].fileBase64",
    "submission.cusdec_draft.supportingDocuments.scannedDocuments[*].fileBase64",
    "submission.lab_tests[*].report_file",
    "lab_tests[*].report_file"
  ],
  "sections": {
    "changes_requested": {
      "templateId": "sltb-final-decision--changes-requested",
      "title": "Changes Requested",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ]
      }
    },
    "verify_result": {
      "templateId": "customs-cusdec--verify-result",
      "title": "CusDec Verification Result",
      "projector": "MARKDOWN",
      "dataKey": "verify",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "verify"
      }
    },
    "user_form": {
      "templateId": "sltb-submit-blendsheet--user-form",
      "title": "SLTB Tea Blend Sheet Details",
      "projector": "FORM",
      "dataKey": "userform",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ]
      },
      "handles": [
        {
          "command": "save_as_draft",
          "label": "Save as Draft",
          "element": "draft_action"
        },
        {
          "command": "verify",
          "label": "Verify CusDec",
          "element": "secondary_action"
        },
        {
          "command": "submit",
          "label": "Resubmit for Approval",
          "element": "primary_action"
        }
      ]
    },
    "trader_status": {
      "templateId": "sltb-final-decision--trader-view",
      "title": "Application Outcome",
      "projector": "MARKDOWN",
      "dataKey": "decision",
      "visibleWhen": {
        "states": [
          "COMPLETED"
        ]
      }
    },
    "status_message": {
      "templateId": "sltb-final-decision--trader-view",
      "title": "Application Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        },
        {
          "command": "verify"
        },
        {
          "command": "save_as_draft"
        }
      ]
    },
    "COMPLETED": {}
  }
}
