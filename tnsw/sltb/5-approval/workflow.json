{
  "id": "sltb-final-decision-flow",
  "name": "Final Application Decision",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "officer_decision_task",
      "type": "TASK",
      "task_template_id": "sltb-final-decision--officer-review",
      "input_mapping": {
        "userform": "submission",
        "sample_number?": "submission.sample_number",
        "lab_tests?": "submission.lab_tests",
        "lab_test_result?": "submission.lab_test_result",
        "agency_token?": "replyToken"
      },
      "output_mapping": {
        "final_decision_outcome": "decision.final_decision_outcome",
        "remarks?": "decision.remarks",
        "callbackToken?": "agency_token"
      }
    },
    {
      "id": "decision_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Changes Requested?"
    },
    {
      "id": "trader_amend",
      "type": "TASK",
      "task_template_id": "sltb-final-decision--trader-amend",
      "input_mapping": {
        "userform?": "userform",
        "decision?": "decision",
        "lab_tests?": "lab_tests",
        "verify?": "verify"
      },
      "output_mapping": {
        "__command": "command",
        "blendsheet_data?": "userform.blendsheet_data",
        "cusdec_draft?": "userform.cusdec_draft"
      }
    },
    {
      "id": "command_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Verify or Submit?"
    },
    {
      "id": "cig_verify",
      "type": "TASK",
      "task_template_id": "customs-cusdec--cig-verify",
      "input_mapping": {
        "userform?": "userform",
        "userform.cusdec_draft": "payload"
      },
      "output_mapping": {
        "verify.verified": "verify.verified",
        "verify.summary?": "verify.summary",
        "verify.total?": "verify.total"
      }
    },
    {
      "id": "generate_blendsheet_nos",
      "type": "TASK",
      "task_template_id": "sltb-submit-blendsheet--generate-blendsheet-nos",
      "input_mapping": {
        "userform.blendsheet_data": "blendsheet_data"
      },
      "output_mapping": {
        "refid.blendsheet_data": "userform.blendsheet_data"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "officer_decision_task"
    },
    {
      "id": "e2",
      "source_id": "officer_decision_task",
      "target_id": "decision_gateway"
    },
    {
      "id": "e_changes",
      "source_id": "decision_gateway",
      "target_id": "trader_amend",
      "condition": "decision.final_decision_outcome == 'needs_more_info'"
    },
    {
      "id": "e_amended",
      "source_id": "trader_amend",
      "target_id": "command_gateway"
    },
    {
      "id": "e_verify",
      "source_id": "command_gateway",
      "target_id": "cig_verify",
      "condition": "command == 'verify'"
    },
    {
      "id": "e_verified",
      "source_id": "cig_verify",
      "target_id": "trader_amend"
    },
    {
      "id": "e_submit",
      "source_id": "command_gateway",
      "target_id": "generate_blendsheet_nos",
      "condition": "command == 'submit'"
    },
    {
      "id": "e_renumbered",
      "source_id": "generate_blendsheet_nos",
      "target_id": "officer_decision_task"
    },
    {
      "id": "e_decided",
      "source_id": "decision_gateway",
      "target_id": "end",
      "condition": "decision.final_decision_outcome in ['approve', 'reject']"
    }
  ]
}
