{
  "id": "sltb-lab-decision--officer-form",
  "title": "Tasting Decision",
  "schema": {
    "type": "object",
    "required": ["tasting_required"],
    "properties": {
      "tasting_required": {
        "type": "string",
        "title": "Tasting Decision",
        "oneOf": [
          { "const": "yes", "title": "Yes — Draw a Sample for Tasting" },
          { "const": "no", "title": "No — Tasting Not Required" }
        ]
      },
      "collection_method": {
        "type": "string",
        "title": "Sample Collection Method",
        "oneOf": [
          { "const": "pickup", "title": "Warehouse Pickup (Tea Inspector visits warehouse)" },
          { "const": "dropoff", "title": "Trader Drop-off (Trader delivers sample to SLTB Export Division)" }
        ],
        "default": "pickup"
      },
      "decision_notes": {
        "type": "string",
        "title": "Decision Notes (Optional)",
        "example": "Random spot-check selected for quality verification."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": { "tasting_required": { "const": "yes" } },
          "required": ["tasting_required"]
        },
        "then": { "required": ["collection_method"] }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      { "type": "Control", "scope": "#/properties/tasting_required" },
      {
        "type": "Control",
        "scope": "#/properties/collection_method",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/tasting_required",
            "schema": { "const": "yes" }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/decision_notes",
        "options": { "multiLine": true }
      }
    ]
  }
}
