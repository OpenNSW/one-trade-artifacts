{
  "id": "sltb-cusdec-submission-flow",
  "name": "Submit the SLTB-Approved CusDec to Customs",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "cig_dispatch",
      "type": "TASK",
      "task_template_id": "customs-cusdec--cig-dispatch",
      "input_mapping": {
        "userform?": "userform",
        "userform": "payload",
        "cig.edge_id?": "previous_edge_id"
      },
      "output_mapping": {
        "cig.accepted": "cig.accepted",
        "cig.edgeId?": "cig.edge_id",
        "cig.error?": "cig.error"
      }
    },
    {
      "id": "dispatch_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Accepted by Customs?"
    },
    {
      "id": "refused_choice",
      "type": "TASK",
      "task_template_id": "sltb-cusdec-submission--refused",
      "input_mapping": {
        "cig?": "cig"
      },
      "output_mapping": {
        "__command": "refused_command"
      }
    },
    {
      "id": "refused_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Retry or Amend?"
    },
    {
      "id": "officer_review",
      "type": "TASK",
      "task_template_id": "customs-cusdec--external-review",
      "input_mapping": {
        "cig?": "cig",
        "userform?": "userform",
        "userform": "submission"
      },
      "output_mapping": {
        "review_outcome": "reviewerform.review_outcome",
        "rejection_reason?": "reviewerform.rejection_reason",
        "cusdec_number?": "reviewerform.cusdec_number",
        "amount_to_pay?": "reviewerform.amount_to_pay"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "source_id": "start",
      "target_id": "cig_dispatch"
    },
    {
      "id": "e_dispatch_check",
      "source_id": "cig_dispatch",
      "target_id": "dispatch_check"
    },
    {
      "id": "e_accepted",
      "source_id": "dispatch_check",
      "target_id": "officer_review",
      "condition": "cig.accepted == true"
    },
    {
      "id": "e_refused",
      "source_id": "dispatch_check",
      "target_id": "refused_choice",
      "condition": "cig.accepted != true"
    },
    {
      "id": "e_refused_choice",
      "source_id": "refused_choice",
      "target_id": "refused_gateway"
    },
    {
      "id": "e_retry",
      "source_id": "refused_gateway",
      "target_id": "cig_dispatch",
      "condition": "refused_command == 'retry'"
    },
    {
      "id": "e_amend",
      "source_id": "refused_gateway",
      "target_id": "end",
      "condition": "refused_command == 'amend'"
    },
    {
      "id": "e_reviewed",
      "source_id": "officer_review",
      "target_id": "end"
    }
  ]
}
