{
  "id": "sltb-schedule-pickup-flow",
  "name": "Schedule Warehouse Pickup",
  "version": 3,
  "nodes": [
    { "id": "start", "type": "START" },
    {
      "id": "trader_suggest",
      "type": "TASK",
      "name": "Suggest or Respond to Pickup Schedule",
      "task_template_id": "sltb-schedule-pickup--suggest",
      "input_mapping": {
        "schedule.schedule_outcome?": "suggest.officer_outcome"
      },
      "output_mapping": {
        "response?": "suggest.response",
        "suggested_date?": "schedule.visit_date",
        "suggested_time?": "schedule.visit_time",
        "trader_notes?": "suggest.trader_notes"
      }
    },
    {
      "id": "trader_response_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Trader Accepted the Proposed Slot?"
    },
    {
      "id": "officer_review",
      "type": "TASK",
      "name": "Review Suggested Pickup Schedule",
      "task_template_id": "sltb-schedule-pickup--officer-review",
      "input_mapping": {
        "schedule.visit_date": "suggested_date",
        "schedule.visit_time": "suggested_time",
        "suggest.trader_notes?": "trader_notes"
      },
      "output_mapping": {
        "schedule_outcome": "schedule.schedule_outcome",
        "visit_date?": "schedule.visit_date",
        "visit_time?": "schedule.visit_time",
        "inspector_name?": "schedule.inspector_name",
        "contact_number?": "schedule.contact_number",
        "feedback?": "schedule.reschedule_feedback"
      }
    },
    {
      "id": "schedule_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Officer Accepted the Suggested Slot?"
    },
    { "id": "end", "type": "END" }
  ],
  "edges": [
    { "id": "e_start", "source_id": "start", "target_id": "trader_suggest" },
    { "id": "e_suggest_to_response_gateway", "source_id": "trader_suggest", "target_id": "trader_response_gateway" },
    {
      "id": "e_trader_first_pass",
      "source_id": "trader_response_gateway",
      "target_id": "officer_review",
      "condition": "schedule.schedule_outcome != 'propose_alternative'"
    },
    {
      "id": "e_trader_accepts",
      "source_id": "trader_response_gateway",
      "target_id": "end",
      "condition": "suggest.response == 'accept'"
    },
    {
      "id": "e_trader_proposes",
      "source_id": "trader_response_gateway",
      "target_id": "officer_review"
    },
    { "id": "e_review_gateway", "source_id": "officer_review", "target_id": "schedule_gateway" },
    {
      "id": "e_officer_accepts",
      "source_id": "schedule_gateway",
      "target_id": "end",
      "condition": "schedule.schedule_outcome == 'approve'"
    },
    {
      "id": "e_officer_proposes",
      "source_id": "schedule_gateway",
      "target_id": "trader_suggest",
      "condition": "schedule.schedule_outcome == 'propose_alternative'"
    }
  ]
}
