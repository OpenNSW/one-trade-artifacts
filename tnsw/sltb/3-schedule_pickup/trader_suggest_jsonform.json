{
  "id": "sltb-schedule-pickup--suggest-form",
  "title": "Warehouse Pickup Schedule",
  "schema": {
    "type": "object",
    "properties": {
      "officer_outcome": {
        "type": "string",
        "readOnly": true
      },
      "response": {
        "type": "string",
        "title": "Your Response to the Proposed Slot",
        "description": "Accept the slot SLTB proposed above, or propose a different date and time.",
        "oneOf": [
          { "const": "propose", "title": "Propose a different date and time" },
          { "const": "accept", "title": "Accept — the proposed date and time work for us" }
        ],
        "default": "propose"
      },
      "suggested_date": {
        "type": "string",
        "format": "date",
        "title": "Suggested Pickup Date",
        "description": "Select a preferred business day for the Tea Inspector visit.",
        "example": "2026-07-02"
      },
      "suggested_time": {
        "type": "string",
        "title": "Suggested Time Range",
        "description": "Specify preferred hours (e.g. 09:00 AM - 12:00 PM).",
        "example": "09:00 AM - 12:00 PM"
      },
      "trader_notes": {
        "type": "string",
        "title": "Warehouse Details / Special Instructions",
        "description": "Provide contact person, gate numbers, or access requirements.",
        "example": "Contact: Mr. Perera, Gate 3, Loading Bay B"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "officer_outcome": { "const": "propose_alternative" }
          },
          "required": ["officer_outcome"]
        },
        "then": {
          "required": ["response"]
        }
      },
      {
        "if": {
          "properties": {
            "response": { "const": "propose" }
          },
          "required": ["response"]
        },
        "then": {
          "required": ["suggested_date", "suggested_time"]
        }
      },
      {
        "if": {
          "not": {
            "required": ["response"]
          }
        },
        "then": {
          "required": ["suggested_date", "suggested_time"]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/response",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/officer_outcome",
            "schema": { "const": "propose_alternative" },
            "failWhenUndefined": true
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/suggested_date",
        "rule": {
          "effect": "HIDE",
          "condition": {
            "scope": "#/properties/response",
            "schema": { "const": "accept" },
            "failWhenUndefined": true
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/suggested_time",
        "rule": {
          "effect": "HIDE",
          "condition": {
            "scope": "#/properties/response",
            "schema": { "const": "accept" },
            "failWhenUndefined": true
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/trader_notes",
        "options": { "multiLine": true },
        "rule": {
          "effect": "HIDE",
          "condition": {
            "scope": "#/properties/response",
            "schema": { "const": "accept" },
            "failWhenUndefined": true
          }
        }
      }
    ]
  }
}
