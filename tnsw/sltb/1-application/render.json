{
  "id": "sltb-submit-blendsheet-flow:render",
  "type": "APPLICATION",
  "title": "[SLTB 1] Submit & Review Blend Sheet and CusDec",
  "files": [
    "payload.supportingDocuments.scannedDocuments[*].fileBase64",
    "userform.cusdec_draft.supportingDocuments.scannedDocuments[*].fileBase64",
    "submission.cusdec_draft.supportingDocuments.scannedDocuments[*].fileBase64"
  ],
  "sections": {
    "status_message": {
      "templateId": "sltb-submit-blendsheet--status-message",
      "title": "Submission & Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER",
          "COMPLETED"
        ]
      }
    },
    "status_awaiting": {
      "templateId": "sltb-submit-blendsheet--status-awaiting",
      "title": "Current Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    },
    "review_history": {
      "templateId": "sltb-submit-blendsheet--previous-feedback",
      "title": "Review History",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "reviewerform"
      }
    },
    "verify_result": {
      "templateId": "customs-cusdec--verify-result",
      "title": "CusDec Verification Result",
      "projector": "MARKDOWN",
      "dataKey": "verify",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "verify"
      }
    },
    "user_form": {
      "templateId": "sltb-submit-blendsheet--user-form",
      "title": "SLTB Tea Blend Sheet Details",
      "projector": "FORM",
      "dataKey": "userform",
      "handles": [
        {
          "command": "save_as_draft",
          "label": "Save as Draft",
          "element": "draft_action"
        },
        {
          "command": "verify",
          "label": "Verify CusDec",
          "element": "secondary_action"
        },
        {
          "command": "submit",
          "label": "Submit Blend Sheet",
          "element": "primary_action"
        }
      ]
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        },
        {
          "command": "verify"
        },
        {
          "command": "save_as_draft"
        }
      ],
      "order": {
        "$ref": "#/layouts/1"
      }
    },
    "QUEUED_EXTERNALLY": {
      "order": {
        "$ref": "#/layouts/1"
      }
    }
  },
  "layouts": {
    "1": [
      "status_message",
      "status_awaiting",
      "review_history",
      "verify_result",
      "user_form"
    ]
  }
}
