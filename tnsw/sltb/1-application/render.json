{
  "id": "sltb-submit-blendsheet-flow:render",
  "type": "APPLICATION",
  "title": "[SLTB] Submit & Review Blend Sheet",
  "sections": {
    "status_message": {
      "templateId": "sltb-submit-blendsheet--status-message",
      "title": "Submission & Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER",
          "COMPLETED"
        ]
      }
    },
    "status_awaiting": {
      "templateId": "sltb-submit-blendsheet--status-awaiting",
      "title": "Current Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    },
    "reference_ids": {
      "templateId": "sltb-submit-blendsheet--refids",
      "title": "Reference IDs",
      "projector": "MARKDOWN",
      "dataKey": "refid",
      "visibleWhen": {
        "states": ["QUEUED_EXTERNALLY", "COMPLETED"],
        "requireDataKey": "refid"
      }
    },
    "review_history": {
      "templateId": "sltb-submit-blendsheet--previous-feedback",
      "title": "Review History",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "reviewerform"
      }
    },
    "user_form": {
      "templateId": "sltb-submit-blendsheet--user-form",
      "title": "SLTB Tea Blend Sheet Details",
      "projector": "FORM",
      "dataKey": "userform",
      "handles": [
        {
          "command": "save_as_draft",
          "label": "Save as Draft",
          "element": "secondary_action"
        },
        {
          "command": "submit",
          "label": "Submit Blend Sheet",
          "element": "primary_action"
        }
      ]
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        },
        {
          "command": "save_as_draft"
        }
      ]
    },
    "QUEUED_EXTERNALLY":{
      "order": { "$ref": "#/layouts/1" }
    }
  }
  ,
  "layouts": {
    "1": ["status_message", "status_awaiting", "reference_ids", "review_history", "user_form"]
     
    
  }
}
