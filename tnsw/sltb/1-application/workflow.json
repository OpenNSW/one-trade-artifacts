{
  "id": "sltb-submit-blendsheet-flow",
  "name": "Submit and Review Blend Sheet",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "applicant_submission",
      "type": "TASK",
      "task_template_id": "sltb-submit-blendsheet--user-input",
      "input_mapping": {
        "reviewerform?": "reviewerform",
        "rejection_reason?": "rejection_reason",
        "userform?": "userform"
      },
      "output_mapping": {
        "blendsheet_data": "userform.blendsheet_data",
        "cusdec_draft": "userform.cusdec_draft"
      }
    },
    {
      "id": "generate_blendsheet_nos",
      "type": "TASK",
      "task_template_id": "sltb-submit-blendsheet--generate-blendsheet-nos",
      "input_mapping": {
        "userform.blendsheet_data": "blendsheet_data"
      },
      "output_mapping": {
        "refid.blendsheet_data": "userform.blendsheet_data"
      }
    },
    {
      "id": "officer_review",
      "type": "TASK",
      "task_template_id": "sltb-submit-blendsheet--officer-review",
      "input_mapping": {
        "reviewerform?": "reviewerform",
        "rejection_reason?": "rejection_reason",
        "userform?": "userform",
        "userform": "submission",
        "agency_token?": "replyToken"
      },
      "output_mapping": {
        "review_outcome": "reviewerform.review_outcome",
        "feedback?": "rejection_reason",
        "levy_amount?": "reviewerform.levy_amount",
        "collection_method?": "reviewerform.collection_method",
        "callbackToken?": "agency_token"
      }
    },
    {
      "id": "review_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "applicant_submission"
    },
    {
      "id": "e2",
      "source_id": "applicant_submission",
      "target_id": "generate_blendsheet_nos"
    },
    {
      "id": "e_numbered",
      "source_id": "generate_blendsheet_nos",
      "target_id": "officer_review"
    },
    {
      "id": "e3",
      "source_id": "officer_review",
      "target_id": "review_gateway"
    },
    {
      "id": "e_needs_info",
      "source_id": "review_gateway",
      "target_id": "applicant_submission",
      "condition": "reviewerform.review_outcome == 'needs_more_info'"
    },
    {
      "id": "e_approve",
      "source_id": "review_gateway",
      "target_id": "end",
      "condition": "reviewerform.review_outcome == 'approve'"
    },
    {
      "id": "e_reject",
      "source_id": "review_gateway",
      "target_id": "end",
      "condition": "reviewerform.review_outcome == 'reject'"
    }
  ]
}
