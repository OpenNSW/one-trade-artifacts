{
  "id": "fcau-lab-testing--officer-form",
  "title": "Submit Test Outcome",
  "schema": {
    "type": "object",
    "title": "SUBMIT TEST OUTCOME",
    "properties": {
      "items": {
        "type": "array",
        "title": "Laboratory Test Result (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "description_of_food": {
              "type": "string",
              "title": "Description of consignment and quantity"
            },
            "lab_result": {
              "type": "string",
              "title": "Microbiology & Pesticide Clearance",
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                },
                {
                  "const": "refer_warehouse",
                  "title": "Refer to Warehouse Inspection"
                }
              ]
            }
          },
          "required": [
            "id",
            "lab_result"
          ]
        }
      }
    },
    "required": [
      "items"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/description_of_food",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/lab_result"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      }
    ]
  }
}
