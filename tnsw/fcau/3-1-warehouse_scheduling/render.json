{
  "id": "fcau-warehouse-scheduling-flow:render",
  "type": "APPLICATION",
  "title": "[FCAU] Warehouse Inspection Scheduling",
  "read": {
    "roles": [
      "trader",
      "cha"
    ]
  },
  "sections": {
    "instructions": {
      "templateId": "fcau-warehouse-scheduling--instructions",
      "title": "Scheduling Instructions",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ]
      }
    },
    "user_input": {
      "id": "workspace",
      "templateId": "fcau-warehouse-scheduling--form",
      "projector": "FORM",
      "dataKey": "traderinput",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ]
      },
      "handles": [
        {
          "command": "submit",
          "label": "Schedule Inspection",
          "element": "primary_action"
        }
      ]
    },
    "trader_review": {
      "id": "workspace_review",
      "templateId": "fcau-warehouse-scheduling--trader-review-form",
      "title": "Review Officer Proposed Date",
      "projector": "FORM",
      "dataKey": "trader_scheduling_review",
      "visibleWhen": {
        "states": [
          "PENDING_TRADER_DATE_REVIEW"
        ],
        "requireDataKey": "officer_review"
      },
      "handles": [
        {
          "command": "submit",
          "label": "Submit Response",
          "element": "primary_action"
        }
      ]
    },
    "pending_officer": {
      "templateId": "fcau-warehouse-scheduling--pending-officer-markdown",
      "title": "Inspection Scheduling Pending Review",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    },
    "confirmed": {
      "templateId": "fcau-warehouse-scheduling--confirmed-markdown",
      "title": "Inspection Date Confirmed",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "COMPLETED"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    },
    "PENDING_TRADER_DATE_REVIEW": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    },
    "QUEUED_EXTERNALLY": {
      "actions": []
    }
  }
}
