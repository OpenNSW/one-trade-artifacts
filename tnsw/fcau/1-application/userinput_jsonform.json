{
  "id": "fcau-apply-health-cert--user-form",
  "title": "FCAU Health Certificate Application",
  "schema": {
    "type": "object",
    "properties": {
      "import_application_xml": {
        "type": "object",
        "title": "Import Application XML",
        "description": "Upload an application XML to fill this form automatically. Also accepts a file from Download Application XML. Files to upload still need to be attached by hand. Values can be corrected afterwards.",
        "x-xml": {
          "accept": ".xml,text/xml,application/xml",
          "maxSize": 5242880,
          "arrayPaths": [
            "FCAU_HEALTH_CERT.commodities"
          ],
          "persistDocument": false,
          "writeTo": [
            { "from": "FCAU_HEALTH_CERT.exporter_name", "to": "exporter_name", "as": "string" },
            { "from": "FCAU_HEALTH_CERT.exporter_address", "to": "exporter_address", "as": "string" },
            { "from": "FCAU_HEALTH_CERT.consignee_name", "to": "consignee_name", "as": "string" },
            { "from": "FCAU_HEALTH_CERT.consignee_address", "to": "consignee_address", "as": "string" },
            {
              "from": "FCAU_HEALTH_CERT.commodities", "to": "commodities",
              "writeTo": [
                { "from": "id", "to": "id", "as": "string" },
                { "from": "description_of_food", "to": "description_of_food", "as": "string" },
                { "from": "consignment_storage_address", "to": "consignment_storage_address", "as": "string" },
                { "from": "package_batch_weight_details", "to": "package_batch_weight_details", "as": "string" },
                { "from": "ingredients_details", "to": "ingredients_details", "as": "string" },
                { "from": "in_house_quality_monitoring", "to": "in_house_quality_monitoring", "as": "string" }
              ]
            },
            { "from": "FCAU_HEALTH_CERT.intended_export_date", "to": "intended_export_date", "as": "date" },
            { "from": "FCAU_HEALTH_CERT.lc_number", "to": "lc_number", "as": "string" },
            { "from": "FCAU_HEALTH_CERT.container_numbers", "to": "container_numbers", "as": "string" },
            { "from": "FCAU_HEALTH_CERT.vessel_name", "to": "vessel_name", "as": "string" }
          ]
        }
      },
      "export_application_xml": {
        "type": "object",
        "title": "Download Application XML",
        "description": "Download this application as XML, to fill it in again later through Import Application XML.",
        "x-xml-export": {
          "rootElement": "FCAU_HEALTH_CERT",
          "declaration": { "standalone": "no" },
          "fileName": "fcau-health-cert-{today(YYYYMMDD)}.xml",
          "writeTo": [
            { "from": "exporter_name", "to": "exporter_name", "as": "string" },
            { "from": "exporter_address", "to": "exporter_address", "as": "string" },
            { "from": "consignee_name", "to": "consignee_name", "as": "string" },
            { "from": "consignee_address", "to": "consignee_address", "as": "string" },
            {
              "from": "commodities", "to": "commodities",
              "writeTo": [
                { "from": "id", "to": "id", "as": "string" },
                { "from": "description_of_food", "to": "description_of_food", "as": "string" },
                { "from": "consignment_storage_address", "to": "consignment_storage_address", "as": "string" },
                { "from": "package_batch_weight_details", "to": "package_batch_weight_details", "as": "string" },
                { "from": "ingredients_details", "to": "ingredients_details", "as": "string" },
                { "from": "in_house_quality_monitoring", "to": "in_house_quality_monitoring", "as": "string" }
              ]
            },
            { "from": "intended_export_date", "to": "intended_export_date", "as": "date" },
            { "from": "lc_number", "to": "lc_number", "as": "string" },
            { "from": "container_numbers", "to": "container_numbers", "as": "string" },
            { "from": "vessel_name", "to": "vessel_name", "as": "string" }
          ]
        }
      },
      "exporter_name": {
        "type": "string",
        "title": "Name of Applicant",
        "example": "ACME Premium Food Exports Ltd."
      },
      "exporter_address": {
        "type": "string",
        "title": "Address of Applicant",
        "example": "No 18, Galle Road, Colombo 03, Sri Lanka"
      },
      "consignee_name": {
        "type": "string",
        "title": "Name of Consignee",
        "example": "Hamburg Fine Foods Import GMBH"
      },
      "consignee_address": {
        "type": "string",
        "title": "Address of Consignee",
        "example": "Industriestrasse 104, 20457 Hamburg, Germany"
      },
      "commodities": {
        "type": "array",
        "title": "Consignment Items",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID",
              "description": "Generated for you as each item is added.",
              "example": "item-1",
              "x-template": {
                "template": "item-{seq(1)}"
              }
            },
            "description_of_food": {
              "type": "string",
              "title": "Description of consignment and quantity",
              "example": "Premium Organic Coconut Cream, canned (400ml) - 500 Cartons, 5400 kg Total Net Weight"
            },
            "consignment_storage_address": {
              "type": "string",
              "title": "Address where consignment is stored",
              "example": "ACME Cold Storage, Sector 4, Export Zone, Biyagama"
            },
            "package_batch_weight_details": {
              "type": "string",
              "title": "Type of Package, Batch Codes and Total weight",
              "example": "Cans in Corrugated Cartons, Batch CC-2026-94, Total Net Weight 5400 kg"
            },
            "ingredients_details": {
              "type": "string",
              "title": "Details of ingredients used in product",
              "example": "Organic Coconut Extract (99.8%), Xanthan Gum (0.2%)"
            },
            "in_house_quality_monitoring": {
              "type": "string",
              "title": "Details of in-house quality monitoring",
              "example": "Daily microbiological sampling, temperature control monitoring, and HACCP CCP verification logs."
            },
            "analysis_certificates": {
              "type": "string",
              "format": "file",
              "title": "Raw Materials & Product Analysis Certificates",
              "x-file": { "accept": ".pdf,.jpg,.jpeg,.jfif,.png,.gif,.webp" }
            },
            "other_declarations": {
              "type": "string",
              "format": "file",
              "title": "Any other Declarations",
              "x-file": { "accept": ".pdf,.jpg,.jpeg,.jfif,.png,.gif,.webp" }
            }
          },
          "required": [
            "id",
            "description_of_food",
            "consignment_storage_address",
            "package_batch_weight_details",
            "ingredients_details",
            "in_house_quality_monitoring",
            "analysis_certificates"
          ]
        },
        "example": [
          {
            "id": "item-1",
            "description_of_food": "Premium Organic Coconut Cream, canned (400ml) - 500 Cartons, 5400 kg Total Net Weight",
            "consignment_storage_address": "ACME Cold Storage, Sector 4, Export Zone, Biyagama",
            "package_batch_weight_details": "Cans in Corrugated Cartons, Batch CC-2026-94, Total Net Weight 5400 kg",
            "ingredients_details": "Organic Coconut Extract (99.8%), Xanthan Gum (0.2%)",
            "in_house_quality_monitoring": "Daily microbiological sampling, temperature control monitoring, and HACCP CCP verification logs."
          }
        ]
      },
      "intended_export_date": {
        "type": "string",
        "format": "date",
        "title": "Date of intended export",
        "example": "2026-06-15"
      },
      "lc_number": {
        "type": "string",
        "title": "L/C No",
        "example": "LC-88392-COL"
      },
      "container_numbers": {
        "type": "string",
        "title": "Container Numbers (attach list if necessary)",
        "example": "MSCU-849201-9, GATU-102938-2"
      },
      "vessel_name": {
        "type": "string",
        "title": "Name of Vessel/ Number",
        "example": "CMA CGM MARCO POLO / V092"
      },
      "other_supporting_documents": {
        "type": "array",
        "title": "Other Supporting Documents",
        "description": "Attach any additional supporting documents (up to 10 files).",
        "items": {
          "type": "string",
          "format": "file"
        },
        "x-file": {
          "maxFiles": 10,
          "accept": ".pdf,.jpg,.jpeg,.png,.xlsx"
        }
      }
    },
    "required": [
      "exporter_name",
      "exporter_address",
      "consignee_name",
      "consignee_address",
      "commodities",
      "intended_export_date"
    ]
  },
  "uiSchema": {
    "type": "Categorization",
    "options": {
      "variant": "stepper"
    },
    "elements": [
      {
        "type": "Category",
        "label": "Applicant and Consignee",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/import_application_xml"
          },
          {
            "type": "Control",
            "scope": "#/properties/export_application_xml"
          },
          {
            "type": "Group",
            "label": "Applicant",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/exporter_name"
              },
              {
                "type": "Control",
                "scope": "#/properties/exporter_address"
              }
            ]
          },
          {
            "type": "Group",
            "label": "Consignee",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/consignee_name"
              },
              {
                "type": "Control",
                "scope": "#/properties/consignee_address"
              }
            ]
          }
        ]
      },
      {
        "type": "Category",
        "label": "Transport and Export",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/intended_export_date"
          },
          {
            "type": "Control",
            "scope": "#/properties/lc_number"
          },
          {
            "type": "Control",
            "scope": "#/properties/container_numbers"
          },
          {
            "type": "Control",
            "scope": "#/properties/vessel_name"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Items",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/commodities",
            "options": {
              "detail": {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/description_of_food"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/consignment_storage_address"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/package_batch_weight_details"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/ingredients_details",
                    "options": {
                      "multi": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/in_house_quality_monitoring",
                    "options": {
                      "multi": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/analysis_certificates"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/other_declarations"
                  }
                ]
              },
              "display": "cards",
              "summary": "{id} · {description_of_food}",
              "summaryDetail": "{package_batch_weight_details}"
            }
          }
        ],
        "options": {
          "description": "Add one item for each food product in this consignment."
        }
      },
      {
        "type": "Category",
        "label": "Supporting Documents",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/other_supporting_documents"
          }
        ]
      }
    ]
  }
}
