{
  "id": "fcau-apply-health-cert--reviewer-form",
  "title": "Application Assessment Review",
  "schema": {
    "type": "object",
    "properties": {
      "application_review_outcome": {
        "type": "string",
        "title": "Application Assessment Outcome",
        "oneOf": [
          {
            "const": "approve",
            "title": "Approve"
          },
          {
            "const": "needs_more_info",
            "title": "Needs More Information"
          }
        ],
        "default": "approve",
        "example": "approve"
      },
      "commodities": {
        "type": "array",
        "title": "Consignment Items: Required Inspections (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "description_of_food": {
              "type": "string",
              "title": "Description of consignment and quantity"
            },
            "visual_required": {
              "type": "boolean",
              "title": "Visual Inspection Required",
              "default": false
            },
            "lab_required": {
              "type": "boolean",
              "title": "Lab Test Required",
              "description": "If an item needs both Visual and Lab, tick Lab only (a lab test covers the visual check).",
              "default": false
            },
            "warehouse_required": {
              "type": "boolean",
              "title": "Warehouse Inspection Required",
              "default": false
            }
          },
          "required": [
            "id",
            "visual_required",
            "lab_required",
            "warehouse_required"
          ]
        }
      },
      "reference_number": {
        "type": "string",
        "title": "FCAU Application Reference Number",
        "description": "Assigned when the application review opens.",
        "readOnly": true,
        "example": "PB/034/0001"
      },
      "rejection_reason": {
        "type": "string",
        "title": "Comments / Feedback / Deficiencies (if Needs Info)",
        "example": "Consignment food grade manufacturing details verified; application is complete and approved for fee assessment."
      }
    },
    "required": [
      "application_review_outcome"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "application_review_outcome": {
              "const": "approve"
            }
          },
          "required": [
            "application_review_outcome"
          ]
        },
        "then": {
          "required": [
            "commodities"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "application_review_outcome": {
              "const": "needs_more_info"
            }
          },
          "required": [
            "application_review_outcome"
          ]
        },
        "then": {
          "required": [
            "rejection_reason"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/application_review_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/commodities",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/application_review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        },
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/description_of_food",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/visual_required"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/lab_required"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/warehouse_required"
                  }
                ]
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/reference_number"
      },
      {
        "type": "Control",
        "scope": "#/properties/rejection_reason",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/application_review_outcome",
            "schema": {
              "const": "needs_more_info"
            }
          }
        }
      }
    ]
  }
}