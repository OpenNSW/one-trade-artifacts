{
  "id": "fcau-apply-health-cert--reviewer-form",
  "title": "Application Assessment Review",
  "schema": {
    "type": "object",
    "properties": {
      "application_review_outcome": {
        "type": "string",
        "title": "Application Assessment Outcome",
        "oneOf": [
          {
            "const": "approve",
            "title": "Approve"
          },
          {
            "const": "needs_more_info",
            "title": "Needs More Information"
          }
        ],
        "example": "approve"
      },
      "commodities": {
        "type": "array",
        "title": "Consignment Items: Required Inspections (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "description_of_food": {
              "type": "string",
              "title": "Description of consignment and quantity"
            },
            "inspection_type": {
              "type": "string",
              "title": "Required Inspection",
              "oneOf": [
                {
                  "const": "visual",
                  "title": "Visual Inspection"
                },
                {
                  "const": "lab",
                  "title": "Lab Test"
                },
                {
                  "const": "warehouse",
                  "title": "Warehouse Inspection"
                }
              ]
            },
            "lab_test_type": {
              "type": "string",
              "title": "Type of Test",
              "oneOf": [
                {
                  "const": "aflatoxin",
                  "title": "Aflatoxin Test"
                }
              ]
            },
            "proposed_lab": {
              "type": "string",
              "title": "Proposed Lab",
              "oneOf": [
                {
                  "const": "sgs_lanka",
                  "title": "SGS Lanka (Pvt) Limited"
                },
                {
                  "const": "bureau_veritas",
                  "title": "Bureau Veritas Sri Lanka"
                }
              ]
            }
          },
          "required": [
            "id",
            "inspection_type"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "inspection_type": {
                    "const": "lab"
                  }
                },
                "required": [
                  "inspection_type"
                ]
              },
              "then": {
                "required": [
                  "lab_test_type",
                  "proposed_lab"
                ]
              }
            }
          ]
        }
      },
      "reference_number": {
        "type": "string",
        "title": "FCAU Application Reference Number",
        "pattern": "^034/[0-9]{5,}$",
        "example": "034/00481"
      },
      "rejection_reason": {
        "type": "string",
        "title": "Comments / Feedback / Deficiencies (if Needs Info)",
        "example": "Consignment food grade manufacturing details verified; application is complete and approved for fee assessment."
      }
    },
    "required": [
      "application_review_outcome"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "application_review_outcome": {
              "const": "approve"
            }
          },
          "required": [
            "application_review_outcome"
          ]
        },
        "then": {
          "required": [
            "reference_number",
            "commodities"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "application_review_outcome": {
              "const": "needs_more_info"
            }
          },
          "required": [
            "application_review_outcome"
          ]
        },
        "then": {
          "required": [
            "rejection_reason"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/application_review_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/commodities",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/application_review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        },
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/description_of_food",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/inspection_type",
                "options": {
                  "format": "radio"
                }
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/lab_test_type",
                    "rule": {
                      "effect": "SHOW",
                      "condition": {
                        "scope": "#/properties/inspection_type",
                        "schema": {
                          "const": "lab"
                        }
                      }
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/proposed_lab",
                    "rule": {
                      "effect": "SHOW",
                      "condition": {
                        "scope": "#/properties/inspection_type",
                        "schema": {
                          "const": "lab"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/reference_number",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/application_review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/rejection_reason",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/application_review_outcome",
            "schema": {
              "const": "needs_more_info"
            }
          }
        }
      }
    ]
  }
}