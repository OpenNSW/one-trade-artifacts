{
  "id": "fcau-sample-collection--reviewer-form",
  "title": "Consignment Sample Receipt Confirmation",
  "schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "title": "Samples Received (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "description_of_food": {
              "type": "string",
              "title": "Description of consignment and quantity"
            },
            "sample_number": {
              "type": "string",
              "title": "Issued Sample Number",
              "example": "SMP-FCAU-2026-948"
            }
          },
          "required": [
            "id",
            "sample_number"
          ]
        }
      },
      "received_at": {
        "type": "string",
        "format": "date",
        "title": "Date of Receipt",
        "example": "2026-06-18T09:30:00Z"
      },
      "notes": {
        "type": "string",
        "title": "Notes",
        "example": "Sample arrived intact; logged into chain-of-custody register."
      }
    },
    "required": [
      "items",
      "received_at"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/description_of_food",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/sample_number"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/received_at"
      },
      {
        "type": "Control",
        "scope": "#/properties/notes",
        "options": {
          "multi": true
        }
      }
    ]
  }
}