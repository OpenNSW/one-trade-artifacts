{
  "id": "fcau-warehouse-inspection--officer-form",
  "title": "Warehouse Visual Inspection Outcome",
  "schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "title": "Warehouse Inspection Result (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "description_of_food": {
              "type": "string",
              "title": "Description of consignment and quantity"
            },
            "warehouse_result": {
              "type": "string",
              "title": "Warehouse Inspection Result",
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Passed (Satisfactory)"
                },
                {
                  "const": "fail",
                  "title": "Failed (Deficiencies Found)"
                }
              ],
              "default": "pass"
            }
          },
          "required": [
            "id",
            "warehouse_result"
          ]
        }
      },
      "inspection_comments": {
        "type": "string",
        "title": "Inspection Notes / Observations",
        "example": "Visual inspection of storage area completed. Food containers intact and temperature controlled."
      },
      "revised_inspection_date": {
        "type": "string",
        "format": "date",
        "title": "Revised Inspection Date",
        "description": "Leave blank if the inspection took place on the scheduled date. Complete this only to record a different actual date.",
        "example": "2026-08-07"
      }
    },
    "required": [
      "items"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/description_of_food",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/warehouse_result"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/inspection_comments"
      },
      {
        "type": "Control",
        "scope": "#/properties/revised_inspection_date"
      }
    ]
  }
}
