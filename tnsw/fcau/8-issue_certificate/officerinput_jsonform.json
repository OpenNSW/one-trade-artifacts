{
  "id": "fcau-issue-certificate--officer-form",
  "title": "Health Certificate Issuance",
  "schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "title": "Consignment Items and Results",
        "readOnly": true,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID",
              "readOnly": true
            },
            "description_of_food": {
              "type": "string",
              "title": "Description of consignment and quantity",
              "readOnly": true
            },
            "visual_result": {
              "type": "string",
              "title": "Visual Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                }
              ]
            },
            "lab_result": {
              "type": "string",
              "title": "Lab Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                }
              ]
            },
            "warehouse_result": {
              "type": "string",
              "title": "Warehouse Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                }
              ]
            },
            "visual_referral": {
              "type": "string",
              "title": "Visual Referral",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "not_required",
                  "title": "Not Required"
                },
                {
                  "const": "lab",
                  "title": "Referred to Lab Test"
                },
                {
                  "const": "warehouse",
                  "title": "Referred to Warehouse Inspection"
                }
              ]
            },
            "lab_referral": {
              "type": "string",
              "title": "Lab Referral",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "not_required",
                  "title": "Not Required"
                },
                {
                  "const": "warehouse",
                  "title": "Referred to Warehouse Inspection"
                }
              ]
            },
            "warehouse_referral": {
              "type": "string",
              "title": "Warehouse Referral",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "not_required",
                  "title": "Not Required"
                },
                {
                  "const": "lab",
                  "title": "Referred to Lab Test"
                }
              ]
            }
          }
        }
      },
      "certificate_decision": {
        "type": "string",
        "title": "Decision",
        "description": "Issue the certificate for the items that passed, or reject the consignment. You can't issue it if every item failed.",
        "oneOf": [
          {
            "const": "issue",
            "title": "Issue Health Certificate (passed items)"
          },
          {
            "const": "reject",
            "title": "Reject Consignment"
          }
        ]
      },
      "rejection_reason": {
        "type": "string",
        "title": "Reason for Rejection"
      },
      "certificate_id": {
        "type": "string",
        "title": "Health Certificate ID",
        "example": "CERT-FCAU-ACME-9024"
      },
      "certificate": {
        "type": "string",
        "title": "Certificate File Upload (PDF)",
        "format": "file",
        "x-file": { "accept": ".pdf" }
      },
      "supporting_documents": {
        "type": "array",
        "title": "Supporting Documents (e.g. Lab Report)",
        "description": "Attach any supporting documents such as the lab report (up to 5 files).",
        "items": {
          "type": "string",
          "format": "file"
        },
        "x-file": {
          "maxFiles": 5,
          "accept": ".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx"
        }
      },
      "authorized_signature": {
        "type": "string",
        "title": "Prepared and Checked By",
        "example": "DR. ANURA SILVA - CHIEF FOOD INSPECTOR"
      }
    },
    "required": [
      "certificate_decision"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "certificate_decision": {
              "const": "issue"
            }
          },
          "required": [
            "certificate_decision"
          ]
        },
        "then": {
          "required": [
            "certificate_id",
            "certificate",
            "authorized_signature"
          ],
          "properties": {
            "items": {
              "contains": {
                "not": {
                  "anyOf": [
                    {
                      "properties": {
                        "visual_result": {
                          "const": "fail"
                        }
                      },
                      "required": [
                        "visual_result"
                      ]
                    },
                    {
                      "properties": {
                        "lab_result": {
                          "const": "fail"
                        }
                      },
                      "required": [
                        "lab_result"
                      ]
                    },
                    {
                      "properties": {
                        "warehouse_result": {
                          "const": "fail"
                        }
                      },
                      "required": [
                        "warehouse_result"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "certificate_decision": {
              "const": "reject"
            }
          },
          "required": [
            "certificate_decision"
          ]
        },
        "then": {
          "required": [
            "rejection_reason"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "readonly": true,
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readonly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/description_of_food",
                    "options": {
                      "readonly": true
                    }
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/visual_result",
                    "options": {
                      "readonly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/lab_result",
                    "options": {
                      "readonly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/warehouse_result",
                    "options": {
                      "readonly": true
                    }
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/visual_referral",
                    "options": {
                      "readonly": true
                    },
                    "rule": {
                      "effect": "SHOW",
                      "condition": {
                        "scope": "#/properties/visual_referral",
                        "schema": {
                          "enum": [
                            "lab",
                            "warehouse"
                          ]
                        },
                        "failWhenUndefined": true
                      }
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/lab_referral",
                    "options": {
                      "readonly": true
                    },
                    "rule": {
                      "effect": "SHOW",
                      "condition": {
                        "scope": "#/properties/lab_referral",
                        "schema": {
                          "const": "warehouse"
                        },
                        "failWhenUndefined": true
                      }
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/warehouse_referral",
                    "options": {
                      "readonly": true
                    },
                    "rule": {
                      "effect": "SHOW",
                      "condition": {
                        "scope": "#/properties/warehouse_referral",
                        "schema": {
                          "const": "lab"
                        },
                        "failWhenUndefined": true
                      }
                    }
                  }
                ]
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/certificate_decision"
      },
      {
        "type": "Control",
        "scope": "#/properties/rejection_reason",
        "options": {
          "multi": true
        },
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/certificate_decision",
            "schema": {
              "const": "reject"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/certificate_id",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/certificate_decision",
            "schema": {
              "const": "issue"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/certificate",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/certificate_decision",
            "schema": {
              "const": "issue"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/supporting_documents",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/certificate_decision",
            "schema": {
              "const": "issue"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/authorized_signature",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/certificate_decision",
            "schema": {
              "const": "issue"
            }
          }
        }
      }
    ]
  }
}