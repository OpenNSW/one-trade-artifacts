{
  "id": "fcau-health-certificate-reg",
  "name": "FCAU Export Consignment & Health Certificate Registration",
  "version": 23,
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "name": "Start Entry Point"
    },
    {
      "id": "fcau_1_0_apply",
      "type": "TASK",
      "name": "[FCAU 1.0/1.1] Submit & Assess Application",
      "task_template_id": "fcau-apply-health-cert-flow",
      "lane": "FCAU Officer/NSW System",
      "input_mapping": {},
      "output_mapping": {
        "reviewerform.application_review_outcome": "fcau.application_review_outcome",
        "reviewerform.reference_number": "fcau.reference_number",
        "reviewerform.commodities": "commodities",
        "userform": "fcau.userform"
      }
    },
    {
      "id": "fcau_2_0_pay_fee",
      "type": "TASK",
      "name": "[FCAU 2.0] Pay Application Fee",
      "task_template_id": "fcau-pay-app-fee-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform"
      },
      "output_mapping": {
        "payment_status": "fcau.app_fee_payment_status"
      }
    },
    {
      "id": "fcau_gw_test_split",
      "type": "GATEWAY",
      "gateway_type": "BATCH_SPLIT",
      "name": "Partition Items: Visual/Lab Testing Needed?",
      "batch_gateway": {
        "items_variable": "commodities",
        "id_field": "id"
      },
      "input_mapping": {
        "fcau.reference_number?": "fcau.reference_number",
        "fcau.userform?": "fcau.userform"
      }
    },
    {
      "id": "fcau_4_1_sample_collection",
      "type": "TASK",
      "name": "[FCAU 4.1/4.2] Submit, Receive and Number Samples (all Visual/Lab items)",
      "task_template_id": "fcau-sample-collection-flow",
      "lane": "Trader & FCAU Officer",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "commodities": "commodities"
      }
    },
    {
      "id": "fcau_gw_track_split",
      "type": "GATEWAY",
      "gateway_type": "BATCH_SPLIT",
      "name": "Partition Items: Lab Track or Visual-Only Track",
      "batch_gateway": {
        "items_variable": "commodities",
        "id_field": "id"
      },
      "input_mapping": {
        "fcau.reference_number?": "fcau.reference_number",
        "fcau.userform?": "fcau.userform"
      }
    },
    {
      "id": "fcau_6_0_pay_lab_test_fee",
      "type": "TASK",
      "name": "[FCAU 6.0] Pay Lab Test Fee & Upload Receipt (payment 1)",
      "task_template_id": "fcau-pay-lab-fee-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform"
      },
      "output_mapping": {
        "payment_review_outcome": "fcau.lab_fee_payment_status"
      }
    },
    {
      "id": "fcau_7_0_wait_lab_results",
      "type": "TASK",
      "name": "[FCAU 7.0] Record Lab Results (per item)",
      "task_template_id": "fcau-lab-testing-flow",
      "lane": "FCAU Officer/NSW System",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "commodities": "commodities"
      }
    },
    {
      "id": "fcau_5_1_visual_assessment",
      "type": "TASK",
      "name": "[FCAU 5.1] Assess Samples Manually (per item)",
      "task_template_id": "fcau-visual-assessment-flow",
      "lane": "FCAU Officer/NSW System",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "commodities": "commodities"
      }
    },
    {
      "id": "fcau_gw_visual_result_split",
      "type": "GATEWAY",
      "gateway_type": "BATCH_SPLIT",
      "name": "Partition Items: Referred to Lab?",
      "batch_gateway": {
        "items_variable": "commodities",
        "id_field": "id"
      },
      "input_mapping": {
        "fcau.reference_number?": "fcau.reference_number",
        "fcau.userform?": "fcau.userform"
      }
    },
    {
      "id": "fcau_6_0_pay_escalated_lab_fee",
      "type": "TASK",
      "name": "[FCAU 6.0-ESCALATED] Pay Lab Test Fee for Referred Items (payment 2)",
      "task_template_id": "fcau-pay-lab-fee-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform"
      },
      "output_mapping": {
        "payment_review_outcome": "fcau.escalated_lab_fee_payment_status"
      }
    },
    {
      "id": "fcau_7_0_wait_escalated_lab_results",
      "type": "TASK",
      "name": "[FCAU 7.0-ESCALATED] Record Lab Results for Referred Items",
      "task_template_id": "fcau-lab-testing-flow",
      "lane": "FCAU Officer/NSW System",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "commodities": "commodities"
      }
    },
    {
      "id": "fcau_gw_visual_result_join",
      "type": "GATEWAY",
      "gateway_type": "BATCH_JOIN",
      "name": "Merge Visual Result Paths",
      "batch_join": {
        "gateway_node_id": "fcau_gw_visual_result_split",
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "fcau_gw_track_join",
      "type": "GATEWAY",
      "gateway_type": "BATCH_JOIN",
      "name": "Merge Lab and Visual Tracks",
      "batch_join": {
        "gateway_node_id": "fcau_gw_track_split",
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "fcau_gw_test_join",
      "type": "GATEWAY",
      "gateway_type": "BATCH_JOIN",
      "name": "Merge Tested and Untested Items",
      "batch_join": {
        "gateway_node_id": "fcau_gw_test_split",
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "fcau_gw_warehouse_split",
      "type": "GATEWAY",
      "gateway_type": "BATCH_SPLIT",
      "name": "Partition Items: Warehouse Inspection Needed?",
      "batch_gateway": {
        "items_variable": "commodities",
        "id_field": "id"
      },
      "input_mapping": {
        "fcau.reference_number?": "fcau.reference_number",
        "fcau.userform?": "fcau.userform"
      }
    },
    {
      "id": "fcau_3_1_schedule_warehouse",
      "type": "TASK",
      "name": "[FCAU 3.1] Inform Warehouse Inspection Date and Location",
      "task_template_id": "fcau-warehouse-scheduling-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "scheduling.proposed_inspection_date": "fcau.warehouse_inspection_date",
        "traderinput.warehouse_location": "fcau.warehouse_location"
      }
    },
    {
      "id": "fcau_3_2_warehouse_inspection",
      "type": "TASK",
      "name": "[FCAU 3.2] Conduct Warehouse Visual Inspection (per item)",
      "task_template_id": "fcau-warehouse-inspection-flow",
      "lane": "FCAU Officer/NSW System",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform",
        "fcau.warehouse_location": "warehouse_location",
        "fcau.warehouse_inspection_date": "inspection_date",
        "commodities": "commodities"
      },
      "output_mapping": {
        "commodities": "commodities",
        "revised_inspection_date?": "fcau.warehouse_inspection_revised_date"
      }
    },
    {
      "id": "fcau_gw_post_wh_split",
      "type": "GATEWAY",
      "gateway_type": "BATCH_SPLIT",
      "name": "Partition Items: Referred to Lab from Warehouse?",
      "batch_gateway": {
        "items_variable": "commodities",
        "id_field": "id"
      },
      "input_mapping": {
        "fcau.reference_number?": "fcau.reference_number",
        "fcau.userform?": "fcau.userform"
      }
    },
    {
      "id": "fcau_3_3_pay_post_wh_lab_fee",
      "type": "TASK",
      "name": "[FCAU 3.3] Pay Post-Warehouse Lab Test Fee & Upload Receipt",
      "task_template_id": "fcau-pay-post-wh-lab-fee-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform"
      },
      "output_mapping": {
        "post_wh_lab_payment_status": "fcau.post_wh_lab_fee_payment_status"
      }
    },
    {
      "id": "fcau_3_4_wait_post_wh_lab_results",
      "type": "TASK",
      "name": "[FCAU 3.4] Record Post-Warehouse Lab Results (per item)",
      "task_template_id": "fcau-post-wh-lab-testing-flow",
      "lane": "FCAU Officer/NSW System",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "commodities": "commodities"
      }
    },
    {
      "id": "fcau_gw_post_wh_join",
      "type": "GATEWAY",
      "gateway_type": "BATCH_JOIN",
      "name": "Merge Post-Warehouse Lab and Other Warehouse Items",
      "batch_join": {
        "gateway_node_id": "fcau_gw_post_wh_split",
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "fcau_gw_warehouse_join",
      "type": "GATEWAY",
      "gateway_type": "BATCH_JOIN",
      "name": "Merge Warehouse and Non-Warehouse Items",
      "batch_join": {
        "gateway_node_id": "fcau_gw_warehouse_split",
        "items_variable": "commodities",
        "id_field": "id"
      }
    },
    {
      "id": "fcau_8_0_issue_certificate",
      "type": "TASK",
      "name": "[FCAU 8.0] Issue Health Certificate for Passed Items, or Reject Consignment",
      "task_template_id": "fcau-issue-certificate-flow",
      "lane": "FCAU Officer/NSW System",
      "input_mapping": {
        "fcau.reference_number": "reference_number",
        "fcau.userform": "userform",
        "commodities": "commodities"
      },
      "output_mapping": {
        "certificate_decision": "fcau.certificate_decision",
        "certificate_id?": "fcau.certificate_id",
        "certificate?": "fcau.certificate",
        "supporting_documents?": "fcau.supporting_documents",
        "rejection_reason?": "fcau.rejection_reason"
      }
    },
    {
      "id": "fcau_gw_certificate_decision",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Certificate Issued or Consignment Rejected?"
    },
    {
      "id": "end_consignment_rejected",
      "type": "END",
      "name": "End: Consignment Rejected by Officer",
      "end": {
        "outcome": "rejected",
        "title": "Consignment Rejected",
        "description": "An FCAU officer rejected this consignment after testing and inspection. No health certificate was issued."
      }
    },
    {
      "id": "end_workflow_success",
      "type": "END",
      "name": "End: Health Certificate Successfully Generated",
      "end": {
        "outcome": "success"
      }
    }
  ],
  "edges": [
    {
      "id": "e_start_to_apply",
      "source_id": "start",
      "target_id": "fcau_1_0_apply"
    },
    {
      "id": "e_apply_to_pay",
      "source_id": "fcau_1_0_apply",
      "target_id": "fcau_2_0_pay_fee"
    },
    {
      "id": "e_pay_to_test_split",
      "source_id": "fcau_2_0_pay_fee",
      "target_id": "fcau_gw_test_split"
    },
    {
      "id": "e_test_split_to_sample",
      "source_id": "fcau_gw_test_split",
      "target_id": "fcau_4_1_sample_collection",
      "condition": "item.inspection_type == 'lab' || item.inspection_type == 'visual'"
    },
    {
      "id": "e_test_split_bypass",
      "source_id": "fcau_gw_test_split",
      "target_id": "fcau_gw_test_join",
      "condition": "item.inspection_type == 'warehouse'"
    },
    {
      "id": "e_sample_to_track_split",
      "source_id": "fcau_4_1_sample_collection",
      "target_id": "fcau_gw_track_split"
    },
    {
      "id": "e_track_split_to_lab",
      "source_id": "fcau_gw_track_split",
      "target_id": "fcau_6_0_pay_lab_test_fee",
      "condition": "item.inspection_type == 'lab'"
    },
    {
      "id": "e_track_split_to_visual",
      "source_id": "fcau_gw_track_split",
      "target_id": "fcau_5_1_visual_assessment",
      "condition": "item.inspection_type == 'visual'"
    },
    {
      "id": "e_lab_fee_to_results",
      "source_id": "fcau_6_0_pay_lab_test_fee",
      "target_id": "fcau_7_0_wait_lab_results"
    },
    {
      "id": "e_lab_results_to_track_join",
      "source_id": "fcau_7_0_wait_lab_results",
      "target_id": "fcau_gw_track_join"
    },
    {
      "id": "e_visual_to_result_split",
      "source_id": "fcau_5_1_visual_assessment",
      "target_id": "fcau_gw_visual_result_split"
    },
    {
      "id": "e_visual_refer_lab",
      "source_id": "fcau_gw_visual_result_split",
      "target_id": "fcau_6_0_pay_escalated_lab_fee",
      "condition": "item.visual_referral == 'lab'"
    },
    {
      "id": "e_visual_other",
      "source_id": "fcau_gw_visual_result_split",
      "target_id": "fcau_gw_visual_result_join",
      "condition": "item.visual_referral != 'lab'"
    },
    {
      "id": "e_escalated_fee_to_results",
      "source_id": "fcau_6_0_pay_escalated_lab_fee",
      "target_id": "fcau_7_0_wait_escalated_lab_results"
    },
    {
      "id": "e_escalated_results_to_join",
      "source_id": "fcau_7_0_wait_escalated_lab_results",
      "target_id": "fcau_gw_visual_result_join"
    },
    {
      "id": "e_visual_join_to_track_join",
      "source_id": "fcau_gw_visual_result_join",
      "target_id": "fcau_gw_track_join"
    },
    {
      "id": "e_track_join_to_test_join",
      "source_id": "fcau_gw_track_join",
      "target_id": "fcau_gw_test_join"
    },
    {
      "id": "e_test_join_to_warehouse_split",
      "source_id": "fcau_gw_test_join",
      "target_id": "fcau_gw_warehouse_split"
    },
    {
      "id": "e_warehouse_split_to_schedule",
      "source_id": "fcau_gw_warehouse_split",
      "target_id": "fcau_3_1_schedule_warehouse",
      "condition": "item.inspection_type == 'warehouse' || item.visual_referral == 'warehouse' || item.lab_referral == 'warehouse'"
    },
    {
      "id": "e_warehouse_split_bypass",
      "source_id": "fcau_gw_warehouse_split",
      "target_id": "fcau_gw_warehouse_join",
      "condition": "item.inspection_type != 'warehouse' && item.visual_referral != 'warehouse' && item.lab_referral != 'warehouse'"
    },
    {
      "id": "e_schedule_to_inspect",
      "source_id": "fcau_3_1_schedule_warehouse",
      "target_id": "fcau_3_2_warehouse_inspection"
    },
    {
      "id": "e_inspect_to_post_wh_split",
      "source_id": "fcau_3_2_warehouse_inspection",
      "target_id": "fcau_gw_post_wh_split"
    },
    {
      "id": "e_post_wh_refer_lab",
      "source_id": "fcau_gw_post_wh_split",
      "target_id": "fcau_3_3_pay_post_wh_lab_fee",
      "condition": "item.warehouse_referral == 'lab'"
    },
    {
      "id": "e_post_wh_other",
      "source_id": "fcau_gw_post_wh_split",
      "target_id": "fcau_gw_post_wh_join",
      "condition": "item.warehouse_referral != 'lab'"
    },
    {
      "id": "e_post_wh_fee_to_results",
      "source_id": "fcau_3_3_pay_post_wh_lab_fee",
      "target_id": "fcau_3_4_wait_post_wh_lab_results"
    },
    {
      "id": "e_post_wh_results_to_join",
      "source_id": "fcau_3_4_wait_post_wh_lab_results",
      "target_id": "fcau_gw_post_wh_join"
    },
    {
      "id": "e_post_wh_join_to_warehouse_join",
      "source_id": "fcau_gw_post_wh_join",
      "target_id": "fcau_gw_warehouse_join"
    },
    {
      "id": "e_warehouse_join_to_issue",
      "source_id": "fcau_gw_warehouse_join",
      "target_id": "fcau_8_0_issue_certificate"
    },
    {
      "id": "e_issue_to_decision",
      "source_id": "fcau_8_0_issue_certificate",
      "target_id": "fcau_gw_certificate_decision"
    },
    {
      "id": "e_decision_issue",
      "source_id": "fcau_gw_certificate_decision",
      "target_id": "end_workflow_success",
      "condition": "fcau.certificate_decision == 'issue'"
    },
    {
      "id": "e_decision_reject",
      "source_id": "fcau_gw_certificate_decision",
      "target_id": "end_consignment_rejected",
      "condition": "fcau.certificate_decision == 'reject'"
    }
  ]
}
