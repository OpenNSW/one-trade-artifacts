{
  "id": "fcau-visual-assessment-flow:render",
  "type": "VISUAL_ASSESSMENT",
  "title": "[FCAU] Manual Sample Assessment",
  "read": {
    "roles": [
      "trader",
      "cha"
    ]
  },
  "files": [
    "submission.commodities[*].analysis_certificates",
    "submission.commodities[*].other_declarations",
    "submission.other_supporting_documents[*]"
  ],
  "sections": {
    "status_message": {
      "templateId": "fcau-visual-assessment--reviewer-instructions",
      "title": "Assessment Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    },
    "officerform": {
      "templateId": "fcau-visual-assessment--trader-results",
      "title": "Visual Sample Assessment",
      "projector": "MARKDOWN",
      "dataKey": "reviewerform",
      "visibleWhen": {
        "requireDataKey": "reviewerform"
      }
    }
  }
}
