{
  "id": "npqs-pay-replacement-fee:render",
  "type": "PAYMENT",
  "title": "[NPQS] Pay Replacement Certificate Fee",
  "files": [
    "receipt.payment_slip",
    "submission.payment_slip"
  ],
  "sections": {
    "payment_details": {
      "templateId": "npqs-pay-replacement-fee--payment-details-markdown",
      "title": "Replacement Certificate Fee Details",
      "projector": "MARKDOWN",
      "dataKey": "payment",
      "visibleWhen": {
        "states": [
          "PENDING_PAYMENT"
        ]
      }
    },
    "select_method": {
      "templateId": "npqs-pay-replacement-fee--select-method-form",
      "title": "Select Payment Method",
      "projector": "FORM",
      "dataKey": "payment_method",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ]
      },
      "handles": [
        {
          "command": "submit",
          "label": "Proceed to Payment",
          "element": "primary_action"
        }
      ]
    },
    "success_message": {
      "templateId": "npqs-pay-replacement-fee--success-message",
      "title": "Payment Successful",
      "projector": "MARKDOWN",
      "dataKey": "payment",
      "visibleWhen": {
        "states": [
          "COMPLETED"
        ]
      }
    },
    "payment_not_received": {
      "templateId": "npqs-pay-replacement-fee--not-received",
      "title": "Payment Not Confirmed",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_REPAYMENT"
        ],
        "requireDataKey": "payment_remarks"
      }
    },
    "pay_again": {
      "templateId": "npqs-pay-replacement-fee--pay-again-form",
      "title": "Notify the Officer",
      "projector": "FORM",
      "dataKey": "repayment",
      "visibleWhen": {
        "states": [
          "PENDING_REPAYMENT"
        ]
      },
      "handles": [
        {
          "command": "submit",
          "label": "I Have Paid — Notify the Officer",
          "element": "primary_action"
        }
      ]
    },
    "receipt_instructions": {
      "templateId": "npqs-pay-replacement-fee--receipt-instructions",
      "title": "Bank Transfer Details",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_SLIP_UPLOAD"
        ]
      }
    },
    "upload_receipt": {
      "templateId": "npqs-payment--upload-form",
      "title": "Upload Payment Receipt",
      "projector": "FORM",
      "dataKey": "receipt",
      "visibleWhen": {
        "states": [
          "PENDING_SLIP_UPLOAD"
        ]
      },
      "handles": [
        {
          "command": "submit",
          "label": "Submit Payment Receipt",
          "element": "primary_action"
        }
      ]
    },
    "awaiting_officer": {
      "templateId": "npqs-pay-replacement-fee--awaiting-officer",
      "title": "Waiting for Officer",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "selected_payment_method"
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    },
    "PENDING_PAYMENT": {
      "actions": []
    },
    "PENDING_SLIP_UPLOAD": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    },
    "QUEUED_EXTERNALLY": {
      "actions": []
    },
    "PENDING_REPAYMENT": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
