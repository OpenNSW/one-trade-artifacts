{
  "id": "npqs-treatment-request:render",
  "type": "APPLICATION",
  "title": "[NPQS] Treatment Request",
  "sections": {
    "assessment_outcome": {
      "templateId": "npqs-treatment-request--status",
      "title": "Treatment Request Assessment",
      "projector": "MARKDOWN",
      "dataKey": "reviewerform",
      "visibleWhen": {
        "states": ["PENDING_USER", "COMPLETED"],
        "requireDataKey": "reviewerform"
      }
    },
    "status_awaiting": {
      "templateId": "npqs-treatment-request--status-awaiting",
      "title": "Current Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": ["QUEUED_EXTERNALLY"]
      }
    },
    "review_history": {
      "templateId": "npqs-treatment-request--previous-feedback",
      "title": "Review History",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": ["QUEUED_EXTERNALLY"],
        "requireDataKey": "reviewerform"
      }
    },
    "submission_form": {
      "templateId": "npqs-treatment-request--trader-form",
      "title": "Treatment Request Details",
      "projector": "FORM",
      "dataKey": "traderinput",
      "handles": [
        {
          "command": "submit",
          "label": "Submit Treatment Request",
          "element": "primary_action"
        }
      ]
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [{ "command": "submit" }]
    }
  }
}
