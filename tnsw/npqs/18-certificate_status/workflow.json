{
  "id": "npqs-certificate-status",
  "name": "NPQS Certificate Status & Next Action",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "refresh",
      "type": "TASK",
      "task_template_id": "npqs-certificate-status--refresh",
      "input_mapping": {
        "ephyto.tracking_number?": "tracking_number"
      },
      "output_mapping": {
        "hubstatus.tracking_info?": "ephyto.tracking_info",
        "hubstatus.delivered?": "ephyto.delivered",
        "hubstatus.error?": "status_error"
      }
    },
    {
      "id": "choose",
      "type": "TASK",
      "task_template_id": "npqs-certificate-status--choose",
      "input_mapping": {
        "reference_number": "reference_number",
        "certificate_id": "certificate_id",
        "ephyto?": "ephyto",
        "status_error?": "status_error",
        "withdrawal?": "withdrawal",
        "replacement?": "replacement"
      },
      "output_mapping": {
        "action": "action.action",
        "withdrawal_reason?": "action.withdrawal_reason",
        "replacement_reason?": "action.replacement_reason"
      }
    },
    {
      "id": "gw_action",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "refresh"
    },
    {
      "id": "e2",
      "source_id": "refresh",
      "target_id": "choose"
    },
    {
      "id": "e3",
      "source_id": "choose",
      "target_id": "gw_action"
    },
    {
      "id": "e4",
      "source_id": "gw_action",
      "target_id": "refresh",
      "condition": "action.action in [nil, 'refresh']"
    },
    {
      "id": "e5",
      "source_id": "gw_action",
      "target_id": "end",
      "condition": "action.action in ['complete', 'withdraw', 'replace']"
    }
  ]
}
