{
  "id": "npqs-certificate-status:render",
  "type": "APPLICATION",
  "title": "[NPQS] Delivery Status & Next Action",
  "read": {
    "roles": [
      "trader",
      "cha"
    ]
  },
  "files": [],
  "sections": {
    "checking": {
      "templateId": "npqs-certificate-status--checking-msg",
      "title": "Delivery Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "STARTING",
          "STARTING_STEP",
          "EPHYTO_POLLING"
        ]
      }
    },
    "status_msg": {
      "templateId": "npqs-certificate-status--status-msg",
      "title": "Delivery Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "ephyto"
      }
    },
    "action_form": {
      "templateId": "npqs-certificate-status--action-form",
      "title": "Next Action",
      "projector": "FORM",
      "dataKey": "action",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "ephyto"
      },
      "handles": [
        {
          "command": "submit",
          "label": "Submit",
          "element": "primary_action"
        }
      ]
    },
    "completed": {
      "templateId": "npqs-certificate-status--next-action-msg",
      "title": "Next Action",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "COMPLETED"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        },
        {
          "command": "save_as_draft"
        }
      ]
    }
  }
}
