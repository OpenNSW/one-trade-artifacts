{
  "id": "npqs-certificate-status:render",
  "type": "APPLICATION",
  "title": "[NPQS] Delivery Status & Next Action",
  "sections": {
    "checking": {
      "templateId": "npqs-certificate-status--checking-msg",
      "title": "Delivery Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "STARTING",
          "STARTING_STEP",
          "EPHYTO_POLLING"
        ]
      }
    },
    "status_msg": {
      "templateId": "npqs-certificate-status--status-msg",
      "title": "Delivery Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "ephyto"
      }
    },
    "action_form": {
      "templateId": "npqs-certificate-status--action-form",
      "title": "Next Action",
      "projector": "FORM",
      "dataKey": "action",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "ephyto"
      },
      "handles": [
        {
          "command": "submit",
          "label": "Submit",
          "element": "primary_action"
        }
      ]
    },
    "amend_msg": {
      "templateId": "npqs-certificate-status--amend-application-msg",
      "title": "Replacement Certificate",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "userform"
      }
    },
    "amend_form": {
      "templateId": "npqs-apply-phyto-cert--user-form",
      "title": "NPQS Application",
      "projector": "FORM",
      "dataKey": "userform",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "userform"
      },
      "handles": [
        {
          "command": "submit",
          "label": "Continue",
          "element": "primary_action"
        }
      ]
    },
    "note_msg": {
      "templateId": "npqs-certificate-status--replacement-note-msg",
      "title": "Replacement Certificate",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "notes"
      }
    },
    "note_form": {
      "templateId": "npqs-certificate-status--replacement-note-form",
      "title": "Replacement Note",
      "projector": "FORM",
      "dataKey": "notes",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "notes"
      },
      "handles": [
        {
          "command": "submit",
          "label": "Send to the NPQS Officer",
          "element": "primary_action"
        }
      ]
    },
    "with_officer": {
      "templateId": "npqs-certificate-status--with-officer-msg",
      "title": "Withdrawal Request",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY",
          "EPHYTO_WITHDRAWAL_SUBMITTED",
          "EPHYTO_SUBMITTED"
        ]
      }
    },
    "completed": {
      "templateId": "npqs-certificate-status--completed-msg",
      "title": "Certificate",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "COMPLETED"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
