{
  "id": "npqs-certificate-status:render",
  "type": "APPLICATION",
  "title": "[NPQS] Certificate Status & Next Action",
  "sections": {
    "checking": {
      "templateId": "npqs-certificate-status--checking-msg",
      "title": "Certificate Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "STARTING",
          "STARTING_STEP",
          "EPHYTO_POLLING"
        ]
      }
    },
    "status_msg": {
      "templateId": "npqs-certificate-status--status-msg",
      "title": "Certificate Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ]
      }
    },
    "action_form": {
      "templateId": "npqs-certificate-status--action-form",
      "title": "Next Action",
      "projector": "FORM",
      "dataKey": "action",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ]
      },
      "handles": [
        {
          "command": "submit",
          "label": "Submit",
          "element": "primary_action"
        }
      ]
    },
    "with_officer": {
      "templateId": "npqs-certificate-status--with-officer-msg",
      "title": "Withdrawal Request",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY",
          "EPHYTO_WITHDRAWAL_SUBMITTED"
        ]
      }
    },
    "completed": {
      "templateId": "npqs-certificate-status--completed-msg",
      "title": "Certificate",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "COMPLETED"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
