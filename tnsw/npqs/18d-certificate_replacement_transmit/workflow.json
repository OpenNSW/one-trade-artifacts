{
  "id": "npqs-certificate-replacement-transmit",
  "name": "Replacement Certificate Transmission",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "transmit_replacement",
      "type": "TASK",
      "task_template_id": "npqs-ephyto-upload--officer-transmit",
      "input_mapping": {
        "reference_number": "reference_number",
        "new_certificate_id": "certificate_id",
        "reference_number?": "submission.reference_number",
        "new_certificate_id?": "submission.certificate_id",
        "certificate_id?": "submission.replaced_certificate_id",
        "replacement_note?": "submission.replacement_note",
        "replacement_hub_error?": "submission.previous_error",
        "officerinput.npqs_reply_token?": "replyToken"
      },
      "output_mapping": {
        "send_application_documents?": "officerinput.send_application_documents",
        "send_treatment_certificate?": "officerinput.send_treatment_certificate",
        "send_supervision_report?": "officerinput.send_supervision_report",
        "send_invoice?": "officerinput.send_invoice",
        "send_packing_list?": "officerinput.send_packing_list",
        "send_additional_document?": "officerinput.send_additional_document",
        "callbackToken?": "officerinput.npqs_reply_token"
      }
    },
    {
      "id": "submit_replacement",
      "type": "TASK",
      "task_template_id": "npqs-ephyto-upload--submit",
      "input_mapping": {
        "userform": "userform",
        "userform.date_of_inspection?": "date_of_inspection",
        "new_certificate_id": "certificate_id",
        "certificate_items?": "certificate_items",
        "reference_number?": "reference_number",
        "certificate_id": "replacement.replaced_number",
        "replacement_note": "replacement.reason",
        "replaced_issue_date?": "replacement.replaced_issue_date",
        "treatment_certificate_url?": "documents.treatment_certificate.url",
        "officerinput.send_treatment_certificate?": "documents.treatment_certificate.send",
        "supervision_report_url?": "documents.treatment_supervision_report.url",
        "officerinput.send_supervision_report?": "documents.treatment_supervision_report.send",
        "invoice_file_url?": "documents.commercial_invoice.url",
        "officerinput.send_invoice?": "documents.commercial_invoice.send",
        "packing_list_file_url?": "documents.packing_list.url",
        "officerinput.send_packing_list?": "documents.packing_list.send",
        "additional_file_url?": "documents.additional_supporting_document.url",
        "officerinput.send_additional_document?": "documents.additional_supporting_document.send",
        "officerinput.send_application_documents?": "send_application_documents"
      },
      "output_mapping": {
        "ephyto.submitted": "replacement_submitted",
        "ephyto.error?": "replacement_hub_error",
        "ephyto.tracking_number?": "ephyto.tracking_number",
        "ephyto.tracking_info?": "ephyto.tracking_info",
        "certificate_id": "certificate_id"
      }
    },
    {
      "id": "gw_submit",
      "name": "Accepted by the IPPC Hub?",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "submitted_notice",
      "name": "Build the accepted notice for NPQS",
      "type": "TASK",
      "task_template_id": "npqs-ephyto-upload--submitted-notice",
      "input_mapping": {
        "reference_number": "reference_number",
        "new_certificate_id": "certificate_id",
        "ephyto?": "ephyto",
        "ephyto.tracking_number?": "payload.tracking_number",
        "replacement_submitted": "payload.transmitted"
      },
      "output_mapping": {
        "notice.command": "npqs_notice.command",
        "notice.payload?": "npqs_notice.payload"
      }
    },
    {
      "id": "notify_submitted",
      "name": "Tell the NPQS officer task the Hub accepted it",
      "type": "TASK",
      "task_template_id": "npqs-ephyto-upload--notify-submitted",
      "input_mapping": {
        "reference_number": "reference_number",
        "new_certificate_id": "certificate_id",
        "ephyto?": "ephyto",
        "officerinput.npqs_reply_token": "npqs_reply_token",
        "npqs_notice.command": "payload.command",
        "npqs_notice.payload?": "payload.payload"
      },
      "output_mapping": {
        "notifyresult.notified": "npqs_notice.notified"
      }
    },
    {
      "id": "gw_notified",
      "name": "NPQS told?",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "notify_wait",
      "name": "Wait before telling NPQS again",
      "type": "TIMER",
      "timer": {
        "duration": "1m",
        "counter_key": "npqs_notice.attempts"
      }
    },
    {
      "id": "gw_notify_retry",
      "name": "Try NPQS again?",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "transmit_replacement"
    },
    {
      "id": "e2",
      "source_id": "transmit_replacement",
      "target_id": "submit_replacement"
    },
    {
      "id": "e_submit_gw",
      "source_id": "submit_replacement",
      "target_id": "gw_submit"
    },
    {
      "id": "e_submitted",
      "source_id": "gw_submit",
      "target_id": "submitted_notice",
      "condition": "replacement_submitted == true && officerinput.npqs_reply_token != nil"
    },
    {
      "id": "e_submitted_no_npqs_token",
      "source_id": "gw_submit",
      "target_id": "end",
      "condition": "replacement_submitted == true && officerinput.npqs_reply_token == nil"
    },
    {
      "id": "e_submit_failed",
      "source_id": "gw_submit",
      "target_id": "transmit_replacement",
      "condition": "replacement_submitted != true"
    },
    {
      "id": "e_notice_built",
      "source_id": "submitted_notice",
      "target_id": "notify_submitted"
    },
    {
      "id": "e_notify_gw",
      "source_id": "notify_submitted",
      "target_id": "gw_notified"
    },
    {
      "id": "e_notified",
      "source_id": "gw_notified",
      "target_id": "end",
      "condition": "npqs_notice.notified == true"
    },
    {
      "id": "e_notify_failed",
      "source_id": "gw_notified",
      "target_id": "notify_wait",
      "condition": "npqs_notice.notified != true"
    },
    {
      "id": "e_notify_waited",
      "source_id": "notify_wait",
      "target_id": "gw_notify_retry"
    },
    {
      "id": "e_notify_again",
      "source_id": "gw_notify_retry",
      "target_id": "notify_submitted",
      "condition": "npqs_notice.attempts < 60"
    },
    {
      "id": "e_notify_give_up",
      "source_id": "gw_notify_retry",
      "target_id": "end",
      "condition": "npqs_notice.attempts >= 60"
    }
  ]
}
