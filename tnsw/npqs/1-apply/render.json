{
  "id": "npqs-apply-phyto-cert:render",
  "type": "APPLICATION",
  "title": "[NPQS] Phytosanitary Certificate Application",
  "files": [
    "submission.attachments[*].attachment_file_url",
    "userform.attachments[*].attachment_file_url"
  ],
  "sections": {
    "assessment_outcome": {
      "templateId": "npqs-apply-phyto-cert--status",
      "title": "Application Assessment",
      "projector": "MARKDOWN",
      "dataKey": "reviewerform",
      "visibleWhen": {
        "states": ["PENDING_USER", "COMPLETED"],
        "requireDataKey": "reviewerform"
      }
    },
    "status_awaiting": {
      "templateId": "npqs-apply-phyto-cert--status-awaiting",
      "title": "Application Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": ["QUEUED_EXTERNALLY"]
      }
    },
    "review_history": {
      "templateId": "npqs-apply-phyto-cert--previous-feedback",
      "title": "Review History",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": ["QUEUED_EXTERNALLY"],
        "requireDataKey": "reviewerform"
      }
    },
    "status_draft_certificate": {
      "templateId": "npqs-apply-phyto-cert--draft-certificate-msg",
      "title": "Draft Phytosanitary Certificate",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": ["QUEUED_EXTERNALLY", "PENDING_USER", "COMPLETED"],
        "requireDataKey": "draft_certificate_key"
      }
    },
    "submission_form": {
      "templateId": "npqs-apply-phyto-cert--user-form",
      "title": "Phytosanitary Certificate Application",
      "projector": "FORM",
      "dataKey": "userform",
      "handles": [
        {
          "command": "save_as_draft",
          "label": "Save as Draft",
          "element": "draft_action"
        },
        {
          "command": "submit",
          "label": "Submit Application",
          "element": "primary_action"
        }
      ]
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [{ "command": "submit" }, { "command": "save_as_draft" }]
    }
  }
}
