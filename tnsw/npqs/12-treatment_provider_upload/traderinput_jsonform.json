{
  "id": "npqs-provider-cert-upload--trader-form",
  "title": "Upload Treatment Provider Certificate",
  "schema": {
    "type": "object",
    "properties": {
      "treatment_certificate_url": {
        "type": "string",
        "format": "file",
        "title": "Treatment Provider's Certificate (PDF/Image)",
        "example": "https://nsw.gov.lk/storage/certs/treatment-cert-1092.pdf",
        "x-file": { "accept": ".pdf,.jpg,.jpeg,.jfif,.png,.gif,.webp" }
      },
      "upload_remarks": {
        "type": "string",
        "title": "Trader Comments / Remarks",
        "example": "Uploaded the fumigation certificate from private provider and supervisor check sheet."
      },
      "commodities": {
        "type": "array",
        "title": "Items Under Treatment (Context)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID",
              "readOnly": true
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "displayTemplate": "{name}",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              },
              "readOnly": true
            }
          }
        },
        "readOnly": true
      }
    },
    "required": [
      "treatment_certificate_url"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/commodities",
        "options": {
          "detail": {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/id"
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_common_name"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/treatment_certificate_url"
      },
      {
        "type": "Control",
        "scope": "#/properties/upload_remarks"
      }
    ]
  }
}
