{
  "id": "npqs-ephyto-upload",
  "name": "Upload to IPPC ePhyto Hub",
  "version": 13,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "officer_transmit",
      "type": "TASK",
      "task_template_id": "npqs-ephyto-upload--officer-transmit",
      "input_mapping": {
        "reference_number": "reference_number",
        "certificate_id": "certificate_id",
        "ephyto?": "ephyto",
        "reference_number?": "submission.reference_number",
        "certificate_id?": "submission.certificate_id",
        "ephyto.error?": "submission.previous_error",
        "replacement_reference_number?": "replacement_reference_number"
      },
      "output_mapping": {
        "hub_destination": "officerinput.hub_destination",
        "send_application_documents?": "officerinput.send_application_documents",
        "send_treatment_certificate?": "officerinput.send_treatment_certificate",
        "send_supervision_report?": "officerinput.send_supervision_report",
        "send_invoice?": "officerinput.send_invoice",
        "send_packing_list?": "officerinput.send_packing_list",
        "send_additional_document?": "officerinput.send_additional_document"
      }
    },
    {
      "id": "submit",
      "type": "TASK",
      "task_template_id": "npqs-ephyto-upload--submit",
      "input_mapping": {
        "userform": "userform",
        "certificate_id": "certificate_id",
        "officerinput.hub_destination": "hub_destination",
        "certificate_items?": "certificate_items",
        "officerinput.send_application_documents?": "send_application_documents",
        "treatment_certificate_url?": "documents.treatment_certificate.url",
        "officerinput.send_treatment_certificate?": "documents.treatment_certificate.send",
        "supervision_report_url?": "documents.treatment_supervision_report.url",
        "officerinput.send_supervision_report?": "documents.treatment_supervision_report.send",
        "invoice_file_url?": "documents.commercial_invoice.url",
        "officerinput.send_invoice?": "documents.commercial_invoice.send",
        "packing_list_file_url?": "documents.packing_list.url",
        "officerinput.send_packing_list?": "documents.packing_list.send",
        "additional_file_url?": "documents.additional_supporting_document.url",
        "officerinput.send_additional_document?": "documents.additional_supporting_document.send",
        "replacement_reference_number?": "replacement_reference_number",
        "reference_number?": "reference_number"
      },
      "output_mapping": {
        "ephyto.submitted": "ephyto.submitted",
        "ephyto.tracking_number?": "ephyto.tracking_number",
        "ephyto.tracking_info?": "ephyto.tracking_info",
        "ephyto.error": "ephyto.error"
      }
    },
    {
      "id": "gw_submit",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e_start",
      "source_id": "start",
      "target_id": "officer_transmit"
    },
    {
      "id": "e_officer_submit",
      "source_id": "officer_transmit",
      "target_id": "submit"
    },
    {
      "id": "e_submit_gw",
      "source_id": "submit",
      "target_id": "gw_submit"
    },
    {
      "id": "e_submitted",
      "source_id": "gw_submit",
      "target_id": "end",
      "condition": "ephyto.submitted == true"
    },
    {
      "id": "e_submit_failed",
      "source_id": "gw_submit",
      "target_id": "officer_transmit",
      "condition": "ephyto.submitted != true"
    }
  ]
}
