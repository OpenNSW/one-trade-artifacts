{
  "id": "customs-cdn-branch-flow",
  "name": "Create CDN (one container)",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "create_cdn",
      "type": "TASK",
      "name": "Create CDN",
      "task_template_id": "customs-create-cdn-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "_iter.input.cusdec_ref": "cusdec_ref",
        "_iter.input.container_label?": "container_label",
        "_iter.input.prefill?": "prefill"
      },
      "output_mapping": {
        "userform": "userform",
        "cig_cdn?": "cig_cdn"
      }
    },
    {
      "id": "cancelled_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Cancelled from the CDN Form?"
    },
    {
      "id": "wait_ack",
      "type": "TASK",
      "name": "Wait on CDN Acknowledgment",
      "task_template_id": "customs-wait-cdn-ack-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "userform": "userform",
        "cig_cdn.edge_id?": "edge_id"
      },
      "output_mapping": {
        "ack_status?": "ack_status"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "create_cdn"
    },
    {
      "id": "e2",
      "source_id": "create_cdn",
      "target_id": "cancelled_check"
    },
    {
      "id": "e_cancelled",
      "source_id": "cancelled_check",
      "target_id": "end",
      "condition": "userform.cancel_cdn == true"
    },
    {
      "id": "e_to_wait_ack",
      "source_id": "cancelled_check",
      "target_id": "wait_ack",
      "condition": "userform.cancel_cdn != true"
    },
    {
      "id": "e3",
      "source_id": "wait_ack",
      "target_id": "end"
    }
  ]
}
