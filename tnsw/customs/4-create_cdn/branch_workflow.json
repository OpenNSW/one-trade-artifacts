{
  "id": "customs-cdn-branch-flow",
  "name": "Create CDN (one container)",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "create_cdn",
      "type": "TASK",
      "name": "Create CDN",
      "task_template_id": "customs-create-cdn-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "_iter.input.cusdec_ref": "cusdec_ref",
        "_iter.input.container_label?": "container_label"
      },
      "output_mapping": {
        "userform": "userform",
        "cig_cdn?": "cig_cdn"
      }
    },
    {
      "id": "withdrawn_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT",
      "name": "Withdrawn by an Amendment?"
    },
    {
      "id": "wait_ack",
      "type": "TASK",
      "name": "Wait on CDN Acknowledgment",
      "task_template_id": "customs-wait-cdn-ack-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "userform": "userform"
      },
      "output_mapping": {
        "ack_status?": "ack_status"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "create_cdn"
    },
    {
      "id": "e2",
      "source_id": "create_cdn",
      "target_id": "withdrawn_check"
    },
    {
      "id": "e_withdrawn",
      "source_id": "withdrawn_check",
      "target_id": "end",
      "condition": "userform.cancelled == true"
    },
    {
      "id": "e_to_wait_ack",
      "source_id": "withdrawn_check",
      "target_id": "wait_ack",
      "condition": "userform.cancelled != true"
    },
    {
      "id": "e3",
      "source_id": "wait_ack",
      "target_id": "end"
    }
  ]
}
