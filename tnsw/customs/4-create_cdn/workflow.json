{
  "id": "customs-create-cdn-flow",
  "name": "Create CDN",
  "version": 2,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "applicant_submission",
      "type": "TASK",
      "task_template_id": "customs-cdn--user-input",
      "input_mapping": {
        "cusdec_ref": "userform.cusdecRef",
        "container_label?": "userform.containerLabel",
        "cig_cdn.error?": "cig_cdn.error"
      },
      "output_mapping": {
        "officeCode": "userform.officeCode",
        "shipper": "userform.shipper",
        "consignee": "userform.consignee",
        "transport": "userform.transport",
        "goods": "userform.goods",
        "container": "userform.container",
        "noteDetails": "userform.noteDetails"
      }
    },
    {
      "id": "cig_dispatch",
      "type": "TASK",
      "task_template_id": "customs-cdn--cig-dispatch",
      "input_mapping": {
        "userform": "payload",
        "cusdec_ref": "payload.cusdecRef"
      },
      "output_mapping": {
        "cig_cdn.accepted": "cig_cdn.accepted",
        "cig_cdn.edgeId?": "cig_cdn.edge_id",
        "cig_cdn.error?": "cig_cdn.error"
      }
    },
    {
      "id": "dispatch_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "integration_wait",
      "type": "TASK",
      "task_template_id": "customs-cdn--integration-wait",
      "input_mapping": {
        "userform": "submission"
      },
      "output_mapping": {
        "integrated": "cdn_integration.integrated",
        "cdn_number?": "userform.registeredCdnNumber",
        "error?": "cig_cdn.error"
      }
    },
    {
      "id": "integration_check",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "applicant_submission"
    },
    {
      "id": "e2",
      "source_id": "applicant_submission",
      "target_id": "cig_dispatch"
    },
    {
      "id": "e_cig_check",
      "source_id": "cig_dispatch",
      "target_id": "dispatch_check"
    },
    {
      "id": "e_cig_accepted",
      "source_id": "dispatch_check",
      "target_id": "integration_wait",
      "condition": "cig_cdn.accepted == true"
    },
    {
      "id": "e_cig_rejected",
      "source_id": "dispatch_check",
      "target_id": "applicant_submission",
      "condition": "cig_cdn.accepted != true"
    },
    {
      "id": "e_wait_to_check",
      "source_id": "integration_wait",
      "target_id": "integration_check"
    },
    {
      "id": "e_integrated",
      "source_id": "integration_check",
      "target_id": "end",
      "condition": "cdn_integration.integrated == true"
    },
    {
      "id": "e_not_integrated",
      "source_id": "integration_check",
      "target_id": "applicant_submission",
      "condition": "cdn_integration.integrated != true"
    }
  ]
}
