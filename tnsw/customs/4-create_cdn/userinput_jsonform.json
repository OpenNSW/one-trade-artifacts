{
  "id": "customs-cdn--user-form",
  "title": "Cargo Dispatch Note (CDN) Application",
  "schema": {
    "type": "object",
    "properties": {
      "import_application_xml": {
        "type": "object",
        "title": "Import CDN XML",
        "description": "Upload a CDN XML to fill this form automatically. Also accepts a file from Download CDN XML. Values can be corrected afterwards.",
        "x-xml": {
          "accept": ".xml,text/xml,application/xml",
          "maxSize": 5242880,
          "persistDocument": false,
          "writeTo": [
            { "from": "CUSTOMS_CDN.officeCode", "to": "officeCode", "as": "string" },
            { "from": "CUSTOMS_CDN.shipper.id", "to": "shipper.id", "as": "string" },
            { "from": "CUSTOMS_CDN.shipper.name", "to": "shipper.name", "as": "string" },
            { "from": "CUSTOMS_CDN.shipper.address", "to": "shipper.address", "as": "string" },
            { "from": "CUSTOMS_CDN.shipper.countryCode", "to": "shipper.countryCode", "as": "string" },
            { "from": "CUSTOMS_CDN.consignee.id", "to": "consignee.id", "as": "string" },
            { "from": "CUSTOMS_CDN.consignee.name", "to": "consignee.name", "as": "string" },
            { "from": "CUSTOMS_CDN.consignee.address", "to": "consignee.address", "as": "string" },
            { "from": "CUSTOMS_CDN.consignee.countryCode", "to": "consignee.countryCode", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.voyageNumber", "to": "transport.voyageNumber", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.voyageDate", "to": "transport.voyageDate", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.exVessel", "to": "transport.exVessel", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.vessel", "to": "transport.vessel", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.vesselOpCode", "to": "transport.vesselOpCode", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.contOpCode", "to": "transport.contOpCode", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.placeOfDischarge", "to": "transport.placeOfDischarge", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.placeOfLoading", "to": "transport.placeOfLoading", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.lorryRegNo", "to": "transport.lorryRegNo", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.trailerRegNo", "to": "transport.trailerRegNo", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.driverName", "to": "transport.driverName", "as": "string" },
            { "from": "CUSTOMS_CDN.transport.locationOfGoods", "to": "transport.locationOfGoods", "as": "string" },
            { "from": "CUSTOMS_CDN.goods.description", "to": "goods.description", "as": "string" },
            { "from": "CUSTOMS_CDN.goods.packageNumber", "to": "goods.packageNumber", "as": "number" },
            { "from": "CUSTOMS_CDN.goods.packageType", "to": "goods.packageType", "as": "string" },
            { "from": "CUSTOMS_CDN.goods.grossWeight", "to": "goods.grossWeight", "as": "number" },
            { "from": "CUSTOMS_CDN.goods.volume", "to": "goods.volume", "as": "number" },
            { "from": "CUSTOMS_CDN.goods.bol", "to": "goods.bol", "as": "string" },
            { "from": "CUSTOMS_CDN.goods.tempRequired", "to": "goods.tempRequired", "as": "number" },
            { "from": "CUSTOMS_CDN.container.number", "to": "container.number", "as": "string" },
            { "from": "CUSTOMS_CDN.container.type", "to": "container.type", "as": "string" },
            { "from": "CUSTOMS_CDN.container.sealNo", "to": "container.sealNo", "as": "string" },
            { "from": "CUSTOMS_CDN.container.mark", "to": "container.mark", "as": "string" }
          ]
        }
      },
      "export_application_xml": {
        "type": "object",
        "title": "Download CDN XML",
        "description": "Download this CDN as XML, to fill it in again later through Import CDN XML.",
        "x-xml-export": {
          "rootElement": "CUSTOMS_CDN",
          "declaration": { "standalone": "no" },
          "fileName": "customs-cdn-{today(YYYYMMDD)}.xml",
          "writeTo": [
            { "from": "officeCode", "to": "officeCode", "as": "string" },
            { "from": "shipper.id", "to": "shipper.id", "as": "string" },
            { "from": "shipper.name", "to": "shipper.name", "as": "string" },
            { "from": "shipper.address", "to": "shipper.address", "as": "string" },
            { "from": "shipper.countryCode", "to": "shipper.countryCode", "as": "string" },
            { "from": "consignee.id", "to": "consignee.id", "as": "string" },
            { "from": "consignee.name", "to": "consignee.name", "as": "string" },
            { "from": "consignee.address", "to": "consignee.address", "as": "string" },
            { "from": "consignee.countryCode", "to": "consignee.countryCode", "as": "string" },
            { "from": "transport.voyageNumber", "to": "transport.voyageNumber", "as": "string" },
            { "from": "transport.voyageDate", "to": "transport.voyageDate", "as": "string" },
            { "from": "transport.exVessel", "to": "transport.exVessel", "as": "string" },
            { "from": "transport.vessel", "to": "transport.vessel", "as": "string" },
            { "from": "transport.vesselOpCode", "to": "transport.vesselOpCode", "as": "string" },
            { "from": "transport.contOpCode", "to": "transport.contOpCode", "as": "string" },
            { "from": "transport.placeOfDischarge", "to": "transport.placeOfDischarge", "as": "string" },
            { "from": "transport.placeOfLoading", "to": "transport.placeOfLoading", "as": "string" },
            { "from": "transport.lorryRegNo", "to": "transport.lorryRegNo", "as": "string" },
            { "from": "transport.trailerRegNo", "to": "transport.trailerRegNo", "as": "string" },
            { "from": "transport.driverName", "to": "transport.driverName", "as": "string" },
            { "from": "transport.locationOfGoods", "to": "transport.locationOfGoods", "as": "string" },
            { "from": "goods.description", "to": "goods.description", "as": "string" },
            { "from": "goods.packageNumber", "to": "goods.packageNumber", "as": "number" },
            { "from": "goods.packageType", "to": "goods.packageType", "as": "string" },
            { "from": "goods.grossWeight", "to": "goods.grossWeight", "as": "number" },
            { "from": "goods.volume", "to": "goods.volume", "as": "number" },
            { "from": "goods.bol", "to": "goods.bol", "as": "string" },
            { "from": "goods.tempRequired", "to": "goods.tempRequired", "as": "number" },
            { "from": "container.number", "to": "container.number", "as": "string" },
            { "from": "container.type", "to": "container.type", "as": "string" },
            { "from": "container.sealNo", "to": "container.sealNo", "as": "string" },
            { "from": "container.mark", "to": "container.mark", "as": "string" }
          ]
        }
      },
      "cancel_cdn": {
        "type": "boolean",
        "title": "Cancel this CDN",
        "description": "Tick to cancel this container's Cargo Dispatch Note instead of sending it to Sri Lanka Customs. Submitting then ends this container's dispatch, and nothing is sent; the sections below need not be filled in."
      },
      "officeCode": {
        "type": "string",
        "title": "Customs Office Code",
        "example": "CBEX1",
        "description": "Office of exit (UNCUOTAB). Annex B: officeCode."
      },
      "declarantTin": {
        "type": "string",
        "title": "35. Name of Declarant (TIN)",
        "readOnly": true,
        "description": "The declarant's TIN, filled in from the CHA profile. Printed on the Cargo Dispatch Note; not sent to Sri Lanka Customs."
      },
      "cusdecRef": {
        "type": "string",
        "title": "Customs Declaration Reference",
        "example": "CBEX1/2026/E/1047",
        "readOnly": true,
        "description": "The registered declaration this dispatch note carries cargo for. Filled in from the CusDec once Customs registers it."
      },
      "containerLabel": {
        "type": "string",
        "title": "Container",
        "example": "Container 1 of 3",
        "readOnly": true,
        "description": "One dispatch note is raised per container on the declaration."
      },
      "shipper": {
        "type": "object",
        "title": "1.a Shipper",
        "properties": {
          "id": {
            "type": "string",
            "title": "Shipper TIN / Code",
            "example": "900000000001"
          },
          "name": {
            "type": "string",
            "title": "Shipper Name",
            "example": "JOTHI COCONUT EXPORTERS"
          },
          "address": {
            "type": "string",
            "title": "Shipper Address",
            "example": "45A, KANDY ROAD, PILIMATHALAWA"
          },
          "countryCode": {
            "type": "string",
            "title": "Country Code",
            "description": "UNCTYTAB, 2 letters.",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--countries",
                "version": "1"
              }
            },
            "example": "LK"
          }
        }
      },
      "consignee": {
        "type": "object",
        "title": "2.b Consignee",
        "properties": {
          "id": {
            "type": "string",
            "title": "Consignee TIN / Code",
            "example": "IMP882"
          },
          "name": {
            "type": "string",
            "title": "Consignee Name",
            "example": "COCO WORLD SDN BHD"
          },
          "address": {
            "type": "string",
            "title": "Consignee Address",
            "example": "125, PUTRAJAYA, KUALA LUMPUR"
          },
          "countryCode": {
            "type": "string",
            "title": "Country Code",
            "description": "UNCTYTAB, 2 letters.",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--countries",
                "version": "1"
              }
            },
            "example": "MY"
          }
        }
      },
      "transport": {
        "type": "object",
        "title": "3–7. Voyage & Transport",
        "properties": {
          "voyageNumber": {
            "type": "string",
            "title": "3.a Voyage No",
            "example": "V092"
          },
          "voyageDate": {
            "type": "string",
            "title": "3.a Voyage Date",
            "example": "2026-06-25",
            "description": "YYYY-MM-DD."
          },
          "exVessel": {
            "type": "string",
            "title": "3.b Ex Vessel",
            "example": "MAERSK KOWLOON"
          },
          "vessel": {
            "type": "string",
            "title": "4. Vessel",
            "example": "CMA CGM MARCO POLO"
          },
          "vesselOpCode": {
            "type": "string",
            "title": "Vessel Op. Code",
            "example": "OP-MSC"
          },
          "contOpCode": {
            "type": "string",
            "title": "Cont. Op. Code",
            "example": "CO-882"
          },
          "placeOfDischarge": {
            "type": "string",
            "title": "5. Port of Discharge",
            "description": "UNLOCTAB, 5 characters.",
            "x-search": {
              "service": "static-data",
              "mode": "large-paginated-list",
              "displayTemplate": "{name} ({id})",
              "params": {
                "id": "customs-cusdec--port-of-entry-and-discharge",
                "version": "1"
              }
            },
            "example": "DEHAM"
          },
          "placeOfLoading": {
            "type": "string",
            "title": "6. Port of Loading",
            "description": "UNLOCTAB, 5 characters.",
            "x-search": {
              "service": "static-data",
              "mode": "large-paginated-list",
              "displayTemplate": "{name} ({id})",
              "params": {
                "id": "customs-cusdec--port-of-entry-and-discharge",
                "version": "1"
              }
            },
            "example": "LKCMB"
          },
          "lorryRegNo": {
            "type": "string",
            "title": "7. Lorry Reg. No",
            "example": "WP-LY-4920"
          },
          "trailerRegNo": {
            "type": "string",
            "title": "7. Trailer Reg. No",
            "example": "TR-8841"
          },
          "driverName": {
            "type": "string",
            "title": "12. Name of the Driver",
            "example": "K. A. Sunil Perera"
          },
          "locationOfGoods": {
            "type": "string",
            "title": "13. Location of Goods",
            "description": "UNSHDTAB shed / location code.",
            "x-search": {
              "service": "static-data",
              "mode": "small-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--sheds",
                "version": "1"
              }
            },
            "example": "CFS1"
          }
        }
      },
      "goods": {
        "type": "object",
        "title": "19–24. Goods & Packaging",
        "properties": {
          "description": {
            "type": "string",
            "title": "20. Description of Goods",
            "example": "Refined Organic Coconut Oil"
          },
          "packageNumber": {
            "type": "number",
            "title": "19. Number of Packages",
            "example": 80
          },
          "packageType": {
            "type": "string",
            "title": "19. Kind of Packages",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "({id}) - {name}",
              "params": {
                "id": "customs-cusdec--package-types",
                "version": "1"
              }
            },
            "example": "DR",
            "description": "Package type code, e.g. DR (drum), PX (pallet)."
          },
          "grossWeight": {
            "type": "number",
            "title": "21.a Gross Weight (Kg)",
            "example": 16500.5
          },
          "volume": {
            "type": "number",
            "title": "22. Cube (m³)",
            "example": 32.5
          },
          "bol": {
            "type": "string",
            "title": "8. SN (B/L) No",
            "example": "BL-9382019-COL"
          },
          "tempRequired": {
            "type": "number",
            "title": "24. Reefer Temperature Required (°C)",
            "example": 4
          }
        }
      },
      "container": {
        "type": "object",
        "title": "18 & 23. Container",
        "properties": {
          "number": {
            "type": "string",
            "title": "18. Container No",
            "example": "MSCU8492019"
          },
          "type": {
            "type": "string",
            "title": "23. Type of Container",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "({id}) - {name}",
              "params": {
                "id": "customs-cusdec--container-types",
                "version": "1"
              }
            },
            "example": "20GP",
            "description": "Height / length / type, e.g. 20GP, 40HC."
          },
          "sealNo": {
            "type": "string",
            "title": "11.a Seal No",
            "example": "894021"
          },
          "mark": {
            "type": "string",
            "title": "18. Marks & Numbers",
            "example": "MSCU-849201-9"
          }
        },
        "description": "The single container this dispatch note covers. Annex B carries one container per CDN."
      }
    },
    "if": {
      "properties": {
        "cancel_cdn": {
          "const": true
        }
      },
      "required": [
        "cancel_cdn"
      ]
    },
    "else": {
      "required": [
        "officeCode",
        "cusdecRef",
        "shipper",
        "consignee",
        "transport",
        "goods",
        "container"
      ],
      "properties": {
        "shipper": {
          "required": [
            "id",
            "name",
            "address",
            "countryCode"
          ]
        },
        "consignee": {
          "required": [
            "id",
            "name",
            "address",
            "countryCode"
          ]
        },
        "transport": {
          "required": [
            "voyageNumber",
            "voyageDate",
            "vessel",
            "vesselOpCode",
            "contOpCode",
            "placeOfDischarge",
            "placeOfLoading",
            "lorryRegNo",
            "trailerRegNo",
            "driverName",
            "locationOfGoods"
          ]
        },
        "goods": {
          "required": [
            "description",
            "packageNumber",
            "packageType",
            "grossWeight"
          ]
        },
        "container": {
          "required": [
            "number",
            "type",
            "sealNo",
            "mark"
          ]
        }
      }
    }
  },
  "uiSchema": {
    "type": "Categorization",
    "options": {
      "variant": "stepper"
    },
    "elements": [
      {
        "type": "Category",
        "label": "Declaration and Container",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/import_application_xml"
          },
          {
            "type": "Control",
            "scope": "#/properties/export_application_xml"
          },
          {
            "type": "Control",
            "scope": "#/properties/cancel_cdn"
          },
          {
            "type": "Control",
            "scope": "#/properties/cusdecRef"
          },
          {
            "type": "Control",
            "scope": "#/properties/containerLabel"
          },
          {
            "type": "Control",
            "scope": "#/properties/officeCode"
          },
          {
            "type": "Control",
            "scope": "#/properties/declarantTin"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Shipper and Consignee",
        "elements": [
          {
            "type": "Group",
            "label": "Shipper",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/shipper/properties/id"
              },
              {
                "type": "Control",
                "scope": "#/properties/shipper/properties/name"
              },
              {
                "type": "Control",
                "scope": "#/properties/shipper/properties/address"
              },
              {
                "type": "Control",
                "scope": "#/properties/shipper/properties/countryCode"
              }
            ]
          },
          {
            "type": "Group",
            "label": "Consignee",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/consignee/properties/id"
              },
              {
                "type": "Control",
                "scope": "#/properties/consignee/properties/name"
              },
              {
                "type": "Control",
                "scope": "#/properties/consignee/properties/address"
              },
              {
                "type": "Control",
                "scope": "#/properties/consignee/properties/countryCode"
              }
            ]
          }
        ]
      },
      {
        "type": "Category",
        "label": "Voyage and Transport",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/voyageNumber"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/voyageDate"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/vessel"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/exVessel"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/vesselOpCode"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/contOpCode"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/placeOfLoading"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/placeOfDischarge"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/lorryRegNo"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/trailerRegNo"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/driverName"
          },
          {
            "type": "Control",
            "scope": "#/properties/transport/properties/locationOfGoods"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Container",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/container/properties/number"
          },
          {
            "type": "Control",
            "scope": "#/properties/container/properties/type"
          },
          {
            "type": "Control",
            "scope": "#/properties/container/properties/sealNo"
          },
          {
            "type": "Control",
            "scope": "#/properties/container/properties/mark"
          }
        ]
      },
      {
        "type": "Category",
        "label": "Goods and Packaging",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/goods/properties/description"
          },
          {
            "type": "Control",
            "scope": "#/properties/goods/properties/packageNumber"
          },
          {
            "type": "Control",
            "scope": "#/properties/goods/properties/packageType"
          },
          {
            "type": "Control",
            "scope": "#/properties/goods/properties/grossWeight"
          },
          {
            "type": "Control",
            "scope": "#/properties/goods/properties/volume"
          },
          {
            "type": "Control",
            "scope": "#/properties/goods/properties/bol"
          },
          {
            "type": "Control",
            "scope": "#/properties/goods/properties/tempRequired"
          }
        ]
      }
    ]
  }
}
