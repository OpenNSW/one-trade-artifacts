{
  "id": "customs-cdn--user-form",
  "title": "Cargo Dispatch Note (CDN) Application",
  "schema": {
    "type": "object",
    "properties": {
      "officeCode": {
        "type": "string",
        "title": "Customs Office Code",
        "example": "CBEX1",
        "description": "Office of exit (UNCUOTAB). Annex B: officeCode."
      },
      "cusdecRef": {
        "type": "string",
        "title": "Customs Declaration Reference",
        "example": "CBEX1/2026/E/1047",
        "readOnly": true,
        "description": "The registered declaration this dispatch note carries cargo for. Filled in from the CusDec once Customs registers it."
      },
      "containerLabel": {
        "type": "string",
        "title": "Container",
        "example": "Container 1 of 3",
        "readOnly": true,
        "description": "One dispatch note is raised per container on the declaration."
      },
      "shipper": {
        "type": "object",
        "title": "1.a Shipper",
        "properties": {
          "id": {
            "type": "string",
            "title": "Shipper TIN / Code",
            "example": "1240016847000"
          },
          "name": {
            "type": "string",
            "title": "Shipper Name",
            "example": "JOTHI COCONUT EXPORTERS"
          },
          "address": {
            "type": "string",
            "title": "Shipper Address",
            "example": "45A, KANDY ROAD, PILIMATHALAWA"
          },
          "countryCode": {
            "type": "string",
            "title": "Country Code",
            "example": "LK",
            "description": "UNCTYTAB, 2 letters."
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "countryCode"
        ]
      },
      "consignee": {
        "type": "object",
        "title": "2.b Consignee",
        "properties": {
          "id": {
            "type": "string",
            "title": "Consignee TIN / Code",
            "example": "IMP882"
          },
          "name": {
            "type": "string",
            "title": "Consignee Name",
            "example": "COCO WORLD SDN BHD"
          },
          "address": {
            "type": "string",
            "title": "Consignee Address",
            "example": "125, PUTRAJAYA, KUALA LUMPUR"
          },
          "countryCode": {
            "type": "string",
            "title": "Country Code",
            "example": "MY",
            "description": "UNCTYTAB, 2 letters."
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "countryCode"
        ]
      },
      "transport": {
        "type": "object",
        "title": "3–7. Voyage & Transport",
        "properties": {
          "voyageNumber": {
            "type": "string",
            "title": "3.a Voyage No",
            "example": "V092"
          },
          "voyageDate": {
            "type": "string",
            "title": "3.a Voyage Date",
            "example": "2026-06-25",
            "description": "YYYY-MM-DD."
          },
          "exVessel": {
            "type": "string",
            "title": "3.b Ex Vessel",
            "example": "MAERSK KOWLOON"
          },
          "vessel": {
            "type": "string",
            "title": "4. Vessel",
            "example": "CMA CGM MARCO POLO"
          },
          "vesselOpCode": {
            "type": "string",
            "title": "Vessel Op. Code",
            "example": "OP-MSC"
          },
          "contOpCode": {
            "type": "string",
            "title": "Cont. Op. Code",
            "example": "CO-882"
          },
          "placeOfDischarge": {
            "type": "string",
            "title": "5. Port of Discharge",
            "example": "DEHAM",
            "description": "UNLOCTAB, 5 characters."
          },
          "placeOfLoading": {
            "type": "string",
            "title": "6. Port of Loading",
            "example": "LKCMB",
            "description": "UNLOCTAB, 5 characters."
          },
          "lorryRegNo": {
            "type": "string",
            "title": "7. Lorry Reg. No",
            "example": "WP-LY-4920"
          },
          "trailerRegNo": {
            "type": "string",
            "title": "7. Trailer Reg. No",
            "example": "TR-8841"
          },
          "driverName": {
            "type": "string",
            "title": "12. Name of the Driver",
            "example": "K. A. Sunil Perera"
          },
          "locationOfGoods": {
            "type": "string",
            "title": "13. Location of Goods",
            "example": "CFS1",
            "description": "UNSHDTAB shed / location code."
          }
        },
        "required": [
          "voyageNumber",
          "voyageDate",
          "vessel",
          "vesselOpCode",
          "contOpCode",
          "placeOfDischarge",
          "placeOfLoading",
          "lorryRegNo",
          "trailerRegNo",
          "driverName",
          "locationOfGoods"
        ]
      },
      "goods": {
        "type": "object",
        "title": "19–24. Goods & Packaging",
        "properties": {
          "description": {
            "type": "string",
            "title": "20. Description of Goods",
            "example": "Refined Organic Coconut Oil"
          },
          "packageNumber": {
            "type": "number",
            "title": "19. Number of Packages",
            "example": 80
          },
          "packageType": {
            "type": "string",
            "title": "19. Kind of Packages",
            "example": "DR",
            "description": "Package type code, e.g. DR (drum), PX (pallet)."
          },
          "grossWeight": {
            "type": "number",
            "title": "21.a Gross Weight (Kg)",
            "example": 16500.5
          },
          "volume": {
            "type": "number",
            "title": "22. Cube (m³)",
            "example": 32.5
          },
          "bol": {
            "type": "string",
            "title": "8. SN (B/L) No",
            "example": "BL-9382019-COL"
          },
          "tempRequired": {
            "type": "number",
            "title": "24. Reefer Temperature Required (°C)",
            "example": 4
          }
        },
        "required": [
          "description",
          "packageNumber",
          "packageType",
          "grossWeight"
        ]
      },
      "container": {
        "type": "object",
        "title": "18 & 23. Container",
        "properties": {
          "number": {
            "type": "string",
            "title": "18. Container No",
            "example": "MSCU8492019"
          },
          "type": {
            "type": "string",
            "title": "23. Type of Container",
            "example": "20GP",
            "description": "Height / length / type, e.g. 20GP, 40HC."
          },
          "sealNo": {
            "type": "string",
            "title": "11.a Seal No",
            "example": "894021"
          },
          "mark": {
            "type": "string",
            "title": "18. Marks & Numbers",
            "example": "MSCU-849201-9"
          }
        },
        "required": [
          "number",
          "type",
          "sealNo",
          "mark"
        ],
        "description": "The single container this dispatch note covers. Annex B carries one container per CDN."
      },
      "noteDetails": {
        "type": "object",
        "title": "Dispatch Note Details",
        "properties": {
          "cdnNumber": {
            "type": "string",
            "title": "CDN No",
            "example": "CDN-2026-00481"
          },
          "brslSelection": {
            "type": "string",
            "title": "2. B / R / S / L Selection",
            "oneOf": [
              {
                "const": "B",
                "title": "B"
              },
              {
                "const": "R",
                "title": "R"
              },
              {
                "const": "S",
                "title": "S"
              },
              {
                "const": "L",
                "title": "L"
              }
            ],
            "default": "B"
          },
          "tareWeight": {
            "type": "number",
            "title": "9. Tare Wt. (Kg)",
            "example": 2200
          },
          "placeOfReceipt": {
            "type": "string",
            "title": "26. Place of Receipt (CY / CFS / DOOR)",
            "example": "CFS"
          },
          "placeOfDelivery": {
            "type": "string",
            "title": "25. Place of Delivery (CY / CFS / DOOR)",
            "example": "CY"
          },
          "departureTime": {
            "type": "string",
            "title": "15. Time of Departure from Stores/CFS",
            "example": "10:30 AM"
          },
          "otherAccompanyingDocs": {
            "type": "string",
            "title": "14. Any other Accompanying Document details"
          },
          "certifyingOfficer": {
            "type": "string",
            "title": "16. Certifying security officer / authorized signatory",
            "example": "S. D. Bandara"
          },
          "signatureDesignationDate": {
            "type": "string",
            "title": "17. Signature, Designation and Date",
            "example": "S.D. Bandara, Chief Security Officer - 2026-06-22"
          },
          "preparingCompanyName": {
            "type": "string",
            "title": "34. Name of Company preparing Note",
            "example": "ADAM PVT LTD (CHA)"
          },
          "declarantName": {
            "type": "string",
            "title": "35. Name of the Declarant",
            "example": "M. T. Fernando"
          },
          "telephoneNo": {
            "type": "string",
            "title": "36. Telephone No",
            "example": "0112345678"
          },
          "declarantSignature": {
            "type": "string",
            "title": "37. Signature of Declarant",
            "example": "M. T. Fernando"
          }
        },
        "required": [
          "cdnNumber",
          "declarantName",
          "preparingCompanyName",
          "telephoneNo"
        ],
        "description": "Fields the printed Cargo Dispatch Note carries that Annex B does not define; they are kept on the record and are not sent to ASYCUDA."
      }
    },
    "required": [
      "officeCode",
      "shipper",
      "consignee",
      "transport",
      "goods",
      "container",
      "noteDetails"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Group",
        "label": "Declaration & Container",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/cusdecRef"
              },
              {
                "type": "Control",
                "scope": "#/properties/containerLabel"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/officeCode"
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "label": "1. Shipper & Consignee",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/shipper/properties/id"
              },
              {
                "type": "Control",
                "scope": "#/properties/shipper/properties/name"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/shipper/properties/address"
              },
              {
                "type": "Control",
                "scope": "#/properties/shipper/properties/countryCode"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/consignee/properties/id"
              },
              {
                "type": "Control",
                "scope": "#/properties/consignee/properties/name"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/consignee/properties/address"
              },
              {
                "type": "Control",
                "scope": "#/properties/consignee/properties/countryCode"
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "label": "2. Voyage & Transport",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/voyageNumber"
              },
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/voyageDate"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/vessel"
              },
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/exVessel"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/vesselOpCode"
              },
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/contOpCode"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/placeOfLoading"
              },
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/placeOfDischarge"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/lorryRegNo"
              },
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/trailerRegNo"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/driverName"
              },
              {
                "type": "Control",
                "scope": "#/properties/transport/properties/locationOfGoods"
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "label": "3. Container",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/container/properties/number"
              },
              {
                "type": "Control",
                "scope": "#/properties/container/properties/type"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/container/properties/sealNo"
              },
              {
                "type": "Control",
                "scope": "#/properties/container/properties/mark"
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "label": "4. Goods & Packaging",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/goods/properties/description"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/goods/properties/packageNumber"
              },
              {
                "type": "Control",
                "scope": "#/properties/goods/properties/packageType"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/goods/properties/grossWeight"
              },
              {
                "type": "Control",
                "scope": "#/properties/goods/properties/volume"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/goods/properties/bol"
              },
              {
                "type": "Control",
                "scope": "#/properties/goods/properties/tempRequired"
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "label": "5. Dispatch Note Details",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/cdnNumber"
              },
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/brslSelection"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/tareWeight"
              },
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/departureTime"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/placeOfReceipt"
              },
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/placeOfDelivery"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/otherAccompanyingDocs"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/certifyingOfficer"
              },
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/signatureDesignationDate"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/preparingCompanyName"
              },
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/declarantName"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/telephoneNo"
              },
              {
                "type": "Control",
                "scope": "#/properties/noteDetails/properties/declarantSignature"
              }
            ]
          }
        ]
      }
    ]
  }
}
