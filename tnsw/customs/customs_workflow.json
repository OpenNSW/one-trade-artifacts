{
  "id": "customs-workflow",
  "name": "Customs Declaration & Clearance Process",
  "version": 1,
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "name": "Start"
    },
    {
      "id": "customs_1_cusdec_submission",
      "type": "TASK",
      "name": "[Customs 1.0] Submit CusDec",
      "task_template_id": "customs-cusdec-apply-flow",
      "lane": "Trader/CHA",
      "input_mapping": {},
      "output_mapping": {
        "reviewerform.review_outcome": "customs.cusdec_review_outcome",
        "reviewerform.cusdec_number": "customs.cusdec_number",
        "reviewerform.amount_to_pay": "customs.amount_to_pay",
        "userform": "customs.userform"
      }
    },
    {
      "id": "customs_2_wait_payment",
      "type": "TASK",
      "name": "[Customs 2.0] Wait on Payment",
      "task_template_id": "customs-wait-payment-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "customs.amount_to_pay": "amount_to_pay",
        "customs.cusdec_number": "cusdec_number",
        "customs.userform": "userform"
      },
      "output_mapping": {
        "payment_status": "customs.payment_status"
      }
    },
    {
      "id": "customs_3_wait_warranting",
      "type": "TASK",
      "name": "[Customs 3.0] Wait on CusDec Warranting",
      "task_template_id": "customs-wait-warranting-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "customs.cusdec_number": "cusdec_number",
        "customs.userform": "userform"
      },
      "output_mapping": {
        "warranting_status": "customs.warranting_status"
      }
    },
    {
      "id": "customs_4a_prepare_cdn_items",
      "type": "TASK",
      "name": "[Customs 4.0a] Prepare CDN Items",
      "task_template_id": "customs-prepare-cdn-items-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "customs.userform.containerCount": "container_count",
        "customs.cusdec_number?": "cusdec_ref"
      },
      "output_mapping": {
        "split_items": "customs.cdn_split_items"
      }
    },
    {
      "id": "customs_4_create_cdn",
      "type": "SPLIT_TASK",
      "name": "[Customs 4.0] Create CDNs",
      "task_template_id": "customs-cdn-branch-flow",
      "lane": "Trader/CHA",
      "split_task": {
        "mode": "SAME_TEMPLATE",
        "items_variable": "customs.cdn_split_items",
        "results_variable": "customs.cdn_results",
        "failure_mode": "COLLECT_ALL"
      }
    },
    {
      "id": "customs_4b_collect_cdn_results",
      "type": "TASK",
      "name": "[Customs 4.0b] Collect CDN Results",
      "task_template_id": "customs-collect-cdn-results-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "customs.cdn_results": "cdn_results"
      },
      "output_mapping": {
        "cdn_userform": "customs.cdn_userform",
        "cdn_number?": "customs.cdn_number",
        "cdn_numbers": "customs.cdn_numbers"
      }
    },
    {
      "id": "customs_6_create_boat_note",
      "type": "TASK",
      "name": "[Customs 6.0] Create Boat Note",
      "task_template_id": "customs-create-boat-note-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "customs.cdn_number": "cdn_number"
      },
      "output_mapping": {
        "userform": "customs.boat_note_userform"
      }
    },
    {
      "id": "customs_7_boat_note_approval",
      "type": "TASK",
      "name": "[Customs 7.0] Boat Note Approval",
      "task_template_id": "customs-boat-note-approval-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "customs.boat_note_userform": "userform"
      },
      "output_mapping": {
        "approval_status": "customs.boat_note_approval_status"
      }
    },
    {
      "id": "customs_8_wait_export_release",
      "type": "TASK",
      "name": "[Customs 8.0] Wait on Export Release",
      "task_template_id": "customs-wait-export-release-flow",
      "lane": "Trader/CHA",
      "input_mapping": {
        "customs.cusdec_number": "cusdec_number",
        "customs.userform": "userform"
      },
      "output_mapping": {
        "release_status": "customs.export_release_status"
      }
    },
    {
      "id": "end",
      "type": "END",
      "name": "End"
    }
  ],
  "edges": [
    {
      "id": "e_start_to_1",
      "source_id": "start",
      "target_id": "customs_1_cusdec_submission"
    },
    {
      "id": "e_1_to_2",
      "source_id": "customs_1_cusdec_submission",
      "target_id": "customs_2_wait_payment"
    },
    {
      "id": "e_2_to_3",
      "source_id": "customs_2_wait_payment",
      "target_id": "customs_3_wait_warranting"
    },
    {
      "id": "e_3_to_4a",
      "source_id": "customs_3_wait_warranting",
      "target_id": "customs_4a_prepare_cdn_items"
    },
    {
      "id": "e_4a_to_4",
      "source_id": "customs_4a_prepare_cdn_items",
      "target_id": "customs_4_create_cdn"
    },
    {
      "id": "e_4_to_4b",
      "source_id": "customs_4_create_cdn",
      "target_id": "customs_4b_collect_cdn_results"
    },
    {
      "id": "e_4b_to_6",
      "source_id": "customs_4b_collect_cdn_results",
      "target_id": "customs_6_create_boat_note"
    },
    {
      "id": "e_6_to_7",
      "source_id": "customs_6_create_boat_note",
      "target_id": "customs_7_boat_note_approval"
    },
    {
      "id": "e_7_to_8",
      "source_id": "customs_7_boat_note_approval",
      "target_id": "customs_8_wait_export_release"
    },
    {
      "id": "e_8_to_end",
      "source_id": "customs_8_wait_export_release",
      "target_id": "end"
    }
  ]
}
