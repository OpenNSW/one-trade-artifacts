{
  "id": "customs-create-boat-note-flow:render",
  "type": "APPLICATION",
  "title": "[Customs] Boat Note Creation",
  "sections": {
    "changes_requested": {
      "templateId": "customs-boat-note--changes-requested",
      "title": "Officer Requested Changes",
      "projector": "MARKDOWN",
