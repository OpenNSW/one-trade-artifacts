{
  "id": "customs-cusdec--user-form",
  "title": "Customs Declaration (CusDec) Submission",
  "schema": {
    "type": "object",
    "properties": {
      "shipmentType": {
        "type": "string",
        "title": "Shipment Type",
        "oneOf": [
          {
            "const": "FCL",
            "title": "FCL — Full Container Load"
          },
          {
            "const": "LCL",
            "title": "LCL — Less than Container Load"
          },
          {
            "const": "BREAK_BULK",
            "title": "Break Bulk"
          }
        ],
        "example": "FCL"
      },
      "containerCount": {
        "type": "integer",
        "title": "Container Count",
        "minimum": 0,
        "example": 2
      },
      "identification": {
        "type": "object",
        "title": "Identification",
        "properties": {
          "officeCode": {
            "type": "string",
            "title": "Customs Office Code",
            "example": "CBEX1"
          },
          "declarationType": {
            "type": "string",
            "title": "Declaration Type",
            "oneOf": [
              {
                "const": "EX",
                "title": "EX — Export"
              },
              {
                "const": "IM",
                "title": "IM — Import"
              }
            ],
            "example": "EX"
          },
          "generalProcedureCode": {
            "type": "string",
            "title": "General Procedure Code",
            "example": "1"
          },
          "transitDocumentType": {
            "type": "string",
            "title": "Transit Document Type",
            "example": "01"
          },
          "manifestRegNumber": {
            "type": "string",
            "title": "Manifest Registration Number",
            "example": ""
          }
        },
        "required": [
          "officeCode",
          "declarationType",
          "generalProcedureCode"
        ]
      },
      "traders": {
        "type": "object",
        "title": "Traders",
        "properties": {
          "exporter": {
            "type": "object",
            "title": "Exporter",
            "properties": {
              "code": {
                "type": "string",
                "title": "Exporter TIN / Code",
                "example": "992000000001"
              },
              "name": {
                "type": "string",
                "title": "Exporter Name",
                "example": ""
              },
              "address": {
                "type": "string",
                "title": "Exporter Address",
                "example": ""
              },
              "countryCode": {
                "type": "string",
                "title": "Country Code",
                "example": ""
              }
            },
            "required": [
              "code"
            ]
          },
          "consignee": {
            "type": "object",
            "title": "Consignee",
            "properties": {
              "code": {
                "type": "string",
                "title": "Consignee TIN / Code",
                "example": ""
              },
              "name": {
                "type": "string",
                "title": "Consignee Name",
                "example": "MERIDIAN IMPORT TRADING KK"
              },
              "address": {
                "type": "string",
                "title": "Consignee Address",
                "example": "8-1 EXAMPLE DORI, MINATO-KU, TOKYO, JAPAN"
              },
              "countryCode": {
                "type": "string",
                "title": "Country Code",
                "example": "JP"
              }
            }
          },
          "declarant": {
            "type": "object",
            "title": "Declarant",
            "properties": {
              "code": {
                "type": "string",
                "title": "Declarant Code",
                "example": "991000000002"
              },
              "referenceNo": {
                "type": "string",
                "title": "Reference No",
                "example": "#1"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "exporter",
          "declarant"
        ]
      },
      "generalInfo": {
        "type": "object",
        "title": "General Information",
        "properties": {
          "countryOfFirstDestination": {
            "type": "string",
            "title": "Country of First Destination",
            "example": "JP"
          },
          "exportCountryCode": {
            "type": "string",
            "title": "Export Country Code",
            "example": "LK"
          },
          "destinationCountryCode": {
            "type": "string",
            "title": "Destination Country Code",
            "example": "JP"
          },
          "commentsText": {
            "type": "string",
            "title": "Comments",
            "example": "Test export declaration"
          }
        },
        "required": [
          "countryOfFirstDestination",
          "exportCountryCode",
          "destinationCountryCode"
        ]
      },
      "transport": {
        "type": "object",
        "title": "Transport",
        "properties": {
          "vesselName": {
            "type": "string",
            "title": "Vessel Name",
            "example": "MV EXAMPLE CARRIER"
          },
          "transportNationality": {
            "type": "string",
            "title": "Transport Nationality",
            "description": "Country code of the vessel/aircraft at departure.",
            "example": "LK"
          },
          "voyageNo": {
            "type": "string",
            "title": "Voyage No",
            "example": "V-2026-018"
          },
          "voyageNationality": {
            "type": "string",
            "title": "Voyage Nationality",
            "example": "LK"
          },
          "modeOfTransport": {
            "type": "string",
            "title": "Mode of Transport",
            "oneOf": [
              {
                "const": "1",
                "title": "1 — Sea"
              },
              {
                "const": "3",
                "title": "3 — Road"
              },
              {
                "const": "4",
                "title": "4 — Air"
              }
            ],
            "example": "1"
          },
          "containerized": {
            "type": "boolean",
            "title": "Containerized",
            "example": true
          },
          "deliveryTermsCode": {
            "type": "string",
            "title": "Delivery Terms Code",
            "example": "FOB"
          },
          "deliveryTermsPlace": {
            "type": "string",
            "title": "Delivery Terms Place",
            "example": "Tokyo"
          },
          "borderOfficeCode": {
            "type": "string",
            "title": "Border Office Code",
            "example": "CBEX1"
          },
          "placeOfLoadingCode": {
            "type": "string",
            "title": "Place of Loading Code",
            "example": "CNNBO"
          },
          "placeOfLoadingName": {
            "type": "string",
            "title": "Place of Loading Name",
            "example": "CNNBO"
          },
          "placeOfDischargeCode": {
            "type": "string",
            "title": "Place of Discharge Code",
            "description": "UN/LOCODE of the place where the goods are discharged.",
            "example": "LKADP"
          },
          "warehouseCode": {
            "type": "string",
            "title": "Warehouse Code",
            "example": "WH01"
          },
          "warehouseDelay": {
            "type": "integer",
            "title": "Warehouse Delay (days)",
            "minimum": 0,
            "example": 0
          }
        },
        "required": [
          "vesselName",
          "transportNationality",
          "deliveryTermsCode",
          "deliveryTermsPlace",
          "modeOfTransport",
          "placeOfDischargeCode",
          "borderOfficeCode",
          "containerized"
        ]
      },
      "financial": {
        "type": "object",
        "title": "Financial",
        "properties": {
          "bankCode": {
            "type": "string",
            "title": "Bank Code",
            "example": "6010"
          },
          "bankName": {
            "type": "string",
            "title": "Bank Name",
            "example": "Commercial Bank"
          },
          "bankBranch": {
            "type": "string",
            "title": "Bank Branch",
            "example": "001"
          },
          "bankReference": {
            "type": "string",
            "title": "Bank Reference",
            "example": "REM-2026-000123"
          },
          "remittanceAmount": {
            "type": "number",
            "title": "Remittance Amount",
            "description": "Amount remitted through the bank against this declaration.",
            "example": 1500
          },
          "paymentTermsCode": {
            "type": "string",
            "title": "Payment Terms Code",
            "example": "10"
          },
          "modeOfPayment": {
            "type": "string",
            "title": "Mode of Payment",
            "example": "CASH"
          },
          "deferredPayment": {
            "type": "string",
            "title": "Deferred Payment Reference",
            "example": "DP-2026-0001"
          }
        },
        "required": [
          "bankCode",
          "bankReference",
          "paymentTermsCode",
          "remittanceAmount"
        ]
      },
      "valuation": {
        "type": "object",
        "title": "Valuation",
        "properties": {
          "invoiceAmountForeign": {
            "type": "number",
            "title": "Invoice Amount (Foreign)",
            "example": 1500
          },
          "invoiceCurrencyCode": {
            "type": "string",
            "title": "Invoice Currency",
            "example": "USD"
          },
          "invoiceAmountLKR": {
            "type": "number",
            "title": "Invoice Amount (LKR)",
            "example": 0
          },
          "externalFreight": {
            "type": "object",
            "title": "External Freight",
            "properties": {
              "amountForeign": {
                "type": "number",
                "title": "Amount (Foreign)",
                "example": 100
              },
              "amountLKR": {
                "type": "number",
                "title": "Amount (LKR)",
                "example": 0
              },
              "currencyCode": {
                "type": "string",
                "title": "Currency",
                "example": "USD"
              }
            }
          },
          "internalFreight": {
            "type": "object",
            "title": "Internal Freight",
            "properties": {
              "amountForeign": {
                "type": "number",
                "title": "Amount (Foreign)",
                "example": 0
              },
              "amountLKR": {
                "type": "number",
                "title": "Amount (LKR)",
                "example": 0
              }
            }
          },
          "insurance": {
            "type": "object",
            "title": "Insurance",
            "properties": {
              "amountForeign": {
                "type": "number",
                "title": "Amount (Foreign)",
                "example": 0
              },
              "amountLKR": {
                "type": "number",
                "title": "Amount (LKR)",
                "example": 0
              }
            }
          },
          "otherCost": {
            "type": "object",
            "title": "Other Cost",
            "properties": {
              "amountForeign": {
                "type": "number",
                "title": "Amount (Foreign)",
                "example": 0
              },
              "amountLKR": {
                "type": "number",
                "title": "Amount (LKR)",
                "example": 0
              }
            }
          },
          "deduction": {
            "type": "object",
            "title": "Deduction",
            "properties": {
              "amountForeign": {
                "type": "number",
                "title": "Amount (Foreign)",
                "example": 0
              },
              "amountLKR": {
                "type": "number",
                "title": "Amount (LKR)",
                "example": 0
              }
            }
          },
          "totalGrossWeight": {
            "type": "number",
            "title": "Total Gross Weight (Kg)",
            "example": 1500
          }
        },
        "required": [
          "invoiceAmountForeign",
          "invoiceCurrencyCode"
        ]
      },
      "packages": {
        "type": "object",
        "title": "Packages",
        "properties": {
          "totalPackages": {
            "type": "integer",
            "title": "Total Packages",
            "minimum": 0,
            "example": 10
          },
          "numberOfLoadingLists": {
            "type": "integer",
            "title": "Number of Loading Lists",
            "minimum": 0,
            "example": 0
          }
        },
        "required": [
          "totalPackages"
        ]
      },
      "items": {
        "type": "array",
        "title": "Declaration Items",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "packages": {
              "type": "object",
              "title": "Packages",
              "properties": {
                "quantity": {
                  "type": "integer",
                  "title": "Quantity",
                  "minimum": 0,
                  "example": 10
                },
                "kindCode": {
                  "type": "string",
                  "title": "Package Kind Code",
                  "example": "2C"
                },
                "kindName": {
                  "type": "string",
                  "title": "Package Kind Name",
                  "example": "Package"
                }
              },
              "required": [
                "quantity",
                "kindCode"
              ]
            },
            "tarification": {
              "type": "object",
              "title": "Tarification",
              "properties": {
                "hsCode": {
                  "type": "string",
                  "title": "HS Code",
                  "example": "0801119000"
                },
                "hsPrecision1": {
                  "type": "string",
                  "title": "HS Precision 1",
                  "example": "00"
                },
                "preferenceCode": {
                  "type": "string",
                  "title": "Preference Code",
                  "example": ""
                },
                "extendedProcedureCode": {
                  "type": "string",
                  "title": "Extended Procedure Code",
                  "example": "1000"
                },
                "nationalProcedureCode": {
                  "type": "string",
                  "title": "National Procedure Code",
                  "example": "000"
                },
                "supplementaryUnit": {
                  "type": "object",
                  "title": "Supplementary Unit",
                  "properties": {
                    "code": {
                      "type": "string",
                      "title": "Unit Code",
                      "example": "KGM"
                    },
                    "quantity": {
                      "type": "number",
                      "title": "Quantity",
                      "example": 125
                    }
                  },
                  "required": [
                    "quantity",
                    "code"
                  ]
                },
                "itemPrice": {
                  "type": "number",
                  "title": "Item Price",
                  "example": 2400
                },
                "incoTermsCode": {
                  "type": "string",
                  "title": "Incoterms Code",
                  "example": "CIF"
                },
                "incoTermsPlace": {
                  "type": "string",
                  "title": "Incoterms Place",
                  "example": "TEST INCO TERMS PLACE"
                }
              },
              "required": [
                "hsCode",
                "extendedProcedureCode",
                "nationalProcedureCode",
                "supplementaryUnit"
              ]
            },
            "goodsDescription": {
              "type": "object",
              "title": "Goods Description",
              "properties": {
                "originCountryCode": {
                  "type": "string",
                  "title": "Origin Country Code",
                  "example": "LK"
                },
                "description": {
                  "type": "string",
                  "title": "Description",
                  "example": "Desiccated coconut, fine grade, for food use"
                },
                "commercialDescription": {
                  "type": "string",
                  "title": "Commercial Description",
                  "example": "DESICCATED COCONUT GRADE A"
                },
                "commercialDescription1": {
                  "type": "string",
                  "title": "Commercial Description (line 2)",
                  "maxLength": 50,
                  "example": "PACKED IN 25 KG PAPER SACKS"
                }
              },
              "required": [
                "commercialDescription",
                "commercialDescription1",
                "originCountryCode"
              ]
            },
            "valuation": {
              "type": "object",
              "title": "Item Valuation",
              "properties": {
                "grossWeight": {
                  "type": "number",
                  "title": "Gross Weight",
                  "example": 1500
                },
                "netWeight": {
                  "type": "number",
                  "title": "Net Weight",
                  "example": 1300
                },
                "totalCIF": {
                  "type": "number",
                  "title": "Total CIF",
                  "example": 2400
                },
                "statisticalValue": {
                  "type": "number",
                  "title": "Statistical Value",
                  "example": 2400
                },
                "invoiceAmountForeign": {
                  "type": "number",
                  "title": "Invoice Amount (Foreign)",
                  "example": 1500
                },
                "invoiceCurrencyCode": {
                  "type": "string",
                  "title": "Invoice Currency",
                  "example": "USD"
                },
                "invoiceAmountLKR": {
                  "type": "number",
                  "title": "Invoice Amount (LKR)",
                  "example": 0
                },
                "externalFreight": {
                  "type": "object",
                  "title": "External Freight",
                  "properties": {
                    "amountForeign": {
                      "type": "number",
                      "title": "Amount (Foreign)",
                      "example": 100
                    },
                    "amountLKR": {
                      "type": "number",
                      "title": "Amount (LKR)",
                      "example": 0
                    },
                    "currencyCode": {
                      "type": "string",
                      "title": "Currency",
                      "example": "USD"
                    }
                  }
                },
                "internalFreight": {
                  "type": "object",
                  "title": "Internal Freight",
                  "properties": {
                    "amountForeign": {
                      "type": "number",
                      "title": "Amount (Foreign)",
                      "example": 0
                    },
                    "amountLKR": {
                      "type": "number",
                      "title": "Amount (LKR)",
                      "example": 0
                    }
                  }
                },
                "insurance": {
                  "type": "object",
                  "title": "Insurance",
                  "properties": {
                    "amountForeign": {
                      "type": "number",
                      "title": "Amount (Foreign)",
                      "example": 0
                    },
                    "amountLKR": {
                      "type": "number",
                      "title": "Amount (LKR)",
                      "example": 0
                    }
                  }
                },
                "otherCost": {
                  "type": "object",
                  "title": "Other Cost",
                  "properties": {
                    "amountForeign": {
                      "type": "number",
                      "title": "Amount (Foreign)",
                      "example": 0
                    },
                    "amountLKR": {
                      "type": "number",
                      "title": "Amount (LKR)",
                      "example": 0
                    }
                  }
                },
                "deduction": {
                  "type": "object",
                  "title": "Deduction",
                  "properties": {
                    "amountForeign": {
                      "type": "number",
                      "title": "Amount (Foreign)",
                      "example": 0
                    },
                    "amountLKR": {
                      "type": "number",
                      "title": "Amount (LKR)",
                      "example": 0
                    }
                  }
                }
              },
              "required": [
                "grossWeight",
                "netWeight",
                "invoiceAmountForeign",
                "invoiceCurrencyCode"
              ]
            },
            "previousDocumentReference": {
              "type": "string",
              "title": "Previous Document Reference",
              "example": "PREV_DOC_REF"
            },
            "summaryDeclaration": {
              "type": "string",
              "title": "Summary Declaration (BL No.)",
              "example": "BL789398639"
            },
            "bol": {
              "type": "string",
              "title": "Bill of Lading",
              "example": "BL-2026-0001"
            },
            "bolSplit": {
              "type": "string",
              "title": "Bill of Lading Split",
              "example": "BL-2026-0001-A"
            },
            "marksAndNumbers": {
              "type": "string",
              "title": "Marks and Numbers",
              "example": "EXP-2026-A/1-10"
            },
            "numberOfUnits": {
              "type": "integer",
              "title": "Number of Units",
              "minimum": 0,
              "example": 1
            }
          },
          "required": [
            "packages",
            "tarification",
            "goodsDescription",
            "valuation"
          ]
        }
      },
      "supportingDocuments": {
        "type": "array",
        "title": "Supporting Documents",
        "description": "Permits, licences and invoices supporting this declaration. PDF only, up to 300 KB each.",
        "items": {
          "type": "object",
          "properties": {
            "documentCode": {
              "type": "string",
              "title": "Document Code",
              "description": "UNATDTAB document type code.",
              "example": "N380"
            },
            "file": {
              "type": "string",
              "format": "file",
              "title": "Document",
              "x-file": {
                "accept": ".pdf",
                "maxSize": 307200
              }
            }
          },
          "required": [
            "documentCode",
            "file"
          ]
        },
        "x-file": {
          "maxFiles": 10
        }
      }
    },
    "required": [
      "shipmentType",
      "identification",
      "traders",
      "generalInfo",
      "transport",
      "financial",
      "valuation",
      "packages",
      "items"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "transport": {
              "properties": {
                "containerized": {
                  "const": true
                }
              }
            }
          },
          "required": [
            "transport"
          ]
        },
        "then": {
          "required": [
            "containerCount"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Group",
        "label": "1. Shipment",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/shipmentType"
              },
              {
                "type": "Control",
                "scope": "#/properties/containerCount"
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "label": "2. Identification",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/identification/properties/officeCode"
              },
              {
                "type": "Control",
                "scope": "#/properties/identification/properties/declarationType"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/identification/properties/generalProcedureCode"
              },
              {
                "type": "Control",
                "scope": "#/properties/identification/properties/transitDocumentType"
              },
              {
                "type": "Control",
                "scope": "#/properties/identification/properties/manifestRegNumber"
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "label": "3. Exporter",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/traders/properties/exporter/properties/code"
              },
              {
                "type": "Control",
                "scope": "#/properties/traders/properties/exporter/properties/name"
              }
            ]
          },
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/traders/properties/exporter/properties/address"
              },
              {
                "type": "Control",
                "scope": "#/properties/traders/properties/exporter/properties/countryCode"
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "label": "4. Consignee",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/traders/properties/consignee/properties/code"
              },
              {
                "type": "Control",
                "scope": "#/properties/traders/properties/consignee/properties/name"
              },
              {
                "type": "Control",
                "scope": "#/properties/traders/properties/consignee/properties/countryCode"
              }
            ]
          },
          {
            "type": "Control",
            "scope": "#/properties/traders/properties/consignee/properties/address"
          }
        ]
      },
      {
        "type": "Group",
        "label": "5. Declarant",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/traders/properties/declarant/properties/code"
              },
              {
                "type": "Control",
                "scope": "#/properties/traders/properties/declarant/properties/referenceNo"
              }
            ]
          }
        ]
      },
      {
        "type": "Group",
        "label": "6. General Information",
        "elements": [
          {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/generalInfo/properties/countryOfFirstDestination"
              },
              {
                "type": "Control",
                "scope": "#/properties/generalInfo/properties/exportCountryCode"
              },
              {
                "type": "Control",
                "scope": "#/properties/generalInfo/properties/destinationCountryCode"
              }
            ]
          },
          {
            "type": "Control",
            "scope": "#/properties/generalInfo/properties/commentsText"
          }
        ]
      },
      {
