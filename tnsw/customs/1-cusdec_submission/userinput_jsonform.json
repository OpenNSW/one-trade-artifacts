{
  "id": "customs-cusdec--user-form",
  "title": "Customs Declaration (CusDec) Submission",
  "schema": {
    "type": "object",
    "properties": {
      "import_cusdec_xml": {
        "type": "object",
        "title": "Import CusDec XML",
        "description": "Upload the ASYCUDA CusDec XML to fill this declaration automatically, including declaration items. Only fields present in the XML are populated — exporter/consignee address details, cost breakdowns, and per-item supplementary unit still need manual entry. Values can be corrected afterwards.",
        "x-xml": {
          "accept": ".xml,text/xml,application/xml",
          "maxSize": 5242880,
          "arrayPaths": ["ASYCUDA.Item"],
          "persistDocument": false,
          "writeBase": "parent",
          "writeTo": [
            { "from": "ASYCUDA.Identification.Office_segment.Customs_clearance_office_code", "to": "identification.officeCode", "as": "string" },
            { "from": "ASYCUDA.Identification.Type.Type_of_declaration", "to": "identification.declarationType", "as": "string" },
            { "from": "ASYCUDA.Identification.Type.Declaration_gen_procedure_code", "to": "identification.generalProcedureCode", "as": "string" },
            { "from": "ASYCUDA.Declarant.Declarant_code", "to": "traders.declarant.code", "as": "string" },
            { "from": "ASYCUDA.General_information.Country.Country_first_destination", "to": "generalInfo.countryOfFirstDestination", "as": "string" },
            { "from": "ASYCUDA.General_information.Country.Export.Export_country_code", "to": "generalInfo.exportCountryCode", "as": "string" },
            { "from": "ASYCUDA.General_information.Country.Destination.Destination_country_code", "to": "generalInfo.destinationCountryCode", "as": "string" },
            { "from": "ASYCUDA.Transport.Means_of_transport.Departure_arrival_information.Identity", "to": "transport.vesselName", "as": "string" },
            { "from": "ASYCUDA.Transport.Means_of_transport.Departure_arrival_information.Nationality", "to": "transport.transportNationality", "as": "string" },
            { "from": "ASYCUDA.Transport.Means_of_transport.Border_information.Identity", "to": "transport.voyageNo", "as": "string" },
            { "from": "ASYCUDA.Transport.Means_of_transport.Border_information.Nationality", "to": "transport.voyageNationality", "as": "string" },
            { "from": "ASYCUDA.Transport.Means_of_transport.Border_information.Mode", "to": "transport.modeOfTransport", "as": "string" },
            { "from": "ASYCUDA.Transport.Container_flag", "to": "transport.containerized", "as": "boolean" },
            { "from": "ASYCUDA.Transport.Delivery_terms.Code", "to": "transport.deliveryTermsCode", "as": "string" },
            { "from": "ASYCUDA.Transport.Delivery_terms.Place", "to": "transport.deliveryTermsPlace", "as": "string" },
            { "from": "ASYCUDA.Transport.Border_office.Code", "to": "transport.borderOfficeCode", "as": "string" },
            { "from": "ASYCUDA.Financial.Bank.Code", "to": "financial.bankCode", "as": "string" },
            { "from": "ASYCUDA.Financial.Bank.Reference", "to": "financial.bankReference", "as": "string" },
            { "from": "ASYCUDA.Financial.Terms.Code", "to": "financial.paymentTermsCode", "as": "string" },
            { "from": "ASYCUDA.Financial.Total_invoice", "to": "valuation.invoiceAmount.amount", "as": "number" },
            { "from": "ASYCUDA.Valuation.Gs_Invoice.Currency_code", "to": "valuation.invoiceAmount.currencyCode", "as": "string" },
            { "from": "ASYCUDA.Valuation.Weight.Gross_weight", "to": "valuation.totalGrossWeight", "as": "number" },
            { "from": "ASYCUDA.Property.Nbers.Total_number_of_packages", "to": "packages.totalPackages", "as": "number" },
            {
              "from": "ASYCUDA.Item",
              "to": "items",
              "writeTo": [
                { "from": "Packages.Number_of_packages", "to": "packages.quantity", "as": "number" },
                { "from": "Packages.Kind_of_packages_code", "to": "packages.kindCode", "as": "string" },
                { "from": "Tarification.HScode.Commodity_code", "to": "tarification.hsCode", "as": "string" },
                { "from": "Tarification.Preference_code", "to": "tarification.preferenceCode", "as": "string" },
                { "from": "Tarification.Extended_customs_procedure", "to": "tarification.extendedProcedureCode", "as": "string" },
                { "from": "Tarification.National_customs_procedure", "to": "tarification.nationalProcedureCode", "as": "string" },
                { "from": "Goods_description.Country_of_origin_code", "to": "goodsDescription.originCountryCode", "as": "string" },
                { "from": "Goods_description.Description_of_goods", "to": "goodsDescription.description", "as": "string" },
                { "from": "Goods_description.Commercial_Description", "to": "goodsDescription.commercialDescription", "as": "string" },
                { "from": "Valuation_item.Weight_itm.Gross_weight_itm", "to": "valuation.grossWeight", "as": "number" },
                { "from": "Valuation_item.Weight_itm.Net_weight_itm", "to": "valuation.netWeight", "as": "number" },
                { "from": "Valuation_item.Item_Invoice.Amount_foreign_currency", "to": "valuation.invoiceAmount.amount", "as": "number" },
                { "from": "Valuation_item.Item_Invoice.Currency_code", "to": "valuation.invoiceAmount.currencyCode", "as": "string" }
              ]
            }
          ]
        }
      },
      "containerCount": {
        "type": "integer",
        "title": "Container Count",
        "minimum": 0,
        "example": 3
      },
      "identification": {
        "type": "object",
        "title": "Identification",
        "properties": {
          "officeCode": {
            "type": "string",
            "title": "Customs Office Code",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name} ({id})",
              "params": {
                "id": "customs-cusdec--office-codes",
                "version": "1"
              }
            },
            "example": "CBEX1"
          },
          "declarationType": {
            "type": "string",
            "title": "Declaration Type",
            "oneOf": [
              {
                "const": "EX",
                "title": "EX — Export"
              }
            ],
            "example": "EX"
          },
          "generalProcedureCode": {
            "type": "string",
            "title": "General Procedure Code",
            "x-search": {
              "service": "static-data",
              "mode": "small-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--declaration-procedures",
                "version": "1"
              }
            },
            "example": "1"
          }
        },
        "required": [
          "officeCode",
          "declarationType",
          "generalProcedureCode"
        ]
      },
      "traders": {
        "type": "object",
        "title": "Traders",
        "properties": {
          "exporter": {
            "type": "object",
            "title": "Exporter",
            "properties": {
              "code": {
                "type": "string",
                "title": "Exporter TIN / Code",
                "example": "900000000001"
              },
              "name": {
                "type": "string",
                "title": "Exporter Name",
                "example": "JOTHI COCONUT EXPORTERS"
              },
              "address": {
                "type": "string",
                "title": "Exporter Address",
                "example": "45A, KANDY ROAD, PILIMATHALAWA"
              },
          "countryCode": {
            "type": "string",
            "title": "Country Code",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--countries",
                "version": "1"
              }
            },
            "example": "LK"
          }
            },
            "required": [
              "code",
              "name",
              "address",
              "countryCode"
            ]
          },
          "consignee": {
            "type": "object",
            "title": "Consignee",
            "properties": {
              "name": {
                "type": "string",
                "title": "Consignee Name",
                "example": "COCO WORLD SDN BHD"
              },
              "address": {
                "type": "string",
                "title": "Consignee Address",
                "example": "125, PUTRAJAYA, KUALA LUMPUR, MALAYSIA"
              },
              "countryCode": {
                "type": "string",
                "title": "Country Code",
                "example": "MY"
              }
            },
            "required": [
              "name",
              "address",
              "countryCode"
            ]
          },
          "declarant": {
            "type": "object",
            "title": "Declarant",
            "properties": {
              "code": {
                "type": "string",
                "title": "Declarant Code",
                "example": "900000000"
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "exporter",
          "consignee",
          "declarant"
        ]
      },
      "generalInfo": {
        "type": "object",
        "title": "General Information",
        "properties": {
          "countryOfFirstDestination": {
            "type": "string",
            "title": "Country of First Destination",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--countries",
                "version": "1"
              }
            },
            "example": "MY"
          },
          "exportCountryCode": {
            "type": "string",
            "title": "Export Country Code",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--countries",
                "version": "1"
              }
            },
            "example": "LK"
          },
          "destinationCountryCode": {
            "type": "string",
            "title": "Destination Country Code",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--countries",
                "version": "1"
              }
            },
            "example": "MY"
          }
        },
        "required": [
          "countryOfFirstDestination",
          "exportCountryCode",
          "destinationCountryCode"
        ]
      },
      "transport": {
        "type": "object",
        "title": "Transport",
        "properties": {
          "vesselName": {
            "type": "string",
            "title": "Vessel Name",
            "example": "MSC SAVANNA"
          },
          "transportNationality": {
            "type": "string",
            "title": "Transport Nationality",
            "description": "Country code of the vessel/aircraft at departure.",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--countries",
                "version": "1"
              }
            },
            "example": "LK"
          },
          "voyageNo": {
            "type": "string",
            "title": "Voyage No",
            "example": "185 E DATED 20/04/2026"
          },
          "voyageNationality": {
            "type": "string",
            "title": "Voyage Nationality",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--countries",
                "version": "1"
              }
            },
            "example": "LK"
          },
          "modeOfTransport": {
            "type": "string",
            "title": "Mode of Transport",
            "x-search":{
              "service": "static-data",
              "mode": "small-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--mode-of-transport",
                "version": "1"
              }
            },
            "example": "1"
          },
          "containerized": {
            "type": "boolean",
            "title": "Containerized",
            "example": true,
            "default": true
          },
          "deliveryTermsCode": {
            "type": "string",
            "title": "Delivery Terms Code",
            "x-search": {
              "service": "static-data",
              "mode": "small-list",
              "displayTemplate": "{name}",
              "params": {
                "id": "customs-cusdec--delivery-terms",
                "version": "1"
              }
            },
            "example": "CIF"
          },
          "deliveryTermsPlace": {
            "type": "string",
            "title": "Delivery Terms Place",
            "example": "TEST DELIVERY TERMS PLACE"
          },
          "borderOfficeCode": {
            "type": "string",
            "title": "Border Office Code",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name} ({id})",
              "params": {
                "id": "customs-cusdec--office-codes",
                "version": "1"
              }
            },
            "example": "CBEX1"
          },
          "placeOfDischargeCode": {
            "type": "string",
            "title": "Place of Discharge Code",
            "description": "UNLOCODE of the place where the goods are discharged.",
            "x-search": {
              "service": "static-data",
              "mode": "large-paginated-list",
              "displayTemplate": "{name} ({id})",
              "params": {
                "id": "customs-cusdec--port-of-entry-and-discharge",
                "version": "1"
              }
            },
            "example": "LKADP"
          }
        },
        "required": [
          "vesselName",
          "transportNationality",
          "modeOfTransport",
          "containerized",
          "deliveryTermsCode",
          "deliveryTermsPlace",
          "borderOfficeCode",
          "placeOfDischargeCode"
        ]
      },
      "financial": {
        "type": "object",
        "title": "Financial",
        "properties": {
          "bankCode": {
            "type": "string",
            "title": "Bank Code",
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "displayTemplate": "{name} ({id})",
              "params": {
                "id": "customs-cusdec--banks",
                "version": "1"
              }
            },
            "example": "7056"
          },
          "bankReference": {
            "type": "string",
            "title": "Bank Reference",
            "example": "84004328"
          },
          "remittanceAmount": {
            "type": "number",
            "title": "Remittance Amount",
            "description": "Amount remitted through the bank against this declaration.",
            "example": 500
          },
          "paymentTermsCode": {
            "type": "string",
            "title": "Payment Terms Code",
            "example": "31"
          }
        },
        "required": [
          "bankCode",
          "bankReference",
          "remittanceAmount",
          "paymentTermsCode"
        ]
      },
      "valuation": {
        "type": "object",
        "title": "Valuation",
        "properties": {
          "invoiceAmount": {
            "type": "object",
            "title": "Invoice Amount",
            "properties": {
              "amount": {
                "type": "number",
                "title": "Amount",
                "example": 2400
              },
              "currencyCode": {
                "type": "string",
                "title": "Currency",
                "example": "USD"
              }
            },
            "required": [
              "amount",
              "currencyCode"
            ]
          },
          "externalFreight": {
            "type": "object",
            "title": "External Freight",
            "properties": {
              "amount": {
                "type": "number",
                "title": "Amount",
                "example": 100
              },
              "currencyCode": {
                "type": "string",
                "title": "Currency",
                "example": "USD"
              }
            },
            "required": [
              "amount",
              "currencyCode"
            ]
          },
          "internalFreight": {
            "type": "object",
            "title": "Internal Freight",
            "properties": {
              "amount": {
                "type": "number",
                "title": "Amount",
                "example": 0
              },
              "currencyCode": {
                "type": "string",
                "title": "Currency",
                "example": "USD"
              }
            },
            "required": [
              "amount",
              "currencyCode"
            ]
          },
          "insurance": {
            "type": "object",
            "title": "Insurance",
            "properties": {
              "amount": {
                "type": "number",
                "title": "Amount",
                "example": 0
              },
              "currencyCode": {
                "type": "string",
                "title": "Currency",
                "example": "USD"
              }
            },
            "required": [
              "amount",
              "currencyCode"
            ]
          },
          "otherCosts": {
            "type": "object",
            "title": "Other Costs",
            "properties": {
              "amount": {
                "type": "number",
                "title": "Amount",
                "example": 0
              },
              "currencyCode": {
                "type": "string",
                "title": "Currency",
                "example": "USD"
              }
            },
            "required": [
              "amount",
              "currencyCode"
            ]
          },
          "deductions": {
            "type": "object",
            "title": "Deductions",
            "properties": {
              "amount": {
                "type": "number",
                "title": "Amount",
                "example": 0
              },
              "currencyCode": {
                "type": "string",
                "title": "Currency",
                "example": "USD"
              }
            },
            "required": [
              "amount",
              "currencyCode"
            ]
          },
          "totalGrossWeight": {
            "type": "number",
            "title": "Total Gross Weight (Kg)",
            "example": 1500
          }
        },
        "required": [
          "invoiceAmount"
        ]
      },
      "packages": {
        "type": "object",
        "title": "Packages",
        "properties": {
          "totalPackages": {
            "type": "integer",
            "title": "Total Packages",
            "minimum": 0,
            "example": 25
          }
        },
        "required": [
          "totalPackages"
        ]
      },
      "items": {
        "type": "array",
        "title": "Declaration Items",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "packages": {
              "type": "object",
              "title": "Packages",
              "properties": {
                "quantity": {
                  "type": "integer",
                  "title": "Quantity",
                  "minimum": 0,
                  "example": 25
                },
                "kindCode": {
                  "type": "string",
                  "title": "Package Kind Code",
                  "example": "PK"
                }
              },
              "required": [
                "quantity",
                "kindCode"
              ]
            },
            "tarification": {
              "type": "object",
              "title": "Tarification",
              "properties": {
                "hsCode": {
                  "type": "string",
                  "title": "HS Code",
                  "example": "11063010"
                },
                "preferenceCode": {
                  "type": "string",
                  "title": "Preference Code",
                  "example": "ISFTA"
                },
                "extendedProcedureCode": {
                  "type": "string",
                  "title": "Extended Procedure Code",
                  "x-search": {
                    "service": "static-data",
                    "mode": "large-searchable-list",
                    "displayTemplate": "{name} ({id})",
                    "params": {
                      "id": "customs-cusdec--extended-procedures",
                      "version": "1"
                    }
                  },
                  "example": "1100"
                },
                "nationalProcedureCode": {
                  "type": "string",
                  "title": "National Procedure Code",
                  "example": "000"
                },
                "supplementaryUnit": {
                  "type": "object",
                  "title": "Supplementary Unit",
                  "properties": {
                    "code": {
                      "type": "string",
                      "title": "Unit Code",
                      "example": "KGM"
                    },
                    "quantity": {
                      "type": "number",
                      "title": "Quantity",
                      "example": 250
                    }
                  },
                  "required": [
                    "code",
                    "quantity"
                  ]
                },
                "itemPrice": {
                  "type": "number",
                  "title": "Item Price",
                  "example": 2400
                }
              },
              "required": [
                "hsCode",
                "extendedProcedureCode",
                "nationalProcedureCode",
                "supplementaryUnit"
              ]
            },
            "goodsDescription": {
              "type": "object",
              "title": "Goods Description",
              "properties": {
                "originCountryCode": {
                  "type": "string",
                  "title": "Origin Country Code",
                  "x-search": {
                    "service": "static-data",
                    "mode": "large-searchable-list",
                    "displayTemplate": "{name}",
                    "params": {
                      "id": "customs-cusdec--countries",
                      "version": "1"
                    }
                  },
                  "example": "LK"
                },
                "description": {
                  "type": "string",
                  "title": "Description",
                  "example": "TEST DESCRIPTION"
                },
                "commercialDescription": {
                  "type": "string",
                  "title": "Commercial Description",
                  "example": "COCONUT KERNEL POWDER"
                },
                "commercialDescription1": {
                  "type": "string",
                  "title": "Commercial Description (line 2)",
                  "maxLength": 50,
                  "example": "PACKED IN CARTONS"
                }
              },
              "required": [
                "originCountryCode",
                "description",
                "commercialDescription",
                "commercialDescription1"
              ]
            },
            "marksAndNumbers": {
              "type": "string",
              "title": "Marks and Numbers",
              "example": "COCO WORLD SDN BHD / KUALA LUMPUR / CTNS 1-25"
            },
            "valuation": {
              "type": "object",
              "title": "Item Valuation",
              "properties": {
                "grossWeight": {
                  "type": "number",
                  "title": "Gross Weight",
                  "example": 1500
                },
                "netWeight": {
                  "type": "number",
                  "title": "Net Weight",
                  "example": 1000
                },
                "invoiceAmount": {
                  "type": "object",
                  "title": "Invoice Amount",
                  "properties": {
                    "amount": {
                      "type": "number",
                      "title": "Amount",
                      "example": 2400
                    },
                    "currencyCode": {
                      "type": "string",
                      "title": "Currency",
                      "example": "USD"
                    }
                  },
                  "required": [
                    "amount",
                    "currencyCode"
                  ]
                }
              },
              "required": [
                "grossWeight",
                "netWeight",
                "invoiceAmount"
              ]
            }
          },
          "required": [
            "packages",
            "tarification",
            "goodsDescription",
            "marksAndNumbers",
            "valuation"
          ]
        }
      },
      "supportingDocuments": {
        "type": "object",
        "title": "Supporting Documents",
        "properties": {
          "scannedDocuments": {
            "type": "array",
            "title": "Scanned Documents",
            "description": "Scanned PDFs for the SCAN DOC tab in the CusDec. Up to 300 KB each.",
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "fileBase64": {
                  "type": "string",
                  "format": "file",
                  "title": "File",
                  "x-file": {
                    "accept": ".pdf",
                    "maxSize": 307200
                  },
                  "example": "storage/customs/invoice-1092.pdf"
                },
                "documentCode": {
                  "type": "string",
                  "title": "Document Code",
                  "x-search": {
                    "service": "static-data",
                    "mode": "small-list",
                    "displayTemplate": "{name} ({id})",
                    "params": {
                      "id": "customs-cusdec--supporting-document-codes",
                      "version": "1"
                    }
                  },
                  "example": "INV"
                }
              },
              "required": [
                "fileBase64",
                "documentCode"
              ]
            }
          },
          "metaDocuments": {
            "type": "array",
            "title": "Meta Documents",
            "description": "Documents referenced by code and reference number (no scan).",
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "itemSequence": {
                  "type": "string",
                  "title": "Item Number",
                  "description": "Attached-document item number.",
                  "x-search": {
                    "service": "static-data",
                    "mode": "small-list",
                    "displayTemplate": "{name} ({id})",
                    "params": {
                      "id": "customs-cusdec--supporting-document-item-numbers",
                      "version": "1"
                    }
                  },
                  "example": "017"
                },
                "documentCode": {
                  "type": "string",
                  "title": "Document Code",
                  "x-search": {
                    "service": "static-data",
                    "mode": "small-list",
                    "displayTemplate": "{name} ({id})",
                    "params": {
                      "id": "customs-cusdec--supporting-document-codes",
                      "version": "1"
                    }
                  },
                  "example": "INV"
                },
                "documentId": {
                  "type": "string",
                  "title": "Document Reference Number",
                  "description": "Reference of a document already held elsewhere.",
                  "example": "INV-1092"
                },
                "dateAsString": {
                  "type": "string",
                  "format": "date",
                  "title": "Document Date",
                  "description": "Date of the referenced document.",
                  "example": "2026-09-15"
                }
              },
              "required": [
                "documentCode",
                "itemSequence",
                "documentId",
                "dateAsString"
              ]
            }
          }
        }
      }
    },
