{
  "id": "fcau-warehouse-inspection--officer-form",
  "title": "Warehouse Visual Inspection Outcome",
  "schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "title": "Warehouse Inspection Result (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID",
              "readOnly": true
            },
            "description_of_food": {
              "type": "string",
              "title": "Description of consignment and quantity",
              "readOnly": true
            },
            "warehouse_result": {
              "type": "string",
              "title": "Warehouse Inspection Result",
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Passed (Satisfactory)"
                },
                {
                  "const": "fail",
                  "title": "Failed (Deficiencies Found)"
                }
              ]
            },
            "warehouse_referral": {
              "type": "string",
              "title": "Further Inspection",
              "oneOf": [
                {
                  "const": "not_required",
                  "title": "Not Required"
                },
                {
                  "const": "lab",
                  "title": "Refer to Lab Test"
                }
              ]
            },
            "sample_number": {
              "type": "string",
              "title": "Sample Number",
              "example": "SMP-FCAU-2026-948"
            }
          },
          "required": [
            "id",
            "warehouse_result"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "inspection_type": {
                    "const": "warehouse"
                  }
                },
                "required": [
                  "inspection_type"
                ]
              },
              "then": {
                "required": [
                  "warehouse_referral"
                ]
              }
            }
          ]
        }
      },
      "inspection_comments": {
        "type": "string",
        "title": "Inspection Notes / Observations",
        "example": "Visual inspection of storage area completed. Food containers intact and temperature controlled."
      },
      "revised_inspection_date": {
        "type": "string",
        "format": "date",
        "title": "Revised Inspection Date",
        "description": "Leave blank if the inspection took place on the scheduled date. Complete this only to record a different actual date.",
        "example": "2026-08-07"
      }
    },
    "required": [
      "items"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/description_of_food"
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/warehouse_result"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/warehouse_referral",
                    "rule": {
                      "effect": "SHOW",
                      "condition": {
                        "scope": "#/properties/inspection_type",
                        "schema": {
                          "const": "warehouse"
                        },
                        "failWhenUndefined": true
                      }
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/sample_number",
                    "rule": {
                      "effect": "SHOW",
                      "condition": {
                        "scope": "#/properties/warehouse_referral",
                        "schema": {
                          "const": "lab"
                        },
                        "failWhenUndefined": true
                      }
                    }
                  }
                ]
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/inspection_comments"
      },
      {
        "type": "Control",
        "scope": "#/properties/revised_inspection_date"
      }
    ]
  }
}
