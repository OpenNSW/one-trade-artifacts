{
  "id": "fcau-application-review--review:render",
  "type": "APPLICATION",
  "title": "FCAU Application Review",
  "files": [
    "reviewform.commodities[*].analysis_certificates",
    "reviewform.commodities[*].other_declarations",
    "submission.commodities[*].analysis_certificates",
    "submission.commodities[*].other_declarations",
    "submission.other_supporting_documents[*]"
  ],
  "sections": {
    "previous_review": {
      "templateId": "fcau-application-review--previous-review",
      "title": "Previous Review",
      "projector": "MARKDOWN",
      "dataKey": "previous_rejection_reason",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireDataKey": "previous_rejection_reason"
      }
    },
    "submission_view": {
      "templateId": "fcau-apply-health-cert--user-form",
      "title": "Submitted Application",
      "projector": "FORM",
      "dataKey": "submission"
    },
    "review_form": {
      "templateId": "fcau-apply-health-cert--reviewer-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "handles": [
        {
          "command": "submit",
          "label": "Submit Review",
          "element": "primary_action"
        }
      ]
    },
    "status_message": {
      "templateId": "fcau-application-review--submission-view",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "callbackToken"
      }
    },
    "awaiting_resubmission": {
      "templateId": "fcau-application-review--awaiting-resubmission",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "dataKey": "reviewform",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ],
        "requireDataKey": "replyToken"
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
