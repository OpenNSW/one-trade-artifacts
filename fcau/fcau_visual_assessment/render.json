{
  "id": "fcau-visual-assessment--review:render",
  "type": "APPLICATION",
  "title": "FCAU Visual Sample Assessment",
  "files": [
    "submission.commodities[*].analysis_certificates",
    "submission.commodities[*].other_declarations",
    "submission.other_supporting_documents[*]"
  ],
  "sections": {
    "submission_view": {
      "templateId": "fcau-apply-health-cert--user-form",
      "title": "Submitted Application",
      "projector": "FORM",
      "dataKey": "submission"
    },
    "review_form": {
      "templateId": "fcau-visual-assessment--reviewer-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireClaim": "role:food_drugs_inspector"
      },
      "handles": [
        {
          "command": "submit",
          "label": "Submit Review",
          "element": "primary_action"
        }
      ]
    },
    "review_result": {
      "templateId": "fcau-visual-assessment--reviewer-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "visibleWhen": {
        "states": [
          "STARTING",
          "STARTING_STEP",
          "ADVANCING",
          "QUEUED_EXTERNALLY",
          "COMPLETED",
          "ON_HOLD",
          "CANCELLED"
        ]
      }
    },
    "awaiting_review_director": {
      "templateId": "fcau-visual-assessment--awaiting-review",
      "title": "Officer Review",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireClaim": "role:director"
      }
    },
    "awaiting_review_assistant_director": {
      "templateId": "fcau-visual-assessment--awaiting-review",
      "title": "Officer Review",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireClaim": "role:assistant_director"
      }
    },
    "status_message": {
      "templateId": "fcau-visual-assessment--submission-view",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
