{
  "id": "cda-review-result--officer-form",
  "title": "CDA Officer Certificate Issuance",
  "schema": {
    "type": "object",
    "properties": {
      "review_outcome": {
        "type": "string",
        "title": "Review Assessment Outcome",
        "default": "approve",
        "example": "approve"
      },
      "cert_type": {
        "type": "string",
        "title": "Certificates Requested",
        "readOnly": true,
        "oneOf": [
          {
            "const": "P",
            "title": "Physical Quality Certificate"
          },
          {
            "const": "S",
            "title": "Salmonella Free Certificate"
          },
          {
            "const": "PS",
            "title": "Both Physical Quality and Salmonella Free Certificates"
          }
        ]
      },
      "physical_certificate_id": {
        "type": "string",
        "title": "Physical Quality Certificate No.",
        "description": "Generated by the system",
        "readOnly": true,
        "example": "PQC/P/1205/26"
      },
      "physical_certificate_file": {
        "type": "string",
        "format": "file",
        "title": "Physical Quality Certificate File (PDF)",
        "example": "https://cda.gov.lk/certs/PQC-P-1205-26.pdf"
      },
      "salmonella_certificate_id": {
        "type": "string",
        "title": "Salmonella Free Certificate No.",
        "description": "Generated by the system",
        "readOnly": true,
        "example": "PQC/S/1205/26"
      },
      "salmonella_certificate_file": {
        "type": "string",
        "format": "file",
        "title": "Salmonella Free Certificate File (PDF)",
        "example": "https://cda.gov.lk/certs/PQC-S-1205-26.pdf"
      }
    },
    "required": [
      "review_outcome"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "cert_type": {
              "enum": [
                "P",
                "PS"
              ]
            }
          },
          "required": [
            "cert_type"
          ]
        },
        "then": {
          "required": [
            "physical_certificate_id",
            "physical_certificate_file"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "cert_type": {
              "enum": [
                "S",
                "PS"
              ]
            }
          },
          "required": [
            "cert_type"
          ]
        },
        "then": {
          "required": [
            "salmonella_certificate_id",
            "salmonella_certificate_file"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/cert_type",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/physical_certificate_id",
        "options": {
          "readonly": true
        },
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/cert_type",
            "schema": {
              "enum": [
                "P",
                "PS"
              ]
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/physical_certificate_file",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/cert_type",
            "schema": {
              "enum": [
                "P",
                "PS"
              ]
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/salmonella_certificate_id",
        "options": {
          "readonly": true
        },
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/cert_type",
            "schema": {
              "enum": [
                "S",
                "PS"
              ]
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/salmonella_certificate_file",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/cert_type",
            "schema": {
              "enum": [
                "S",
                "PS"
              ]
            }
          }
        }
      }
    ]
  }
}
