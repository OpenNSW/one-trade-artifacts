{
  "id": "cda-lot-adjustment-officer--review-form",
  "title": "CDA Officer Lot Adjustment Review",
  "schema": {
    "type": "object",
    "properties": {
      "adjustment_outcome": {
        "type": "string",
        "title": "Assessment Outcome",
        "oneOf": [
          {
            "const": "approve",
            "title": "Approve Adjustment & Upload New Certificate"
          },
          {
            "const": "needs_more_info",
            "title": "Needs More Information (Send back to applicant)"
          }
        ],
        "default": "approve",
        "example": "approve"
      },
      "cert_type": {
        "type": "string",
        "title": "Certificates Issued",
        "readOnly": true,
        "oneOf": [
          {
            "const": "P",
            "title": "Physical Quality Certificate"
          },
          {
            "const": "S",
            "title": "Salmonella Free Certificate"
          },
          {
            "const": "PS",
            "title": "Both Physical Quality and Salmonella Free Certificates"
          }
        ]
      },
      "new_physical_certificate_file": {
        "type": "string",
        "format": "file",
        "title": "New Physical Quality Certificate File (PDF)",
        "example": "https://cda.gov.lk/certs/PQC-P-1205-26-REV1.pdf"
      },
      "new_salmonella_certificate_file": {
        "type": "string",
        "format": "file",
        "title": "New Salmonella Free Certificate File (PDF)",
        "example": "https://cda.gov.lk/certs/PQC-S-1205-26-REV1.pdf"
      },
      "adjustment_feedback": {
        "type": "string",
        "title": "Officer Comments / Feedback / Rejection Reasons",
        "example": "Please clarify which specific bags are being excluded."
      }
    },
    "required": [
      "adjustment_outcome"
    ],
    "if": {
      "properties": {
        "adjustment_outcome": {
          "const": "approve"
        }
      },
      "required": [
        "adjustment_outcome"
      ]
    },
    "then": {
      "allOf": [
        {
          "if": {
            "properties": {
              "cert_type": {
                "enum": [
                  "P",
                  "PS"
                ]
              }
            },
            "required": [
              "cert_type"
            ]
          },
          "then": {
            "required": [
              "new_physical_certificate_file"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "cert_type": {
                "enum": [
                  "S",
                  "PS"
                ]
              }
            },
            "required": [
              "cert_type"
            ]
          },
          "then": {
            "required": [
              "new_salmonella_certificate_file"
            ]
          }
        }
      ]
    },
    "else": {
      "required": [
        "adjustment_feedback"
      ]
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/adjustment_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/cert_type",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/new_physical_certificate_file",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/cert_type",
            "schema": {
              "enum": [
                "P",
                "PS"
              ]
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/new_salmonella_certificate_file",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/cert_type",
            "schema": {
              "enum": [
                "S",
                "PS"
              ]
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/adjustment_feedback",
        "options": {
          "multiLine": true
        },
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/adjustment_outcome",
            "schema": {
              "const": "needs_more_info"
            }
          }
        }
      }
    ]
  }
}
