{
  "id": "cda-apply-coconut-cert--officer-verification-form",
  "title": "CDA Officer Application Verification",
  "schema": {
    "type": "object",
    "properties": {
      "verification_outcome": {
        "type": "string",
        "title": "Verification Outcome",
        "oneOf": [
          {
            "const": "approve",
            "title": "Approve Verification"
          },
          {
            "const": "needs_more_info",
            "title": "Needs More Information (Send back to applicant)"
          }
        ],
        "default": "approve",
        "example": "approve"
      },
      "rejection_reason": {
        "type": "string",
        "title": "Comments / Feedback / Deficiencies (Required if Needs More Info)",
        "example": "Please upload the correct certificate template."
      },
      "product_type_dc": {
        "type": "boolean",
        "title": "DC",
        "default": false
      },
      "product_type_value_added_dc": {
        "type": "boolean",
        "title": "Value Added DC - Low Fat DC",
        "default": false
      }
    },
    "required": [
      "verification_outcome"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "verification_outcome": {
              "const": "needs_more_info"
            }
          },
          "required": [
            "verification_outcome"
          ]
        },
        "then": {
          "required": [
            "rejection_reason"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "verification_outcome": {
              "const": "approve"
            }
          },
          "required": [
            "verification_outcome"
          ]
        },
        "then": {
          "anyOf": [
            {
              "properties": {
                "product_type_dc": {
                  "const": true
                }
              },
              "required": [
                "product_type_dc"
              ]
            },
            {
              "properties": {
                "product_type_value_added_dc": {
                  "const": true
                }
              },
              "required": [
                "product_type_value_added_dc"
              ]
            }
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/verification_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/rejection_reason",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/verification_outcome",
            "schema": {
              "const": "needs_more_info"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/product_type_dc",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/verification_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/product_type_value_added_dc",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/verification_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      }
    ]
  }
}
