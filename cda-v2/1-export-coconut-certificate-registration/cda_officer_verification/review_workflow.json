{
  "id": "cda-officer-verification--review-workflow",
  "name": "CDA Coconut Certificate Verification \u2014 Officer Review",
  "version": 2,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "userform",
      "type": "TASK",
      "task_template_id": "cda-officer-verification--officer-review",
      "input_mapping": {
        "submission?": "submission"
      },
      "output_mapping": {
        "verification_outcome": "reviewform.verification_outcome",
        "rejection_reason?": "reviewform.rejection_reason"
      }
    },
    {
      "id": "api_call",
      "type": "TASK",
      "task_template_id": "cda-officer-verification--notify-decision",
      "input_mapping": {
        "callbackToken": "callbackToken",
        "reviewform?": "reviewform",
        "submission?": "submission",
        "taskId": "taskId",
        "reviewform.verification_outcome": "payload.command",
        "reviewform": "payload.payload"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "userform"
    },
    {
      "id": "e2",
      "source_id": "userform",
      "target_id": "api_call"
    },
    {
      "id": "e3",
      "source_id": "api_call",
      "target_id": "end"
    }
  ]
}
