{
  "id": "cda-kcfn-inspection-review--review-workflow",
  "name": "CDA Container Inspection & Recommendation \u2014 Officer Review",
  "version": 3,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "userform",
      "type": "TASK",
      "task_template_id": "cda-kcfn-inspection-review--officer-review",
      "input_mapping": {
        "submission?": "submission",
        "reviewform.rejection_reason?": "previous_rejection_reason"
      },
      "output_mapping": {
        "review_outcome": "reviewform.review_outcome",
        "inspection_notes?": "reviewform.inspection_notes",
        "rejection_reason?": "reviewform.rejection_reason"
      }
    },
    {
      "id": "decision_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "request_info",
      "type": "TASK",
      "task_template_id": "cda-kcfn-inspection-review--request-info",
      "input_mapping": {
        "callbackToken": "replyToken",
        "reviewform.review_outcome": "review_outcome",
        "reviewform.rejection_reason?": "rejection_reason",
        "reviewform.inspection_notes?": "inspection_notes"
      },
      "output_mapping": {
        "submission": "submission",
        "callbackToken": "callbackToken"
      }
    },
    {
      "id": "api_call",
      "type": "TASK",
      "task_template_id": "cda-kcfn-inspection-review--notify-decision",
      "input_mapping": {
        "callbackToken": "callbackToken",
        "reviewform?": "reviewform",
        "submission?": "submission",
        "taskId": "taskId",
        "reviewform.review_outcome": "payload.command",
        "reviewform": "payload.payload"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "userform"
    },
    {
      "id": "e2",
      "source_id": "userform",
      "target_id": "decision_gateway"
    },
    {
      "id": "e_needs_info",
      "source_id": "decision_gateway",
      "target_id": "request_info",
      "condition": "reviewform.review_outcome == 'needs_more_info'"
    },
    {
      "id": "e_resubmitted",
      "source_id": "request_info",
      "target_id": "userform"
    },
    {
      "id": "e_approve",
      "source_id": "decision_gateway",
      "target_id": "api_call",
      "condition": "reviewform.review_outcome == 'approve'"
    },
    {
      "id": "e3",
      "source_id": "api_call",
      "target_id": "end"
    }
  ]
}
