{
  "id": "sltb-schedule-pickup--officer-review-form",
  "title": "Review Suggested Pickup Schedule",
  "schema": {
    "type": "object",
    "required": [
      "schedule_outcome"
    ],
    "properties": {
      "suggested_date": {
        "type": "string",
        "title": "Trader Suggested Date",
        "readOnly": true
      },
      "suggested_time": {
        "type": "string",
        "title": "Trader Suggested Time Range",
        "readOnly": true
      },
      "trader_notes": {
        "type": "string",
        "title": "Trader Special Instructions",
        "readOnly": true
      },
      "schedule_outcome": {
        "type": "string",
        "title": "Schedule Decision",
        "oneOf": [
          {
            "const": "approve",
            "title": "Accept — Confirm the Trader's Suggested Slot"
          },
          {
            "const": "propose_alternative",
            "title": "Propose a Different Date & Time"
          }
        ]
      },
      "visit_date": {
        "type": "string",
        "format": "date",
        "title": "New Pickup Date",
        "description": "The date SLTB can accommodate instead of the trader's suggestion."
      },
      "visit_time": {
        "type": "string",
        "title": "New Time Range (e.g. 10:00 AM - 12:30 PM)",
        "description": "The time range SLTB can accommodate instead of the trader's suggestion.",
        "example": "10:00 AM - 12:30 PM"
      },
      "inspector_name": {
        "type": "string",
        "title": "Assigned Tea Inspector Name",
        "example": "K. Perera"
      },
      "contact_number": {
        "type": "string",
        "title": "Inspector Contact Number",
        "example": "+94 77 123 4567"
      },
      "feedback": {
        "type": "string",
        "title": "Notes for Trader",
        "description": "When proposing an alternative, explain why the suggested slot cannot be accommodated.",
        "example": "Inspector unavailable that week. We can accommodate July 8th instead."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "schedule_outcome": {
              "const": "propose_alternative"
            }
          },
          "required": [
            "schedule_outcome"
          ]
        },
        "then": {
          "required": [
            "visit_date",
            "visit_time",
            "inspector_name"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/suggested_date",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/suggested_date",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/suggested_time",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/suggested_time",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/trader_notes",
        "options": {
          "multiLine": true
        },
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/trader_notes",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/schedule_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/visit_date",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/schedule_outcome",
            "schema": {
              "const": "propose_alternative"
            },
            "failWhenUndefined": true
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/visit_time",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/schedule_outcome",
            "schema": {
              "const": "propose_alternative"
            },
            "failWhenUndefined": true
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/inspector_name"
      },
      {
        "type": "Control",
        "scope": "#/properties/contact_number"
      },
      {
        "type": "Control",
        "scope": "#/properties/feedback",
        "options": {
          "multiLine": true
        },
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/schedule_outcome",
            "schema": {
              "const": "propose_alternative"
            }
          }
        }
      }
    ]
  }
}
