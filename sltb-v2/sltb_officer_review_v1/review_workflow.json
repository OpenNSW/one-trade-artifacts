{
  "id": "sltb-officer-review--review-workflow",
  "name": "SLTB Blend Sheet Review — Officer Review",
  "version": 3,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "userform",
      "type": "TASK",
      "task_template_id": "sltb-officer-review--officer-review",
      "input_mapping": {
        "submission?": "submission",
        "reviewform.feedback?": "previous_feedback"
      },
      "output_mapping": {
        "review_outcome": "reviewform.review_outcome",
        "feedback?": "reviewform.feedback",
        "levy_amount?": "reviewform.levy_amount",
        "collection_method?": "reviewform.collection_method"
      }
    },
    {
      "id": "decision_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "request_info",
      "type": "TASK",
      "task_template_id": "sltb-officer-review--request-info",
      "input_mapping": {
        "callbackToken": "replyToken",
        "reviewform.review_outcome": "review_outcome",
        "reviewform.feedback?": "feedback"
      },
      "output_mapping": {
        "submission": "submission",
        "callbackToken": "callbackToken"
      }
    },
    {
      "id": "api_call",
      "type": "TASK",
      "task_template_id": "sltb-officer-review--notify-decision",
      "input_mapping": {
        "callbackToken": "callbackToken",
        "reviewform?": "reviewform",
        "submission?": "submission",
        "taskId": "taskId",
        "reviewform.review_outcome": "payload.command",
        "reviewform": "payload.payload"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "userform"
    },
    {
      "id": "e2",
      "source_id": "userform",
      "target_id": "decision_gateway"
    },
    {
      "id": "e_needs_info",
      "source_id": "decision_gateway",
      "target_id": "request_info",
      "condition": "reviewform.review_outcome == 'needs_more_info'"
    },
    {
      "id": "e_resubmitted",
      "source_id": "request_info",
      "target_id": "userform"
    },
    {
      "id": "e_decided",
      "source_id": "decision_gateway",
      "target_id": "api_call",
      "condition": "reviewform.review_outcome != 'needs_more_info'"
    },
    {
      "id": "e3",
      "source_id": "api_call",
      "target_id": "end"
    }
  ]
}
