{
  "id": "npqs-upload-treatment-certs--trader-form",
  "title": "Trader Submitted Treatment Certificates",
  "schema": {
    "type": "object",
    "properties": {
      "commodities": {
        "type": "array",
        "title": "Items Under Treatment (Context)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "treatment_type": {
              "type": "string",
              "title": "Treatment Type Requested"
            }
          }
        }
      },
      "treatment_certificate_url": {
        "type": "string",
        "format": "file",
        "title": "Treatment Certificate Document (PDF/Image)",
        "readOnly": true
      },
      "supervision_report_url": {
        "type": "string",
        "format": "file",
        "title": "Supervision Report Document (Required if supervision was requested)",
        "readOnly": true
      },
      "upload_remarks": {
        "type": "string",
        "title": "Trader Comments / Remarks",
        "readOnly": true
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/commodities",
        "options": {
          "readonly": true,
          "detail": {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/id",
                "options": {
                  "readOnly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_common_name",
                "options": {
                  "readOnly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/treatment_type",
                "options": {
                  "readOnly": true
                }
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/treatment_certificate_url",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/supervision_report_url",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/upload_remarks",
        "options": {
          "readonly": true
        }
      }
    ]
  }
}
