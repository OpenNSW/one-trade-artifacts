{
  "id": "npqs-review-treatment-certs--officer-form",
  "title": "Review Treatment Certificate Documents",
  "schema": {
    "type": "object",
    "properties": {
      "treatment_review_result": {
        "type": "string",
        "title": "Verification Result",
        "oneOf": [
          {
            "const": "pass",
            "title": "Pass (Certificates are valid and correct)"
          },
          {
            "const": "needs_more_info",
            "title": "Needs More Info (Request re-upload with corrections)"
          }
        ],
        "default": "pass"
      },
      "review_comments": {
        "type": "string",
        "title": "Verification Notes / Feedback",
        "example": "Reviewed the uploaded treatment certificate. The chemical, dosage, and duration match standard requirements."
      },
      "commodities": {
        "type": "array",
        "title": "Items Under Treatment",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "displayTemplate": "{name}",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "treatment_result": {
              "type": "string",
              "title": "Treatment Result",
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail (Reject Item)"
                }
              ],
              "default": "pass"
            }
          },
          "required": [
            "id",
            "treatment_result"
          ]
        }
      }
    },
    "required": [
      "treatment_review_result"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/commodities",
        "options": {
          "detail": {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/id",
                "options": {
                  "readOnly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_common_name/properties/label",
                "options": {
                  "readOnly": true
                },
                "label": "Commodity Name"
              },
              {
                "type": "Control",
                "scope": "#/properties/treatment_result"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/treatment_review_result"
      },
      {
        "type": "Control",
        "scope": "#/properties/review_comments"
      }
    ]
  }
}
