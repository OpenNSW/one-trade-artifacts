{
  "id": "npqs-visual2-decision--officer-form",
  "title": "Visual Inspection 2",
  "schema": {
    "type": "object",
    "properties": {
      "visual2_comments": {
        "type": "string",
        "title": "Officer Notes"
      },
      "items": {
        "type": "array",
        "title": "Items (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Common Name",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "displayTemplate": "{name}",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "commodity_botanical_name": {
              "type": "string",
              "title": "Botanical Name"
            },
            "visual2_required": {
              "type": "boolean",
              "title": "Visual Inspection Required",
              "default": false
            }
          },
          "required": [
            "id"
          ]
        }
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/id",
                "options": {
                  "readOnly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_common_name/properties/label",
                "options": {
                  "readOnly": true
                },
                "label": "Common Name"
              },
              {
                "type": "Control",
                "scope": "#/properties/visual2_required"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/visual2_comments"
      }
    ]
  }
}
