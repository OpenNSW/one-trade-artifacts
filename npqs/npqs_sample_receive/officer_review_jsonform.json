{
  "id": "npqs-draw-sample--officer-receive-form",
  "title": "Verify & Register Received Sample",
  "schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "title": "Samples Expected for This Batch",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID",
              "readOnly": true
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string",
                  "readOnly": true
                },
                "label": {
                  "type": "string",
                  "readOnly": true
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "displayTemplate": "{name}",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "commodity_botanical_name": {
              "type": "string",
              "title": "Botanical Name",
              "readOnly": true
            }
          }
        },
        "readOnly": true
      },
      "sample_number": {
        "type": "string",
        "title": "Assigned Sample Number",
        "readOnly": true,
        "example": "PQS/2026/0001"
      },
      "receive_comments": {
        "type": "string",
        "title": "Observations on Receipt",
        "example": "Sample bag intact, sealed correctly."
      }
    },
    "required": [
      "sample_number"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/id"
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_common_name/properties/label",
                "label": "Commodity Name"
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_botanical_name"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/sample_number"
      },
      {
        "type": "Control",
        "scope": "#/properties/receive_comments"
      }
    ]
  }
}
