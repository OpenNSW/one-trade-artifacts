{
  "id": "npqs-draw-sample--officer-receive-form",
  "title": "Verify & Register Received Sample",
  "schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "title": "Samples Expected for This Batch",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            },
            "commodity_botanical_name": {
              "type": "string",
              "title": "Botanical Name"
            }
          }
        }
      },
      "sample_number": {
        "type": "string",
        "title": "Assigned Sample Number",
        "example": "SMP-NPQS-2026-1092"
      },
      "receive_comments": {
        "type": "string",
        "title": "Observations on Receipt",
        "example": "Sample bag intact, sealed correctly."
      }
    },
    "required": [
      "sample_number"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "readonly": true,
          "detail": {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/id",
                "options": {
                  "readOnly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_common_name",
                "options": {
                  "readOnly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_botanical_name",
                "options": {
                  "readOnly": true
                }
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/sample_number"
      },
      {
        "type": "Control",
        "scope": "#/properties/receive_comments"
      }
    ]
  }
}
