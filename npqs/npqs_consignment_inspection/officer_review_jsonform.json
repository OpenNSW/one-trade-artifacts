{
  "id": "npqs-visual-consignment--officer-form",
  "title": "Consignment Visual Inspection Outcome",
  "schema": {
    "type": "object",
    "properties": {
      "visual_result": {
        "type": "string",
        "title": "Inspection Result",
        "oneOf": [
          {
            "const": "pass",
            "title": "Pass (Consignment approved visually)"
          },
          {
            "const": "fail",
            "title": "Fail (Consignment has pests, rot, or damage)"
          }
        ],
        "default": "pass"
      },
      "inspection_comments": {
        "type": "string",
        "title": "Inspection Notes",
        "example": "Conducted visual inspection of packages at port. Storage conditions are acceptable, all seals intact."
      },
      "items": {
        "type": "array",
        "title": "Commodity Consignment Inspection Results (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID",
              "readOnly": true
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Common Name",
              "properties": {
                "value": {
                  "type": "string",
                  "readOnly": true
                },
                "label": {
                  "type": "string",
                  "readOnly": true
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "displayTemplate": "{name}",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "visual_result": {
              "type": "string",
              "title": "Inspection Result",
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass (Approved visually)"
                },
                {
                  "const": "fail",
                  "title": "Fail (Pests, rot, or damage detected)"
                }
              ],
              "default": "pass"
            },
            "visual_failure_reason": {
              "type": "string",
              "title": "Failure Reason",
              "example": "Rot and physical fungal damage observed on packaging."
            },
            "treatment_required": {
              "type": "boolean",
              "title": "Treatment Required",
              "description": "Send this item for treatment once it passes."
            }
          },
          "required": [
            "id",
            "visual_result"
          ]
        }
      }
    },
    "required": [
      "visual_result"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/visual_result"
      },
      {
        "type": "Control",
        "scope": "#/properties/inspection_comments"
      },
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/commodity_common_name/properties/label",
                    "label": "Common Name"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/visual_result"
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/visual_failure_reason",
                "rule": {
                  "effect": "SHOW",
                  "condition": {
                    "scope": "#/properties/visual_result",
                    "schema": {
                      "const": "fail"
                    }
                  }
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/treatment_required",
                "rule": {
                  "effect": "SHOW",
                  "condition": {
                    "scope": "#/properties/visual_result",
                    "schema": {
                      "const": "pass"
                    }
                  }
                }
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      }
    ]
  }
}
