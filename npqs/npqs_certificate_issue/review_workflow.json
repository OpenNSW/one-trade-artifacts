{
  "id": "npqs-certificate-issue--review-workflow",
  "name": "NPQS Certificate Issuance — Officer Review",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "reference_type_split",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "generate_both_references",
      "type": "TASK",
      "task_template_id": "npqs-certificate-issue--generate-both-references",
      "input_mapping": {},
      "output_mapping": {
        "refid.certificate_number": "reviewform.certificate_number",
        "refid.replacement_reference_number": "reviewform.replacement_reference_number"
      }
    },
    {
      "id": "generate_ephyto_reference",
      "type": "TASK",
      "task_template_id": "npqs-certificate-issue--generate-ephyto-reference",
      "input_mapping": {},
      "output_mapping": {
        "refid.certificate_number": "reviewform.certificate_number"
      }
    },
    {
      "id": "userform",
      "type": "TASK",
      "task_template_id": "npqs-certificate-issue--officer-review",
      "input_mapping": {
        "submission?": "submission",
        "submission.certificate_items?": "reviewform.certificate_items",
        "submission.certificate_type?": "reviewform.certificate_type",
        "reviewform.replacement_reference_number?": "reviewform.replacement_reference_number",
        "submission.ephyto_country?": "reviewform.ephyto_country",
        "reviewform.certificate_number?": "reviewform.certificate_number"
      },
      "output_mapping": {
        "__command": "command",
        "issue_date?": "reviewform.issue_date",
        "comments?": "reviewform.comments",
        "certificate_items?": "reviewform.certificate_items"
      }
    },
    {
      "id": "generate_certificate",
      "type": "TASK",
      "task_template_id": "npqs-certificate-issue--generate-certificate",
      "input_mapping": {
        "submission": "application",
        "reviewform.certificate_number": "certificate_number",
        "reviewform.certificate_items?": "items",
        "reviewform.issue_date?": "issue_date"
      },
      "output_mapping": {
        "certificate_document": "certificate_document",
        "certificate_document.key": "reviewform.certificate_url"
      }
    },
    {
      "id": "api_call",
      "type": "TASK",
      "task_template_id": "npqs-certificate-issue--notify-decision",
      "input_mapping": {
        "callbackToken": "callbackToken",
        "certificate_document?": "certificate_document",
        "reviewform?": "reviewform",
        "submission?": "submission",
        "taskId": "taskId",
        "command": "payload.command",
        "reviewform": "payload.payload"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "reference_type_split"
    },
    {
      "id": "e_both",
      "source_id": "reference_type_split",
      "target_id": "generate_both_references",
      "condition": "submission.certificate_type == 're-export'"
    },
    {
      "id": "e_ephyto",
      "source_id": "reference_type_split",
      "target_id": "generate_ephyto_reference",
      "condition": "submission.certificate_type in [nil, 'export']"
    },
    {
      "id": "e_both_to_form",
      "source_id": "generate_both_references",
      "target_id": "userform"
    },
    {
      "id": "e_ephyto_to_form",
      "source_id": "generate_ephyto_reference",
      "target_id": "userform"
    },
    {
      "id": "e_form_to_certificate",
      "source_id": "userform",
      "target_id": "generate_certificate"
    },
    {
      "id": "e_generated",
      "source_id": "generate_certificate",
      "target_id": "api_call"
    },
    {
      "id": "e_api_to_end",
      "source_id": "api_call",
      "target_id": "end"
    }
  ]
}
