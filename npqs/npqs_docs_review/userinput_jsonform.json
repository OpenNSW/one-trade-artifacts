{
  "id": "npqs-upload-docs--trader-form",
  "title": "Trader Submitted Consignment Documents",
  "schema": {
    "type": "object",
    "properties": {
      "invoice_file_url": {
        "type": "string",
        "format": "file",
        "title": "Commercial Invoice (PDF/Image)",
        "readOnly": true
      },
      "packing_list_file_url": {
        "type": "string",
        "format": "file",
        "title": "Packing List (PDF/Image)",
        "readOnly": true
      },
      "additional_file_url": {
        "type": "string",
        "format": "file",
        "title": "Other Supporting Documents (Bill of Lading / Customs declaration)",
        "readOnly": true
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/invoice_file_url",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/packing_list_file_url",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/additional_file_url",
        "options": {
          "readonly": true
        }
      }
    ]
  }
}
