{
  "id": "npqs-docs-review--review:render",
  "type": "APPLICATION",
  "title": "NPQS Documents Review",
  "files": [
    "submission.additional_file_url[*]",
    "submission.invoice_file_url",
    "submission.packing_list_file_url"
  ],
  "sections": {
    "submission_view": {
      "templateId": "npqs-upload-docs--trader-form",
      "title": "Submitted Application",
      "projector": "FORM",
      "dataKey": "submission"
    },
    "review_form": {
      "templateId": "npqs-review-docs--officer-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireClaim": "role:nppo_officer"
      },
      "handles": [
        {
          "command": "submit",
          "label": "Submit Review",
          "element": "primary_action"
        }
      ]
    },
    "review_result": {
      "templateId": "npqs-review-docs--officer-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "visibleWhen": {
        "states": [
          "STARTING",
          "STARTING_STEP",
          "ADVANCING",
          "QUEUED_EXTERNALLY",
          "COMPLETED",
          "ON_HOLD",
          "CANCELLED"
        ]
      }
    },
    "awaiting_review_nppo_inspector": {
      "templateId": "npqs-docs-review--awaiting-review",
      "title": "Officer Review",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireClaim": "role:nppo_inspector"
      }
    },
    "awaiting_review_nppo_assistant": {
      "templateId": "npqs-docs-review--awaiting-review",
      "title": "Officer Review",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "PENDING_USER"
        ],
        "requireClaim": "role:nppo_assistant"
      }
    },
    "status_message": {
      "templateId": "npqs-docs-review--submission-view",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
