{
  "id": "npqs-docs-review--review:render",
  "type": "APPLICATION",
  "title": "NPQS Documents Review",
  "read": {
    "roles": [
      "officer"
    ]
  },
  "files": [
    "submission.additional_file_url[*]",
    "submission.invoice_file_url",
    "submission.packing_list_file_url"
  ],
  "sections": {
    "submission_view": {
      "templateId": "npqs-upload-docs--trader-form",
      "title": "Submitted Application",
      "projector": "FORM",
      "dataKey": "submission"
    },
    "review_form": {
      "templateId": "npqs-review-docs--officer-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "handles": [
        {
          "command": "submit",
          "label": "Submit Review",
          "element": "primary_action"
        }
      ]
    },
    "status_message": {
      "templateId": "npqs-docs-review--submission-view",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
