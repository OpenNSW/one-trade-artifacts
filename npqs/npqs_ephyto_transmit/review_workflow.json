{
  "id": "npqs-ephyto-transmit--review-workflow",
  "name": "NPQS IPPC ePhyto Hub Transmission — Officer",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "userform",
      "type": "TASK",
      "task_template_id": "npqs-ephyto-transmit--officer-review",
      "input_mapping": {
        "submission?": "submission"
      },
      "output_mapping": {
        "__command": "command",
        "send_application_documents?": "reviewform.send_application_documents",
        "send_treatment_certificate?": "reviewform.send_treatment_certificate",
        "send_supervision_report?": "reviewform.send_supervision_report",
        "send_invoice?": "reviewform.send_invoice",
        "send_packing_list?": "reviewform.send_packing_list",
        "send_additional_document?": "reviewform.send_additional_document"
      }
    },
    {
      "id": "transmit_reply",
      "type": "TASK",
      "task_template_id": "npqs-ephyto-transmit--transmit-reply",
      "input_mapping": {
        "callbackToken": "replyToken",
        "reviewform": "payload",
        "submission?": "submission"
      },
      "output_mapping": {
        "__command": "transmit_result",
        "submission?": "submission",
        "callbackToken?": "callbackToken",
        "transmitted?": "transmitted"
      }
    },
    {
      "id": "gw_transmit_result",
      "name": "Accepted by the IPPC Hub?",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "record_transmitted",
      "name": "Show the certificate as transmitted",
      "type": "TASK",
      "task_template_id": "npqs-ephyto-transmit--record-transmitted",
      "input_mapping": {
        "submission": "submission",
        "transmitted": "submission.transmitted"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "userform"
    },
    {
      "id": "e2",
      "source_id": "userform",
      "target_id": "transmit_reply"
    },
    {
      "id": "e_transmit_result",
      "source_id": "transmit_reply",
      "target_id": "gw_transmit_result"
    },
    {
      "id": "e_hub_rejected",
      "source_id": "gw_transmit_result",
      "target_id": "userform",
      "condition": "transmit_result == 'resubmit'"
    },
    {
      "id": "e_hub_accepted",
      "source_id": "gw_transmit_result",
      "target_id": "record_transmitted",
      "condition": "transmit_result == 'submitted'"
    },
    {
      "id": "e_recorded",
      "source_id": "record_transmitted",
      "target_id": "end"
    }
  ]
}
