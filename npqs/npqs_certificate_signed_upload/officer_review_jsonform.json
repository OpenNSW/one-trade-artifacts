{
  "id": "npqs-certificate-signed-upload--officer-form",
  "title": "Upload the Signed Phytosanitary Certificate",
  "schema": {
    "type": "object",
    "properties": {
      "serial_number": {
        "type": "string",
        "minLength": 1,
        "title": "Certificate Serial Number",
        "description": "The serial number printed on the pre-printed certificate form. Seen by NPQS only."
      },
      "certificate_url": {
        "type": "string",
        "format": "file",
        "title": "Signed Phytosanitary Certificate (PDF)",
        "x-file": {
          "accept": ".pdf"
        }
      },
      "comments": {
        "type": "string",
        "title": "Officer Remarks"
      }
    },
    "required": [
      "serial_number",
      "certificate_url"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/serial_number"
      },
      {
        "type": "Control",
        "scope": "#/properties/certificate_url"
      },
      {
        "type": "Control",
        "scope": "#/properties/comments"
      }
    ]
  }
}
