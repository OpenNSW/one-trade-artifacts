{
  "id": "npqs-treatment-issue--review:render",
  "type": "APPLICATION",
  "title": "NPQS NPQS Treatment Certificate",
  "files": [
    "payload.payload.treatment_certificate_url",
    "reviewform.treatment_certificate_url",
    "submission.attachments[*].attachment_file_url"
  ],
  "sections": {
    "submission_view": {
      "templateId": "npqs-apply-phyto-cert--officer-view-form",
      "title": "Submitted Application",
      "projector": "FORM",
      "dataKey": "submission"
    },
    "review_form": {
      "templateId": "npqs-treatment-issue--officer-form",
      "title": "Officer Review",
      "projector": "FORM",
      "dataKey": "reviewform",
      "handles": [
        {
          "command": "submit",
          "label": "Submit Review",
          "element": "primary_action"
        }
      ]
    },
    "status_message": {
      "templateId": "npqs-treatment-issue--submission-view",
      "title": "Review Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
