{
  "id": "npqs-apply-phyto-cert--reviewer-form",
  "title": "Application Assessment Review",
  "schema": {
    "type": "object",
    "properties": {
      "reference_number": {
        "type": "string",
        "title": "NPQS Reference Number",
        "readOnly": true,
        "example": "TNSW/NPQS/SEA-CMB/PC/2026/000001"
      },
      "review_outcome": {
        "type": "string",
        "title": "Review Decision",
        "oneOf": [
          {
            "const": "approve",
            "title": "Accept & Proceed"
          },
          {
            "const": "needs_more_info",
            "title": "Request Modifications (Send Back to Trader)"
          }
        ],
        "default": "approve"
      },
      "clarification_reason": {
        "type": "string",
        "title": "Clarification Required (If sending back to trader)",
        "example": "Please specify the exact scientific name of the cut foliage."
      },
      "ephyto_required": {
        "type": "boolean",
        "title": "IPPC ePhyto Hub Upload Required (for Consignment)",
        "default": false
      },
      "commodities": {
        "type": "array",
        "title": "Commodity Inspection & Treatment Pathways (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID",
              "readOnly": true
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string",
                  "readOnly": true
                },
                "label": {
                  "type": "string",
                  "readOnly": true
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "displayTemplate": "{name}",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "commodity_botanical_name": {
              "type": "string",
              "title": "Scientific Name",
              "readOnly": true
            },
            "quantity_net_weight": {
              "type": "number",
              "title": "Net Weight",
              "readOnly": true
            },
            "quantity_net_weight_unit": {
              "type": "object",
              "title": "Unit",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            },
            "packages_count": {
              "type": "integer",
              "title": "Packages"
            },
            "inspection_type": {
              "type": "string",
              "title": "Inspection",
              "oneOf": [
                {
                  "const": "lab",
                  "title": "Lab Test"
                },
                {
                  "const": "visual",
                  "title": "Visual Inspection"
                }
              ]
            },
            "lab_sample_method": {
              "type": "string",
              "title": "Sample Drop-off Method for Laboratory Testing",
              "oneOf": [
                {
                  "const": "drop_off_npqs",
                  "title": "Sample Drop-off to NPQS"
                },
                {
                  "const": "drop_off_pqs",
                  "title": "Sample Drop-off to PQS"
                },
                {
                  "const": "drawn_at_site",
                  "title": "Sample Drawn by Officer at Site"
                }
              ],
              "default": "drop_off_pqs"
            },
            "visual_approach": {
              "type": "string",
              "title": "Visual Inspection Approach",
              "oneOf": [
                {
                  "const": "sample",
                  "title": "Sample Inspection (requires sample collection)"
                },
                {
                  "const": "consignment",
                  "title": "Consignment Inspection (scheduled at site)"
                },
                {
                  "const": "system",
                  "title": "Through System Approach (recorded from external system)"
                }
              ],
              "default": "consignment"
            },
            "visual_sample_method": {
              "type": "string",
              "title": "Visual Sample Collection",
              "oneOf": [
                {
                  "const": "drop_off",
                  "title": "Sample Drop Off"
                },
                {
                  "const": "drawn_at_site",
                  "title": "Sample Drawn by Officer at Site"
                }
              ],
              "default": "drop_off"
            },
            "treatment_required": {
              "type": "boolean",
              "title": "Treatment Required",
              "default": false
            }
          },
          "required": [
            "id",
            "commodity_common_name"
          ]
        },
        "example": [
          {
            "id": "item-1",
            "commodity_common_name": "Cut Rose Flowers",
            "commodity_botanical_name": "Rosa hybrida",
            "quantity_net_weight": 250.0,
            "quantity_net_weight_unit": {
              "value": "KGM",
              "label": "kilogram (kg)"
            },
            "packages_count": 50,
            "inspection_type": "lab",
            "lab_sample_method": "drop_off_pqs",
            "visual_approach": "consignment",
            "treatment_required": false
          },
          {
            "id": "item-2",
            "commodity_common_name": "Fresh Cut Foliage",
            "commodity_botanical_name": "Monstera deliciosa",
            "quantity_net_weight": 500.0,
            "quantity_net_weight_unit": {
              "value": "KGM",
              "label": "kilogram (kg)"
            },
            "packages_count": 80,
            "inspection_type": "visual",
            "lab_sample_method": "drop_off_pqs",
            "visual_approach": "consignment",
            "treatment_required": false
          },
          {
            "id": "item-3",
            "commodity_common_name": "Sawn Timber",
            "commodity_botanical_name": "Hevea brasiliensis",
            "quantity_net_weight": 4200.0,
            "quantity_net_weight_unit": {
              "value": "KGM",
              "label": "kilogram (kg)"
            },
            "packages_count": 12,
            "inspection_type": "visual",
            "lab_sample_method": "drop_off_pqs",
            "visual_approach": "consignment",
            "treatment_required": true
          },
          {
            "id": "item-4",
            "commodity_common_name": "Coir Pith Block",
            "commodity_botanical_name": "Cocos nucifera",
            "quantity_net_weight": 5000.0,
            "quantity_net_weight_unit": {
              "value": "KGM",
              "label": "kilogram (kg)"
            },
            "packages_count": 200,
            "inspection_type": "visual",
            "lab_sample_method": "drop_off_pqs",
            "visual_approach": "consignment",
            "treatment_required": false
          }
        ]
      }
    },
    "required": [
      "reference_number",
      "review_outcome"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "review_outcome": {
              "const": "approve"
            }
          },
          "required": [
            "review_outcome"
          ]
        },
        "then": {
          "properties": {
            "commodities": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "inspection_type",
                  "treatment_required"
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "review_outcome": {
              "const": "needs_more_info"
            }
          },
          "required": [
            "review_outcome"
          ]
        },
        "then": {
          "required": [
            "clarification_reason"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/reference_number"
      },
      {
        "type": "Control",
        "scope": "#/properties/review_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/clarification_reason",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/review_outcome",
            "schema": {
              "const": "needs_more_info"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/ephyto_required",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/commodities",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        },
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/commodity_common_name/properties/label",
                    "label": "Commodity Name"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/commodity_botanical_name"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/id"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/quantity_net_weight"
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/inspection_type",
                "options": {
                  "format": "radio"
                }
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/lab_sample_method",
                    "rule": {
                      "effect": "SHOW",
                      "condition": {
                        "scope": "#/properties/inspection_type",
                        "schema": {
                          "const": "lab"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/visual_approach",
                    "rule": {
                      "effect": "SHOW",
                      "condition": {
                        "scope": "#/properties/inspection_type",
                        "schema": {
                          "const": "visual"
                        }
                      }
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/visual_sample_method",
                    "rule": {
                      "effect": "SHOW",
                      "condition": {
                        "type": "AND",
                        "conditions": [
                          {
                            "scope": "#/properties/inspection_type",
                            "schema": {
                              "const": "visual"
                            }
                          },
                          {
                            "scope": "#/properties/visual_approach",
                            "schema": {
                              "const": "sample"
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/treatment_required"
                  }
                ]
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      }
    ]
  }
}
