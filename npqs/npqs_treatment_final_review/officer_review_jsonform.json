{
  "id": "npqs-treatment-final-review--officer-form",
  "title": "Treatment Review",
  "schema": {
    "type": "object",
    "properties": {
      "treatment_certificate_urls": {
        "type": "array",
        "title": "Treatment Certificates",
        "readOnly": true,
        "items": {
          "type": "string",
          "format": "file"
        },
        "x-file": {
          "maxFiles": 50
        }
      },
      "supervision_report_urls": {
        "type": "array",
        "title": "Supervision Reports",
        "readOnly": true,
        "items": {
          "type": "string",
          "format": "file"
        },
        "x-file": {
          "maxFiles": 50
        }
      },
      "items": {
        "type": "array",
        "title": "Items Under Treatment",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID",
              "readOnly": true
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string",
                  "readOnly": true
                },
                "label": {
                  "type": "string",
                  "readOnly": true
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "displayTemplate": "{name}",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "treatment_result": {
              "type": "string",
              "title": "Treatment Result",
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail (Reject Item)"
                }
              ],
              "default": "pass"
            },
            "commodity_botanical_name": {
              "type": "string",
              "title": "Botanical Name",
              "readOnly": true
            }
          },
          "required": [
            "id",
            "treatment_result"
          ]
        }
      },
      "review_comments": {
        "type": "string",
        "title": "Review Notes"
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/treatment_certificate_urls"
      },
      {
        "type": "Control",
        "scope": "#/properties/supervision_report_urls"
      },
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/id"
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_common_name/properties/label",
                "label": "Commodity Name"
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_botanical_name"
              },
              {
                "type": "Control",
                "scope": "#/properties/treatment_result"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/review_comments"
      }
    ]
  }
}
