{
  "id": "npqs-issue-certificate-non-ephyto--officer-form",
  "title": "Prepare the Phytosanitary Certificate for Printing",
  "schema": {
    "type": "object",
    "properties": {
      "certificate_items": {
        "type": "array",
        "title": "Items To Include On This Certificate",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID",
              "readOnly": true
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string",
                  "readOnly": true
                },
                "label": {
                  "type": "string",
                  "readOnly": true
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "displayTemplate": "{name}",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "include_in_certificate": {
              "type": "boolean",
              "title": "Include on Certificate"
            },
            "sample_test_result": {
              "type": "string",
              "title": "Lab Test Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail_resubmit",
                  "title": "Fail (resubmission allowed)"
                },
                {
                  "const": "fail_final",
                  "title": "Fail"
                },
                {
                  "const": "skipped",
                  "title": "Skipped"
                }
              ],
              "default": "skipped"
            },
            "visual_result": {
              "type": "string",
              "title": "Visual Inspection 1 Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                },
                {
                  "const": "skipped",
                  "title": "Skipped"
                }
              ],
              "default": "skipped"
            },
            "treatment_result": {
              "type": "string",
              "title": "Treatment Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                },
                {
                  "const": "skipped",
                  "title": "Skipped"
                }
              ],
              "default": "skipped"
            },
            "visual2_result": {
              "type": "string",
              "title": "Visual Inspection 2 Result",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                },
                {
                  "const": "skipped",
                  "title": "Skipped"
                }
              ],
              "default": "skipped"
            },
            "commodity_botanical_name": {
              "type": "string",
              "title": "Botanical Name",
              "readOnly": true
            }
          },
          "required": [
            "id"
          ],
          "if": {
            "anyOf": [
              {
                "properties": {
                  "sample_test_result": {
                    "enum": [
                      "fail_final",
                      "fail_resubmit"
                    ]
                  }
                },
                "required": [
                  "sample_test_result"
                ]
              },
              {
                "properties": {
                  "visual_result": {
                    "enum": [
                      "fail"
                    ]
                  }
                },
                "required": [
                  "visual_result"
                ]
              },
              {
                "properties": {
                  "treatment_result": {
                    "enum": [
                      "fail"
                    ]
                  }
                },
                "required": [
                  "treatment_result"
                ]
              },
              {
                "properties": {
                  "visual2_result": {
                    "enum": [
                      "fail"
                    ]
                  }
                },
                "required": [
                  "visual2_result"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "include_in_certificate": {
                "default": false
              }
            }
          },
          "else": {
            "properties": {
              "include_in_certificate": {
                "default": true
              }
            }
          }
        }
      },
      "certificate_type": {
        "type": "string",
        "title": "Application Certificate Type",
        "readOnly": true
      },
      "issue_date": {
        "type": "string",
        "format": "date",
        "title": "Date of Issue",
        "example": "2026-10-27"
      },
      "registration_number": {
        "type": "string",
        "title": "Reg. No.",
        "description": "Printed in the certificate's Reg. No. box; NIL when left empty."
      },
      "treatment_items": {
        "type": "array",
        "title": "Approved Treatments",
        "description": "The treatment request as approved, carried for the print copy and not shown: the first treated item on the certificate prints in boxes 12 to 15, and the others are filled into Additional Information.",
        "readOnly": true,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            },
            "treatment_type": {
              "type": "string",
              "title": "Treatment Type",
              "oneOf": [
                {
                  "const": "FU",
                  "title": "Fumigation (FU)"
                },
                {
                  "const": "CD",
                  "title": "Cold Disinfestation (CD)"
                },
                {
                  "const": "HT",
                  "title": "Heat Treatment (HT)"
                },
                {
                  "const": "KD",
                  "title": "Kiln Drying (KD)"
                },
                {
                  "const": "HW",
                  "title": "Hot Water Treatment (HW)"
                },
                {
                  "const": "CHT",
                  "title": "Chemical Treatment (CHT)"
                },
                {
                  "const": "TPT",
                  "title": "Temperature Treatment (TPT)"
                },
                {
                  "const": "RAT",
                  "title": "Radiation Treatment (RAT)"
                },
                {
                  "const": "DR",
                  "title": "Dry Heat (DR)"
                },
                {
                  "const": "MH",
                  "title": "Moist Heat (MH)"
                },
                {
                  "const": "VH",
                  "title": "Vapour Heat (VH)"
                },
                {
                  "const": "DH",
                  "title": "Dielectric Heating (DH)"
                },
                {
                  "const": "FG",
                  "title": "Fungicide (FG)"
                },
                {
                  "const": "IN",
                  "title": "Insecticide (IN)"
                },
                {
                  "const": "NE",
                  "title": "Nematicide (NE)"
                },
                {
                  "const": "OP",
                  "title": "Other Pesticide (OP)"
                },
                {
                  "const": "CPI",
                  "title": "Chemical Pressure Impregnation (CPI)"
                },
                {
                  "const": "SC",
                  "title": "Seed Coating (SC)"
                },
                {
                  "const": "DV",
                  "title": "Devitalization (DV)"
                },
                {
                  "const": "DB",
                  "title": "Debarking (DB)"
                },
                {
                  "const": "OTT",
                  "title": "Other Treatment (OTT)"
                }
              ]
            },
            "chemical_used": {
              "type": "string",
              "title": "Chemical / Medium Used"
            },
            "treatment_duration": {
              "type": "string",
              "title": "Treatment Duration"
            },
            "treatment_temperature": {
              "type": "string",
              "title": "Target Temperature (°C)"
            },
            "treatment_concentration": {
              "type": "string",
              "title": "Chemical Concentration / Dosage"
            }
          }
        }
      },
      "additional_information": {
        "type": "string",
        "title": "Additional Information",
        "description": "Printed in box 17 of the certificate: at most 300 characters on 5 lines, smaller as it gets longer; NIL when left empty. Filled with the other treated items' treatments, which you can change or remove.",
        "maxLength": 300,
        "pattern": "^[^\\n]*(\\n[^\\n]*){0,4}$",
        "x-text": {
          "inputs": {
            "other_treatments": {
              "path": "treatment_items.*",
              "aggregate": "join",
              "where": "treatment_type",
              "skip": 1,
              "template": "{commodity_common_name.label}: {treatment_type} · {chemical_used} · {treatment_duration} · {treatment_temperature} °C · {treatment_concentration}",
              "separator": "\n"
            }
          },
          "template": "{other_treatments}",
          "editable": true
        }
      },
      "comments": {
        "type": "string",
        "title": "Officer Remarks",
        "example": "Issued phytosanitary certificate after validating treatment and visual inspection records."
      }
    },
    "required": [
      "certificate_items",
      "issue_date"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/certificate_items",
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/commodity_common_name/properties/label",
                    "label": "Commodity Name"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/commodity_botanical_name"
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/sample_test_result"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/visual_result"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/treatment_result"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/visual2_result"
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/include_in_certificate"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/issue_date"
      },
      {
        "type": "Control",
        "scope": "#/properties/registration_number"
      },
      {
        "type": "Control",
        "scope": "#/properties/additional_information",
        "options": {
          "multi": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/certificate_type"
      },
      {
        "type": "Control",
        "scope": "#/properties/comments"
      }
    ]
  }
}
