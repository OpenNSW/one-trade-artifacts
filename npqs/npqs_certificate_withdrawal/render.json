{
  "id": "npqs-certificate-withdrawal--review:render",
  "type": "APPLICATION",
  "title": "NPQS Certificate Withdrawal Request",
  "files": [
    "application.attachments[*].attachment_file_url",
    "payload.payload.withdrawn_certificate_url",
    "reviewform.withdrawn_certificate_url",
    "submission.application.attachments[*].attachment_file_url",
    "withdrawn_copy.key"
  ],
  "sections": {
    "request_view": {
      "templateId": "npqs-certificate-withdrawal--request-view",
      "title": "Withdrawal Request",
      "projector": "MARKDOWN",
      "dataKey": "submission"
    },
    "review_form": {
      "templateId": "npqs-certificate-withdrawal--officer-form",
      "title": "Decision",
      "projector": "FORM",
      "dataKey": "reviewform",
      "handles": [
        {
          "command": "submit",
          "label": "Submit Decision",
          "element": "primary_action"
        }
      ]
    },
    "withdrawn_copy": {
      "templateId": "npqs-certificate-withdrawal--withdrawn-copy-view",
      "title": "Withdrawn Certificate",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "requireDataKey": "withdrawn_copy"
      }
    },
    "status_message": {
      "templateId": "npqs-certificate-withdrawal--decided-view",
      "title": "Status",
      "projector": "MARKDOWN",
      "visibleWhen": {
        "states": [
          "QUEUED_EXTERNALLY"
        ]
      }
    }
  },
  "states": {
    "PENDING_USER": {
      "actions": [
        {
          "command": "submit"
        }
      ]
    }
  }
}
