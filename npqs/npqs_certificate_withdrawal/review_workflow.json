{
  "id": "npqs-certificate-withdrawal--review-workflow",
  "name": "NPQS Certificate Withdrawal Request — Officer Review",
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "userform",
      "type": "TASK",
      "task_template_id": "npqs-certificate-withdrawal--officer-review",
      "input_mapping": {
        "submission?": "submission"
      },
      "output_mapping": {
        "__command": "command",
        "decision": "reviewform.decision",
        "remarks?": "reviewform.remarks"
      }
    },
    {
      "id": "decision_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "generate_withdrawn_copy",
      "type": "TASK",
      "task_template_id": "npqs-certificate-withdrawal--generate-withdrawn-copy",
      "input_mapping": {
        "submission.application": "application",
        "submission.certificate_id": "certificate_number",
        "submission.certificate_items?": "items",
        "submission.issue_date?": "issue_date",
        "reviewform.decision": "withdrawal"
      },
      "output_mapping": {
        "withdrawn_copy": "withdrawn_copy",
        "withdrawn_copy.key": "reviewform.withdrawn_certificate_url"
      }
    },
    {
      "id": "api_call",
      "type": "TASK",
      "task_template_id": "npqs-certificate-withdrawal--notify-decision",
      "input_mapping": {
        "callbackToken": "callbackToken",
        "reviewform?": "reviewform",
        "submission?": "submission",
        "taskId": "taskId",
        "withdrawn_copy?": "withdrawn_copy",
        "command": "payload.command",
        "reviewform": "payload.payload"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "userform"
    },
    {
      "id": "e2",
      "source_id": "userform",
      "target_id": "decision_gateway"
    },
    {
      "id": "e_accept",
      "source_id": "decision_gateway",
      "target_id": "generate_withdrawn_copy",
      "condition": "reviewform.decision == 'accept'"
    },
    {
      "id": "e_copy_generated",
      "source_id": "generate_withdrawn_copy",
      "target_id": "api_call"
    },
    {
      "id": "e_reject",
      "source_id": "decision_gateway",
      "target_id": "api_call",
      "condition": "reviewform.decision == 'reject'"
    },
    {
      "id": "e3",
      "source_id": "api_call",
      "target_id": "end"
    }
  ]
}
