{
  "id": "npqs-issue-treatment-cert--officer-form",
  "title": "Record Treatment Details & Issue Certificate",
  "schema": {
    "type": "object",
    "properties": {
      "treatment_certificate_id": {
        "type": "string",
        "title": "Treatment Certificate Number",
        "example": "TC-NPQS-2026-9042"
      },
      "treatment_outcome": {
        "type": "string",
        "title": "Treatment Outcome Status",
        "default": "completed",
        "oneOf": [
          {
            "const": "completed",
            "title": "Treatment Completed Successfully"
          },
          {
            "const": "failed",
            "title": "Treatment Failed / Incomplete"
          }
        ]
      },
      "issue_comments": {
        "type": "string",
        "title": "Treatment Observation Notes",
        "example": "Fumigation executed using Methyl Bromide at 48 g/m\u00b3 for 24h at 21.2\u00b0C. Target concentration maintained. No leakage observed."
      },
      "commodities": {
        "type": "array",
        "title": "Items Under Treatment (Context)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "small-list",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "treatment_certificate_id",
      "treatment_outcome"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/commodities",
        "options": {
          "readonly": true,
          "detail": {
            "type": "HorizontalLayout",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/id",
                "options": {
                  "readOnly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/commodity_common_name",
                "options": {
                  "readOnly": true
                }
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/treatment_certificate_id"
      },
      {
        "type": "Control",
        "scope": "#/properties/treatment_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/issue_comments"
      }
    ]
  }
}
