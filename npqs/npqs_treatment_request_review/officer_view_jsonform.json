{
  "id": "npqs-treatment-request--officer-view-form",
  "title": "Application Context",
  "schema": {
    "type": "object",
    "properties": {
      "treatment_items": {
        "type": "array",
        "title": "Treatment Specifications (Per Item)",
        "readOnly": true,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID",
              "readOnly": true
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Common Name",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "large-searchable-list",
                "display-template": "{name}",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "treatment_type": {
              "type": "string",
              "title": "Treatment Type",
              "readOnly": true
            },
            "chemical_used": {
              "type": "string",
              "title": "Chemical / Medium",
              "readOnly": true
            },
            "treatment_duration": {
              "type": "string",
              "title": "Duration",
              "readOnly": true
            },
            "treatment_temperature": {
              "type": "string",
              "title": "Temperature",
              "readOnly": true
            },
            "treatment_concentration": {
              "type": "string",
              "title": "Dosage / Concentration",
              "readOnly": true
            }
          }
        }
      },
      "userform": {
        "type": "object",
        "title": "Phytosanitary Application",
        "properties": {
          "certificate_type": {
            "type": "string",
            "title": "Certificate Type",
            "readOnly": true,
            "oneOf": [
              {
                "const": "export",
                "title": "Export"
              },
              {
                "const": "re-export",
                "title": "Re-Export"
              }
            ]
          },
          "applicant_name": {
            "type": "string",
            "title": "Applicant Name",
            "readOnly": true
          },
          "importing_country": {
            "type": "object",
            "title": "Name of Importing Country",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "value"
            ],
            "x-search": {
              "service": "static-data",
              "mode": "large-searchable-list",
              "display-template": "{name}",
              "params": {
                "id": "npqs-apply-phyto-cert--importing-countries",
                "version": "1"
              }
            }
          },
          "exporter_name": {
            "type": "string",
            "title": "Exporter Name",
            "readOnly": true
          },
          "consignee_name": {
            "type": "string",
            "title": "Consignee Name",
            "readOnly": true
          },
          "place_of_inspection": {
            "type": "string",
            "title": "Place of Inspection",
            "readOnly": true
          },
          "commodities": {
            "type": "array",
            "title": "Commodities List",
            "readOnly": true,
            "items": {
              "type": "object",
              "properties": {
                "commodity_common_name": {
                  "type": "object",
                  "title": "Commodity Common Name",
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value"
                  ],
                  "x-search": {
                    "service": "static-data",
                    "mode": "large-searchable-list",
                    "display-template": "{name}",
                    "params": {
                      "id": "npqs-apply-phyto-cert--commodity-common-names",
                      "version": "1"
                    }
                  }
                },
                "commodity_botanical_name": {
                  "type": "string",
                  "title": "Botanical Name",
                  "readOnly": true
                },
                "commodity_quantity": {
                  "type": "string",
                  "title": "Quantity",
                  "readOnly": true
                }
              }
            }
          },
          "disinfestation_treatment": {
            "type": "string",
            "title": "Disinfestation and/or Treatment Details",
            "readOnly": true
          }
        }
      }
    }
  },
  "uiSchema": {
    "type": "Categorization",
    "elements": [
      {
        "type": "Category",
        "label": "Treatment Request",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/treatment_items",
            "options": {
              "readonly": true
            }
          }
        ]
      },
      {
        "type": "Category",
        "label": "Phytosanitary Application",
        "elements": [
          {
            "type": "Group",
            "label": "General Info",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/userform/properties/certificate_type",
                "options": {
                  "readonly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/userform/properties/applicant_name",
                "options": {
                  "readonly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/userform/properties/importing_country",
                "options": {
                  "readonly": true
                }
              }
            ]
          },
          {
            "type": "Group",
            "label": "Consignment Details",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/userform/properties/exporter_name",
                "options": {
                  "readonly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/userform/properties/consignee_name",
                "options": {
                  "readonly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/userform/properties/place_of_inspection",
                "options": {
                  "readonly": true
                }
              }
            ]
          },
          {
            "type": "Group",
            "label": "Commodity Details",
            "elements": [
              {
                "type": "Control",
                "scope": "#/properties/userform/properties/commodities",
                "options": {
                  "readonly": true
                }
              },
              {
                "type": "Control",
                "scope": "#/properties/userform/properties/disinfestation_treatment",
                "options": {
                  "readonly": true,
                  "multiLine": true
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
