{
  "id": "npqs-treatment-request--reviewer-form",
  "title": "Treatment Request Review & Decision",
  "schema": {
    "type": "object",
    "properties": {
      "treatment_request_outcome": {
        "type": "string",
        "title": "Treatment Request Decision",
        "oneOf": [
          {
            "const": "approve",
            "title": "Approve Treatment Plan"
          },
          {
            "const": "needs_more_info",
            "title": "Needs More Info (Send back to trader with feedback)"
          }
        ],
        "default": "approve"
      },
      "clarification_comments": {
        "type": "string",
        "title": "Clarifications / Feedback / Comments",
        "example": "Dosage is approved. Please ensure treatment is conducted at a certified facility."
      },
      "treatment_items": {
        "type": "array",
        "title": "Treatment Provider & Supervision (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "commodity_common_name": {
              "type": "object",
              "title": "Commodity Name",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "x-search": {
                "service": "static-data",
                "mode": "small-list",
                "params": {
                  "id": "npqs-apply-phyto-cert--commodity-common-names",
                  "version": "1"
                }
              }
            },
            "treatment_type": {
              "type": "string",
              "title": "Treatment Type Requested",
              "readOnly": true,
              "oneOf": [
                {
                  "const": "FU",
                  "title": "Fumigation (FU)"
                },
                {
                  "const": "CD",
                  "title": "Cold Disinfestation (CD)"
                },
                {
                  "const": "HT",
                  "title": "Heat Treatment (HT)"
                },
                {
                  "const": "KD",
                  "title": "Kiln Drying (KD)"
                },
                {
                  "const": "HW",
                  "title": "Hot Water Treatment (HW)"
                },
                {
                  "const": "CHT",
                  "title": "Chemical Treatment (CHT)"
                },
                {
                  "const": "TPT",
                  "title": "Temperature Treatment (TPT)"
                },
                {
                  "const": "RAT",
                  "title": "Radiation Treatment (RAT)"
                },
                {
                  "const": "DR",
                  "title": "Dry Heat (DR)"
                },
                {
                  "const": "MH",
                  "title": "Moist Heat (MH)"
                },
                {
                  "const": "VH",
                  "title": "Vapour Heat (VH)"
                },
                {
                  "const": "DH",
                  "title": "Dielectric Heating (DH)"
                },
                {
                  "const": "FG",
                  "title": "Fungicide (FG)"
                },
                {
                  "const": "IN",
                  "title": "Insecticide (IN)"
                },
                {
                  "const": "NE",
                  "title": "Nematicide (NE)"
                },
                {
                  "const": "OP",
                  "title": "Other Pesticide (OP)"
                },
                {
                  "const": "CPI",
                  "title": "Chemical Pressure Impregnation (CPI)"
                },
                {
                  "const": "SC",
                  "title": "Seed Coating (SC)"
                },
                {
                  "const": "DV",
                  "title": "Devitalization (DV)"
                },
                {
                  "const": "DB",
                  "title": "Debarking (DB)"
                },
                {
                  "const": "OTT",
                  "title": "Other Treatment (OTT)"
                }
              ]
            },
            "chemical_used": {
              "type": "string",
              "title": "Chemical / Medium Used",
              "readOnly": true
            },
            "treatment_duration": {
              "type": "string",
              "title": "Treatment Duration",
              "readOnly": true
            },
            "treatment_temperature": {
              "type": "string",
              "title": "Target Temperature (°C)",
              "readOnly": true
            },
            "treatment_concentration": {
              "type": "string",
              "title": "Chemical Concentration / Dosage",
              "readOnly": true
            },
            "treatment_provider": {
              "type": "string",
              "title": "Treatment Provider",
              "oneOf": [
                {
                  "const": "npqs",
                  "title": "NPQS Treatment Station"
                },
                {
                  "const": "external",
                  "title": "Authorized External Provider"
                }
              ],
              "default": "npqs"
            },
            "treatment_supervision": {
              "type": "string",
              "title": "Supervision Required",
              "oneOf": [
                {
                  "const": "with_supervision",
                  "title": "With NPQS Supervision"
                },
                {
                  "const": "without_supervision",
                  "title": "Without Supervision"
                }
              ],
              "default": "without_supervision"
            }
          },
          "required": [
            "id",
            "treatment_provider",
            "treatment_supervision"
          ]
        }
      }
    },
    "required": [
      "treatment_request_outcome"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/treatment_request_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/treatment_items",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/treatment_request_outcome",
            "schema": {
              "const": "approve"
            }
          }
        },
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/commodity_common_name/properties/label",
                    "options": {
                      "readOnly": true
                    },
                    "label": "Commodity Name"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/treatment_type",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/chemical_used",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/treatment_duration",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/treatment_temperature",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/treatment_concentration",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/treatment_provider"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/treatment_supervision"
                  }
                ]
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/clarification_comments",
        "options": {
          "multiLine": true
        }
      }
    ]
  }
}
