{
  "id": "npqs-treatment-request--trader-form",
  "title": "Treatment Request Details",
  "schema": {
    "type": "object",
    "properties": {
      "treatment_type": {
        "type": "string",
        "title": "Treatment Type Requested",
        "readOnly": true,
        "oneOf": [
          { "const": "TPT", "title": "Temperature Treatment" },
          { "const": "CHT", "title": "Chemical Treatment" },
          { "const": "RAT", "title": "Radiation Treatment" },
          { "const": "OTT", "title": "Other Treatment" },
          { "const": "CT", "title": "Cold Treatment" },
          { "const": "HT", "title": "Heat Treatment" },
          { "const": "DR", "title": "Dry Heat" },
          { "const": "MH", "title": "Moist Heat" },
          { "const": "VH", "title": "Vapour Heat" },
          { "const": "KD", "title": "Kiln drying" },
          { "const": "HW", "title": "Hot water treatment" },
          { "const": "DH", "title": "Dielectric Heating" },
          { "const": "FG", "title": "Fungicide" },
          { "const": "IN", "title": "Insecticide" },
          { "const": "NE", "title": "Nematicide" },
          { "const": "OP", "title": "Other pesticide" },
          { "const": "CPI", "title": "Chemical pressure impregnation" },
          { "const": "FU", "title": "Fumigation" },
          { "const": "SC", "title": "Seed coating" },
          { "const": "DV", "title": "Devitalization" },
          { "const": "DB", "title": "Debarking" },
          { "const": "CD", "title": "Cold disinfestation" }
        ]
      },
      "chemical_used": {
        "type": "string",
        "title": "Chemical / Medium Used (If fumigation)",
        "readOnly": true
      },
      "treatment_duration": {
        "type": "string",
        "title": "Treatment Duration",
        "readOnly": true
      },
      "treatment_temperature": {
        "type": "string",
        "title": "Target Temperature (°C)",
        "readOnly": true
      },
      "treatment_concentration": {
        "type": "string",
        "title": "Chemical Concentration / Dosage",
        "readOnly": true
      }
    }
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/treatment_type",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/chemical_used",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/treatment_duration",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/treatment_temperature",
        "options": {
          "readonly": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/treatment_concentration",
        "options": {
          "readonly": true
        }
      }
    ]
  }
}
