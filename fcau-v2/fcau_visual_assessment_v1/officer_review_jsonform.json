{
  "id": "fcau-visual-assessment--reviewer-form",
  "title": "Visual Sample Assessment Form",
  "schema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "title": "Visual Assessment Result (Per Item)",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "Item ID"
            },
            "description_of_food": {
              "type": "string",
              "title": "Description of consignment and quantity"
            },
            "visual_result": {
              "type": "string",
              "title": "Visual Inspection Result",
              "oneOf": [
                {
                  "const": "pass",
                  "title": "Pass - Satisfactory"
                },
                {
                  "const": "fail",
                  "title": "Fail"
                },
                {
                  "const": "refer_lab",
                  "title": "Refer to Lab Test"
                },
                {
                  "const": "refer_warehouse",
                  "title": "Refer to Warehouse Inspection"
                }
              ],
              "default": "pass"
            }
          },
          "required": [
            "id",
            "visual_result"
          ]
        }
      },
      "comments": {
        "type": "string",
        "title": "Manual Physical Assessment Comments"
      }
    },
    "required": [
      "items"
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/items",
        "options": {
          "detail": {
            "type": "VerticalLayout",
            "elements": [
              {
                "type": "HorizontalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/id",
                    "options": {
                      "readOnly": true
                    }
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/description_of_food",
                    "options": {
                      "readOnly": true
                    }
                  }
                ]
              },
              {
                "type": "Control",
                "scope": "#/properties/visual_result"
              }
            ]
          },
          "addable": false,
          "removable": false
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/comments",
        "options": {
          "multi": true
        }
      }
    ]
  }
}
