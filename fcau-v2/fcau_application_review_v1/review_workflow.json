{
  "id": "fcau-application-review--review-workflow",
  "name": "FCAU Application Review — Officer Review",
  "version": 2,
  "nodes": [
    {
      "id": "start",
      "type": "START"
    },
    {
      "id": "userform",
      "type": "TASK",
      "task_template_id": "fcau-application-review--officer-review",
      "input_mapping": {
        "submission?": "submission",
        "reviewform.rejection_reason?": "previous_rejection_reason"
      },
      "output_mapping": {
        "application_review_outcome": "reviewform.application_review_outcome",
        "sample_inspection_required": "reviewform.sample_inspection_required",
        "lab_test_required": "reviewform.lab_test_required",
        "warehouse_inspection_required": "reviewform.warehouse_inspection_required",
        "reference_number?": "reviewform.reference_number",
        "rejection_reason?": "reviewform.rejection_reason"
      }
    },
    {
      "id": "decision_gateway",
      "type": "GATEWAY",
      "gateway_type": "EXCLUSIVE_SPLIT"
    },
    {
      "id": "request_info",
      "type": "TASK",
      "task_template_id": "fcau-application-review--request-info",
      "input_mapping": {
        "callbackToken": "replyToken",
        "reviewform.application_review_outcome": "application_review_outcome",
        "reviewform.sample_inspection_required": "sample_inspection_required",
        "reviewform.lab_test_required": "lab_test_required",
        "reviewform.warehouse_inspection_required": "warehouse_inspection_required",
        "reviewform.reference_number?": "reference_number",
        "reviewform.rejection_reason?": "rejection_reason"
      },
      "output_mapping": {
        "submission": "submission",
        "callbackToken": "callbackToken"
      }
    },
    {
      "id": "api_call",
      "type": "TASK",
      "task_template_id": "fcau-application-review--notify-decision",
      "input_mapping": {
        "callbackToken": "callbackToken",
        "reviewform?": "reviewform",
        "submission?": "submission",
        "taskId": "taskId",
        "reviewform.application_review_outcome": "payload.command",
        "reviewform": "payload.payload"
      }
    },
    {
      "id": "end",
      "type": "END"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source_id": "start",
      "target_id": "userform"
    },
    {
      "id": "e2",
      "source_id": "userform",
      "target_id": "decision_gateway"
    },
    {
      "id": "e_needs_info",
      "source_id": "decision_gateway",
      "target_id": "request_info",
      "condition": "reviewform.application_review_outcome == 'needs_more_info'"
    },
    {
      "id": "e_resubmitted",
      "source_id": "request_info",
      "target_id": "userform"
    },
    {
      "id": "e_approve",
      "source_id": "decision_gateway",
      "target_id": "api_call",
      "condition": "reviewform.application_review_outcome == 'approve'"
    },
    {
      "id": "e3",
      "source_id": "api_call",
      "target_id": "end"
    }
  ]
}
